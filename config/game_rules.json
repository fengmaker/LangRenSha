    "rules": [
      {
        "id": "fox_hunt_threshold",
        "statement": "已标记存活人数加九尾狐自身严格大于未标记存活人数，猎杀时刻才成功；结算出局的是未标记方。",
        "status": "ai_crosschecked_in_game",
        "evidence": [
          {
            "source_path": "data/seasons/S23/第02周_正赛第01期/2026-09-11/2026-09-11_S23_第02周_正赛第01期_第02局_青丘夜影__BV1g1YU6kERd_P01_CID41835236131.平台AI字幕_ai-zh_01.原始.json",
            "source_sha256": "15aa583be5c5ffe2b352b67fb944f6944afe2ab3de4fe58bb32bd7a50d48f58d",
            "start_ms": 4545390,
            "end_ms": 4575340,
            "quote": "12号女巫带有标记\n我们的结算规则为\n标记人数加上九尾狐自身人数\n严格大于未被标记人数\n所以当时场上玩家只有3号玩家\n预言家和6号玩家白泽身上没有标记\n所以在第三天的白天\n4号九尾狐发动猎杀时刻技能\n导致3号预言家以及6号白泽出局\n此时6号白泽出去无法发动技能后"
          },
          {
            "source_path": "data/seasons/S23/第04周_正赛第03期/2026-09-24/2026-09-24_S23_第04周_正赛第03期_第02局_青丘夜影__BV1saaT6jEyK_P01_CID42171630894.平台AI字幕_ai-zh_01.原始.json",
            "source_sha256": "0d544437c0b5c89a0299fd06a7fa14421dff9fe8dd04b8c4ea4a307085262b3c",
            "start_ms": 4054940,
            "end_ms": 4076650,
            "quote": "平民为好人身份\n在第三天白天\n9号玩家九尾狐选择发动技能\n此时的结算为2号玩家身上有标记\n且3号玩家身上有标记\n加上九尾狐\n9号玩家场上一共是三个人\n然后我们剩余没有标记的玩家一共是四个人\n所以没有严格大于九尾狐技能发动失败\n发动失败后"
          }
        ]
      },
      {
        "id": "fox_poison_immunity",
        "statement": "九尾狐免疫普通女巫毒药，原用毒动作仍保存，免疫结算另记。",
        "status": "ai_crosschecked_in_game",
        "evidence": [
          {
            "source_path": "data/seasons/S23/第03周_正赛第02期/2026-09-17/2026-09-17_S23_第03周_正赛第02期_第02局_青丘夜影__BV1nJer63EDh_P01_CID41978954294.平台AI字幕_ai-zh_01.原始.json",
            "source_sha256": "2a524007ce6b9c9a40feba660c8ef2a6a3bd85dc43e07389579cc5d19641db1f",
            "start_ms": 3809990,
            "end_ms": 3822930,
            "quote": "当夜九尾狐开刀击杀6号平民女巫\n毒杀11号九尾狐\n由于特殊结算规则\n我们九尾狐免疫毒药\n所以当夜为6号平民单死\n在第四天白天"
          },
          {
            "source_path": "data/seasons/S23/第05周_正赛第04期/2026-09-29/2026-09-29_S23_第05周_正赛第04期_第02局_青丘夜影__BV1VPaW66EZz_P01_CID42315612579.平台AI字幕_ai-zh_01.原始.json",
            "source_sha256": "c0011bf10a245b697287fb4d168c8c0ae2a6bd02ba42f0a5b78b143ebf52320c",
            "start_ms": 4028740,
            "end_ms": 4045620,
            "quote": "4号六号十号首页守卫守护3号狼人\n当夜九尾对9号玩家女巫进行标记\n狼人击杀9号女巫毒杀8号九尾毒杀失败\n当夜9号玩家被刀出局"
          }
        ]
      },
      {
        "id": "fox_sheriff_vote_mark",
        "statement": "本局九尾狐8号的警徽票为5号带来额外标记；不得将5号标记错补为夜间标记。是否所有投票类型都触发，仍不从这一个场次扩展。",
        "status": "ai_crosschecked_in_game",
        "evidence": [
          {
            "source_path": "data/seasons/S23/第05周_正赛第04期/2026-09-29/2026-09-29_S23_第05周_正赛第04期_第02局_青丘夜影__BV1VPaW66EZz_P01_CID42315612579.平台AI字幕_ai-zh_01.原始.json",
            "source_sha256": "c0011bf10a245b697287fb4d168c8c0ae2a6bd02ba42f0a5b78b143ebf52320c",
            "start_ms": 899460,
            "end_ms": 910290,
            "quote": "带了一刀九对\n因为这板子这个在警下九尾能投一票\n可以出第一个标记\n所以狼在警下可以伪造成这个对"
          },
          {
            "source_path": "data/seasons/S23/第05周_正赛第04期/2026-09-29/2026-09-29_S23_第05周_正赛第04期_第02局_青丘夜影__BV1VPaW66EZz_P01_CID42315612579.平台AI字幕_ai-zh_01.原始.json",
