FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY website/requirements.txt /app/website/requirements.txt
RUN pip install --no-cache-dir -r /app/website/requirements.txt \
    && useradd --create-home --uid 10001 app
COPY website/api /app/website/api
COPY website/assets/player-photos /app/website/assets/player-photos
COPY website/assets/bluffs /app/website/assets/bluffs
COPY website/grant_reader.py /app/website/grant_reader.py
USER app
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "website.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
