    },
    {
      "index": 2359,
      "start_ms": 4479810,
      "end_ms": 4480770,
      "text": "一号5号双死"
    },
    {
      "index": 2360,
      "start_ms": 4480770,
      "end_ms": 4482210,
      "text": "预言家验证8号玩家"
    },
    {
      "index": 2361,
      "start_ms": 4482210,
      "end_ms": 4483430,
      "text": "平民为好人身份"
    },
    {
      "index": 2362,
      "start_ms": 4483430,
      "end_ms": 4484830,
      "text": "在第二令的白天"
    },
    {
      "index": 2363,
      "start_ms": 4484830,
      "end_ms": 4485950,
