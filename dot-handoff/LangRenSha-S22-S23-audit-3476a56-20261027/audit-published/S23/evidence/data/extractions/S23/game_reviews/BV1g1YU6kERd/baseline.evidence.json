      "start_ms": 4503850,
      "end_ms": 4505290,
      "text": "10号狼人选择自爆"
    },
    {
      "index": 2373,
      "start_ms": 4505290,
      "end_ms": 4506750,
      "text": "入夜守卫守护十"
