  "recap_segments": [
    {
      "index": 3115,
      "start_ms": 6105410,
      "end_ms": 6106510,
      "text": "你不是换了女巫吗"
    },
    {
      "index": 3116,
      "start_ms": 6106510,
      "end_ms": 6107670,
      "text": "女巫自己更好"
    },
    {
      "index": 3117,
      "start_ms": 6107670,
      "end_ms": 6109930,
      "text": "她翻一只鞋子了"
    },
    {
      "index": 3118,
      "start_ms": 6109930,
      "end_ms": 6111430,
      "text": "我一直在笑声"
    },
    {
      "index": 3119,
      "start_ms": 6111430,
      "end_ms": 6113500,
      "text": "你才刚没见过"
    },
    {
      "index": 3120,
      "start_ms": 6116910,
      "end_ms": 6118670,
      "text": "好第一局游戏结束了"
    },
    {
      "index": 3121,
      "start_ms": 6118670,
      "end_ms": 6120830,
      "text": "本局游戏预女猎白混血儿版型预言家"
    },
    {
      "index": 3122,
      "start_ms": 6120830,
      "end_ms": 6121590,
      "text": "9号女巫"
    },
    {
      "index": 3123,
      "start_ms": 6121590,
      "end_ms": 6122230,
      "text": "10号猎人"
    },
    {
      "index": 3124,
      "start_ms": 6122230,
      "end_ms": 6123420,
      "text": "一号白神"
    },
    {
      "index": 3125,
      "start_ms": 6123420,
      "end_ms": 6124300,
      "text": "3号狼人"
    },
    {
      "index": 3126,
      "start_ms": 6124300,
      "end_ms": 6127920,
      "text": "2号四号五号八号平民6号七号12号"
    },
    {
      "index": 3127,
      "start_ms": 6127920,
      "end_ms": 6128940,
      "text": "本局游戏的混血儿"
    },
    {
      "index": 3128,
      "start_ms": 6128940,
      "end_ms": 6131040,
      "text": "11号榜样是10号女巫"
    },
    {
      "index": 3129,
      "start_ms": 6131040,
      "end_ms": 6132040,
      "text": "本就戏为好人"
    },
    {
      "index": 3130,
      "start_ms": 6132040,
      "end_ms": 6135390,
      "text": "混首夜狼人击杀12号平民女巫开药解救行程"
    },
    {
      "index": 3131,
      "start_ms": 6135390,
      "end_ms": 6137950,
      "text": "平安夜冤家验证一号玩家为好人身份"
    },
    {
      "index": 3132,
      "start_ms": 6137950,
      "end_ms": 6139330,
      "text": "上警环节"
    },
    {
      "index": 3133,
      "start_ms": 6139330,
      "end_ms": 6140330,
      "text": "警徽流失"
    },
    {
      "index": 3134,
      "start_ms": 6140330,
      "end_ms": 6141110,
      "text": "第一天白天"
    },
    {
      "index": 3135,
      "start_ms": 6141110,
      "end_ms": 6143030,
      "text": "8号悍跳狼被公投出局"
    },
    {
      "index": 3136,
      "start_ms": 6143030,
      "end_ms": 6143970,
      "text": "入夜狼击杀"
    },
    {
      "index": 3137,
      "start_ms": 6143970,
      "end_ms": 6147639,
      "text": "9号预言家女巫毒杀3号白神三九双死"
    },
    {
      "index": 3138,
      "start_ms": 6147639,
      "end_ms": 6150319,
      "text": "当夜预言家验证7号玩家为好人身份"
    },
    {
      "index": 3139,
      "start_ms": 6150319,
      "end_ms": 6152130,
      "text": "第二天白天2号狼人自爆"
    },
    {
      "index": 3140,
      "start_ms": 6152130,
      "end_ms": 6153650,
      "text": "入夜狼人决定拍刀"
    },
    {
      "index": 3141,
      "start_ms": 6153650,
      "end_ms": 6154570,
      "text": "狼人可拍两刀"
    },
    {
      "index": 3142,
      "start_ms": 6154570,
      "end_ms": 6158030,
      "text": "给出的刀路是10号女巫和11号混血儿"
    },
    {
      "index": 3143,
      "start_ms": 6158030,
      "end_ms": 6159030,
      "text": "拍刀失败"
    },
    {
      "index": 3144,
      "start_ms": 6159030,
      "end_ms": 6160740,
      "text": "好人正义获胜"
    },
    {
      "index": 3145,
      "start_ms": 6161060,
      "end_ms": 6162020,
      "text": "好各位大宝老师们"
    },
    {
      "index": 3146,
      "start_ms": 6162020,
      "end_ms": 6164740,
      "text": "您正在收看到的是京城大师赛第23季"
    },
    {
      "index": 3147,
      "start_ms": 6164740,
      "end_ms": 6165440,
      "text": "昆仑归墟"
    },
    {
      "index": 3148,
      "start_ms": 6165440,
      "end_ms": 6166740,
      "text": "京城大师赛第23季"
    },
    {
      "index": 3149,
      "start_ms": 6166740,
      "end_ms": 6169300,
      "text": "是由天天老人app独家冠名赞助播出的"
    },
    {
      "index": 3150,
      "start_ms": 6169300,
      "end_ms": 6171500,
      "text": "欢迎各位弹幕老师们到各大应用商店来搜索"
    },
    {
      "index": 3151,
      "start_ms": 6171500,
      "end_ms": 6172860,
      "text": "并下载天天老app"
    },
    {
      "index": 3152,
      "start_ms": 6172860,
      "end_ms": 6175400,
      "text": "来跟我们一起玩京城大赛的同款版型"
    },
    {
      "index": 3153,
      "start_ms": 6175400,
      "end_ms": 6176240,
      "text": "各位大宝老师们"
    },
    {
      "index": 3154,
      "start_ms": 6176240,
      "end_ms": 6178440,
      "text": "我们正在冲击本小时的抖音人气榜"
    },
    {
      "index": 3155,
      "start_ms": 6178440,
      "end_ms": 6179280,
      "text": "希望各位大老师们"
    },
    {
      "index": 3156,
      "start_ms": 6179280,
      "end_ms": 6181240,
      "text": "在这个小时都能帮我们送一送人气票"
    },
    {
      "index": 3157,
      "start_ms": 6181240,
      "end_ms": 6184600,
      "text": "在下方礼物清单当中找到人气票的选项"
    },
    {
      "index": 3158,
      "start_ms": 6184600,
      "end_ms": 6186680,
      "text": "一毛一装最多可以拉满600张"
    },
    {
      "index": 3159,
      "start_ms": 6186680,
      "end_ms": 6187720,
      "text": "有效的人气票"
    },
    {
      "index": 3160,
      "start_ms": 6187720,
      "end_ms": 6189080,
      "text": "第一张非常关键啊"
    },
    {
      "index": 3161,
      "start_ms": 6189080,
      "end_ms": 6190720,
      "text": "大家在直播间都尽量帮我们送下"
    },
    {
      "index": 3162,
      "start_ms": 6190720,
      "end_ms": 6191940,
      "text": "第一张付费的人气票"
    },
    {
      "index": 3163,
      "start_ms": 6191940,
      "end_ms": 6194220,
      "text": "有额外的200的人气值加成"
    },
    {
      "index": 3164,
      "start_ms": 6194220,
      "end_ms": 6195780,
      "text": "大家每个人都送出一张"
    },
    {
      "index": 3165,
      "start_ms": 6195780,
      "end_ms": 6197140,
      "text": "第一张的付费人气票的话"
    },
    {
      "index": 3166,
      "start_ms": 6197140,
      "end_ms": 6198560,
      "text": "我们很容易冲到前十的"
    },
    {
      "index": 3167,
      "start_ms": 6198560,
      "end_ms": 6200000,
      "text": "感谢各位弹幕老师的支持"
    },
    {
      "index": 3168,
      "start_ms": 6200000,
      "end_ms": 6202460,
      "text": "接下来把镜头给到第二现场的解说老师"
    },
    {
      "index": 3169,
      "start_ms": 6202460,
      "end_ms": 6204140,
      "text": "稍后回来是我们今天的第二局游戏"
    },
    {
      "index": 3170,
      "start_ms": 6204140,
      "end_ms": 6206000,
      "text": "盗宝大师"
    },
    {
      "index": 3171,
      "start_ms": 6211060,
      "end_ms": 6212620,
      "text": "哇苏达太幸福了"
    },
    {
      "index": 3172,
      "start_ms": 6212620,
      "end_ms": 6214380,
      "text": "我说实在太幸福了"
    },
    {
      "index": 3173,
      "start_ms": 6214380,
      "end_ms": 6216060,
      "text": "正好是混子嘛对吧"
    },
    {
      "index": 3174,
      "start_ms": 6216060,
      "end_ms": 6218180,
      "text": "肯定知道肯定歪哥不是狼混"
    },
    {
      "index": 3175,
      "start_ms": 6218180,
      "end_ms": 6219260,
      "text": "肯定知道歪哥不是狼混"
    },
    {
      "index": 3176,
      "start_ms": 6219260,
      "end_ms": 6220460,
      "text": "歪哥是纯种好人"
    },
    {
      "index": 3177,
      "start_ms": 6220460,
      "end_ms": 6224190,
      "text": "对呃这把的"
    },
    {
      "index": 3178,
      "start_ms": 6224670,
      "end_ms": 6227550,
      "text": "而且歪哥如果真的是狼人点的刀"
    },
    {
      "index": 3179,
      "start_ms": 6227550,
      "end_ms": 6228630,
      "text": "也不也不会错嘛"
    },
    {
      "index": 3180,
      "start_ms": 6228630,
      "end_ms": 6229639,
      "text": "对吧对啊"
    },
    {
      "index": 3181,
      "start_ms": 6229639,
      "end_ms": 6231579,
      "text": "他自己知道自己是平民好人"
    },
    {
      "index": 3182,
      "start_ms": 6231579,
      "end_ms": 6233799,
      "text": "就一下知道七肯定是纯种好人"
    },
    {
      "index": 3183,
      "start_ms": 6233799,
      "end_ms": 6235380,
      "text": "而且如果七是"
    },
    {
      "index": 3184,
      "start_ms": 6235380,
      "end_ms": 6236580,
      "text": "其实这个狼混"
    },
    {
      "index": 3185,
      "start_ms": 6236580,
      "end_ms": 6241300,
      "text": "判断3号是一个白神或者猎人的话"
    },
    {
      "index": 3186,
      "start_ms": 6241300,
      "end_ms": 6242820,
      "text": "就接着继续听发言吧"
    },
    {
      "index": 3187,
      "start_ms": 6242820,
      "end_ms": 6247700,
      "text": "我觉得这把这把的情况其实好人的赢面很低了"
    },
    {
      "index": 3188,
      "start_ms": 6247700,
      "end_ms": 6248540,
      "text": "已经对啊"
    },
    {
      "index": 3189,
      "start_ms": 6248540,
      "end_ms": 6250520,
      "text": "如果没有歪哥这波打心态啊"
    },
    {
      "index": 3190,
      "start_ms": 6250520,
      "end_ms": 6254309,
      "text": "对就是劝是就是劝的话"
    },
    {
      "index": 3191,
      "start_ms": 6254309,
      "end_ms": 6255969,
      "text": "自己的身份反而不高"
    },
    {
      "index": 3192,
      "start_ms": 6255969,
      "end_ms": 6259029,
      "text": "然后聊逻辑呢自己又在狼坑里"
    },
    {
      "index": 3193,
      "start_ms": 6259029,
      "end_ms": 6261420,
      "text": "因为4号的身份太高"
    },
    {
      "index": 3194,
      "start_ms": 6261420,
      "end_ms": 6262860,
      "text": "就怕P不过四"
    },
    {
      "index": 3195,
      "start_ms": 6262860,
      "end_ms": 6265900,
      "text": "而且这个6号和12号第一天就认准身份的"
    },
    {
      "index": 3196,
      "start_ms": 6265900,
      "end_ms": 6269210,
      "text": "一本正经拍他的话就是让狼自己拍的话"
    },
    {
      "index": 3197,
      "start_ms": 6269210,
      "end_ms": 6270810,
      "text": "未必会拍错的"
    },
    {
      "index": 3198,
      "start_ms": 6270810,
      "end_ms": 6272070,
