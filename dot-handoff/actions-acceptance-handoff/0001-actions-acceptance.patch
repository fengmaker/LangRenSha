@@ -0,0 +1,74 @@
+name: Full S22 S23 acceptance
+on:
+  workflow_dispatch:
+  push:
+    branches: ['ci/full-acceptance']
+permissions:
+  contents: read
+concurrency:
+  group: full-acceptance-${{ github.ref }}
+  cancel-in-progress: true
+jobs:
+  acceptance:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 35
+    services:
+      postgres:
+        image: postgres:18-alpine
+        env:
+          POSTGRES_DB: masters_ci
+          POSTGRES_USER: masters_ci
+          # Disposable runner-only credentials, NEVER production credentials.
+          POSTGRES_PASSWORD: ci-disposable-owner-password
+        ports: ['5432:5432']
+        options: >-
+          --health-cmd "pg_isready -U masters_ci -d masters_ci"
+          --health-interval 5s --health-timeout 3s --health-retries 20
+    env:
+      CI: 'true'
+      NEXT_TELEMETRY_DISABLED: '1'
+      DATABASE_URL: postgresql://masters_ci:ci-disposable-owner-password@127.0.0.1:5432/masters_ci
+      MASTERS_READER_PASSWORD: ci-disposable-reader-password
+      API_BASE_URL: http://127.0.0.1:8000
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+        with:
+          persist-credentials: false
+          fetch-depth: 1
+          # Sparse checkout also enables partial clone: do not add filter, which overrides it.
+          sparse-checkout: |
+            .github
+            config
+            scripts
+            requirements
+            website
+            data/games/S22
+            data/games/S23
+            data/extractions/S22/voting
+            data/extractions/S23/voting
+            data/reports
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
+        with:
+          python-version: '3.12'
+      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
+        with:
+          node-version: '22'
+      - name: Install only website acceptance dependencies
+        run: |
+          python -m pip install -r requirements/web.txt 'pytest>=8,<9' 'httpx>=0.28,<1' 'playwright==1.61.0'
+          python -m playwright install --with-deps chromium
+          npm ci --prefix website/web
+      - name: Publish, test, serve and verify real data
+        run: python -m website.ci_acceptance
+      - name: Upload bounded acceptance evidence (no sources, DB dumps, env or traces)
+        if: ${{ always() }}
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: acceptance-${{ github.run_id }}-${{ github.run_attempt }}
+          path: |
+            website/artifacts/ci-upload/*.json
+            website/artifacts/ci-upload/*.log
+            website/artifacts/ci-upload/screenshots/*.png
+          if-no-files-found: warn
+          retention-days: 7
+          include-hidden-files: false
