      "text": "来源先"
    },
    {
      "start_ms": 8511390,
      "end_ms": 8512720,
      "text": "我先把复盘做了"
    },
    {
      "start_ms": 8512720,
      "end_ms": 8514360,
      "text": "本局版型为机械狼"
    },
    {
      "start_ms": 8514360,
      "end_ms": 8514820,
      "text": "通灵师"
    },
    {
      "start_ms": 8514820,
