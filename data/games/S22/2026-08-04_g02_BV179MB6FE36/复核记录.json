  "recap_segments": [
    {
      "start_ms": 5363330,
      "end_ms": 5366710,
      "text": "当时啊什么那个我们也什么好，"
    },
    {
      "start_ms": 5366730,
      "end_ms": 5367930,
      "text": "第二局游戏结束了，"
    },
    {
      "start_ms": 5367930,
      "end_ms": 5368990,
      "text": "本局游戏预言家，"
    },
    {
      "start_ms": 5369010,
      "end_ms": 5369890,
      "text": "八号女巫，"
    },
    {
      "start_ms": 5369910,
      "end_ms": 5373930,
      "text": "五号舞者十号白神一号假面十二号，"
    },
    {
      "start_ms": 5373930,
      "end_ms": 5378395,
      "text": "狼人六号、七号、十一号平民二号、三号、四号、九号。"
    },
    {
      "start_ms": 5378920,
      "end_ms": 5387050,
      "text": "首夜狼姬杀一号白神女巫开药解救行程平安夜冤家验证三号安家伟好人身份上警环节警徽流失。"
    },
    {
      "start_ms": 5387050,
      "end_ms": 5387790,
      "text": "第一天白天，"
    },
    {
      "start_ms": 5387790,
      "end_ms": 5388230,
      "text": "六号，"
    },
    {
      "start_ms": 5388230,
      "end_ms": 5389645,
      "text": "狼人被公投出局，"
    },
    {
      "start_ms": 5390200,
      "end_ms": 5392400,
      "text": "入夜舞者跟我的对象为三号平民，"
    },
    {
      "start_ms": 5392420,
      "end_ms": 5396100,
      "text": "四号平民和十二号假面假面验证。"
    },
    {
      "start_ms": 5396140,
      "end_ms": 5397600,
      "text": "八号预言家不在舞池，"
    },
    {
      "start_ms": 5397600,
      "end_ms": 5399340,
      "text": "给十号舞者扣了面具。"
    },
    {
      "start_ms": 5399340,
      "end_ms": 5399980,
      "text": "舞池当中，"
    },
    {
      "start_ms": 5399980,
      "end_ms": 5401845,
      "text": "十二号假面被公务出局，"
    },
    {
      "start_ms": 5402260,
      "end_ms": 5404080,
      "text": "狼人空刀女巫毒杀七号，"
    },
    {
      "start_ms": 5404140,
      "end_ms": 5405100,
      "text": "狼人七十二，"
    },
    {
      "start_ms": 5405100,
      "end_ms": 5407545,
      "text": "双子预言家验证九号两位好人身份。"
    },
    {
      "start_ms": 5407950,
      "end_ms": 5410550,
      "text": "第二天白天最后一张狼人十一号选择招牌，"
    },
    {
      "start_ms": 5410590,
      "end_ms": 5411325,
      "text": "游戏结束，"
    },
    {
      "start_ms": 5411610,
      "end_ms": 5412605,
      "text": "好人正义获胜，"
    },
    {
      "start_ms": 5413650,
      "end_ms": 5416870,
      "text": "一局好人一个都没出局的加冕舞会啊，"
    }
