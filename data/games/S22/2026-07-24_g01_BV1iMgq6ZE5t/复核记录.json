  "recap_segments": [
    {
      "start_ms": 3159090,
      "end_ms": 3159330,
      "text": "好，"
    },
    {
      "start_ms": 3159570,
      "end_ms": 3161510,
      "text": "给各位大宝师们做本游戏的复盘。"
    },
    {
      "start_ms": 3161510,
      "end_ms": 3164590,
      "text": "本集版新为一女列白混血儿玄君预言家。"
    },
    {
      "start_ms": 3164590,
      "end_ms": 3166070,
      "text": "九号女巫八号猎人，"
    },
    {
      "start_ms": 3166070,
      "end_ms": 3166410,
      "text": "二号，"
    },
    {
      "start_ms": 3166410,
      "end_ms": 3167490,
      "text": "白蛇十一号狼人阵营，"
    },
    {
      "start_ms": 3167490,
      "end_ms": 3169090,
      "text": "三号、四号、十号十二号，"
    },
    {
      "start_ms": 3169410,
      "end_ms": 3172250,
      "text": "平民阵营五号六号七号混血儿一号。"
    },
    {
      "start_ms": 3172270,
      "end_ms": 3178260,
      "text": "本游戏为好人混首夜混者尔选择七号平民为榜样，"
    },
    {
      "start_ms": 3178260,
      "end_ms": 3178780,
      "text": "形成好人。"
    },
    {
      "start_ms": 3178780,
      "end_ms": 3181780,
      "text": "问狼人击杀三号狼人女巫要救起，"
    },
    {
      "start_ms": 3181780,
      "end_ms": 3182940,
      "text": "形成平安夜预言家，"
    },
    {
      "start_ms": 3182940,
      "end_ms": 3183380,
      "text": "验证。"
    },
    {
      "start_ms": 3183380,
      "end_ms": 3186140,
      "text": "十号玩家为狼人身份情商竞尾环节，"
    },
    {
      "start_ms": 3186240,
      "end_ms": 3187680,
      "text": "十号狼人选择自爆，"
    },
    {
      "start_ms": 3187960,
      "end_ms": 3191480,
      "text": "入夜狼队击杀九号预言家牛犊杀四号狼人，"
    },
    {
      "start_ms": 3191480,
      "end_ms": 3193300,
      "text": "四号九号伤死预言家验证。"
    },
    {
      "start_ms": 3193320,
      "end_ms": 3196300,
      "text": "三号玩家为狼人身份延期禁尾环节。"
    },
    {
      "start_ms": 3196320,
      "end_ms": 3198935,
      "text": "十二号狼人选择自爆本游戏警徽流失。"
    },
    {
      "start_ms": 3201990,
      "end_ms": 3202370,
      "text": "入夜，"
    },
    {
      "start_ms": 3202370,
      "end_ms": 3205930,
      "text": "狼队击杀七号平民七号平民单死在第三天。"
    },
    {
      "start_ms": 3205930,
      "end_ms": 3207030,
      "text": "白天十一号，"
    },
    {
      "start_ms": 3207110,
      "end_ms": 3209150,
      "text": "白神被扛推出局后，"
    },
    {
      "start_ms": 3209250,
      "end_ms": 3211870,
      "text": "狼队拍刀二号猎人拍刀失败，"
    },
    {
      "start_ms": 3211890,
      "end_ms": 3212530,
      "text": "游戏结束，"
    },
    {
      "start_ms": 3212650,
      "end_ms": 3213550,
      "text": "好人阵营获胜。"
    },
    {
      "start_ms": 3213910,
      "end_ms": 3216590,
      "text": "以上是我们今天第一局孕女李白混血儿的全部内容。"
    },
    {
      "start_ms": 3216730,
      "end_ms": 3218024,
      "text": "感谢各位家人的陪伴，"
    }
  ],
