    },
    {
      "start_ms": 2993450,
      "end_ms": 2994595,
      "text": "12号"
    },
    {
      "start_ms": 2995930,
      "end_ms": 3000570,
      "text": "狼人阵营2号四号六号七号平民阵营一号3号"
    },
    {
      "start_ms": 3000570,
      "end_ms": 3002330,
      "text": "10号混血儿5号"
    },
    {
      "start_ms": 3002330,
      "end_ms": 3006209,
      "text": "本游戏为狼人混咳啊"
    },
    {
      "start_ms": 3006209,
      "end_ms": 3008789,
      "text": "所以混血选择7号狼人为榜样"
    },
    {
      "start_ms": 3008789,
      "end_ms": 3012440,
      "text": "形成狼人混狼人击杀12号白神牛药救起"
    },
    {
      "start_ms": 3012440,
      "end_ms": 3014880,
      "text": "形成平安夜预言家验证了3号玩家"
    },
    {
      "start_ms": 3014880,
