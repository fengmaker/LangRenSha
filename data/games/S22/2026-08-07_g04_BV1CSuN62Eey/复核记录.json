  "audio_path": "data/seasons/S22/第11周_正赛第10期/2026-08-07/2026-08-07_S22_第11周_正赛第10期_第04局_机械狼通灵师__BV1CSuN62Eey_P01_CID40694515701.音频.m4a",
  "source_path": "data/seasons/S22/第11周_正赛第10期/2026-08-07/2026-08-07_S22_第11周_正赛第10期_第04局_机械狼通灵师__BV1CSuN62Eey_P01_CID40694515701.本地全文转写_funasr.json",
  "recap_segments": [
    {
      "start_ms": 2447345,
      "end_ms": 2447625,
      "text": "谢谢。"
    },
    {
      "start_ms": 2447625,
      "end_ms": 2449445,
      "text": "守卫又让我知道了，"
    },
    {
      "start_ms": 2450965,
      "end_ms": 2457905,
      "text": "谢谢胖发不如好给各位弹幕老师们做本游戏的复盘。"
    },
    {
      "start_ms": 2457905,
      "end_ms": 2459285,
      "text": "本局版型为机械狼，"
    },
    {
      "start_ms": 2459285,
      "end_ms": 2459865,
      "text": "通灵师，"
    },
    {
      "start_ms": 2460185,
      "end_ms": 2461145,
      "text": "神人阵营通灵师。"
    },
    {
      "start_ms": 2461145,
      "end_ms": 2464605,
      "text": "七号女巫二号猎人五号守卫十一号狼人阵营，"
    },
    {
      "start_ms": 2464605,
      "end_ms": 2466025,
      "text": "三号八号九号，"
    },
    {
      "start_ms": 2466365,
      "end_ms": 2467405,
      "text": "机械狼十二号。"
    },
    {
      "start_ms": 2467425,
      "end_ms": 2477205,
      "text": "本局游戏为机械守卫平民阵营一号四号、六号、十号首页守卫守护十号平民狼队击杀四号平民女巫要救起，"
    },
    {
      "start_ms": 2477225,
      "end_ms": 2478885,
      "text": "形成平安夜机械狼，"
    },
    {
      "start_ms": 2478985,
      "end_ms": 2480205,
      "text": "当夜技能空过，"
    },
    {
      "start_ms": 2480685,
      "end_ms": 2481705,
      "text": "通灵师验证。"
    },
    {
      "start_ms": 2481805,
      "end_ms": 2483985,
      "text": "十一号玩家为守卫身份，"
    },
    {
      "start_ms": 2484225,
      "end_ms": 2485355,
      "text": "警称竞选环节。"
    },
    {
      "start_ms": 2485375,
      "end_ms": 2486840,
      "text": "九号狼人选择自爆，"
    },
    {
      "start_ms": 2487205,
      "end_ms": 2487605,
      "text": "入夜，"
    },
    {
      "start_ms": 2487625,
      "end_ms": 2489905,
      "text": "守卫守护六号平民狼队击杀。"
    },
    {
      "start_ms": 2490005,
      "end_ms": 2490425,
      "text": "七号，"
    },
    {
      "start_ms": 2490505,
      "end_ms": 2492585,
      "text": "通灵师女巫毒杀，"
    },
    {
      "start_ms": 2492645,
      "end_ms": 2494565,
      "text": "三号狼人三号七号，"
    },
    {
      "start_ms": 2494585,
      "end_ms": 2498355,
      "text": "双子机械狼当夜选择模仿十一号首位本局游戏，"
    },
    {
      "start_ms": 2498355,
      "end_ms": 2501155,
      "text": "为机械守卫通律师，"
    },
    {
      "start_ms": 2501155,
      "end_ms": 2504405,
      "text": "验证了三号玩家为狼人身份延期接吻环节。"
    },
    {
      "start_ms": 2504405,
      "end_ms": 2506830,
      "text": "八号狼人选择自爆本局游戏警分流失，"
    },
    {
      "start_ms": 2507315,
      "end_ms": 2510105,
      "text": "入夜守卫技能空过狼队哦。"
    },
    {
      "start_ms": 2510105,
      "end_ms": 2513545,
      "text": "机械狼选择击杀六号平民，"
    },
    {
      "start_ms": 2513685,
      "end_ms": 2515265,
      "text": "并自首守护十二号。"
    },
    {
      "start_ms": 2515265,
      "end_ms": 2516625,
      "text": "机械狼当役为六号，"
    },
    {
      "start_ms": 2516625,
      "end_ms": 2518325,
      "text": "平民单死在第三天，"
    },
    {
      "start_ms": 2518325,
      "end_ms": 2522205,
      "text": "白天场上最后一狼十二号机械守卫被公投出局，"
    },
    {
      "start_ms": 2522225,
      "end_ms": 2523830,
      "text": "游戏结束好人这一获胜。"
    },
    {
      "start_ms": 2524255,
      "end_ms": 2526395,
      "text": "以上呢是我们今天四局版型的全部内容，"
    },
    {
      "start_ms": 2526395,
      "end_ms": 2528460,
      "text": "也是我们本周竞争大赛的全部内容。"
    },
    {
      "start_ms": 2528775,
      "end_ms": 2530515,
      "text": "再次感谢每位家人陪伴。"
    }
  ],
