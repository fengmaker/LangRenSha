  "recap_segments": [
    {
      "start_ms": 5212840,
      "end_ms": 5213080,
      "text": "好，"
    },
    {
      "start_ms": 5213460,
      "end_ms": 5215860,
      "text": "给各位弹幕老师们做一下本局游戏的复盘。"
    },
    {
      "start_ms": 5215860,
      "end_ms": 5216740,
      "text": "本局版行为，"
    },
    {
      "start_ms": 5217040,
      "end_ms": 5226920,
      "text": "机械狼通灵师神警营通灵师五号女巫七号猎人十号守卫十一号狼人阵营二号、六号八号。"
    },
    {
      "start_ms": 5226960,
      "end_ms": 5232280,
      "text": "机械狼三号本局游戏为机械守卫平民阵营一号四号九号十二号，"
    },
    {
      "start_ms": 5232600,
      "end_ms": 5237020,
      "text": "首夜守卫守护一号平民狼人击杀九号平民扭妖救骑行车。"
    },
    {
      "start_ms": 5237020,
      "end_ms": 5237500,
      "text": "平安夜。"
    },
    {
      "start_ms": 5237960,
      "end_ms": 5243930,
      "text": "机械狼选择模仿十一号守卫本局游戏为机械守卫通灵师验证六号玩家为狼人身份，"
    },
    {
      "start_ms": 5244230,
      "end_ms": 5245250,
      "text": "请稍记尾环节。"
    },
    {
      "start_ms": 5245370,
      "end_ms": 5246850,
      "text": "五号通灵师获得警徽。"
    },
    {
      "start_ms": 5246850,
      "end_ms": 5248150,
      "text": "第一天白天六号，"
    },
    {
      "start_ms": 5248250,
      "end_ms": 5249470,
      "text": "狼人被公托出局，"
    },
    {
      "start_ms": 5252070,
      "end_ms": 5253210,
      "text": "入夜守卫守护。"
    },
    {
      "start_ms": 5253210,
      "end_ms": 5255770,
      "text": "五号通灵师狼人击杀十一号，"
    },
    {
      "start_ms": 5255770,
      "end_ms": 5257930,
      "text": "守卫牛毒杀八号狼人，"
    },
    {
      "start_ms": 5258310,
      "end_ms": 5265650,
      "text": "机械狼守护二号狼人当年为八号十一号双死通灵师夜间验证九号玩家为平民身份，"
    },
    {
      "start_ms": 5265970,
      "end_ms": 5266970,
      "text": "在第二天的白天，"
    },
    {
      "start_ms": 5267090,
      "end_ms": 5268350,
      "text": "二号狼人选择自爆，"
    },
    {
      "start_ms": 5268610,
      "end_ms": 5271120,
      "text": "入夜机械狼开刀击杀。"
    },
    {
      "start_ms": 5271260,
      "end_ms": 5274985,
      "text": "五号通灵师五号通灵师验证了十二号玩家为平民身份，"
    },
    {
      "start_ms": 5275320,
      "end_ms": 5278065,
      "text": "并在出局后将警徽一交至十二号平民。"
    },
    {
      "start_ms": 5279110,
      "end_ms": 5283680,
      "text": "在第三天白天场上最后一狼三号机械守卫被公投出局，"
    },
    {
      "start_ms": 5283700,
      "end_ms": 5285225,
      "text": "游戏结束好人阵营获胜。"
    },
    {
      "start_ms": 5285570,
      "end_ms": 5287470,
      "text": "以上是我们今天三局版型的全部内容，"
    },
    {
      "start_ms": 5287470,
      "end_ms": 5289585,
      "text": "也是我们本周精神大赛的全部内容，"
    },
    {
      "start_ms": 5289880,
      "end_ms": 5291460,
      "text": "非常感谢每一位家人的陪伴。"
    }
  ],
