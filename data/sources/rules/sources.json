  "official_cards": [
    {
      "board": "预女猎白混",
      "image_order": 4,
      "printed_profile": "神职：预言家+女巫+猎人+白神；平民：平民×3+混血儿；狼人：狼人×4。",
      "printed_rules": "混血儿首夜选择榜样，胜利条件跟随榜样阵营；自身底牌属性为平民、无夜间技能、预言家查验恒为好人。白神被放逐时公布身份。",
      "printed_roles_sum": 12,
      "s21_status": "S21字幕只指向官方置顶规则，未单独复述这些技能；S21修订状态unknown。",
      "source-unverified": "unknown"
    },
    {
      "board": "机械狼通灵师",
      "image_order": 2,
      "printed_profile": "神职：通灵师+女巫+猎人+守卫；平民×4；狼人：机械狼+狼人×3。",
      "printed_rules": "机械狼夜间模仿一名玩家；模仿守卫可守护并免狼刀/毒，若守护到毒目标则女巫反伤出局；模仿女巫可毒；模仿猎人出局可带人但被毒不能开枪；模仿通灵师每晚查具体身份；模仿狼人则其他狼全出后可用无视保护的狼刀；模仿平民无技能。机械狼不见其他三狼、不可自爆；其他狼人出局后机械狼方可带刀。",
      "printed_roles_sum": 12,
      "s21_status": "S21标题存在；一个S21字幕只说本局无警徽，另有讨论说机械狼学到身份，均不足以验证完整配置。",
      "source-unverified": "unknown"
    },
    {
      "board": "假面舞会",
      "image_order": 3,
      "printed_profile": "神职：预言家+女巫+舞者+白痴；平民×4；狼人：假面+狼人×3。",
      "printed_rules": "舞者自第二夜起每晚选三人共舞；同阵营无事，异阵营人数少的一方死亡。舞者免毒；舞者入舞池时当夜三人免狼刀；每人只能共舞一次。假面与狼队不见面；每晚验一人是否在舞池并可给一人面具，持面具者入舞池时按相反阵营结算；假面免毒、不能连续两夜验同一人或给同一人面具、不能自爆；其他狼全出后方可每夜刀人。屠边。",
      "printed_roles_sum": 12,
      "s21_status": "S21开场字幕逐项讲舞者/假面能力并提屠边，和卡片大体相符；字幕的第二页、被五出局需听音复核。",
      "source-unverified": "unknown"
    },
    {
      "board": "孤注一掷",
      "image_order": 5,
      "printed_profile": "神职：预言家+女巫+猎人+摄梦人；平民×4；狼人：典狱长+狼人×3。",
      "printed_rules": "典狱长次夜起每晚选两人交易，随后与狼队共同行动；每人只能交易一次。两人知交易对象、不知其身份，各自选交易或背叛。双方交易则免夜伤；双方背叛则互为当夜技能目标；一交易一背叛则交易者出局。典狱长选自己时，同典狱长选择则典狱长出局，不同则另一方出局。",
      "printed_roles_sum": 12,
      "s21_status": "S21字幕解释选两人、同意/背叛和部分免伤结果；未证实卡片所有分支及次夜起时间。",
      "source-unverified": "unknown"
    },
    {
      "board": "唯邻是从",
      "image_order": 6,
      "printed_profile": "神职：预言家+女巫+猎人+守卫；平民×5；狼人：狼王+狼人×2+傀儡。",
      "printed_rules": "3名狼人入夜后选择与狼人相邻的一名玩家成为傀儡；傀儡底牌不变但技能错乱；预言家查验结果相反，女巫/猎人/守卫技能失效。",
      "printed_roles_sum": 13,
      "s21_status": "S21开场字幕称5民+3狼+1狼王+4神，也合计13；卡片/字幕与12席的关系未解，不得压缩成12。",
      "source-unverified": "unknown"
    },
    {
      "board": "盗宝大师",
      "image_order": 1,
      "printed_profile": "神职：通灵师+毒师+猎人+摄梦人+蒙面人；平民×5；狼人：狼王+狼人×3；另列特殊身份盗宝大师、蒙面人。",
      "printed_rules": "首夜狼人不能击杀；毒师有一瓶毒，毒杀的猎人或狼王不能发动技能。盗宝大师首夜得知剩余牌堆三张身份；若含狼人阵营角色则归狼队，否则归好人；狼人同伴全出后可杀人；每夜选一身份牌用技能，不能连续两夜选同一牌。蒙面人有中毒/负伤延迟死亡和盗宝切蒙面后被抗推不死的说明。",
      "printed_faction_rows_sum": 14,
      "s21_status": "S21字幕提及五张神、盗宝大师与三小狼分开、夜间不能切狼人且切神牌可用技能；卡片行数/特殊身份席位仍不清楚。",
      "source-unverified": "unknown"
    },
    {
      "board": "诡术之境",
      "image_order": 7,
      "printed_profile": "神职：预言家+女巫+魔术师+定序王子；平民×4；狼人：诡术师+狼人×3。",
      "printed_rules": "魔术师与诡术师完全交换同样号码时两者均无效。定序王子放逐投票后可翻牌重新组织投票，重投前可额外发言一次，整局至多一次。诡术师每晚交换两号、每人最多一次、可空过但不可连续空换；被交换玩家白天出局信息置换。",
      "printed_roles_sum": 12,
      "s21_status": "All listed profile and rule text is also on the S21-specific official image S21-P0105.",
      "source-unverified": "unknown"
    }
  ]
