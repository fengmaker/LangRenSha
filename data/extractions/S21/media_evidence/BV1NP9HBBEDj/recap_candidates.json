        "evidence": [
          {
            "index": 2206,
            "source_segment_index": 2206,
            "start_ms": 4529469,
            "end_ms": 4531509,
            "text": "一起来为呆呆鸟庆生吧"
          },
          {
            "index": 2207,
            "source_segment_index": 2207,
            "start_ms": 4531509,
            "end_ms": 4533789,
            "text": "接下来我们把镜头给到第二现场解说老师"
          },
          {
            "index": 2208,
            "source_segment_index": 2208,
            "start_ms": 4533789,
            "end_ms": 4535760,
            "text": "上午回来是我们今天的第二局"
          },
          {
            "index": 2209,
            "source_segment_index": 2209,
            "start_ms": 4535760,
            "end_ms": 4538320,
            "text": "然后我们第二句的版型是鬼畜之镜"
          },
          {
            "index": 2210,
            "source_segment_index": 2210,
            "start_ms": 4538320,
            "end_ms": 4542870,
            "text": "感兴趣的宝石们可以到官博置顶部分来查看到文字版的版型规则介绍"
          },
          {
            "index": 2211,
            "source_segment_index": 2211,
            "start_ms": 4542870,
            "end_ms": 4544590,
            "text": "有请第二现场"
          },
          {
            "index": 2212,
            "source_segment_index": 2212,
            "start_ms": 4547700,
            "end_ms": 4551060,
            "text": "呃确实也是非常快就结束了"
          },
          {
            "index": 2213,
            "source_segment_index": 2213,
            "start_ms": 4551950,
            "end_ms": 4558920,
            "text": "呃手指非常符合我们大二赛我们毕竟是非常高水平的一个比赛啊"
          },
          {
            "index": 2214,
            "source_segment_index": 2214,
            "start_ms": 4558920,
            "end_ms": 4560680,
            "text": "就是只打第一天"
          },
          {
            "index": 2215,
            "source_segment_index": 2215,
            "start_ms": 4560680,
            "end_ms": 4561800,
            "text": "只打第一天"
          },
          {
            "index": 2216,
            "source_segment_index": 2216,
            "start_ms": 4561800,
            "end_ms": 4566910,
            "text": "只打第一天呃那我们先请笑笑来评价一下我们第一局就分析分析嘛"
          },
          {
            "index": 2217,
            "source_segment_index": 2217,
            "start_ms": 4566910,
            "end_ms": 4569840,
            "text": "作作为作为一个呃解说老师"
          },
          {
            "index": 2218,
            "source_segment_index": 2218,
            "start_ms": 4569840,
            "end_ms": 4571360,
            "text": "就对第一局有什么看法"
          },
          {
            "index": 2219,
            "source_segment_index": 2219,
            "start_ms": 4571360,
            "end_ms": 4574500,
            "text": "我们其实可以看到第一把我们上6号混血了"
          },
          {
            "index": 2220,
            "source_segment_index": 2220,
            "start_ms": 4574500,
            "end_ms": 4575760,
            "text": "第一天混的是7号"
          },
          {
            "index": 2221,
            "source_segment_index": 2221,
            "start_ms": 4575760,
            "end_ms": 4576940,
            "text": "歪哥狼混嘛"
          },
          {
            "index": 2222,
            "source_segment_index": 2222,
            "start_ms": 4576940,
            "end_ms": 4581390,
            "text": "这个然后歪哥悍跳拿到总会因为我们两个没有声音吗"
          },
          {
            "index": 2223,
            "source_segment_index": 2223,
            "start_ms": 4581390,
            "end_ms": 4583190,
            "text": "两个狼牌在警下"
          },
          {
            "index": 2224,
            "source_segment_index": 2224,
            "start_ms": 4583190,
            "end_ms": 4587770,
            "text": "然后我们其实基本上就奠定了这把狼队胜利的一个大基础"
          },
          {
            "index": 2225,
            "source_segment_index": 2225,
            "start_ms": 4588409,
            "end_ms": 4589549,
            "text": "没事那我们一起"
          },
          {
            "index": 2226,
            "source_segment_index": 2226,
            "start_ms": 4589549,
            "end_ms": 4592689,
            "text": "然后当我们歪哥拿到警徽的时候"
          },
          {
            "index": 2227,
            "source_segment_index": 2227,
            "start_ms": 4592689,
            "end_ms": 4593849,
            "text": "其实骗一票就够了"
          },
          {
            "index": 2228,
            "source_segment_index": 2228,
            "start_ms": 4593849,
            "end_ms": 4594849,
            "text": "我们当时上生理的时候"
          },
          {
            "index": 2229,
            "source_segment_index": 2229,
            "start_ms": 4594849,
            "end_ms": 4597190,
            "text": "你看gr好"
          },
          {
            "index": 2230,
            "source_segment_index": 2230,
            "start_ms": 4597190,
            "end_ms": 4599430,
            "text": "给二发的是金水牌对吧"
          },
          {
            "index": 2231,
            "source_segment_index": 2231,
            "start_ms": 4599430,
            "end_ms": 4601070,
            "text": "给二发的是金水牌"
          },
          {
            "index": 2232,
            "source_segment_index": 2232,
            "start_ms": 4601070,
            "end_ms": 4602920,
            "text": "没杀你"
          },
          {
            "index": 2233,
            "source_segment_index": 2233,
            "start_ms": 4602920,
            "end_ms": 4604180,
            "text": "那我先来吧"
          },
          {
            "index": 2234,
            "source_segment_index": 2234,
            "start_ms": 4604180,
            "end_ms": 4605320,
            "text": "好你来你来呃"
          },
          {
            "index": 2235,
            "source_segment_index": 2235,
            "start_ms": 4605320,
            "end_ms": 4609870,
            "text": "其实我觉得啊本局游戏四张狼牌打的非常具有战术特色"
          },
          {
            "index": 2236,
            "source_segment_index": 2236,
            "start_ms": 4609870,
            "end_ms": 4611450,
            "text": "你看啊就这个刺杀狼"
          },
          {
            "index": 2237,
            "source_segment_index": 2237,
            "start_ms": 4611450,
            "end_ms": 4612670,
            "text": "包括这个悍跳狼"
          },
          {
            "index": 2238,
            "source_segment_index": 2238,
            "start_ms": 4612670,
            "end_ms": 4613610,
            "text": "是歪哥"
          },
          {
            "index": 2239,
            "source_segment_index": 2239,
            "start_ms": 4613610,
            "end_ms": 4615770,
            "text": "首先狼确保游戏的第一步"
          },
          {
            "index": 2240,
            "source_segment_index": 2240,
            "start_ms": 4615770,
            "end_ms": 4617920,
            "text": "先骗警徽对吧"
          },
          {
            "index": 2241,
            "source_segment_index": 2241,
            "start_ms": 4617920,
            "end_ms": 4621280,
            "text": "先把警徽拿到这个警徽还是非常的关键对吧"
          },
          {
            "index": 2242,
            "source_segment_index": 2242,
            "start_ms": 4621280,
            "end_ms": 4622680,
            "text": "两个狼在警下一冲票"
          },
          {
            "index": 2243,
            "source_segment_index": 2243,
            "start_ms": 4622680,
            "end_ms": 4625820,
            "text": "因为这0.5票有时候是决定性的优势呃"
          },
          {
            "index": 2244,
            "source_segment_index": 2244,
            "start_ms": 4625820,
            "end_ms": 4631099,
            "text": "再加上这个3号狼人也是来一手阴阳垫飞倒钩螺旋螺旋螺旋郎"
          },
          {
            "index": 2245,
            "source_segment_index": 2245,
            "start_ms": 4631099,
            "end_ms": 4636570,
            "text": "指导在今晚一号看到一号2号站错边的情况下"
          },
          {
            "index": 2246,
            "source_segment_index": 2246,
            "start_ms": 4637010,
            "end_ms": 4638930,
            "text": "呃郎指导也是反应非常快"
          },
          {
            "index": 2247,
            "source_segment_index": 2247,
            "start_ms": 4638930,
            "end_ms": 4640690,
            "text": "直接垫飞填狼坑对"
          },
          {
            "index": 2248,
            "source_segment_index": 2248,
            "start_ms": 4640690,
            "end_ms": 4643260,
            "text": "直接直接去把好人才的话说"
          },
          {
            "index": 2249,
            "source_segment_index": 2249,
            "start_ms": 4643260,
            "end_ms": 4644060,
            "text": "连三都是狼"
          },
          {
            "index": 2250,
            "source_segment_index": 2250,
            "start_ms": 4644060,
            "end_ms": 4647940,
            "text": "这把确实没办法对狼狼发言发的也是非常好"
          },
          {
            "index": 2251,
            "source_segment_index": 2251,
            "start_ms": 4647940,
            "end_ms": 4649469,
            "text": "包括3号这么玩之后"
          },
          {
            "index": 2252,
            "source_segment_index": 2252,
            "start_ms": 4649469,
            "end_ms": 4651569,
            "text": "4号也是借势直接把3号踩死"
          },
          {
            "index": 2253,
            "source_segment_index": 2253,
            "start_ms": 4651569,
            "end_ms": 4652789,
            "text": "就很自然对吧"
          },
          {
            "index": 2254,
            "source_segment_index": 2254,
            "start_ms": 4652789,
            "end_ms": 4653910,
            "text": "很自然啊"
          },
          {
            "index": 2255,
            "source_segment_index": 2255,
            "start_ms": 4653910,
            "end_ms": 4656610,
            "text": "这样很影响这个预言家点狼坑对吧"
          },
          {
            "index": 2256,
            "source_segment_index": 2256,
            "start_ms": 4656610,
            "end_ms": 4659430,
            "text": "因为人家不可能当时就很快觉得3号是一个垫飞狼"
          },
          {
            "index": 2257,
            "source_segment_index": 2257,
            "start_ms": 4659430,
            "end_ms": 4662190,
            "text": "因为毕竟还有好人是站错边的嘛"
          },
          {
            "index": 2258,
            "source_segment_index": 2258,
            "start_ms": 4662190,
            "end_ms": 4664290,
            "text": "所以打下来嗯"
          },
          {
            "index": 2259,
            "source_segment_index": 2259,
            "start_ms": 4664290,
            "end_ms": 4666660,
            "text": "Y哥那句把站对边的都杀了"
          },
          {
            "index": 2260,
            "source_segment_index": 2260,
            "start_ms": 4666660,
            "end_ms": 4668540,
            "text": "把站对边的都杀了啊"
          },
          {
            "index": 2261,
            "source_segment_index": 2261,
            "start_ms": 4668540,
            "end_ms": 4669420,
            "text": "非常的帅啊"
          },
          {
            "index": 2262,
            "source_segment_index": 2262,
            "start_ms": 4669420,
            "end_ms": 4670120,
            "text": "非常的帅"
          },
          {
            "index": 2263,
            "source_segment_index": 2263,
            "start_ms": 4670120,
            "end_ms": 4671100,
            "text": "不愧是我们的"
          },
          {
            "index": 2264,
            "source_segment_index": 2264,
            "start_ms": 4671100,
            "end_ms": 4672020,
            "text": "还JY戴士"
          },
          {
            "index": 2265,
            "source_segment_index": 2265,
            "start_ms": 4672020,
            "end_ms": 4673790,
            "text": "不愧是我们狼王呃"
          },
          {
            "index": 2266,
            "source_segment_index": 2266,
            "start_ms": 4673790,
            "end_ms": 4675870,
            "text": "那么这一局游戏也是比较快啊"
          }
        ],
