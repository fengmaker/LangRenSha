      "text": "所以昨天11号投5号确实是认狼票型对吧",
      "source_segment_index": 1780,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3512959,
      "end_ms": 3513680,
      "text": "去投6号",
      "source_segment_index": 1796,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3819120,
      "end_ms": 3822320,
      "text": "其实我觉得我就我本来其实昨天想想投一号的",
      "source_segment_index": 1990,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3822320,
      "end_ms": 3823320,
      "text": "我觉得昨天投一号很稳",
      "source_segment_index": 1991,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3831740,
      "end_ms": 3832180,
      "text": "就不投一号",
      "source_segment_index": 1998,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3832180,
      "end_ms": 3833980,
      "text": "我他到时万一投一号",
      "source_segment_index": 1999,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3833980,
      "end_ms": 3837200,
      "text": "就我一个人投一号投魔术师变三变那个了",
      "source_segment_index": 2000,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3847300,
      "end_ms": 3849600,
      "text": "其次他出局说他投5号",
      "source_segment_index": 2006,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3886050,
      "end_ms": 3886730,
      "text": "你要投5号",
      "source_segment_index": 2031,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3886730,
      "end_ms": 3887410,
      "text": "投5号投出去",
      "source_segment_index": 2032,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3896420,
      "end_ms": 3897360,
      "text": "今天是可以投6号的",
      "source_segment_index": 2040,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3901300,
      "end_ms": 3902890,
      "text": "六十一两个狼可以投6号",
