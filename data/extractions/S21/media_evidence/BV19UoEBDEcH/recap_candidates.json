          {
            "index": 1470,
            "source_segment_index": 1470,
            "start_ms": 2925380,
            "end_ms": 2926340,
            "text": "预言家哈哈"
          },
          {
            "index": 1471,
            "source_segment_index": 1471,
            "start_ms": 2926340,
            "end_ms": 2930760,
            "text": "我去哪都知道了"
          },
          {
            "index": 1472,
            "source_segment_index": 1472,
            "start_ms": 2930880,
            "end_ms": 2933960,
            "text": "770白低的"
          },
          {
            "index": 1473,
            "source_segment_index": 1473,
            "start_ms": 2934300,
            "end_ms": 2936580,
            "text": "来给各位当老师们做本本游戏的复盘"
          },
          {
            "index": 1474,
            "source_segment_index": 1474,
            "start_ms": 2936580,
            "end_ms": 2938700,
            "text": "本局版型为假面舞会神阵营预言家"
          },
          {
            "index": 1475,
            "source_segment_index": 1475,
            "start_ms": 2938700,
            "end_ms": 2939620,
            "text": "12号女巫"
          },
          {
            "index": 1476,
            "source_segment_index": 1476,
            "start_ms": 2939620,
            "end_ms": 2940340,
            "text": "3号舞者"
          },
          {
            "index": 1477,
            "source_segment_index": 1477,
            "start_ms": 2940340,
            "end_ms": 2940980,
            "text": "4号白神"
          },
          {
            "index": 1478,
            "source_segment_index": 1478,
            "start_ms": 2940980,
            "end_ms": 2943160,
            "text": "7号狼人阵营5号八号"
          },
          {
            "index": 1479,
            "source_segment_index": 1479,
            "start_ms": 2943160,
            "end_ms": 2945540,
            "text": "11号假面6号平民阵营一号2号"
          },
          {
            "index": 1480,
            "source_segment_index": 1480,
            "start_ms": 2945540,
            "end_ms": 2949720,
            "text": "9号十号首页狼人击杀2号平民女王救起行程"
          },
          {
            "index": 1481,
            "source_segment_index": 1481,
            "start_ms": 2949720,
            "end_ms": 2953510,
            "text": "平安夜预言家验证了9号玩家平民为好人身份"
          },
          {
            "index": 1482,
            "source_segment_index": 1482,
            "start_ms": 2953510,
            "end_ms": 2954910,
            "text": "在警上竞选环节"
          },
          {
            "index": 1483,
            "source_segment_index": 1483,
            "start_ms": 2954910,
            "end_ms": 2957430,
            "text": "11号狼人选择自爆入夜舞者舞池"
          },
          {
            "index": 1484,
            "source_segment_index": 1484,
            "start_ms": 2957430,
            "end_ms": 2958790,
            "text": "13号女巫"
          },
          {
            "index": 1485,
            "source_segment_index": 1485,
            "start_ms": 2958790,
            "end_ms": 2960170,
            "text": "8号狼人"
          },
          {
            "index": 1486,
            "source_segment_index": 1486,
            "start_ms": 2960170,
            "end_ms": 2961560,
            "text": "10号平民"
          },
          {
            "index": 1487,
            "source_segment_index": 1487,
            "start_ms": 2961560,
            "end_ms": 2964440,
            "text": "此时五池内8号狼人为独立阵营假面"
          },
          {
            "index": 1488,
            "source_segment_index": 1488,
            "start_ms": 2964440,
            "end_ms": 2966160,
            "text": "验证7号白神不在五池内"
          },
          {
            "index": 1489,
            "source_segment_index": 1489,
            "start_ms": 2966160,
            "end_ms": 2968210,
            "text": "给予了10号平民一张面具"
          },
          {
            "index": 1490,
            "source_segment_index": 1490,
            "start_ms": 2968210,
            "end_ms": 2970810,
            "text": "此时舞池内3号女巫被五出局"
          },
          {
            "index": 1491,
            "source_segment_index": 1491,
            "start_ms": 2970810,
            "end_ms": 2973890,
            "text": "当夜狼人击杀10号平民牛毒杀5号狼人"
          },
          {
            "index": 1492,
            "source_segment_index": 1492,
            "start_ms": 2973890,
            "end_ms": 2975330,
            "text": "当夜为3号五号"
          },
          {
            "index": 1493,
            "source_segment_index": 1493,
            "start_ms": 2975330,
            "end_ms": 2976250,
            "text": "10号多岛"
          },
          {
            "index": 1494,
            "source_segment_index": 1494,
            "start_ms": 2976250,
            "end_ms": 2978950,
            "text": "夜间预言家验证了5号玩家为狼人身份"
          },
          {
            "index": 1495,
            "source_segment_index": 1495,
            "start_ms": 2978950,
            "end_ms": 2980150,
            "text": "在延期竞选环节"
          },
          {
            "index": 1496,
            "source_segment_index": 1496,
            "start_ms": 2980150,
            "end_ms": 2981170,
            "text": "8号狼人选择自爆"
          },
          {
            "index": 1497,
            "source_segment_index": 1497,
            "start_ms": 2981170,
            "end_ms": 2982320,
            "text": "本局游戏警徽流失"
          },
          {
            "index": 1498,
            "source_segment_index": 1498,
            "start_ms": 2982320,
            "end_ms": 2985800,
            "text": "入夜舞者的舞池是4号舞者"
          },
          {
            "index": 1499,
            "source_segment_index": 1499,
            "start_ms": 2985800,
            "end_ms": 2990340,
            "text": "6号假面以及7号白神假面"
          },
          {
            "index": 1500,
            "source_segment_index": 1500,
            "start_ms": 2990340,
            "end_ms": 2991460,
            "text": "验证了4号玩家"
          },
          {
            "index": 1501,
            "source_segment_index": 1501,
            "start_ms": 2991460,
            "end_ms": 2994400,
            "text": "五者在五室内给予了4号五者一张面具"
          },
          {
            "index": 1502,
            "source_segment_index": 1502,
            "start_ms": 2994400,
            "end_ms": 2997600,
            "text": "此时五室内7号白神被五出局"
          },
          {
            "index": 1503,
            "source_segment_index": 1503,
            "start_ms": 2997600,
            "end_ms": 3000720,
            "text": "且当夜假面牌开刀击杀7号白神"
          },
          {
            "index": 1504,
            "source_segment_index": 1504,
            "start_ms": 3000720,
            "end_ms": 3001680,
            "text": "实际行程平安夜"
          },
          {
            "index": 1505,
            "source_segment_index": 1505,
            "start_ms": 3001680,
            "end_ms": 3004000,
            "text": "但当夜依旧为7号白神单死"
          },
          {
            "index": 1506,
            "source_segment_index": 1506,
            "start_ms": 3004000,
            "end_ms": 3007520,
            "text": "夜间预言家验证了一号玩家平民为好人身份"
          },
          {
            "index": 1507,
            "source_segment_index": 1507,
            "start_ms": 3007520,
            "end_ms": 3008320,
            "text": "在第三天白天"
          },
          {
            "index": 1508,
            "source_segment_index": 1508,
            "start_ms": 3008320,
            "end_ms": 3011140,
            "text": "场上最后一狼6号假面被公投出局"
          },
          {
            "index": 1509,
            "source_segment_index": 1509,
            "start_ms": 3011140,
            "end_ms": 3012780,
            "text": "嗯游戏结束"
          },
          {
            "index": 1510,
            "source_segment_index": 1510,
            "start_ms": 3012780,
            "end_ms": 3013860,
            "text": "好人阵营获胜"
          },
          {
            "index": 1511,
            "source_segment_index": 1511,
            "start_ms": 3013860,
            "end_ms": 3016420,
            "text": "以上是我们今天第二局假面舞会的全部内容"
          },
          {
            "index": 1512,
            "source_segment_index": 1512,
            "start_ms": 3016420,
            "end_ms": 3017320,
            "text": "感谢阿喵"
          },
          {
            "index": 1513,
            "source_segment_index": 1513,
            "start_ms": 3017320,
            "end_ms": 3019420,
            "text": "感谢RX老师给我的投食"
          },
          {
            "index": 1514,
            "source_segment_index": 1514,
            "start_ms": 3019420,
            "end_ms": 3021520,
            "text": "这里是京城大师赛第21赛季"
          },
          {
            "index": 1515,
            "source_segment_index": 1515,
            "start_ms": 3021520,
            "end_ms": 3022860,
            "text": "葵曲奇谭的直播现场"
          },
          {
            "index": 1516,
            "source_segment_index": 1516,
            "start_ms": 3022860,
            "end_ms": 3024300,
            "text": "再次感谢天天狼人app"
          },
          {
            "index": 1517,
            "source_segment_index": 1517,
            "start_ms": 3024300,
            "end_ms": 3025930,
            "text": "对我们节目的冠名赞助支持"
          },
          {
            "index": 1518,
            "source_segment_index": 1518,
            "start_ms": 3025930,
            "end_ms": 3028110,
            "text": "各位家人们也可以随时来到各大应用平台"
          },
          {
            "index": 1519,
            "source_segment_index": 1519,
            "start_ms": 3028110,
            "end_ms": 3030050,
            "text": "搜索并下载天天狼人app"
          },
          {
            "index": 1520,
            "source_segment_index": 1520,
            "start_ms": 3030050,
            "end_ms": 3031820,
            "text": "就可以跟我们一起来玩网杀游戏了"
          },
          {
            "index": 1521,
            "source_segment_index": 1521,
            "start_ms": 3031820,
            "end_ms": 3033780,
            "text": "同样感谢本赛季特约赞助商"
          },
          {
            "index": 1522,
            "source_segment_index": 1522,
            "start_ms": 3033780,
            "end_ms": 3035380,
            "text": "感谢柠檬共和国懒赤霞"
          },
          {
            "index": 1523,
            "source_segment_index": 1523,
            "start_ms": 3035380,
            "end_ms": 3037800,
            "text": "以及哈尼牧场对我们节目的大力支持"
          },
          {
            "index": 1524,
            "source_segment_index": 1524,
            "start_ms": 3037800,
            "end_ms": 3039860,
            "text": "各位家人们也可以来到这位带师个人主页"
          },
          {
            "index": 1525,
            "source_segment_index": 1525,
            "start_ms": 3039860,
            "end_ms": 3040520,
            "text": "橱窗内"
          },
          {
            "index": 1526,
            "source_segment_index": 1526,
            "start_ms": 3040520,
            "end_ms": 3041980,
            "text": "随时进行下单补货"
          },
          {
            "index": 1527,
            "source_segment_index": 1527,
            "start_ms": 3041980,
            "end_ms": 3042620,
            "text": "那么接下来"
          },
          {
            "index": 1528,
            "source_segment_index": 1528,
            "start_ms": 3042620,
            "end_ms": 3044760,
            "text": "导播老师会优先把镜头移交至电商现场"
          },
          {
            "index": 1529,
            "source_segment_index": 1529,
            "start_ms": 3044760,
            "end_ms": 3047510,
            "text": "两位解说老师会对本局假面舞会进行复盘"
          },
          {
            "index": 1530,
            "source_segment_index": 1530,
            "start_ms": 3047510,
            "end_ms": 3049050,
            "text": "稍后回来会是第三局"
          },
          {
            "index": 1531,
            "source_segment_index": 1531,
            "start_ms": 3049050,
            "end_ms": 3049950,
            "text": "机械狼通灵师"
          },
          {
            "index": 1532,
            "source_segment_index": 1532,
            "start_ms": 3049950,
            "end_ms": 3051270,
            "text": "一会见"
          },
          {
            "index": 1533,
            "source_segment_index": 1533,
            "start_ms": 3052500,
            "end_ms": 3053820,
            "text": "差点就赢了"
          },
          {
            "index": 1534,
            "source_segment_index": 1534,
            "start_ms": 3055220,
            "end_ms": 3056180,
            "text": "很难平"
          },
          {
            "index": 1535,
            "source_segment_index": 1535,
            "start_ms": 3056180,
            "end_ms": 3057020,
            "text": "诶"
          },
          {
            "index": 1536,
            "source_segment_index": 1536,
            "start_ms": 3057020,
            "end_ms": 3059100,
            "text": "怎么卡住了"
          },
          {
            "index": 1537,
            "source_segment_index": 1537,
            "start_ms": 3059740,
            "end_ms": 3060580,
            "text": "Hello"
          },
          {
            "index": 1538,
            "source_segment_index": 1538,
            "start_ms": 3060580,
            "end_ms": 3062140,
            "text": "镜头为什么卡住了"
          },
          {
            "index": 1539,
            "source_segment_index": 1539,
            "start_ms": 3063700,
            "end_ms": 3066300,
            "text": "家人们问我为什么久跪不起"
          },
          {
            "index": 1540,
            "source_segment_index": 1540,
            "start_ms": 3066300,
            "end_ms": 3068500,
            "text": "我在看京城大师赛"
          },
          {
            "index": 1541,
            "source_segment_index": 1541,
            "start_ms": 3068500,
            "end_ms": 3071520,
            "text": "这个悬念居然留到了最后一刻"
          },
          {
            "index": 1542,
            "source_segment_index": 1542,
            "start_ms": 3071520,
            "end_ms": 3074690,
            "text": "狼甚至有角度能够突围成功"
          },
          {
            "index": 1543,
            "source_segment_index": 1543,
            "start_ms": 3074690,
            "end_ms": 3076870,
            "text": "我觉得仓姐投12"
          },
          {
            "index": 1544,
            "source_segment_index": 1544,
            "start_ms": 3076870,
            "end_ms": 3079410,
            "text": "他觉得别人认不下12是预言家"
          },
          {
            "index": 1545,
            "source_segment_index": 1545,
            "start_ms": 3079410,
            "end_ms": 3083990,
            "text": "因为9号他说六跟12号pk有可能吧对"
          },
          {
            "index": 1546,
            "source_segment_index": 1546,
            "start_ms": 3083990,
            "end_ms": 3089110,
            "text": "但12这种感觉又让他们觉得这个不像狼"
          },
          {
            "index": 1547,
            "source_segment_index": 1547,
            "start_ms": 3089110,
            "end_ms": 3091350,
            "text": "因为12是狼就找六了对的"
          },
          {
            "index": 1548,
            "source_segment_index": 1548,
            "start_ms": 3091350,
            "end_ms": 3095010,
            "text": "但是其其实最后呢还是有悬念的"
          },
          {
            "index": 1549,
            "source_segment_index": 1549,
            "start_ms": 3098240,
            "end_ms": 3100800,
            "text": "12号投2号三比三的票型"
          },
          {
            "index": 1550,
            "source_segment_index": 1550,
            "start_ms": 3100800,
            "end_ms": 3102380,
            "text": "再上一轮票pk"
          },
          {
            "index": 1551,
            "source_segment_index": 1551,
            "start_ms": 3102380,
            "end_ms": 3103820,
            "text": "那就更精彩了"
          },
          {
            "index": 1552,
            "source_segment_index": 1552,
            "start_ms": 3103820,
            "end_ms": 3106300,
            "text": "家人们真的是就是怎么讲呢"
          },
          {
            "index": 1553,
            "source_segment_index": 1553,
            "start_ms": 3106300,
            "end_ms": 3109140,
            "text": "就是仓姐仓姐她"
          },
          {
            "index": 1554,
            "source_segment_index": 1554,
            "start_ms": 3109140,
            "end_ms": 3110700,
            "text": "我觉得他应该是知道轮次"
          },
          {
            "index": 1555,
            "source_segment_index": 1555,
            "start_ms": 3110700,
            "end_ms": 3111140,
            "text": "因为他知道"
          },
          {
            "index": 1556,
            "source_segment_index": 1556,
            "start_ms": 3111140,
            "end_ms": 3112140,
            "text": "比如说投了2号"
          },
          {
            "index": 1557,
            "source_segment_index": 1557,
            "start_ms": 3112140,
            "end_ms": 3114570,
            "text": "他可以砍四扣12"
          },
          {
            "index": 1558,
            "source_segment_index": 1558,
            "start_ms": 3114570,
            "end_ms": 3117090,
            "text": "因为唯一五池是一九十二对的"
          },
          {
            "index": 1559,
            "source_segment_index": 1559,
            "start_ms": 3117090,
            "end_ms": 3118790,
            "text": "但是他不知道这个五池"
          },
          {
            "index": 1560,
            "source_segment_index": 1560,
            "start_ms": 3118790,
            "end_ms": 3122740,
            "text": "他他但但是他我觉得他的想法可能觉得"
          },
          {
            "index": 1561,
            "source_segment_index": 1561,
            "start_ms": 3122740,
            "end_ms": 3124580,
            "text": "因为九一个公共好人"
          },
          {
            "index": 1562,
            "source_segment_index": 1562,
            "start_ms": 3124580,
            "end_ms": 3126990,
            "text": "他说了嗯对吧对的"
          },
          {
            "index": 1563,
            "source_segment_index": 1563,
            "start_ms": 3126990,
            "end_ms": 3128530,
            "text": "今天在六跟12里面偷"
          },
          {
            "index": 1564,
            "source_segment_index": 1564,
            "start_ms": 3128530,
            "end_ms": 3131240,
            "text": "他觉得不管12号归不归2号外圈的人"
          },
          {
            "index": 1565,
            "source_segment_index": 1565,
            "start_ms": 3131240,
            "end_ms": 3132400,
            "text": "只会在他俩里面投"
          },
          {
            "index": 1566,
            "source_segment_index": 1566,
            "start_ms": 3132400,
            "end_ms": 3134360,
            "text": "所以他觉得可能投12会有机会"
          },
          {
            "index": 1567,
            "source_segment_index": 1567,
            "start_ms": 3134360,
            "end_ms": 3137080,
            "text": "但没有想到12号归完票之后"
          },
          {
            "index": 1568,
            "source_segment_index": 1568,
            "start_ms": 3137080,
            "end_ms": 3139040,
            "text": "一跟他投了二了"
          },
          {
            "index": 1569,
            "source_segment_index": 1569,
            "start_ms": 3139500,
            "end_ms": 3140460,
            "text": "非常可惜"
          },
          {
            "index": 1570,
            "source_segment_index": 1570,
            "start_ms": 3140460,
            "end_ms": 3142380,
            "text": "但是我大胆预测一波"
          },
          {
            "index": 1571,
            "source_segment_index": 1571,
            "start_ms": 3142380,
