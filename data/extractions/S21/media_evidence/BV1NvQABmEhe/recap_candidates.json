            "source_segment_index": 2272,
            "start_ms": 4386650,
            "end_ms": 4387790,
            "text": "对谁都一样的"
          },
          {
            "index": 2273,
            "source_segment_index": 2273,
            "start_ms": 4387790,
            "end_ms": 4389470,
            "text": "对对四是假面呀"
          },
          {
            "index": 2274,
            "source_segment_index": 2274,
            "start_ms": 4389470,
            "end_ms": 4390860,
            "text": "四是假面"
          },
          {
            "index": 2275,
            "source_segment_index": 2275,
            "start_ms": 4390860,
            "end_ms": 4392060,
            "text": "他真是女巫"
          },
          {
            "index": 2276,
            "source_segment_index": 2276,
            "start_ms": 4392060,
            "end_ms": 4392700,
            "text": "她真是女巫"
          },
          {
            "index": 2277,
            "source_segment_index": 2277,
            "start_ms": 4392700,
            "end_ms": 4395580,
            "text": "毒的五毒的武武是狼啊"
          },
          {
            "index": 2278,
            "source_segment_index": 2278,
            "start_ms": 4395580,
            "end_ms": 4396820,
            "text": "那天三五双死"
          },
          {
            "index": 2279,
            "source_segment_index": 2279,
            "start_ms": 4396820,
            "end_ms": 4397480,
            "text": "然后杀八田"
          },
          {
            "index": 2280,
            "source_segment_index": 2280,
            "start_ms": 4397480,
            "end_ms": 4401459,
            "text": "也给各位弹幕老师们做本局游戏的复盘"
          },
          {
            "index": 2281,
            "source_segment_index": 2281,
            "start_ms": 4401459,
            "end_ms": 4403899,
            "text": "本局版型为假面舞会神人阵营预言家"
          },
          {
            "index": 2282,
            "source_segment_index": 2282,
            "start_ms": 4403899,
            "end_ms": 4404619,
            "text": "8号女巫"
          },
          {
            "index": 2283,
            "source_segment_index": 2283,
            "start_ms": 4404619,
            "end_ms": 4405299,
            "text": "7号舞者"
          },
          {
            "index": 2284,
            "source_segment_index": 2284,
            "start_ms": 4405299,
            "end_ms": 4405979,
            "text": "3号白神"
          },
          {
            "index": 2285,
            "source_segment_index": 2285,
            "start_ms": 4405979,
            "end_ms": 4407799,
            "text": "12号狼人阵营5号六号"
          },
          {
            "index": 2286,
            "source_segment_index": 2286,
            "start_ms": 4407799,
            "end_ms": 4409260,
            "text": "11号假面"
          },
          {
            "index": 2287,
            "source_segment_index": 2287,
            "start_ms": 4409260,
            "end_ms": 4411080,
            "text": "4号平民阵营一号2号"
          },
          {
            "index": 2288,
            "source_segment_index": 2288,
            "start_ms": 4411080,
            "end_ms": 4415440,
            "text": "9号十号首页狼人击杀12号白神女巫要救起"
          },
          {
            "index": 2289,
            "source_segment_index": 2289,
            "start_ms": 4415440,
            "end_ms": 4416240,
            "text": "形成平安夜"
          },
          {
            "index": 2290,
            "source_segment_index": 2290,
            "start_ms": 4416240,
            "end_ms": 4419160,
            "text": "预言家验证了10号玩家平民为好人身份"
          },
          {
            "index": 2291,
            "source_segment_index": 2291,
            "start_ms": 4419160,
            "end_ms": 4420520,
            "text": "在警上竞选环节"
          },
          {
            "index": 2292,
            "source_segment_index": 2292,
            "start_ms": 4420520,
            "end_ms": 4423960,
            "text": "6号狼人选择自爆入夜舞者的舞池是3号舞者"
          },
          {
            "index": 2293,
            "source_segment_index": 2293,
            "start_ms": 4423960,
            "end_ms": 4427310,
            "text": "4号假面以及8号预言家"
          },
          {
            "index": 2294,
            "source_segment_index": 2294,
            "start_ms": 4427310,
            "end_ms": 4431030,
            "text": "此时舞者在舞池内50免疫狼刀假面牌"
          },
          {
            "index": 2295,
            "source_segment_index": 2295,
            "start_ms": 4431030,
            "end_ms": 4432430,
            "text": "验证了7号玩家"
          },
          {
            "index": 2296,
            "source_segment_index": 2296,
            "start_ms": 4432430,
            "end_ms": 4435680,
            "text": "女巫在舞池内给予了8号预言家一张面具"
          },
          {
            "index": 2297,
            "source_segment_index": 2297,
            "start_ms": 4435680,
            "end_ms": 4438559,
            "text": "此时五池内3号舞者被五出局"
          },
          {
            "index": 2298,
            "source_segment_index": 2298,
            "start_ms": 4438559,
            "end_ms": 4439599,
            "text": "狼人击杀"
          },
          {
            "index": 2299,
            "source_segment_index": 2299,
            "start_ms": 4439599,
            "end_ms": 4441459,
            "text": "8号预言家形成平安夜"
          },
          {
            "index": 2300,
            "source_segment_index": 2300,
            "start_ms": 4441459,
            "end_ms": 4443039,
            "text": "牛毒杀5号狼人"
          },
          {
            "index": 2301,
            "source_segment_index": 2301,
            "start_ms": 4443039,
            "end_ms": 4447110,
            "text": "当夜为3号五号伤死预言家验证了9号玩家"
          },
          {
            "index": 2302,
            "source_segment_index": 2302,
            "start_ms": 4447110,
            "end_ms": 4448490,
            "text": "平民为好人身份"
          },
          {
            "index": 2303,
            "source_segment_index": 2303,
            "start_ms": 4448490,
            "end_ms": 4449910,
            "text": "在延期竞选环节"
          },
          {
            "index": 2304,
            "source_segment_index": 2304,
            "start_ms": 4449910,
            "end_ms": 4451710,
            "text": "11号狼人选择自爆"
          },
          {
            "index": 2305,
            "source_segment_index": 2305,
            "start_ms": 4451710,
            "end_ms": 4453350,
            "text": "本游戏警徽流失"
          },
          {
            "index": 2306,
            "source_segment_index": 2306,
            "start_ms": 4453350,
            "end_ms": 4458400,
            "text": "咳咳入夜假面验证9号不在五之内"
          },
          {
            "index": 2307,
            "source_segment_index": 2307,
            "start_ms": 4458400,
            "end_ms": 4462710,
            "text": "给予7号女巫一张面具并击杀8号预言家"
          },
          {
            "index": 2308,
            "source_segment_index": 2308,
            "start_ms": 4462710,
            "end_ms": 4464650,
            "text": "当验预言家验证了7号玩家"
          },
          {
            "index": 2309,
            "source_segment_index": 2309,
            "start_ms": 4464650,
            "end_ms": 4465910,
            "text": "女巫为好人身份"
          },
          {
            "index": 2310,
            "source_segment_index": 2310,
            "start_ms": 4465910,
            "end_ms": 4469029,
            "text": "当夜为8号预言家单死在第三天的白天"
          },
          {
            "index": 2311,
            "source_segment_index": 2311,
            "start_ms": 4469029,
            "end_ms": 4471160,
            "text": "9号平民被抗推出局"
          },
          {
            "index": 2312,
            "source_segment_index": 2312,
            "start_ms": 4471160,
            "end_ms": 4474200,
            "text": "入夜假面验证7号不在舞池内"
          },
          {
            "index": 2313,
            "source_segment_index": 2313,
            "start_ms": 4474200,
            "end_ms": 4475440,
            "text": "给予2号一张面具"
          },
          {
            "index": 2314,
            "source_segment_index": 2314,
            "start_ms": 4475440,
            "end_ms": 4477320,
            "text": "并击杀了7号女巫"
          },
          {
            "index": 2315,
            "source_segment_index": 2315,
            "start_ms": 4477320,
            "end_ms": 4480710,
            "text": "当夜7号牛单死在第四天的白天场上"
          },
          {
            "index": 2316,
            "source_segment_index": 2316,
            "start_ms": 4480710,
            "end_ms": 4482970,
            "text": "最后一狼4号假面被公投出局"
          },
          {
            "index": 2317,
            "source_segment_index": 2317,
            "start_ms": 4482970,
            "end_ms": 4483630,
            "text": "游戏结束"
          },
          {
            "index": 2318,
            "source_segment_index": 2318,
            "start_ms": 4483630,
            "end_ms": 4484660,
            "text": "好人阵营获胜"
          },
          {
            "index": 2319,
            "source_segment_index": 2319,
            "start_ms": 4484660,
            "end_ms": 4487400,
            "text": "以上是我们今天第二局假面舞会的全部内容"
          },
          {
            "index": 2320,
            "source_segment_index": 2320,
            "start_ms": 4487400,
            "end_ms": 4489780,
            "text": "在此再次感谢天天狼人app"
          },
          {
            "index": 2321,
            "source_segment_index": 2321,
            "start_ms": 4489780,
            "end_ms": 4491690,
            "text": "对我们节目的冠名赞助支持"
          },
          {
            "index": 2322,
            "source_segment_index": 2322,
            "start_ms": 4491690,
            "end_ms": 4492570,
            "text": "各位弹幕老师们"
          },
          {
            "index": 2323,
            "source_segment_index": 2323,
            "start_ms": 4492570,
            "end_ms": 4494530,
            "text": "也可以随时来到我们各大应用平台"
          },
          {
            "index": 2324,
            "source_segment_index": 2324,
            "start_ms": 4494530,
            "end_ms": 4496570,
            "text": "搜索并下载天天狼人app"
          },
          {
            "index": 2325,
            "source_segment_index": 2325,
            "start_ms": 4496570,
            "end_ms": 4498309,
            "text": "就可以跟我们一起来玩网上游戏了"
          },
          {
            "index": 2326,
            "source_segment_index": 2326,
            "start_ms": 4498309,
            "end_ms": 4500809,
            "text": "这里是我们京城大师赛第21赛季"
          },
          {
            "index": 2327,
            "source_segment_index": 2327,
            "start_ms": 4500809,
            "end_ms": 4502389,
            "text": "鬼泣集团的直播现场"
          },
          {
            "index": 2328,
            "source_segment_index": 2328,
            "start_ms": 4502389,
            "end_ms": 4505029,
            "text": "也再次我们感谢一下我们的特约赞助商啊"
          },
          {
            "index": 2329,
            "source_segment_index": 2329,
            "start_ms": 4505029,
            "end_ms": 4507029,
            "text": "感谢下懒之霞柠檬共和国"
          },
          {
            "index": 2330,
            "source_segment_index": 2330,
            "start_ms": 4507029,
            "end_ms": 4509740,
            "text": "以及哈尼牧场对我们节目的冠名支持"
          },
          {
            "index": 2331,
            "source_segment_index": 2331,
            "start_ms": 4509740,
            "end_ms": 4512060,
            "text": "各位弹幕老师们也可以在观赛途中"
          },
          {
            "index": 2332,
            "source_segment_index": 2332,
            "start_ms": 4512060,
            "end_ms": 4514380,
            "text": "随时来到我们歪哥的个人主页橱窗内"
          },
          {
            "index": 2333,
            "source_segment_index": 2333,
            "start_ms": 4514380,
            "end_ms": 4515480,
            "text": "进行下单补货"
          },
          {
            "index": 2334,
            "source_segment_index": 2334,
            "start_ms": 4515480,
            "end_ms": 4517120,
            "text": "同样的还有一个很好的消息啊"
          },
          {
            "index": 2335,
            "source_segment_index": 2335,
            "start_ms": 4517120,
            "end_ms": 4518080,
            "text": "在明天下午"
          },
          {
            "index": 2336,
            "source_segment_index": 2336,
            "start_ms": 4518080,
            "end_ms": 4520430,
            "text": "也就是我们13:30分开始"
          },
          {
            "index": 2337,
            "source_segment_index": 2337,
            "start_ms": 4520430,
            "end_ms": 4522470,
            "text": "会有耿雪儿老师给我们带货"
          },
          {
            "index": 2338,
            "source_segment_index": 2338,
            "start_ms": 4522470,
            "end_ms": 4524250,
            "text": "零食美妆的混场"
          },
          {
            "index": 2339,
            "source_segment_index": 2339,
            "start_ms": 4524250,
            "end_ms": 4527110,
            "text": "然后各位家人们可以在明天下午1.30分"
          },
          {
            "index": 2340,
            "source_segment_index": 2340,
            "start_ms": 4527110,
            "end_ms": 4529250,
            "text": "蹲守在我们京师甄选直播间"
          },
          {
            "index": 2341,
            "source_segment_index": 2341,
            "start_ms": 4529250,
            "end_ms": 4531410,
            "text": "同样呢在明天下午的15点整"
          },
          {
            "index": 2342,
            "source_segment_index": 2342,
            "start_ms": 4531410,
            "end_ms": 4533820,
            "text": "就是明天下午三点会有耿雪儿老师"
          },
          {
            "index": 2343,
            "source_segment_index": 2343,
            "start_ms": 4533820,
            "end_ms": 4536420,
            "text": "还有申屠老师给我们带来水晶专场的带货"
          },
          {
            "index": 2344,
            "source_segment_index": 2344,
            "start_ms": 4536420,
            "end_ms": 4539280,
            "text": "感兴趣的各位家人们一定要及时来观看一下"
          },
          {
            "index": 2345,
            "source_segment_index": 2345,
            "start_ms": 4539280,
            "end_ms": 4540760,
            "text": "然后感谢一下LISA"
          },
          {
            "index": 2346,
            "source_segment_index": 2346,
            "start_ms": 4540760,
            "end_ms": 4542700,
            "text": "感谢浩浩腾老师给我的投食"
          },
          {
            "index": 2347,
            "source_segment_index": 2347,
            "start_ms": 4542700,
            "end_ms": 4545120,
            "text": "接下来导播老师会优先把镜头移交至第二现场"
          },
          {
            "index": 2348,
            "source_segment_index": 2348,
            "start_ms": 4547900,
            "end_ms": 4550480,
            "text": "稍后回来会是我们第三局机械狼通灵师"
          },
          {
            "index": 2349,
            "source_segment_index": 2349,
            "start_ms": 4550480,
            "end_ms": 4551880,
            "text": "一会见"
          }
        ],
