            "source_segment_index": 1415,
            "start_ms": 2987760,
            "end_ms": 2989480,
            "text": "我哈哈哈哈哈"
          },
          {
            "index": 1416,
            "source_segment_index": 1416,
            "start_ms": 2989480,
            "end_ms": 2991419,
            "text": "我得说一一句都没说"
          },
          {
            "index": 1417,
            "source_segment_index": 1417,
            "start_ms": 2991419,
            "end_ms": 2992860,
            "text": "我为什么三点死啊"
          },
          {
            "index": 1418,
            "source_segment_index": 1418,
            "start_ms": 2992860,
            "end_ms": 2995660,
            "text": "好给各位弹幕老师们做本酒席的复盘"
          },
          {
            "index": 1419,
            "source_segment_index": 1419,
            "start_ms": 2995660,
            "end_ms": 2997360,
            "text": "本局办新微盗宝大师"
          },
          {
            "index": 1420,
            "source_segment_index": 1420,
            "start_ms": 2997360,
            "end_ms": 2999560,
            "text": "神智营通灵师"
          },
          {
            "index": 1421,
            "source_segment_index": 1421,
            "start_ms": 2999560,
            "end_ms": 3000720,
            "text": "9号毒师"
          },
          {
            "index": 1422,
            "source_segment_index": 1422,
            "start_ms": 3000720,
            "end_ms": 3001920,
            "text": "2号射某人"
          },
          {
            "index": 1423,
            "source_segment_index": 1423,
            "start_ms": 3001920,
            "end_ms": 3003200,
            "text": "6号蒙面人"
          },
          {
            "index": 1424,
            "source_segment_index": 1424,
            "start_ms": 3003200,
            "end_ms": 3006100,
            "text": "8号狼人阵营4号十号狼王"
          },
          {
            "index": 1425,
            "source_segment_index": 1425,
            "start_ms": 3006100,
            "end_ms": 3008890,
            "text": "7号盗宝大师为一号"
          },
          {
            "index": 1426,
            "source_segment_index": 1426,
            "start_ms": 3008890,
            "end_ms": 3010390,
            "text": "本救系盗宝猎人"
          },
          {
            "index": 1427,
            "source_segment_index": 1427,
            "start_ms": 3010390,
            "end_ms": 3011750,
            "text": "平民阵营3号五号"
          },
          {
            "index": 1428,
            "source_segment_index": 1428,
            "start_ms": 3011750,
            "end_ms": 3012250,
            "text": "11号"
          },
          {
            "index": 1429,
            "source_segment_index": 1429,
            "start_ms": 3012250,
            "end_ms": 3016340,
            "text": "12号首页圣梦人梦游4号狼人"
          },
          {
            "index": 1430,
            "source_segment_index": 1430,
            "start_ms": 3016340,
            "end_ms": 3020180,
            "text": "盗宝大师在猎人平民身份中选择了猎人身份"
          },
          {
            "index": 1431,
            "source_segment_index": 1431,
            "start_ms": 3020180,
            "end_ms": 3023860,
            "text": "当夜通灵师查验了3号玩家为平民身份"
          },
          {
            "index": 1432,
            "source_segment_index": 1432,
            "start_ms": 3023860,
            "end_ms": 3025100,
            "text": "警上竞选环节"
          },
          {
            "index": 1433,
            "source_segment_index": 1433,
            "start_ms": 3025100,
            "end_ms": 3026380,
            "text": "本局游戏全员上警"
          },
          {
            "index": 1434,
            "source_segment_index": 1434,
            "start_ms": 3026380,
            "end_ms": 3028380,
            "text": "警徽流失在第一天白天"
          },
          {
            "index": 1435,
            "source_segment_index": 1435,
            "start_ms": 3028380,
            "end_ms": 3032300,
            "text": "一号盗宝猎人被公投出局并开枪带走"
          },
          {
            "index": 1436,
            "source_segment_index": 1436,
            "start_ms": 3032300,
            "end_ms": 3034590,
            "text": "8号蒙面人入夜"
          },
          {
            "index": 1437,
            "source_segment_index": 1437,
            "start_ms": 3034590,
            "end_ms": 3037370,
            "text": "圣某人再次梦游4号狼人"
          },
          {
            "index": 1438,
            "source_segment_index": 1438,
            "start_ms": 3037370,
            "end_ms": 3039700,
            "text": "4号狼人被梦王出局"
          },
          {
            "index": 1439,
            "source_segment_index": 1439,
            "start_ms": 3039700,
            "end_ms": 3040540,
            "text": "狼人击杀"
          },
          {
            "index": 1440,
            "source_segment_index": 1440,
            "start_ms": 3040540,
            "end_ms": 3044500,
            "text": "9号通灵师女呃毒师毒杀10号狼人"
          },
          {
            "index": 1441,
            "source_segment_index": 1441,
            "start_ms": 3044500,
            "end_ms": 3047490,
            "text": "当夜为4号九号十号多岛通灵师"
          },
          {
            "index": 1442,
            "source_segment_index": 1442,
            "start_ms": 3047490,
            "end_ms": 3050030,
            "text": "当夜验证了12号玩家为平民身份"
          },
          {
            "index": 1443,
            "source_segment_index": 1443,
            "start_ms": 3050030,
            "end_ms": 3051760,
            "text": "在第二天的白天"
          },
          {
            "index": 1444,
            "source_segment_index": 1444,
            "start_ms": 3051760,
            "end_ms": 3053080,
            "text": "狼人选择交牌"
          },
          {
            "index": 1445,
            "source_segment_index": 1445,
            "start_ms": 3053080,
            "end_ms": 3053700,
            "text": "游戏结束"
          },
          {
            "index": 1446,
            "source_segment_index": 1446,
            "start_ms": 3053700,
            "end_ms": 3054700,
            "text": "好人阵营获胜"
          },
          {
            "index": 1447,
            "source_segment_index": 1447,
            "start_ms": 3054700,
            "end_ms": 3057480,
            "text": "以上是我们今天第二局盗宝大师的全内容"
          },
          {
            "index": 1448,
            "source_segment_index": 1448,
            "start_ms": 3057480,
            "end_ms": 3058540,
            "text": "感谢各位段落"
          },
          {
            "index": 1449,
            "source_segment_index": 1449,
            "start_ms": 3058540,
            "end_ms": 3060240,
            "text": "弹幕老师们能够陪伴在我们直播间"
          },
          {
            "index": 1450,
            "source_segment_index": 1450,
            "start_ms": 3060240,
            "end_ms": 3062720,
            "text": "这里是我们精神大师赛第21赛季"
          },
          {
            "index": 1451,
            "source_segment_index": 1451,
            "start_ms": 3062720,
            "end_ms": 3064300,
            "text": "葵曲奇谭的直播现场"
          },
          {
            "index": 1452,
            "source_segment_index": 1452,
            "start_ms": 3064300,
            "end_ms": 3066100,
            "text": "再一次感谢天天狼人app"
          },
          {
            "index": 1453,
            "source_segment_index": 1453,
            "start_ms": 3066100,
            "end_ms": 3068080,
            "text": "对我们节目的冠名赞助支持"
          },
          {
            "index": 1454,
            "source_segment_index": 1454,
            "start_ms": 3068080,
            "end_ms": 3070420,
            "text": "各位家人们可以随时来到我们各大应用平台"
          },
          {
            "index": 1455,
            "source_segment_index": 1455,
            "start_ms": 3070420,
            "end_ms": 3072720,
            "text": "搜索并下载这款天天狼人app"
          },
          {
            "index": 1456,
            "source_segment_index": 1456,
            "start_ms": 3072720,
            "end_ms": 3075069,
            "text": "就可以跟我们一起来玩我们的网杀游戏了"
          },
          {
            "index": 1457,
            "source_segment_index": 1457,
            "start_ms": 3075069,
            "end_ms": 3077909,
            "text": "同样呢也再次感谢我们的特约赞助商"
          },
          {
            "index": 1458,
            "source_segment_index": 1458,
            "start_ms": 3077909,
            "end_ms": 3079869,
            "text": "感谢柠檬共和国揽痴霞"
          },
          {
            "index": 1459,
            "source_segment_index": 1459,
            "start_ms": 3079869,
            "end_ms": 3082380,
            "text": "以及哈尼牧场对我们节目的支持"
          },
          {
            "index": 1460,
            "source_segment_index": 1460,
            "start_ms": 3082380,
            "end_ms": 3084020,
            "text": "各位家人们在观赛途中"
          },
          {
            "index": 1461,
            "source_segment_index": 1461,
            "start_ms": 3084020,
            "end_ms": 3086620,
            "text": "随时可以来到这位带师的个人主页橱窗内"
          },
          {
            "index": 1462,
            "source_segment_index": 1462,
            "start_ms": 3086620,
            "end_ms": 3087930,
            "text": "进行下单补货"
          },
          {
            "index": 1463,
            "source_segment_index": 1463,
            "start_ms": 3087930,
            "end_ms": 3088490,
            "text": "同样的"
          },
          {
            "index": 1464,
            "source_segment_index": 1464,
            "start_ms": 3088490,
            "end_ms": 3090090,
            "text": "明天下午的16点整"
          },
          {
            "index": 1465,
            "source_segment_index": 1465,
            "start_ms": 3090090,
            "end_ms": 3091610,
            "text": "就是周五下午的四点"
          },
          {
            "index": 1466,
            "source_segment_index": 1466,
            "start_ms": 3091610,
            "end_ms": 3093330,
            "text": "会在京师甄选直播间"
          },
          {
            "index": 1467,
            "source_segment_index": 1467,
            "start_ms": 3093330,
            "end_ms": 3095930,
            "text": "为各位带来我们的潮牌服饰的带货"
          },
          {
            "index": 1468,
            "source_segment_index": 1468,
            "start_ms": 3095930,
            "end_ms": 3097710,
            "text": "我们带货主播是呃"
          },
          {
            "index": 1469,
            "source_segment_index": 1469,
            "start_ms": 3097710,
            "end_ms": 3098810,
            "text": "鹏鹏金融大师赛"
          },
          {
            "index": 1470,
            "source_segment_index": 1470,
            "start_ms": 3098810,
            "end_ms": 3100850,
            "text": "还有我们李鬼鬼京城小师赛"
          },
          {
            "index": 1471,
            "source_segment_index": 1471,
            "start_ms": 3100850,
            "end_ms": 3102950,
            "text": "各位家人们可以过来观看一下"
          },
          {
            "index": 1472,
            "source_segment_index": 1472,
            "start_ms": 3102950,
            "end_ms": 3103430,
            "text": "接下来"
          },
          {
            "index": 1473,
            "source_segment_index": 1473,
            "start_ms": 3103430,
            "end_ms": 3106190,
