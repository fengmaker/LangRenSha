            "source_segment_index": 2293,
            "start_ms": 4482250,
            "end_ms": 4483150,
            "text": "狼人可拍三刀"
          },
          {
            "index": 2294,
            "source_segment_index": 2294,
            "start_ms": 4483150,
            "end_ms": 4484670,
            "text": "给出的道路是7号预言家"
          },
          {
            "index": 2295,
            "source_segment_index": 2295,
            "start_ms": 4484670,
            "end_ms": 4485850,
            "text": "一号混血儿"
          },
          {
            "index": 2296,
            "source_segment_index": 2296,
            "start_ms": 4485850,
            "end_ms": 4487750,
            "text": "8号平民拍刀失败"
          },
          {
            "index": 2297,
            "source_segment_index": 2297,
            "start_ms": 4487750,
            "end_ms": 4488510,
            "text": "游戏结束"
          },
          {
            "index": 2298,
            "source_segment_index": 2298,
            "start_ms": 4488510,
            "end_ms": 4490174,
            "text": "好人阵营获胜"
          },
          {
            "index": 2299,
            "source_segment_index": 2299,
            "start_ms": 4490740,
            "end_ms": 4491140,
            "text": "好"
          },
          {
            "index": 2300,
            "source_segment_index": 2300,
            "start_ms": 4491140,
            "end_ms": 4493460,
            "text": "您正在收看到的是京城大赛第21季"
          },
          {
            "index": 2301,
            "source_segment_index": 2301,
            "start_ms": 4493460,
            "end_ms": 4494100,
            "text": "国际奇谈"
          },
          {
            "index": 2302,
            "source_segment_index": 2302,
            "start_ms": 4494100,
            "end_ms": 4495560,
            "text": "京城大赛第21季"
          },
          {
            "index": 2303,
            "source_segment_index": 2303,
            "start_ms": 4495560,
            "end_ms": 4498260,
            "text": "是由天天狼人app冠名赞助播出的"
          },
          {
            "index": 2304,
            "source_segment_index": 2304,
            "start_ms": 4498260,
            "end_ms": 4500760,
            "text": "欢迎各位弹幕老师们到各大应用商店来搜索"
          },
          {
            "index": 2305,
            "source_segment_index": 2305,
            "start_ms": 4500760,
            "end_ms": 4502530,
            "text": "并下载天天狼人APP"
          },
          {
            "index": 2306,
            "source_segment_index": 2306,
            "start_ms": 4502530,
            "end_ms": 4503970,
            "text": "再次跟大家来预告一下"
          },
          {
            "index": 2307,
            "source_segment_index": 2307,
            "start_ms": 4503970,
            "end_ms": 4507130,
            "text": "我们即将在两天之后开启我们的京城大师赛"
          },
          {
            "index": 2308,
            "source_segment_index": 2308,
            "start_ms": 4507130,
            "end_ms": 4510160,
            "text": "2026高校联赛的线上海选的赛道"
          },
          {
            "index": 2309,
            "source_segment_index": 2309,
            "start_ms": 4510160,
            "end_ms": 4513720,
            "text": "同时呢我们的报名工作将截止于25号啊"
          },
          {
            "index": 2310,
            "source_segment_index": 2310,
            "start_ms": 4513720,
            "end_ms": 4516400,
            "text": "各位弹幕老师们想要报名参加这次高校联赛"
          },
          {
            "index": 2311,
            "source_segment_index": 2311,
            "start_ms": 4516400,
            "end_ms": 4518880,
            "text": "可以抓紧时间到我们的官博来了解一下"
          },
          {
            "index": 2312,
            "source_segment_index": 2312,
            "start_ms": 4518880,
            "end_ms": 4520549,
            "text": "报名的相关资讯"
          },
          {
            "index": 2313,
            "source_segment_index": 2313,
            "start_ms": 4520549,
            "end_ms": 4522909,
            "text": "接下来把镜头给到第二现场的解说老师"
          },
          {
            "index": 2314,
            "source_segment_index": 2314,
            "start_ms": 4522909,
            "end_ms": 4524229,
            "text": "稍后回来是我们接的第二局游戏"
          },
          {
            "index": 2315,
            "source_segment_index": 2315,
            "start_ms": 4524229,
            "end_ms": 4525709,
            "text": "假面舞会"
          },
          {
            "index": 2316,
            "source_segment_index": 2316,
            "start_ms": 4557320,
            "end_ms": 4561770,
            "text": "大师赛原创版型假面舞会阵营分别为神职阵营"
          },
          {
            "index": 2317,
            "source_segment_index": 2317,
            "start_ms": 4561770,
            "end_ms": 4563530,
            "text": "狼人阵营和平民阵营"
          },
          {
            "index": 2318,
            "source_segment_index": 2318,
            "start_ms": 4563530,
            "end_ms": 4565450,
            "text": "在神职阵营中分为预言家"
          },
          {
            "index": 2319,
            "source_segment_index": 2319,
            "start_ms": 4565450,
            "end_ms": 4565930,
            "text": "女巫"
          },
          {
            "index": 2320,
            "source_segment_index": 2320,
            "start_ms": 4565930,
            "end_ms": 4567200,
            "text": "白痴和舞者"
          },
          {
            "index": 2321,
            "source_segment_index": 2321,
            "start_ms": 4567200,
            "end_ms": 4569740,
            "text": "舞者从第二页开始才能发动技能"
          },
          {
            "index": 2322,
            "source_segment_index": 2322,
            "start_ms": 4569740,
            "end_ms": 4571520,
            "text": "且每晚必须发动技能"
          },
          {
            "index": 2323,
            "source_segment_index": 2323,
            "start_ms": 4571520,
            "end_ms": 4574270,
            "text": "舞者每晚选择三名玩家进入50共五"
          },
          {
            "index": 2324,
            "source_segment_index": 2324,
            "start_ms": 4574270,
            "end_ms": 4575650,
            "text": "舞池中的三名玩家"
          },
          {
            "index": 2325,
            "source_segment_index": 2325,
            "start_ms": 4575650,
            "end_ms": 4578050,
            "text": "同为好人阵营或同为狼人阵营时"
          },
          {
            "index": 2326,
            "source_segment_index": 2326,
            "start_ms": 4578050,
            "end_ms": 4579610,
            "text": "舞池里无事发生"
          },
          {
            "index": 2327,
            "source_segment_index": 2327,
            "start_ms": 4579610,
            "end_ms": 4580630,
            "text": "舞池中的玩家"
          },
          {
            "index": 2328,
            "source_segment_index": 2328,
            "start_ms": 4580630,
            "end_ms": 4583820,
            "text": "如果为不同阵营人数少的一方被五出局"
          },
          {
            "index": 2329,
            "source_segment_index": 2329,
            "start_ms": 4583820,
            "end_ms": 4585860,
            "text": "舞者选择自己进入舞池时"
          },
          {
            "index": 2330,
            "source_segment_index": 2330,
            "start_ms": 4585860,
            "end_ms": 4588060,
            "text": "当夜舞池中的三人免疫狼刀"
          },
          {
            "index": 2331,
            "source_segment_index": 2331,
            "start_ms": 4588060,
            "end_ms": 4589280,
            "text": "需要注意的是"
          },
          {
            "index": 2332,
            "source_segment_index": 2332,
            "start_ms": 4589280,
            "end_ms": 4592320,
            "text": "整局游戏每名玩家只可进入一次舞池"
          },
          {
            "index": 2333,
            "source_segment_index": 2333,
            "start_ms": 4592320,
            "end_ms": 4595520,
            "text": "并且当剩余可进入舞池的玩家不足三人时"
          },
          {
            "index": 2334,
            "source_segment_index": 2334,
            "start_ms": 4595520,
            "end_ms": 4597120,
            "text": "舞者不可发动技能"
          },
          {
            "index": 2335,
            "source_segment_index": 2335,
            "start_ms": 4597120,
            "end_ms": 4598860,
            "text": "舞者免疫女巫的毒药"
          },
          {
            "index": 2336,
            "source_segment_index": 2336,
            "start_ms": 4598860,
            "end_ms": 4601080,
            "text": "在狼人阵营中分为三名"
          },
          {
            "index": 2337,
            "source_segment_index": 2337,
            "start_ms": 4601080,
            "end_ms": 4602060,
            "text": "狼人和假面"
          },
          {
            "index": 2338,
            "source_segment_index": 2338,
            "start_ms": 4602060,
            "end_ms": 4603250,
            "text": "从第二页起"
          },
          {
            "index": 2339,
            "source_segment_index": 2339,
            "start_ms": 4603250,
            "end_ms": 4606190,
            "text": "假面可以查验一名玩家是否在武士当中"
          },
          {
            "index": 2340,
            "source_segment_index": 2340,
            "start_ms": 4606190,
            "end_ms": 4608530,
            "text": "假面连续两晚不可确认同一人"
          },
          {
            "index": 2341,
            "source_segment_index": 2341,
            "start_ms": 4608530,
            "end_ms": 4611330,
            "text": "然后选择给予场上任意一名玩家面具"
          },
          {
            "index": 2342,
            "source_segment_index": 2342,
            "start_ms": 4611330,
            "end_ms": 4614110,
            "text": "当夜带有面具的玩家进入舞池时"
          },
          {
            "index": 2343,
            "source_segment_index": 2343,
            "start_ms": 4614110,
            "end_ms": 4617490,
            "text": "将被视为相反阵营的玩家进行结算"
          },
          {
            "index": 2344,
            "source_segment_index": 2344,
            "start_ms": 4618230,
            "end_ms": 4618870,
            "text": "Oh no"
          },
          {
            "index": 2345,
            "source_segment_index": 2345,
            "start_ms": 4618870,
            "end_ms": 4621550,
            "text": "假面连续两晚不可给予同一名玩家面具"
          },
          {
            "index": 2346,
            "source_segment_index": 2346,
            "start_ms": 4621550,
            "end_ms": 4622809,
            "text": "需要注意的是"
          },
          {
            "index": 2347,
            "source_segment_index": 2347,
            "start_ms": 4622809,
            "end_ms": 4625269,
            "text": "假面与其他狼人同伴互不见面"
          },
          {
            "index": 2348,
            "source_segment_index": 2348,
            "start_ms": 4625269,
            "end_ms": 4626569,
            "text": "且假面不能自爆"
          },
          {
            "index": 2349,
            "source_segment_index": 2349,
            "start_ms": 4626569,
            "end_ms": 4628510,
            "text": "当其他狼人全部出局时"
          },
          {
            "index": 2350,
            "source_segment_index": 2350,
            "start_ms": 4628510,
            "end_ms": 4630990,
            "text": "假面方可行使狼人基本击杀技能"
          },
          {
            "index": 2351,
            "source_segment_index": 2351,
            "start_ms": 4630990,
            "end_ms": 4632350,
            "text": "及每晚可以刀人"
          },
          {
            "index": 2352,
            "source_segment_index": 2352,
            "start_ms": 4632350,
            "end_ms": 4634270,
            "text": "假面同样免疫女巫毒药"
          },
          {
            "index": 2353,
            "source_segment_index": 2353,
            "start_ms": 4634270,
            "end_ms": 4636100,
            "text": "本版型采用屠边规则"
          },
          {
            "index": 2354,
            "source_segment_index": 2354,
            "start_ms": 4636100,
            "end_ms": 4638460,
            "text": "及其中任一阵营玩家全部出局时"
          },
          {
            "index": 2355,
            "source_segment_index": 2355,
            "start_ms": 4638460,
            "end_ms": 4640340,
            "text": "则对立阵营获胜"
          }
        ],
