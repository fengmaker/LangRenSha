            "source_segment_index": 2284,
            "start_ms": 4468350,
            "end_ms": 4469430,
            "text": "本球星为好人"
          },
          {
            "index": 2285,
            "source_segment_index": 2285,
            "start_ms": 4469430,
            "end_ms": 4471360,
            "text": "混首夜狼人击杀5号女巫"
          },
          {
            "index": 2286,
            "source_segment_index": 2286,
            "start_ms": 4471360,
            "end_ms": 4473220,
            "text": "女巫毒杀4号平民四五双死"
          },
          {
            "index": 2287,
            "source_segment_index": 2287,
            "start_ms": 4473220,
            "end_ms": 4475580,
