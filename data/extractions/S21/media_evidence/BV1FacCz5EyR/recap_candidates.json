          },
          {
            "index": 2291,
            "source_segment_index": 2291,
            "start_ms": 4478820,
            "end_ms": 4480790,
            "text": "2号汉太狼被公投出局"
          },
          {
            "index": 2292,
            "source_segment_index": 2292,
            "start_ms": 4480790,
            "end_ms": 4482250,
            "text": "然后狼人阵营决定拍刀"
          },
          {
