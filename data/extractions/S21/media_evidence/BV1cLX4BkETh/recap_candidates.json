            "source_segment_index": 3051,
            "start_ms": 5557880,
            "end_ms": 5559400,
            "text": "除夕好个屁呀"
          },
          {
            "index": 3051,
            "source_segment_index": 3052,
            "start_ms": 5559400,
            "end_ms": 5563060,
            "text": "我天来给各位当老师们做一下本局游戏的复盘"
          },
          {
            "index": 3052,
            "source_segment_index": 3053,
            "start_ms": 5563060,
            "end_ms": 5565690,
            "text": "本局版行为鬼畜之信"
          },
          {
            "index": 3053,
            "source_segment_index": 3054,
            "start_ms": 5565690,
            "end_ms": 5566750,
            "text": "神人阵营预言家"
          },
          {
            "index": 3054,
            "source_segment_index": 3055,
            "start_ms": 5566750,
            "end_ms": 5567530,
            "text": "7号女巫"
          },
          {
            "index": 3055,
            "source_segment_index": 3056,
            "start_ms": 5567530,
            "end_ms": 5568650,
            "text": "8号魔术师"
          },
          {
            "index": 3056,
            "source_segment_index": 3057,
            "start_ms": 5568650,
            "end_ms": 5569450,
            "text": "12号地球王子"
          },
          {
            "index": 3057,
            "source_segment_index": 3058,
            "start_ms": 5569450,
            "end_ms": 5570970,
            "text": "9号狼人阵营2号五号"
          },
          {
            "index": 3058,
            "source_segment_index": 3059,
            "start_ms": 5570970,
            "end_ms": 5572350,
            "text": "10号鬼术师"
          },
          {
            "index": 3059,
            "source_segment_index": 3060,
            "start_ms": 5572350,
            "end_ms": 5575129,
            "text": "6号平民阵营一号3号四号"
          },
          {
            "index": 3060,
            "source_segment_index": 3061,
            "start_ms": 5575129,
            "end_ms": 5579440,
            "text": "11号首页鬼术师交换了5号狼人及8号女巫"
          },
          {
            "index": 3061,
            "source_segment_index": 3062,
            "start_ms": 5579440,
            "end_ms": 5580040,
            "text": "狼人"
          },
          {
            "index": 3062,
            "source_segment_index": 3063,
            "start_ms": 5580040,
            "end_ms": 5581800,
            "text": "击杀一号平民女荣耀救起"
          },
          {
            "index": 3063,
            "source_segment_index": 3064,
            "start_ms": 5581800,
            "end_ms": 5584220,
            "text": "形成平安夜预言家验证了9号玩家定序"
          },
          {
            "index": 3064,
            "source_segment_index": 3065,
            "start_ms": 5584220,
            "end_ms": 5586590,
            "text": "王子为好人身份"
          },
          {
            "index": 3065,
            "source_segment_index": 3066,
            "start_ms": 5586870,
            "end_ms": 5588510,
            "text": "在警上竞选环节"
          },
          {
            "index": 3066,
            "source_segment_index": 3067,
            "start_ms": 5588510,
            "end_ms": 5590310,
            "text": "7号预言家胡的警徽"
          },
          {
            "index": 3067,
            "source_segment_index": 3068,
            "start_ms": 5590310,
            "end_ms": 5590970,
            "text": "第一天白天"
          },
          {
            "index": 3068,
            "source_segment_index": 3069,
            "start_ms": 5590970,
            "end_ms": 5593130,
            "text": "2号狼人被公投出局"
          },
          {
            "index": 3069,
            "source_segment_index": 3070,
            "start_ms": 5593130,
            "end_ms": 5593850,
            "text": "入夜"
          },
          {
            "index": 3070,
            "source_segment_index": 3071,
            "start_ms": 5593850,
            "end_ms": 5596270,
            "text": "鬼术师交换7号预言家"
          },
          {
            "index": 3071,
            "source_segment_index": 3072,
            "start_ms": 5596270,
            "end_ms": 5601320,
            "text": "10号狼人魔术师交换7号预言家以及10号狼人"
          },
          {
            "index": 3072,
            "source_segment_index": 3073,
            "start_ms": 5601320,
            "end_ms": 5604790,
            "text": "我们当夜触发了我们本局的这个鬼畜之境"
          },
          {
            "index": 3073,
            "source_segment_index": 3074,
            "start_ms": 5604790,
            "end_ms": 5606470,
            "text": "版型的一个彩蛋规则"
          },
          {
            "index": 3074,
            "source_segment_index": 3075,
            "start_ms": 5606470,
            "end_ms": 5608150,
            "text": "所以相当于鬼畜师与魔术师"
          },
          {
            "index": 3075,
            "source_segment_index": 3076,
            "start_ms": 5608150,
            "end_ms": 5610400,
            "text": "夜晚的技能互相抵消"
          },
          {
            "index": 3076,
            "source_segment_index": 3077,
            "start_ms": 5610400,
            "end_ms": 5612400,
            "text": "狼人击杀9号定序"
          },
          {
            "index": 3077,
            "source_segment_index": 3078,
            "start_ms": 5612400,
            "end_ms": 5614540,
            "text": "王子女巫毒杀5号狼人"
          },
          {
            "index": 3078,
            "source_segment_index": 3079,
            "start_ms": 5614540,
            "end_ms": 5615940,
            "text": "5号九号双死"
          },
          {
            "index": 3079,
            "source_segment_index": 3080,
            "start_ms": 5615940,
            "end_ms": 5619480,
            "text": "预言家验证了一号玩家平民为好人身份"
          },
          {
            "index": 3080,
            "source_segment_index": 3081,
            "start_ms": 5619480,
            "end_ms": 5620900,
            "text": "在第二天的白天"
          },
          {
            "index": 3081,
            "source_segment_index": 3082,
            "start_ms": 5620900,
            "end_ms": 5623240,
            "text": "6号玩家鬼术师被公投出局后"
          },
          {
            "index": 3082,
            "source_segment_index": 3083,
            "start_ms": 5623240,
            "end_ms": 5624260,
            "text": "狼人选择交牌"
          },
          {
            "index": 3083,
            "source_segment_index": 3084,
            "start_ms": 5624260,
            "end_ms": 5624980,
            "text": "游戏结束"
          },
          {
            "index": 3084,
            "source_segment_index": 3085,
            "start_ms": 5624980,
            "end_ms": 5626090,
            "text": "好人阵营获胜"
          },
          {
            "index": 3085,
            "source_segment_index": 3086,
            "start_ms": 5626090,
            "end_ms": 5628290,
            "text": "以上是我们今天第二局版型"
          },
          {
            "index": 3086,
            "source_segment_index": 3087,
            "start_ms": 5628290,
            "end_ms": 5629330,
            "text": "鬼畜致敬的全部内容"
          },
          {
            "index": 3087,
            "source_segment_index": 3088,
            "start_ms": 5629330,
            "end_ms": 5631219,
            "text": "非常感谢每一位弹幕老师的陪伴"
          },
          {
            "index": 3088,
            "source_segment_index": 3089,
            "start_ms": 5631219,
            "end_ms": 5633919,
            "text": "这里是我们京城大师赛第21赛季"
          },
          {
            "index": 3089,
            "source_segment_index": 3090,
            "start_ms": 5633919,
            "end_ms": 5635219,
            "text": "葵曲奇谭的直播现场"
          },
          {
            "index": 3090,
            "source_segment_index": 3091,
            "start_ms": 5635219,
            "end_ms": 5637299,
            "text": "也非常感谢我们本节目的赞助商啊"
          },
          {
            "index": 3091,
            "source_segment_index": 3092,
            "start_ms": 5637299,
            "end_ms": 5640609,
            "text": "感谢天天狼人app对我们节目的冠名赞助支持"
          },
          {
            "index": 3092,
            "source_segment_index": 3093,
            "start_ms": 5640609,
            "end_ms": 5642729,
            "text": "也请各位大老师们可以来到我们各大应用平台"
          },
          {
            "index": 3093,
            "source_segment_index": 3094,
            "start_ms": 5642729,
            "end_ms": 5644830,
            "text": "搜索并下载天天狼人app"
          },
          {
            "index": 3094,
            "source_segment_index": 3095,
            "start_ms": 5644830,
            "end_ms": 5646750,
            "text": "就可以跟我们一起来玩网杀游戏了"
          },
          {
            "index": 3095,
            "source_segment_index": 3096,
            "start_ms": 5646750,
            "end_ms": 5647230,
            "text": "然后呢"
          },
          {
            "index": 3096,
            "source_segment_index": 3097,
            "start_ms": 5647230,
            "end_ms": 5649990,
            "text": "我们本赛季还有两名特约赞助品牌"
          },
          {
            "index": 3097,
            "source_segment_index": 3098,
            "start_ms": 5649990,
            "end_ms": 5653950,
            "text": "第一个是我们这款来懒痴霞的零食啊"
          },
          {
            "index": 3098,
            "source_segment_index": 3099,
            "start_ms": 5653950,
            "end_ms": 5654990,
            "text": "感谢感谢懒之霞"
          },
          {
            "index": 3099,
            "source_segment_index": 3100,
            "start_ms": 5654990,
            "end_ms": 5656490,
            "text": "第二个是我们柠檬共和国"
          },
          {
            "index": 3100,
            "source_segment_index": 3101,
            "start_ms": 5656490,
            "end_ms": 5658470,
            "text": "我们有非常多的好喝的饮品"
          },
          {
            "index": 3101,
            "source_segment_index": 3102,
            "start_ms": 5658470,
            "end_ms": 5659990,
            "text": "以及我们非常多好吃的食品"
          },
          {
            "index": 3102,
            "source_segment_index": 3103,
            "start_ms": 5659990,
            "end_ms": 5661250,
            "text": "也欢迎各位弹幕老师们"
          },
          {
            "index": 3103,
            "source_segment_index": 3104,
            "start_ms": 5661250,
            "end_ms": 5663910,
            "text": "能够来到我们歪哥的个人主页橱窗中"
          },
          {
            "index": 3104,
            "source_segment_index": 3105,
            "start_ms": 5663910,
            "end_ms": 5666270,
            "text": "然后随时进行下单和补货"
          },
          {
            "index": 3105,
            "source_segment_index": 3106,
            "start_ms": 5666270,
            "end_ms": 5668510,
            "text": "同样的再次感谢一下LISA"
          },
          {
            "index": 3106,
            "source_segment_index": 3107,
            "start_ms": 5668510,
            "end_ms": 5669570,
            "text": "感谢LISA"
          },
          {
            "index": 3107,
            "source_segment_index": 3108,
            "start_ms": 5669570,
            "end_ms": 5670990,
            "text": "感谢烟锁秦楼"
          },
          {
            "index": 3108,
            "source_segment_index": 3109,
            "start_ms": 5670990,
            "end_ms": 5673070,
            "text": "感谢安G宝宝给我的投食"
          },
          {
            "index": 3109,
            "source_segment_index": 3110,
            "start_ms": 5673070,
            "end_ms": 5674150,
            "text": "接下来请导播老师"
          },
