        "evidence": [
          {
            "index": 2892,
            "source_segment_index": 2892,
            "start_ms": 5578680,
            "end_ms": 5579940,
            "text": "真男人啊"
          },
          {
            "index": 2893,
            "source_segment_index": 2893,
            "start_ms": 5579940,
            "end_ms": 5582320,
            "text": "哎确实听说这人怎么样"
          },
          {
            "index": 2894,
            "source_segment_index": 2894,
            "start_ms": 5582320,
            "end_ms": 5584420,
            "text": "听说学医都这样吗"
          },
          {
            "index": 2895,
            "source_segment_index": 2895,
            "start_ms": 5584420,
            "end_ms": 5586060,
            "text": "我我最后好"
          },
          {
            "index": 2896,
            "source_segment_index": 2896,
            "start_ms": 5586060,
            "end_ms": 5589020,
            "text": "给各位道老师们做一下本局游戏的复盘"
          },
          {
            "index": 2897,
            "source_segment_index": 2897,
            "start_ms": 5589470,
            "end_ms": 5592910,
            "text": "本剧版星鹰女猎白混血儿神阵营原价4号女巫"
          },
          {
            "index": 2898,
            "source_segment_index": 2898,
            "start_ms": 5592910,
            "end_ms": 5593990,
            "text": "9号猎人"
          },
          {
            "index": 2899,
            "source_segment_index": 2899,
            "start_ms": 5593990,
            "end_ms": 5594990,
            "text": "7号白神"
          },
          {
            "index": 2900,
            "source_segment_index": 2900,
            "start_ms": 5594990,
            "end_ms": 5596520,
            "text": "12号狼人阵营"
          },
          {
            "index": 2901,
            "source_segment_index": 2901,
            "start_ms": 5596520,
            "end_ms": 5600100,
            "text": "5号八号十号11号平民阵营"
          },
          {
            "index": 2902,
            "source_segment_index": 2902,
            "start_ms": 5600100,
            "end_ms": 5603360,
            "text": "2号三号六号混血儿一号"
          },
          {
            "index": 2903,
            "source_segment_index": 2903,
            "start_ms": 5603360,
            "end_ms": 5604960,
            "text": "本局游戏为好人混"
          },
          {
            "index": 2904,
            "source_segment_index": 2904,
            "start_ms": 5604960,
            "end_ms": 5607640,
            "text": "首页混血儿选择9号女巫为榜样"
          },
          {
            "index": 2905,
            "source_segment_index": 2905,
            "start_ms": 5607640,
            "end_ms": 5611010,
            "text": "倾城好人混狼人击杀12号白神"
          },
          {
            "index": 2906,
            "source_segment_index": 2906,
            "start_ms": 5611010,
            "end_ms": 5613650,
            "text": "女巫要救起形成平安夜当夜"
          },
          {
            "index": 2907,
            "source_segment_index": 2907,
            "start_ms": 5613650,
            "end_ms": 5617450,
            "text": "预言家验证了12号玩家白神为好人身份"
          },
          {
            "index": 2908,
            "source_segment_index": 2908,
            "start_ms": 5617450,
            "end_ms": 5618850,
            "text": "在警上竞选环节"
          },
          {
            "index": 2909,
            "source_segment_index": 2909,
            "start_ms": 5618850,
            "end_ms": 5621030,
            "text": "8号悍跳狼人获得警徽"
          },
          {
            "index": 2910,
            "source_segment_index": 2910,
            "start_ms": 5621030,
            "end_ms": 5624790,
            "text": "在第一天白天一号混血而被抗推出局"
          },
          {
            "index": 2911,
            "source_segment_index": 2911,
            "start_ms": 5624790,
            "end_ms": 5627990,
            "text": "咳入夜狼人击杀3号平民女巫"
          },
          {
            "index": 2912,
            "source_segment_index": 2912,
            "start_ms": 5627990,
            "end_ms": 5629530,
            "text": "毒杀5号狼人"
          },
          {
            "index": 2913,
            "source_segment_index": 2913,
            "start_ms": 5629530,
            "end_ms": 5631150,
            "text": "3号五号双死"
          },
          {
            "index": 2914,
            "source_segment_index": 2914,
            "start_ms": 5631150,
            "end_ms": 5633950,
            "text": "预言家验证了9号玩家女巫为好人身份"
          },
          {
            "index": 2915,
            "source_segment_index": 2915,
            "start_ms": 5633950,
            "end_ms": 5634870,
            "text": "在第二天的白天"
          },
          {
            "index": 2916,
            "source_segment_index": 2916,
            "start_ms": 5634870,
            "end_ms": 5636350,
            "text": "狼对阵营选择拍刀"
          },
          {
            "index": 2917,
            "source_segment_index": 2917,
            "start_ms": 5636350,
            "end_ms": 5637490,
            "text": "2号平民"
          },
          {
            "index": 2918,
            "source_segment_index": 2918,
            "start_ms": 5637490,
            "end_ms": 5639350,
            "text": "6号平民拍刀成功"
          },
          {
            "index": 2919,
            "source_segment_index": 2919,
            "start_ms": 5639350,
            "end_ms": 5640050,
            "text": "游戏结束"
          },
          {
            "index": 2920,
            "source_segment_index": 2920,
            "start_ms": 5640050,
            "end_ms": 5641650,
            "text": "狼人阵营同名获胜"
          },
          {
            "index": 2921,
            "source_segment_index": 2921,
            "start_ms": 5641650,
            "end_ms": 5643210,
            "text": "以上是我们今天第一局版型"
          },
          {
            "index": 2922,
            "source_segment_index": 2922,
            "start_ms": 5643210,
            "end_ms": 5644570,
            "text": "玉女猎白混血儿的全部内容"
          },
          {
            "index": 2923,
            "source_segment_index": 2923,
            "start_ms": 5644570,
            "end_ms": 5646469,
            "text": "非常感谢各位大木老师的陪伴"
          },
          {
            "index": 2924,
            "source_segment_index": 2924,
            "start_ms": 5646469,
            "end_ms": 5648929,
            "text": "这里是我们京城大师赛第21赛季"
          },
          {
            "index": 2925,
            "source_segment_index": 2925,
            "start_ms": 5648929,
            "end_ms": 5650469,
            "text": "口语曲集团的直播现场"
          },
          {
            "index": 2926,
            "source_segment_index": 2926,
            "start_ms": 5650469,
            "end_ms": 5652830,
            "text": "然后今天也是我们常规赛的最后一天"
          },
          {
            "index": 2927,
            "source_segment_index": 2927,
            "start_ms": 5652830,
            "end_ms": 5655740,
            "text": "希望各位家人们能够在我们直播间看得开心"
          },
          {
            "index": 2928,
            "source_segment_index": 2928,
            "start_ms": 5655740,
            "end_ms": 5657140,
            "text": "再一次感谢天天狼人app"
          },
          {
            "index": 2929,
            "source_segment_index": 2929,
            "start_ms": 5657140,
            "end_ms": 5658700,
            "text": "对我们节目的冠名赞助支持"
          },
          {
            "index": 2930,
            "source_segment_index": 2930,
            "start_ms": 5658700,
            "end_ms": 5660880,
            "text": "各位家人们也可以随时来到各大应用平台"
          },
          {
            "index": 2931,
            "source_segment_index": 2931,
            "start_ms": 5660880,
            "end_ms": 5662790,
            "text": "搜索并下载天天狼人app"
          },
          {
            "index": 2932,
            "source_segment_index": 2932,
            "start_ms": 5662790,
            "end_ms": 5664510,
            "text": "就可以跟我们一起来玩京城大师赛"
          },
          {
            "index": 2933,
            "source_segment_index": 2933,
            "start_ms": 5664510,
            "end_ms": 5665810,
            "text": "同款的网杀游戏了"
          },
          {
            "index": 2934,
            "source_segment_index": 2934,
            "start_ms": 5665810,
            "end_ms": 5667830,
            "text": "同样感谢本赛季特约赞助商"
          },
          {
            "index": 2935,
            "source_segment_index": 2935,
            "start_ms": 5667830,
            "end_ms": 5669470,
            "text": "感谢柠檬共和国懒赤霞"
          },
          {
            "index": 2936,
            "source_segment_index": 2936,
            "start_ms": 5669470,
            "end_ms": 5671710,
            "text": "以及哈尼牧场对我们节目的赞助支持"
          },
          {
            "index": 2937,
            "source_segment_index": 2937,
            "start_ms": 5671710,
            "end_ms": 5674350,
            "text": "各位家人们可以来到我们这外代师个人主页"
          },
          {
            "index": 2938,
            "source_segment_index": 2938,
            "start_ms": 5674350,
            "end_ms": 5674910,
            "text": "橱窗内"
          },
          {
            "index": 2939,
            "source_segment_index": 2939,
            "start_ms": 5674910,
            "end_ms": 5676250,
            "text": "随时进行下单补货"
          },
          {
            "index": 2940,
            "source_segment_index": 2940,
            "start_ms": 5676250,
            "end_ms": 5678400,
            "text": "感谢阿"
          },
          {
            "index": 2941,
            "source_segment_index": 2941,
            "start_ms": 5678400,
            "end_ms": 5679740,
            "text": "感谢阿陆"
          },
          {
            "index": 2942,
            "source_segment_index": 2942,
            "start_ms": 5679740,
            "end_ms": 5680520,
            "text": "感谢早八"
          },
          {
            "index": 2943,
            "source_segment_index": 2943,
            "start_ms": 5680520,
            "end_ms": 5681240,
            "text": "感谢小五"
          },
          {
            "index": 2944,
            "source_segment_index": 2944,
            "start_ms": 5681240,
            "end_ms": 5683200,
            "text": "感谢性感大蟑螂老师给我投食"
          },
          {
            "index": 2945,
            "source_segment_index": 2945,
            "start_ms": 5683200,
            "end_ms": 5685420,
            "text": "接下来请导老师把镜头移交出调到现场"
          },
          {
            "index": 2946,
            "source_segment_index": 2946,
            "start_ms": 5687680,
            "end_ms": 5689460,
            "text": "稍后回来会是我们第二局假面舞会"
          },
          {
            "index": 2947,
            "source_segment_index": 2947,
            "start_ms": 5689460,
            "end_ms": 5690700,
            "text": "一会见"
          },
          {
            "index": 2948,
            "source_segment_index": 2948,
            "start_ms": 5694980,
            "end_ms": 5698420,
            "text": "哇塞这把杠杆太厉害啦"
          },
          {
            "index": 2949,
            "source_segment_index": 2949,
            "start_ms": 5699580,
            "end_ms": 5701460,
            "text": "唉我都不敢说话了啊"
          },
          {
            "index": 2950,
            "source_segment_index": 2950,
            "start_ms": 5701460,
            "end_ms": 5702740,
            "text": "大家弹幕直接喷我吧"
          },
          {
            "index": 2951,
            "source_segment_index": 2951,
            "start_ms": 5702740,
            "end_ms": 5703540,
            "text": "没事没事"
          },
          {
            "index": 2952,
            "source_segment_index": 2952,
            "start_ms": 5703540,
            "end_ms": 5705700,
            "text": "锤一下这个狼混狼混锤"
          },
          {
            "index": 2953,
            "source_segment_index": 2953,
            "start_ms": 5705700,
            "end_ms": 5707669,
            "text": "狼混有没有"
          },
          {
            "index": 2954,
            "source_segment_index": 2954,
            "start_ms": 5707669,
            "end_ms": 5709950,
            "text": "确实确实就是嗯"
          },
          {
            "index": 2955,
            "source_segment_index": 2955,
            "start_ms": 5709950,
            "end_ms": 5713790,
            "text": "呃确实没有分清楚哥哥是狼还是好"
          },
          {
            "index": 2956,
            "source_segment_index": 2956,
            "start_ms": 5713790,
            "end_ms": 5717909,
            "text": "然后就最后可能觉得那个呃他们是一个团队"
          },
          {
            "index": 2957,
            "source_segment_index": 2957,
            "start_ms": 5717909,
            "end_ms": 5718589,
            "text": "但是要出我"
          },
          {
            "index": 2958,
            "source_segment_index": 2958,
            "start_ms": 5718589,
            "end_ms": 5720789,
            "text": "然后那我只能出对面团队的哎"
          },
          {
            "index": 2959,
            "source_segment_index": 2959,
            "start_ms": 5720789,
            "end_ms": 5722269,
            "text": "有可能是我这个四对吧"
          },
          {
            "index": 2960,
            "source_segment_index": 2960,
            "start_ms": 5722269,
            "end_ms": 5724270,
            "text": "就可能往下苟一下就好了"
          },
          {
            "index": 2961,
            "source_segment_index": 2961,
            "start_ms": 5724270,
            "end_ms": 5726870,
            "text": "嗯其实小五就是觉得自己是狼混了对吧"
          },
          {
            "index": 2962,
            "source_segment_index": 2962,
            "start_ms": 5726870,
            "end_ms": 5727910,
            "text": "觉得自己是狼混了"
          },
          {
            "index": 2963,
            "source_segment_index": 2963,
            "start_ms": 5727910,
            "end_ms": 5729710,
            "text": "那就是他觉得自己狼混了"
          },
          {
            "index": 2964,
            "source_segment_index": 2964,
            "start_ms": 5729710,
            "end_ms": 5730270,
            "text": "刚刚是狼"
          },
          {
            "index": 2965,
            "source_segment_index": 2965,
            "start_ms": 5730270,
            "end_ms": 5731830,
            "text": "然后他说意思是刚刚投他"
          },
          {
            "index": 2966,
            "source_segment_index": 2966,
            "start_ms": 5731830,
            "end_ms": 5733640,
            "text": "他又帮刚刚投了一下4号"
          },
          {
            "index": 2967,
            "source_segment_index": 2967,
            "start_ms": 5733655,
            "end_ms": 5736400,
            "text": "但是其实我们小五第一票是投队已经非常"
          },
          {
            "index": 2968,
            "source_segment_index": 2968,
            "start_ms": 5736400,
            "end_ms": 5737560,
            "text": "我觉得已经非常厉害了"
          },
          {
            "index": 2969,
            "source_segment_index": 2969,
            "start_ms": 5737560,
            "end_ms": 5739200,
            "text": "第一票其实就两个人投队"
          },
          {
            "index": 2970,
            "source_segment_index": 2970,
            "start_ms": 5739200,
            "end_ms": 5740080,
            "text": "两到三个人"
          },
          {
            "index": 2971,
            "source_segment_index": 2971,
            "start_ms": 5740080,
            "end_ms": 5741290,
            "text": "两个人还是三个人投队"
          },
          {
            "index": 2972,
            "source_segment_index": 2972,
            "start_ms": 5741290,
            "end_ms": 5742990,
            "text": "就我跟7号玩家投对了啊"
          },
          {
            "index": 2973,
            "source_segment_index": 2973,
            "start_ms": 5742990,
            "end_ms": 5744350,
            "text": "这个说要夸一下自己"
          },
          {
            "index": 2974,
            "source_segment_index": 2974,
            "start_ms": 5744350,
            "end_ms": 5745370,
            "text": "对对对"
          },
          {
            "index": 2975,
            "source_segment_index": 2975,
            "start_ms": 5745370,
            "end_ms": 5747930,
            "text": "就我是确实我是第一次拿混子牌"
          },
          {
            "index": 2976,
            "source_segment_index": 2976,
            "start_ms": 5747930,
            "end_ms": 5749210,
            "text": "我第一次拿混子这张牌啊"
          },
          {
            "index": 2977,
            "source_segment_index": 2977,
            "start_ms": 5749210,
            "end_ms": 5750860,
            "text": "嗯确实玩的不太好"
          },
          {
            "index": 2978,
            "source_segment_index": 2978,
            "start_ms": 5750860,
            "end_ms": 5751840,
            "text": "真的非常抱歉"
          },
          {
            "index": 2979,
            "source_segment_index": 2979,
            "start_ms": 5751840,
            "end_ms": 5754040,
            "text": "哎我这个诶你的锤子呢"
          },
          {
            "index": 2980,
            "source_segment_index": 2980,
            "start_ms": 5754040,
            "end_ms": 5754980,
            "text": "锤锤子不用锤了"
          },
          {
            "index": 2981,
            "source_segment_index": 2981,
            "start_ms": 5754980,
            "end_ms": 5756820,
            "text": "大家说好的好的"
          },
          {
            "index": 2982,
            "source_segment_index": 2982,
            "start_ms": 5756820,
            "end_ms": 5757720,
            "text": "谢谢哇"
          },
          {
            "index": 2983,
            "source_segment_index": 2983,
            "start_ms": 5757720,
            "end_ms": 5758680,
            "text": "做解说还是没好"
          },
          {
            "index": 2984,
            "source_segment_index": 2984,
            "start_ms": 5758680,
            "end_ms": 5759840,
            "text": "还可以帮自己洗一洗"
          },
          {
            "index": 2985,
            "source_segment_index": 2985,
            "start_ms": 5759840,
            "end_ms": 5761640,
            "text": "其实大家玩的都还可以"
          },
          {
            "index": 2986,
            "source_segment_index": 2986,
            "start_ms": 5761640,
            "end_ms": 5762360,
            "text": "都挺好的"
          },
          {
            "index": 2987,
            "source_segment_index": 2987,
            "start_ms": 5762360,
            "end_ms": 5763280,
            "text": "今天压力比较大"
          },
          {
            "index": 2988,
            "source_segment_index": 2988,
            "start_ms": 5763280,
            "end_ms": 5764080,
            "text": "突然下去了"
          },
          {
            "index": 2989,
            "source_segment_index": 2989,
            "start_ms": 5764480,
            "end_ms": 5766760,
            "text": "下一把是我们的假面舞会"
          },
          {
            "index": 2990,
            "source_segment_index": 2990,
            "start_ms": 5766760,
            "end_ms": 5768660,
            "text": "对这一把这把我说实话"
          }
        ],
