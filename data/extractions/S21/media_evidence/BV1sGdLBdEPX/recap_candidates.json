            "start_ms": 5840520,
            "end_ms": 5843240,
            "text": "稍后回来会是我们第三局机械狼通灵师"
          },
          {
            "index": 3066,
            "source_segment_index": 3066,
            "start_ms": 5843240,
            "end_ms": 5844560,
            "text": "一会见"
          }
