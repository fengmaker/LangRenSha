            "source_segment_index": 2747,
            "start_ms": 5313760,
            "end_ms": 5316850,
            "text": "我觉得这局游戏就印证了一句话"
          },
          {
            "index": 2748,
            "source_segment_index": 2748,
            "start_ms": 5317020,
            "end_ms": 5319170,
            "text": "战力有强弱"
          },
          {
            "index": 2749,
            "source_segment_index": 2749,
            "start_ms": 5319170,
            "end_ms": 5321010,
            "text": "狼少好人多"
          },
          {
            "index": 2750,
            "source_segment_index": 2750,
            "start_ms": 5321010,
            "end_ms": 5322750,
            "text": "狼少好人多啊"
          },
          {
            "index": 2751,
            "source_segment_index": 2751,
            "start_ms": 5322750,
            "end_ms": 5324150,
            "text": "确实第一把也没有期待"
          },
          {
            "index": 2752,
            "source_segment_index": 2752,
            "start_ms": 5324150,
            "end_ms": 5325470,
            "text": "也没有狼混的"
