          {
            "index": 2698,
            "source_segment_index": 2698,
            "start_ms": 5215280,
            "end_ms": 5218020,
            "text": "6号狼人阵营一号4号八号"
          },
          {
            "index": 2699,
            "source_segment_index": 2699,
            "start_ms": 5218020,
            "end_ms": 5220770,
            "text": "11号平民阵营3号五号"
          },
          {
            "index": 2700,
            "source_segment_index": 2700,
            "start_ms": 5220770,
            "end_ms": 5221870,
            "text": "7号混血儿"
          },
          {
            "index": 2701,
            "source_segment_index": 2701,
            "start_ms": 5221870,
            "end_ms": 5223700,
            "text": "2号本就戏为好人混"
          },
          {
            "index": 2702,
            "source_segment_index": 2702,
            "start_ms": 5223700,
            "end_ms": 5226780,
            "text": "首页混血儿选择7号平民为榜样"
          },
          {
            "index": 2703,
            "source_segment_index": 2703,
            "start_ms": 5226780,
            "end_ms": 5229090,
            "text": "新生好人混狼人击杀9号预言家"
          },
          {
            "index": 2704,
            "source_segment_index": 2704,
            "start_ms": 5229090,
            "end_ms": 5230110,
            "text": "云雾要救起"
          },
          {
            "index": 2705,
            "source_segment_index": 2705,
            "start_ms": 5230110,
            "end_ms": 5231090,
            "text": "形成平安夜"
          },
          {
            "index": 2706,
            "source_segment_index": 2706,
            "start_ms": 5231090,
            "end_ms": 5233750,
            "text": "预言家验证了一号玩家为狼人身份"
          },
          {
            "index": 2707,
            "source_segment_index": 2707,
            "start_ms": 5233750,
            "end_ms": 5235520,
            "text": "在警上竞选环节"
          },
          {
            "index": 2708,
            "source_segment_index": 2708,
            "start_ms": 5235520,
            "end_ms": 5237600,
            "text": "9号预言家获得警徽"
          },
          {
            "index": 2709,
            "source_segment_index": 2709,
            "start_ms": 5237600,
            "end_ms": 5240929,
            "text": "第一天白天8号狼人选择自爆入夜"
          },
          {
            "index": 2710,
            "source_segment_index": 2710,
            "start_ms": 5240929,
            "end_ms": 5242509,
            "text": "狼人击杀9号预言家"
          },
          {
            "index": 2711,
            "source_segment_index": 2711,
            "start_ms": 5242509,
            "end_ms": 5243349,
            "text": "女巫技能空过"
          },
          {
            "index": 2712,
            "source_segment_index": 2712,
            "start_ms": 5243349,
            "end_ms": 5246470,
            "text": "预言家验证了12号玩家猎人为好人身份"
          },
          {
            "index": 2713,
            "source_segment_index": 2713,
            "start_ms": 5246470,
            "end_ms": 5249510,
            "text": "并在出局后将警徽移交至12号猎人"
          },
          {
            "index": 2714,
            "source_segment_index": 2714,
            "start_ms": 5249510,
            "end_ms": 5250370,
            "text": "第二天的白天"
          },
          {
            "index": 2715,
            "source_segment_index": 2715,
            "start_ms": 5250370,
            "end_ms": 5254080,
            "text": "一号狼人选择自爆入夜狼人击杀10号女巫"
          },
          {
            "index": 2716,
            "source_segment_index": 2716,
            "start_ms": 5254080,
            "end_ms": 5255700,
            "text": "女巫毒杀4号狼人"
          },
          {
            "index": 2717,
            "source_segment_index": 2717,
            "start_ms": 5255700,
            "end_ms": 5257389,
            "text": "4号十号双四"
          },
          {
            "index": 2718,
            "source_segment_index": 2718,
            "start_ms": 5257389,
            "end_ms": 5258569,
            "text": "第三天的白天"
          },
          {
            "index": 2719,
            "source_segment_index": 2719,
            "start_ms": 5258569,
            "end_ms": 5261449,
            "text": "场上最后一狼11号被公投出局"
          },
          {
            "index": 2720,
            "source_segment_index": 2720,
            "start_ms": 5261449,
            "end_ms": 5262129,
            "text": "游戏结束"
          },
          {
            "index": 2721,
            "source_segment_index": 2721,
            "start_ms": 5262129,
            "end_ms": 5263150,
            "text": "好人阵营获胜"
          },
          {
            "index": 2722,
            "source_segment_index": 2722,
            "start_ms": 5263150,
            "end_ms": 5264670,
            "text": "以上是我们今天第一局预女猎"
          },
          {
            "index": 2723,
            "source_segment_index": 2723,
            "start_ms": 5264670,
            "end_ms": 5265790,
            "text": "白混血儿的全部内容"
          },
          {
            "index": 2724,
            "source_segment_index": 2724,
            "start_ms": 5265790,
            "end_ms": 5267420,
            "text": "感谢每一位弹幕老师的陪伴"
          },
          {
            "index": 2725,
            "source_segment_index": 2725,
            "start_ms": 5267420,
            "end_ms": 5269760,
            "text": "这里是我们晋城大师赛第21赛季"
          },
          {
            "index": 2726,
            "source_segment_index": 2726,
            "start_ms": 5269760,
            "end_ms": 5271380,
            "text": "葵曲奇谭的直播现场"
          },
          {
            "index": 2727,
            "source_segment_index": 2727,
            "start_ms": 5271380,
            "end_ms": 5274460,
            "text": "也再次感谢天天狼人app对我们节目的冠名"
          },
          {
            "index": 2728,
            "source_segment_index": 2728,
            "start_ms": 5274460,
            "end_ms": 5275570,
            "text": "大力支持"
          },
          {
            "index": 2729,
            "source_segment_index": 2729,
            "start_ms": 5275570,
            "end_ms": 5276810,
            "text": "也希望各位弹幕老师们"
          },
          {
            "index": 2730,
            "source_segment_index": 2730,
            "start_ms": 5276810,
            "end_ms": 5278190,
            "text": "能够来到我们各大应用平台"
          },
          {
            "index": 2731,
            "source_segment_index": 2731,
            "start_ms": 5278190,
            "end_ms": 5280170,
            "text": "搜索并下载天天狼人app"
          },
          {
            "index": 2732,
            "source_segment_index": 2732,
            "start_ms": 5280170,
            "end_ms": 5281730,
            "text": "就可以跟我们一起来玩游戏了"
          },
          {
            "index": 2733,
            "source_segment_index": 2733,
            "start_ms": 5281730,
            "end_ms": 5285040,
            "text": "同时也感谢一下我们本赛季的两名特约赞助商"
          },
          {
            "index": 2734,
            "source_segment_index": 2734,
            "start_ms": 5285040,
            "end_ms": 5286220,
            "text": "一个是我们的懒赤霞"
          },
          {
            "index": 2735,
            "source_segment_index": 2735,
            "start_ms": 5286220,
            "end_ms": 5288340,
            "text": "还有一个是我们柠檬共和国"
          },
          {
            "index": 2736,
            "source_segment_index": 2736,
            "start_ms": 5288340,
            "end_ms": 5290860,
            "text": "也希望各位弹幕老师们在观赛途中"
          },
          {
            "index": 2737,
            "source_segment_index": 2737,
            "start_ms": 5290860,
            "end_ms": 5291940,
            "text": "如果想要吃好喝好"
          },
          {
            "index": 2738,
            "source_segment_index": 2738,
            "start_ms": 5291940,
            "end_ms": 5294410,
            "text": "欢迎来到我们Y哥的主页橱窗内"
          },
          {
            "index": 2739,
            "source_segment_index": 2739,
            "start_ms": 5294410,
            "end_ms": 5296090,
            "text": "就可以随时下单补货了"
          },
          {
            "index": 2740,
            "source_segment_index": 2740,
            "start_ms": 5296090,
            "end_ms": 5296790,
            "text": "那么接下来"
          },
          {
            "index": 2741,
            "source_segment_index": 2741,
            "start_ms": 5296790,
            "end_ms": 5299040,
            "text": "导播老师会优先把镜头移交至我们第二现场"
          },
          {
            "index": 2742,
            "source_segment_index": 2742,
            "start_ms": 5301720,
            "end_ms": 5303160,
            "text": "稍后回来会是我们第二局"
          },
          {
            "index": 2743,
            "source_segment_index": 2743,
            "start_ms": 5303160,
            "end_ms": 5305320,
            "text": "维林是从一会见"
          },
          {
            "index": 2744,
            "source_segment_index": 2744,
            "start_ms": 5307880,
            "end_ms": 5310600,
            "text": "好我们柠檬共和国好喝啊"
          },
          {
            "index": 2745,
            "source_segment_index": 2745,
            "start_ms": 5310600,
            "end_ms": 5311540,
            "text": "新生活啊"
          },
          {
            "index": 2746,
            "source_segment_index": 2746,
            "start_ms": 5311540,
            "end_ms": 5313760,
