            "source_segment_index": 2694,
            "start_ms": 5211400,
            "end_ms": 5212620,
            "text": "神人阵营预言家"
          },
          {
            "index": 2695,
            "source_segment_index": 2695,
            "start_ms": 5212620,
            "end_ms": 5213440,
            "text": "9号女巫"
          },
          {
