      "end_ms": 3813695,
      "text": "他也知道换口是我为什么要投七号呀，",
      "source_segment_index": 1836,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_call_candidate",
      "start_ms": 3829265,
      "end_ms": 3830045,
      "text": "有请自我投票。",
      "source_segment_index": 1844,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3832945,
      "end_ms": 3834205,
      "text": "二号投给四号，",
      "source_segment_index": 1846,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_result_or_close_candidate",
      "start_ms": 3834265,
      "end_ms": 3841610,
      "text": "四号投给七号七号投给二号八号投给四号十一号投给四号投票结束，",
      "source_segment_index": 1847,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3834265,
      "end_ms": 3841610,
      "text": "四号投给七号七号投给二号八号投给四号十一号投给四号投票结束，",
      "source_segment_index": 1847,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_call_candidate",
      "start_ms": 3991575,
      "end_ms": 3993570,
      "text": "昨晚将请戴辉做好投票准备。",
      "source_segment_index": 1915,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_call_candidate",
      "start_ms": 3995775,
      "end_ms": 3998195,
      "text": "将请自由投票三二一，",
      "source_segment_index": 1917,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_result_or_close_candidate",
      "start_ms": 3999455,
      "end_ms": 4007810,
      "text": "二号投给七号四号投给二号七号投给二号八号投给二号十一号投给二号投票结束，",
      "source_segment_index": 1919,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3999455,
      "end_ms": 4007810,
      "text": "二号投给七号四号投给二号七号投给二号八号投给二号十一号投给二号投票结束，",
      "source_segment_index": 1919,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "death_or_night_result_candidate",
      "start_ms": 4009165,
      "end_ms": 4011765,
      "text": "二号玩家四票出局，",
      "source_segment_index": 1920,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "night_entry_or_night_command_candidate",
      "start_ms": 4111205,
      "end_ms": 4114035,
      "text": "天黑请闭眼嗯，",
      "source_segment_index": 1976,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "night_entry_or_night_command_candidate",
      "start_ms": 4118855,
      "end_ms": 4127760,
      "text": "第一夜钟没有八是最后一个十是乌龙出局的狼七是平民。",
      "source_segment_index": 1980,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "night_entry_or_night_command_candidate",
      "start_ms": 4165475,
      "end_ms": 4187270,
      "text": "女巫五号定序王子四号、魔术师九号、鬼术师八号狼人一号、六号十号、平民二号、三号、七号、十一号首夜鬼术师更换了一号和六号两名狼人的投票放出结果当夜魔术师空过狼吉莎沙九号魔术师女巫用药解救九号玩家形成平安夜，",
      "source_segment_index": 2003,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "night_entry_or_night_command_candidate",
      "start_ms": 4193535,
      "end_ms": 4193915,
      "text": "入夜，",
      "source_segment_index": 2006,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "death_or_night_result_candidate",
      "start_ms": 4211445,
      "end_ms": 4212950,
      "text": "十二号家被刀出局，",
      "source_segment_index": 2011,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "night_entry_or_night_command_candidate",
      "start_ms": 4218125,
      "end_ms": 4218670,
      "text": "入夜，",
      "source_segment_index": 2014,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "death_or_night_result_candidate",
      "start_ms": 4229565,
      "end_ms": 4231960,
      "text": "实际三号平民中毒出局。",
      "source_segment_index": 2018,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "death_or_night_result_candidate",
      "start_ms": 4235185,
      "end_ms": 4241820,
      "text": "第二天白天第呃第三天白天七号玩家高票十号玩家狼人被公投出局，",
      "source_segment_index": 2020,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "night_entry_or_night_command_candidate",
      "start_ms": 4242275,
      "end_ms": 4246295,
      "text": "入夜鬼术师更换了八号自己和十一号平民的放逐。",
