        "evidence": [
          {
            "index": 2826,
            "source_segment_index": 2826,
            "start_ms": 5546209,
            "end_ms": 5547069,
            "text": "他出局"
          },
          {
            "index": 2827,
            "source_segment_index": 2827,
            "start_ms": 5547069,
            "end_ms": 5548510,
            "text": "平安夜没守"
          },
          {
            "index": 2828,
            "source_segment_index": 2828,
            "start_ms": 5548510,
            "end_ms": 5550990,
            "text": "那不是他说那天晚上错了"
          },
          {
            "index": 2829,
            "source_segment_index": 2829,
            "start_ms": 5550990,
            "end_ms": 5552870,
            "text": "我忘记你是咋啦"
          },
          {
            "index": 2830,
            "source_segment_index": 2830,
            "start_ms": 5552870,
            "end_ms": 5554710,
            "text": "不是你气死我了"
          },
          {
            "index": 2831,
            "source_segment_index": 2831,
            "start_ms": 5554710,
            "end_ms": 5556730,
            "text": "你这个老死来好"
          },
          {
            "index": 2832,
            "source_segment_index": 2832,
            "start_ms": 5556730,
            "end_ms": 5558450,
            "text": "给各位弹幕老师们做本局游戏的复盘"
          },
          {
            "index": 2833,
            "source_segment_index": 2833,
            "start_ms": 5558450,
            "end_ms": 5560730,
            "text": "本剧版行为假面舞会神人阵营预言家"
          },
          {
            "index": 2834,
            "source_segment_index": 2834,
            "start_ms": 5560730,
            "end_ms": 5561490,
            "text": "6号女巫"
          },
          {
            "index": 2835,
            "source_segment_index": 2835,
            "start_ms": 5561490,
            "end_ms": 5562270,
            "text": "一号武者"
          },
          {
            "index": 2836,
            "source_segment_index": 2836,
            "start_ms": 5562270,
            "end_ms": 5562930,
            "text": "5号白神"
          },
          {
            "index": 2837,
            "source_segment_index": 2837,
            "start_ms": 5562930,
            "end_ms": 5565120,
            "text": "3号狼人阵营4号七号"
          },
          {
            "index": 2838,
            "source_segment_index": 2838,
            "start_ms": 5565120,
            "end_ms": 5566420,
            "text": "12号假面"
          },
          {
            "index": 2839,
            "source_segment_index": 2839,
            "start_ms": 5566420,
            "end_ms": 5569520,
            "text": "9号平民阵营2号八号"
          },
          {
            "index": 2840,
            "source_segment_index": 2840,
            "start_ms": 5569520,
            "end_ms": 5577630,
            "text": "10号11号首页狼人击杀7号狼人牛要救起"
          },
          {
            "index": 2841,
            "source_segment_index": 2841,
            "start_ms": 5577630,
            "end_ms": 5578690,
            "text": "形成平安夜"
          },
          {
            "index": 2842,
            "source_segment_index": 2842,
            "start_ms": 5578690,
            "end_ms": 5582870,
            "text": "预言家验证了11号玩家平民为好人身份"
          },
          {
            "index": 2843,
            "source_segment_index": 2843,
            "start_ms": 5582870,
            "end_ms": 5584390,
            "text": "在警上竞选环节"
          },
          {
            "index": 2844,
            "source_segment_index": 2844,
            "start_ms": 5584390,
            "end_ms": 5585750,
            "text": "6号预言家获得警徽"
          },
          {
            "index": 2845,
            "source_segment_index": 2845,
            "start_ms": 5585750,
            "end_ms": 5586430,
            "text": "第一天白天"
          },
          {
            "index": 2846,
            "source_segment_index": 2846,
            "start_ms": 5586430,
            "end_ms": 5588190,
            "text": "6号预言家被抗推出局"
          },
          {
            "index": 2847,
            "source_segment_index": 2847,
            "start_ms": 5588190,
            "end_ms": 5590800,
            "text": "警徽交至11号平民入夜"
          },
          {
            "index": 2848,
            "source_segment_index": 2848,
            "start_ms": 5590800,
            "end_ms": 5593620,
            "text": "舞者的舞池是3号白神"
          },
          {
            "index": 2849,
            "source_segment_index": 2849,
            "start_ms": 5593620,
            "end_ms": 5595140,
            "text": "8号平民"
          },
          {
            "index": 2850,
            "source_segment_index": 2850,
            "start_ms": 5595140,
            "end_ms": 5596940,
            "text": "12号狼人"
          },
          {
            "index": 2851,
            "source_segment_index": 2851,
            "start_ms": 5596940,
            "end_ms": 5600270,
            "text": "当夜假面验证了8号玩家"
          },
          {
            "index": 2852,
            "source_segment_index": 2852,
            "start_ms": 5600270,
            "end_ms": 5603430,
            "text": "平民在舞池内给予了8号平民一张面具"
          },
          {
            "index": 2853,
            "source_segment_index": 2853,
            "start_ms": 5603430,
            "end_ms": 5606960,
            "text": "此时五池内3号白神被五出局"
          },
          {
            "index": 2854,
            "source_segment_index": 2854,
            "start_ms": 5606960,
            "end_ms": 5608880,
            "text": "当夜狼人击杀一号女巫牛"
          },
          {
            "index": 2855,
            "source_segment_index": 2855,
            "start_ms": 5608880,
            "end_ms": 5610080,
            "text": "毒杀7号狼人"
          },
          {
            "index": 2856,
            "source_segment_index": 2856,
            "start_ms": 5610080,
            "end_ms": 5612790,
            "text": "当夜为一号3号七号多岛"
          },
          {
            "index": 2857,
            "source_segment_index": 2857,
            "start_ms": 5612790,
            "end_ms": 5613810,
            "text": "第二天白天"
          },
          {
            "index": 2858,
            "source_segment_index": 2858,
            "start_ms": 5613810,
            "end_ms": 5616090,
            "text": "9号假面被公投出局"
          },
          {
            "index": 2859,
            "source_segment_index": 2859,
            "start_ms": 5616090,
            "end_ms": 5618250,
            "text": "入野无止的舞池是2号平民"
          },
          {
            "index": 2860,
            "source_segment_index": 2860,
            "start_ms": 5618250,
            "end_ms": 5621040,
            "text": "5号舞者以及10号平民"
          },
          {
            "index": 2861,
            "source_segment_index": 2861,
            "start_ms": 5621040,
            "end_ms": 5623880,
            "text": "此时舞者在舞池内五池内免疫狼刀"
          },
          {
            "index": 2862,
            "source_segment_index": 2862,
            "start_ms": 5623880,
            "end_ms": 5625540,
            "text": "狼人击杀5号武者"
          },
          {
            "index": 2863,
            "source_segment_index": 2863,
            "start_ms": 5625540,
            "end_ms": 5626549,
            "text": "形成平安夜"
          },
          {
            "index": 2864,
            "source_segment_index": 2864,
            "start_ms": 5626549,
            "end_ms": 5627789,
            "text": "在第三天白天"
          },
          {
            "index": 2865,
            "source_segment_index": 2865,
            "start_ms": 5627789,
            "end_ms": 5629629,
            "text": "12号狼人选择自爆入夜"
          },
          {
            "index": 2866,
            "source_segment_index": 2866,
            "start_ms": 5629629,
            "end_ms": 5632050,
            "text": "狼人击杀场上最后一神"
          },
          {
            "index": 2867,
            "source_segment_index": 2867,
            "start_ms": 5632050,
            "end_ms": 5633850,
            "text": "5号舞者游戏结束"
          },
          {
            "index": 2868,
            "source_segment_index": 2868,
            "start_ms": 5633850,
            "end_ms": 5635650,
            "text": "狼人阵营屠神获胜"
          },
          {
            "index": 2869,
            "source_segment_index": 2869,
            "start_ms": 5635650,
            "end_ms": 5638490,
            "text": "以上是我们今天第二局假面舞会的全部内容"
          },
          {
            "index": 2870,
            "source_segment_index": 2870,
            "start_ms": 5638490,
            "end_ms": 5640379,
            "text": "非常感谢各位弹幕老师的陪伴"
          },
          {
            "index": 2871,
            "source_segment_index": 2871,
            "start_ms": 5640379,
            "end_ms": 5642979,
            "text": "这里是京城大师赛第21赛季"
          },
          {
            "index": 2872,
            "source_segment_index": 2872,
            "start_ms": 5642979,
            "end_ms": 5644519,
            "text": "鬼泣奇谭的直播现场"
          },
          {
            "index": 2873,
            "source_segment_index": 2873,
            "start_ms": 5644519,
            "end_ms": 5645859,
            "text": "再一次感谢天天狼人app"
          },
          {
            "index": 2874,
            "source_segment_index": 2874,
            "start_ms": 5645859,
            "end_ms": 5647559,
            "text": "对我们节目的冠名赞助支持"
          },
          {
            "index": 2875,
            "source_segment_index": 2875,
            "start_ms": 5647559,
            "end_ms": 5649759,
            "text": "同时感谢本赛季特约赞助商"
          },
          {
            "index": 2876,
            "source_segment_index": 2876,
            "start_ms": 5649759,
            "end_ms": 5651819,
            "text": "感谢柠檬共和国懒痴霞"
          },
          {
            "index": 2877,
            "source_segment_index": 2877,
            "start_ms": 5651819,
            "end_ms": 5653870,
            "text": "以及哈尼牧场对我们节目的支持"
          },
          {
            "index": 2878,
            "source_segment_index": 2878,
            "start_ms": 5653870,
            "end_ms": 5656610,
            "text": "各位家人们可以来到这位带师个人主页橱窗内"
          },
          {
            "index": 2879,
            "source_segment_index": 2879,
            "start_ms": 5656610,
            "end_ms": 5658200,
            "text": "随时进行下单补货"
          },
          {
            "index": 2880,
            "source_segment_index": 2880,
            "start_ms": 5658200,
            "end_ms": 5659580,
            "text": "同时感谢龙哥"
          },
          {
            "index": 2881,
            "source_segment_index": 2881,
            "start_ms": 5659580,
            "end_ms": 5660500,
            "text": "感谢阿喵"
          },
          {
            "index": 2882,
            "source_segment_index": 2882,
            "start_ms": 5660500,
            "end_ms": 5662300,
            "text": "感谢LISA老师给我的投食"
          },
          {
            "index": 2883,
            "source_segment_index": 2883,
            "start_ms": 5662300,
            "end_ms": 5664640,
            "text": "那么接下来导播老师会把镜头移交至我们"
          },
          {
            "index": 2884,
            "source_segment_index": 2884,
            "start_ms": 5664640,
            "end_ms": 5665280,
            "text": "第二现场"
          },
          {
            "index": 2885,
            "source_segment_index": 2885,
            "start_ms": 5667879,
            "end_ms": 5669479,
            "text": "稍后回来会是我们第三局"
          },
          {
            "index": 2886,
            "source_segment_index": 2886,
            "start_ms": 5669479,
            "end_ms": 5670419,
            "text": "机械狼通灵师"
          },
          {
            "index": 2887,
            "source_segment_index": 2887,
            "start_ms": 5670419,
            "end_ms": 5671719,
            "text": "一会见"
          },
          {
            "index": 2888,
            "source_segment_index": 2888,
            "start_ms": 5708400,
            "end_ms": 5709200,
            "text": "看一下啊"
          },
          {
            "index": 2889,
            "source_segment_index": 2889,
            "start_ms": 5709200,
            "end_ms": 5711750,
            "text": "这把这把怎么说"
          },
          {
            "index": 2890,
            "source_segment_index": 2890,
            "start_ms": 5711750,
            "end_ms": 5713750,
            "text": "其实我觉得一号5号"
          },
          {
            "index": 2891,
            "source_segment_index": 2891,
            "start_ms": 5713750,
            "end_ms": 5715670,
            "text": "11号这把游戏已经在猛C了"
          },
          {
            "index": 2892,
            "source_segment_index": 2892,
            "start_ms": 5715670,
            "end_ms": 5717830,
            "text": "是对都很都猛C"
          },
          {
            "index": 2893,
            "source_segment_index": 2893,
            "start_ms": 5717830,
            "end_ms": 5719460,
            "text": "你看一号救了7号"
          },
          {
            "index": 2894,
            "source_segment_index": 2894,
            "start_ms": 5719460,
            "end_ms": 5721340,
            "text": "不怎么自刀的歪哥"
          },
          {
            "index": 2895,
            "source_segment_index": 2895,
            "start_ms": 5721340,
            "end_ms": 5723940,
            "text": "其实这只能说是罕见了对"
          },
          {
            "index": 2896,
            "source_segment_index": 2896,
            "start_ms": 5723940,
            "end_ms": 5726800,
            "text": "直接说7号悍跳狼"
          },
          {
            "index": 2897,
            "source_segment_index": 2897,
            "start_ms": 5726800,
            "end_ms": 5728040,
            "text": "晚上送7号走"
          },
          {
            "index": 2898,
            "source_segment_index": 2898,
            "start_ms": 5729040,
            "end_ms": 5729950,
            "text": "对不对"
          },
          {
            "index": 2899,
            "source_segment_index": 2899,
            "start_ms": 5729950,
            "end_ms": 5732670,
            "text": "11号我们抛开一切"
          },
          {
            "index": 2900,
            "source_segment_index": 2900,
            "start_ms": 5732670,
            "end_ms": 5735150,
            "text": "首先他警徽我们投对了"
          },
          {
            "index": 2901,
            "source_segment_index": 2901,
            "start_ms": 5735150,
            "end_ms": 5737790,
            "text": "对放逐投票我们投对了"
          },
          {
            "index": 2902,
            "source_segment_index": 2902,
            "start_ms": 5737790,
            "end_ms": 5739460,
            "text": "在最关键的一头"
          },
          {
            "index": 2903,
            "source_segment_index": 2903,
            "start_ms": 5739460,
            "end_ms": 5740300,
            "text": "对不对"
          },
          {
            "index": 2904,
            "source_segment_index": 2904,
            "start_ms": 5740300,
            "end_ms": 5741780,
            "text": "他4号12号不投"
          },
          {
            "index": 2905,
            "source_segment_index": 2905,
            "start_ms": 5741780,
            "end_ms": 5744460,
            "text": "就在90里区分假面又投对了"
          },
          {
            "index": 2906,
            "source_segment_index": 2906,
            "start_ms": 5744460,
            "end_ms": 5745700,
            "text": "而且劝回了2号"
          },
          {
            "index": 2907,
            "source_segment_index": 2907,
            "start_ms": 5745700,
            "end_ms": 5746980,
            "text": "至少劝回了2号嘛"
          },
          {
            "index": 2908,
            "source_segment_index": 2908,
            "start_ms": 5746980,
            "end_ms": 5747760,
            "text": "对不对"
          },
          {
            "index": 2909,
            "source_segment_index": 2909,
            "start_ms": 5747760,
            "end_ms": 5752420,
            "text": "那5号其实其实大家我们在看这个狼人杀的话"
          },
          {
            "index": 2910,
            "source_segment_index": 2910,
            "start_ms": 5752420,
            "end_ms": 5756290,
            "text": "就是其实我们上帝这看上去是245必赢了"
          },
          {
            "index": 2911,
            "source_segment_index": 2911,
            "start_ms": 5756290,
            "end_ms": 5756770,
            "text": "对不对"
          },
          {
            "index": 2912,
            "source_segment_index": 2912,
            "start_ms": 5756770,
            "end_ms": 5757730,
            "text": "自己没被斗死"
          },
          {
            "index": 2913,
            "source_segment_index": 2913,
            "start_ms": 5757730,
            "end_ms": 5758630,
            "text": "4号还被捂死"
          },
          {
            "index": 2914,
            "source_segment_index": 2914,
            "start_ms": 5758630,
            "end_ms": 5760270,
            "text": "但是3号的身份也很关键"
          },
          {
            "index": 2915,
            "source_segment_index": 2915,
            "start_ms": 5760270,
            "end_ms": 5760950,
            "text": "对不对"
          },
          {
            "index": 2916,
            "source_segment_index": 2916,
            "start_ms": 5760950,
            "end_ms": 5762690,
            "text": "3号如果是明牌的话"
          },
          {
            "index": 2917,
            "source_segment_index": 2917,
            "start_ms": 5762690,
            "end_ms": 5767210,
            "text": "2号五号十号作为这个三个好人的话"
          },
          {
            "index": 2918,
            "source_segment_index": 2918,
            "start_ms": 5767210,
            "end_ms": 5769100,
            "text": "九是一个假面"
          },
          {
            "index": 2919,
            "source_segment_index": 2919,
            "start_ms": 5769100,
            "end_ms": 5770780,
            "text": "也是一样可以赢的"
          },
          {
            "index": 2920,
            "source_segment_index": 2920,
            "start_ms": 5770780,
            "end_ms": 5772120,
            "text": "如果说九是一个好人"
          },
          {
            "index": 2921,
            "source_segment_index": 2921,
            "start_ms": 5772120,
            "end_ms": 5773800,
            "text": "10号是一个假面"
          },
          {
            "index": 2922,
            "source_segment_index": 2922,
            "start_ms": 5773800,
            "end_ms": 5775710,
            "text": "把假面捂死的话"
          },
          {
            "index": 2923,
            "source_segment_index": 2923,
            "start_ms": 5775710,
            "end_ms": 5777370,
            "text": "5号又不不会被杀"
          },
          {
            "index": 2924,
            "source_segment_index": 2924,
            "start_ms": 5777370,
            "end_ms": 5779410,
            "text": "那这个也是能赢的"
          },
          {
            "index": 2925,
            "source_segment_index": 2925,
            "start_ms": 5779410,
            "end_ms": 5782650,
            "text": "所以就看当下5号怎么判断三的身份"
          },
          {
            "index": 2926,
            "source_segment_index": 2926,
            "start_ms": 5782650,
            "end_ms": 5783530,
            "text": "对不对"
          }
        ],
