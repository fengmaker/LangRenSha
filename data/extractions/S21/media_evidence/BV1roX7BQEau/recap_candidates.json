            "source_segment_index": 2450,
            "start_ms": 4898040,
            "end_ms": 4899120,
            "text": "3号六号"
          },
          {
            "index": 2451,
            "source_segment_index": 2451,
            "start_ms": 4899120,
            "end_ms": 4900000,
            "text": "12号平民"
          },
          {
            "index": 2452,
            "source_segment_index": 2452,
            "start_ms": 4900000,
            "end_ms": 4901160,
            "text": "2号五号十号"
          },
          {
            "index": 2453,
            "source_segment_index": 2453,
            "start_ms": 4901160,
            "end_ms": 4905790,
            "text": "11号守夜守卫守护5号平民狼人击杀11号平民女巫"
          },
          {
            "index": 2454,
            "source_segment_index": 2454,
            "start_ms": 4905790,
            "end_ms": 4906470,
            "text": "用药救起"
          },
          {
            "index": 2455,
            "source_segment_index": 2455,
            "start_ms": 4906470,
            "end_ms": 4907190,
            "text": "形成平安夜"
          },
          {
            "index": 2456,
            "source_segment_index": 2456,
            "start_ms": 4907190,
            "end_ms": 4909750,
            "text": "好入夜守卫守护8号通灵师"
          },
          {
            "index": 2457,
            "source_segment_index": 2457,
            "start_ms": 4909750,
            "end_ms": 4911190,
            "text": "狼人击杀8号行程"
          },
          {
            "index": 2458,
            "source_segment_index": 2458,
            "start_ms": 4911190,
            "end_ms": 4915690,
            "text": "平安夜当夜机械通灵验证7号玩家为猎人身份"
          },
          {
            "index": 2459,
            "source_segment_index": 2459,
            "start_ms": 4915690,
            "end_ms": 4919020,
            "text": "女巫通过通灵是验证3号玩家为狼人身份"
          },
          {
            "index": 2460,
            "source_segment_index": 2460,
            "start_ms": 4919020,
            "end_ms": 4919980,
            "text": "第二天延期"
          },
          {
            "index": 2461,
            "source_segment_index": 2461,
            "start_ms": 4919980,
            "end_ms": 4920800,
            "text": "精神紧张环节"
          },
          {
            "index": 2462,
            "source_segment_index": 2462,
            "start_ms": 4920800,
            "end_ms": 4922400,
            "text": "12号狼人自爆"
          },
          {
            "index": 2463,
            "source_segment_index": 2463,
            "start_ms": 4922400,
            "end_ms": 4923680,
            "text": "本游戏警徽流失"
          },
          {
            "index": 2464,
            "source_segment_index": 2464,
            "start_ms": 4923680,
            "end_ms": 4925740,
            "text": "入夜守卫守护7号猎人"
          },
          {
            "index": 2465,
            "source_segment_index": 2465,
            "start_ms": 4925740,
            "end_ms": 4926440,
            "text": "狼人追刀"
          },
          {
            "index": 2466,
            "source_segment_index": 2466,
            "start_ms": 4926440,
            "end_ms": 4927600,
            "text": "8号通灵师"
          },
          {
            "index": 2467,
            "source_segment_index": 2467,
            "start_ms": 4927600,
            "end_ms": 4930480,
            "text": "机械通灵师验证2号玩家为平民身份"
          },
          {
            "index": 2468,
            "source_segment_index": 2468,
            "start_ms": 4930480,
            "end_ms": 4933660,
            "text": "女巫通过通灵实验证7号玩家为猎人身份"
          },
          {
            "index": 2469,
            "source_segment_index": 2469,
            "start_ms": 4933660,
            "end_ms": 4934480,
            "text": "第三天八天"
          },
          {
            "index": 2470,
            "source_segment_index": 2470,
            "start_ms": 4934480,
            "end_ms": 4936780,
            "text": "2号平民被抗推出局"
          },
          {
            "index": 2471,
            "source_segment_index": 2471,
            "start_ms": 4936780,
            "end_ms": 4942730,
            "text": "入夜守卫守护一号女巫狼人击杀10号平民女巫毒杀9号机械通灵师"
          },
          {
            "index": 2472,
            "source_segment_index": 2472,
            "start_ms": 4942730,
            "end_ms": 4945490,
            "text": "机械通灵师验证10号玩家为平民身份"
          },
          {
            "index": 2473,
            "source_segment_index": 2473,
            "start_ms": 4945490,
            "end_ms": 4946930,
            "text": "第四天白天"
          },
          {
            "index": 2474,
            "source_segment_index": 2474,
            "start_ms": 4946930,
            "end_ms": 4948850,
            "text": "7号猎人被抗推出局"
          },
          {
            "index": 2475,
            "source_segment_index": 2475,
            "start_ms": 4948850,
            "end_ms": 4950610,
            "text": "发动技能带走最后一张狼人"
          },
          {
            "index": 2476,
            "source_segment_index": 2476,
            "start_ms": 4950610,
            "end_ms": 4952110,
            "text": "3号游戏结束"
          },
          {
            "index": 2477,
            "source_segment_index": 2477,
            "start_ms": 4952110,
            "end_ms": 4954010,
            "text": "好人阵营获胜"
          },
          {
            "index": 2478,
            "source_segment_index": 2478,
            "start_ms": 4954730,
            "end_ms": 4957650,
            "text": "好您正在收看的节目是京城大师赛第21季"
          },
          {
            "index": 2479,
            "source_segment_index": 2479,
            "start_ms": 4957650,
            "end_ms": 4958130,
            "text": "魁奇奇谭"
          },
          {
            "index": 2480,
            "source_segment_index": 2480,
            "start_ms": 4958130,
            "end_ms": 4958770,
            "text": "各位大众老师们"
          },
          {
            "index": 2481,
            "source_segment_index": 2481,
            "start_ms": 4958770,
            "end_ms": 4962680,
            "text": "京城大师赛第21季是由天天狼人app冠名赞助播出的"
          },
          {
            "index": 2482,
            "source_segment_index": 2482,
            "start_ms": 4962680,
            "end_ms": 4966600,
            "text": "欢迎各位弹幕老师们到各大应用商店搜索并下载天天狼人APP"
          },
          {
            "index": 2483,
            "source_segment_index": 2483,
            "start_ms": 4966600,
            "end_ms": 4967840,
            "text": "来跟我们一起玩狼人杀游戏"
          },
          {
            "index": 2484,
            "source_segment_index": 2484,
            "start_ms": 4967840,
            "end_ms": 4973300,
            "text": "也同时特别感谢懒赤霞以及柠檬共和国对本节目的特约赞助"
          },
          {
            "index": 2485,
            "source_segment_index": 2485,
            "start_ms": 4973300,
            "end_ms": 4976600,
            "text": "欢迎各位弹幕老师们到我们JY大师的主页橱窗当中"
          },
          {
            "index": 2486,
            "source_segment_index": 2486,
            "start_ms": 4976600,
            "end_ms": 4980740,
            "text": "来选购我们的蓝之霞以及我们柠檬共和国的产品"
          },
          {
            "index": 2487,
            "source_segment_index": 2487,
            "start_ms": 4980740,
            "end_ms": 4981380,
            "text": "另外呢"
          },
          {
            "index": 2488,
            "source_segment_index": 2488,
            "start_ms": 4981380,
            "end_ms": 4984060,
            "text": "我们京城大厦2026高校联赛的报名"
          },
          {
            "index": 2489,
            "source_segment_index": 2489,
            "start_ms": 4984060,
            "end_ms": 4987220,
            "text": "还剩下大概30多分钟就要截止了"
          },
          {
            "index": 2490,
            "source_segment_index": 2490,
            "start_ms": 4987220,
            "end_ms": 4991110,
            "text": "我们在今天的12点整会准时的关闭我们的报名通道"
          },
          {
            "index": 2491,
            "source_segment_index": 2491,
            "start_ms": 4991110,
            "end_ms": 4992870,
            "text": "晋城大师2026高校联赛"
          },
          {
            "index": 2492,
            "source_segment_index": 2492,
            "start_ms": 4992870,
            "end_ms": 4995990,
            "text": "第一赛段的海选赛正在如火如荼的进行当中"
          },
          {
            "index": 2493,
            "source_segment_index": 2493,
            "start_ms": 4995990,
            "end_ms": 4999040,
            "text": "最后的报名阶段就是最后的这不到一个小时的时间"
          },
          {
            "index": 2494,
            "source_segment_index": 2494,
            "start_ms": 4999040,
            "end_ms": 5001460,
            "text": "然后明天是我们这一赛段的最后一天"
          },
          {
            "index": 2495,
            "source_segment_index": 2495,
            "start_ms": 5001460,
            "end_ms": 5005330,
            "text": "然后我们这一赛段呢都是在我们的天天狼app上线上进行的"
          },
          {
            "index": 2496,
            "source_segment_index": 2496,
            "start_ms": 5005330,
            "end_ms": 5010490,
            "text": "所以无论各位是正在就读于专科或本科的或者研究生的高校学子"
          },
          {
            "index": 2497,
            "source_segment_index": 2497,
            "start_ms": 5010490,
            "end_ms": 5012030,
            "text": "一定不要错过这次机会"
          },
          {
            "index": 2498,
            "source_segment_index": 2498,
            "start_ms": 5012030,
            "end_ms": 5013590,
            "text": "无论你身在哪个城市"
          },
          {
            "index": 2499,
            "source_segment_index": 2499,
            "start_ms": 5013590,
            "end_ms": 5014150,
            "text": "哪个国家"
          },
          {
            "index": 2500,
            "source_segment_index": 2500,
            "start_ms": 5014150,
            "end_ms": 5017990,
            "text": "都可以在通过线上的方式先参与到我们这次海选当中"
          },
          {
            "index": 2501,
            "source_segment_index": 2501,
            "start_ms": 5017990,
            "end_ms": 5020750,
            "text": "然后我们在第一整个赛段都是在天天狼人"
          },
          {
            "index": 2502,
            "source_segment_index": 2502,
            "start_ms": 5020750,
            "end_ms": 5022760,
            "text": "我们明天结束之后会有一次晋级"
          }
        ],
