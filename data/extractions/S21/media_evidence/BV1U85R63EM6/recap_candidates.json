          {
            "index": 2844,
            "source_segment_index": 2844,
            "start_ms": 5299170,
            "end_ms": 5300890,
            "text": "那天直接到二五"
          },
          {
            "index": 2845,
            "source_segment_index": 2845,
            "start_ms": 5300890,
            "end_ms": 5302330,
            "text": "大二五死了"
          },
          {
            "index": 2846,
            "source_segment_index": 2846,
            "start_ms": 5302330,
            "end_ms": 5303250,
            "text": "到二五死"
          },
          {
            "index": 2847,
            "source_segment_index": 2847,
            "start_ms": 5303250,
            "end_ms": 5305040,
            "text": "就说他是生梦呗"
          },
          {
            "index": 2848,
            "source_segment_index": 2848,
            "start_ms": 5305040,
            "end_ms": 5306880,
            "text": "好第二局游戏结束了"
          },
          {
            "index": 2849,
            "source_segment_index": 2849,
            "start_ms": 5306880,
            "end_ms": 5308920,
            "text": "本游戏盗宝大师版型通灵师"
          },
          {
            "index": 2850,
            "source_segment_index": 2850,
            "start_ms": 5308920,
            "end_ms": 5309640,
            "text": "6号猎人"
          },
          {
            "index": 2851,
            "source_segment_index": 2851,
            "start_ms": 5309640,
            "end_ms": 5310560,
            "text": "12号圣梦人"
          },
          {
            "index": 2852,
            "source_segment_index": 2852,
            "start_ms": 5310560,
            "end_ms": 5311560,
            "text": "2号蒙面人"
          },
          {
            "index": 2853,
            "source_segment_index": 2853,
            "start_ms": 5311560,
            "end_ms": 5312710,
            "text": "3号狼王"
          },
          {
            "index": 2854,
            "source_segment_index": 2854,
            "start_ms": 5312710,
            "end_ms": 5313470,
            "text": "5号狼人"
          },
          {
            "index": 2855,
            "source_segment_index": 2855,
            "start_ms": 5313470,
            "end_ms": 5314490,
            "text": "9号十号"
          },
          {
            "index": 2856,
            "source_segment_index": 2856,
            "start_ms": 5314490,
            "end_ms": 5316870,
            "text": "本游戏的盗宝大师为8号"
          },
          {
            "index": 2857,
            "source_segment_index": 2857,
            "start_ms": 5316870,
            "end_ms": 5317950,
            "text": "隶属狼人阵营"
          },
          {
            "index": 2858,
            "source_segment_index": 2858,
            "start_ms": 5317950,
            "end_ms": 5320210,
            "text": "可以选择底牌为平民和毒师"
          },
          {
            "index": 2859,
            "source_segment_index": 2859,
            "start_ms": 5320210,
            "end_ms": 5322730,
            "text": "平民一号4号七号11号"
          },
          {
            "index": 2860,
            "source_segment_index": 2860,
            "start_ms": 5322730,
            "end_ms": 5326620,
            "text": "首页圣梦人梦游8号盗宝大师"
          },
          {
            "index": 2861,
            "source_segment_index": 2861,
            "start_ms": 5326620,
            "end_ms": 5329280,
            "text": "盗宝大师选择毒师身份毒杀6号通灵师"
          },
          {
            "index": 2862,
            "source_segment_index": 2862,
            "start_ms": 5329280,
            "end_ms": 5332059,
            "text": "通灵师验证3号玩家为蒙面人身份"
          },
          {
            "index": 2863,
            "source_segment_index": 2863,
            "start_ms": 5332059,
            "end_ms": 5333299,
            "text": "上警环节"
          },
          {
            "index": 2864,
            "source_segment_index": 2864,
            "start_ms": 5333299,
            "end_ms": 5335159,
            "text": "6号通灵师获得警徽"
          },
          {
            "index": 2865,
            "source_segment_index": 2865,
            "start_ms": 5335159,
            "end_ms": 5335779,
            "text": "6号出局"
          },
          {
            "index": 2866,
            "source_segment_index": 2866,
            "start_ms": 5335779,
            "end_ms": 5338080,
            "text": "将警徽移交至3号蒙面人"
          },
          {
            "index": 2867,
            "source_segment_index": 2867,
            "start_ms": 5338080,
            "end_ms": 5339040,
            "text": "第一天白天"
          },
          {
            "index": 2868,
            "source_segment_index": 2868,
            "start_ms": 5339040,
            "end_ms": 5341100,
            "text": "8号盗宝大师被公投出局"
          },
          {
            "index": 2869,
            "source_segment_index": 2869,
            "start_ms": 5341100,
            "end_ms": 5342160,
            "text": "入夜圣梦人梦游"
          },
          {
            "index": 2870,
            "source_segment_index": 2870,
            "start_ms": 5342160,
            "end_ms": 5343150,
            "text": "5号狼王"
          },
          {
            "index": 2871,
            "source_segment_index": 2871,
            "start_ms": 5343150,
            "end_ms": 5345070,
            "text": "狼人击杀3号蒙面人"
          },
          {
            "index": 2872,
            "source_segment_index": 2872,
            "start_ms": 5345070,
            "end_ms": 5348990,
            "text": "第二天白天5号狼王自爆入夜射梦人"
          },
          {
            "index": 2873,
            "source_segment_index": 2873,
            "start_ms": 5348990,
            "end_ms": 5351100,
            "text": "梦游9号狼人"
          },
          {
            "index": 2874,
            "source_segment_index": 2874,
            "start_ms": 5351100,
            "end_ms": 5353280,
            "text": "狼人击杀12号猎人"
          },
          {
            "index": 2875,
            "source_segment_index": 2875,
            "start_ms": 5353280,
            "end_ms": 5353940,
            "text": "猎人出局"
          },
          {
            "index": 2876,
            "source_segment_index": 2876,
            "start_ms": 5353940,
            "end_ms": 5355740,
            "text": "发动技能带走9号狼人"
          },
          {
            "index": 2877,
            "source_segment_index": 2877,
            "start_ms": 5355740,
            "end_ms": 5356220,
            "text": "最后一狼"
          },
          {
            "index": 2878,
            "source_segment_index": 2878,
            "start_ms": 5356220,
            "end_ms": 5357200,
            "text": "10号选择交牌"
          },
          {
            "index": 2879,
            "source_segment_index": 2879,
            "start_ms": 5357200,
            "end_ms": 5357980,
            "text": "游戏结束"
          },
          {
            "index": 2880,
            "source_segment_index": 2880,
            "start_ms": 5357980,
            "end_ms": 5359469,
            "text": "好人阵营获胜"
          },
          {
            "index": 2881,
            "source_segment_index": 2881,
            "start_ms": 5359469,
            "end_ms": 5362329,
            "text": "好京城大赛第21季会聚集团"
          },
          {
            "index": 2882,
            "source_segment_index": 2882,
            "start_ms": 5362329,
            "end_ms": 5363029,
            "text": "各位大宝老师们"
          },
          {
            "index": 2883,
            "source_segment_index": 2883,
            "start_ms": 5363029,
            "end_ms": 5365789,
            "text": "京城大赛第21季是由天天狼人app冠名赞助"
          },
          {
            "index": 2884,
            "source_segment_index": 2884,
            "start_ms": 5365789,
            "end_ms": 5366380,
            "text": "播出的"
          },
          {
            "index": 2885,
            "source_segment_index": 2885,
            "start_ms": 5366380,
            "end_ms": 5366700,
            "text": "同时"
          },
          {
            "index": 2886,
            "source_segment_index": 2886,
            "start_ms": 5366700,
            "end_ms": 5370300,
            "text": "要特别感谢懒痴霞哈尼牧场以及柠檬共和国"
          },
          {
            "index": 2887,
            "source_segment_index": 2887,
            "start_ms": 5370300,
            "end_ms": 5372040,
            "text": "对于本节目的大力支持"
          },
          {
            "index": 2888,
            "source_segment_index": 2888,
            "start_ms": 5372040,
            "end_ms": 5375460,
            "text": "我们这一周是我们第21届的决赛周"
          },
          {
            "index": 2889,
            "source_segment_index": 2889,
            "start_ms": 5375460,
            "end_ms": 5376560,
            "text": "今天是倒数第二天"
          },
          {
            "index": 2890,
            "source_segment_index": 2890,
            "start_ms": 5376560,
            "end_ms": 5378280,
            "text": "欢迎各位大老师们持续关注"
          },
          {
            "index": 2891,
            "source_segment_index": 2891,
            "start_ms": 5378280,
            "end_ms": 5379360,
            "text": "我们这一次的决赛周"
          },
          {
            "index": 2892,
            "source_segment_index": 2892,
            "start_ms": 5379360,
            "end_ms": 5381340,
            "text": "一起来见证冠军的诞生"
          },
          {
            "index": 2893,
            "source_segment_index": 2893,
            "start_ms": 5381340,
            "end_ms": 5383640,
            "text": "接下来我们会把镜头给到第二现场的解说老师"
          },
          {
            "index": 2894,
            "source_segment_index": 2894,
            "start_ms": 5383640,
            "end_ms": 5385440,
            "text": "稍后回来是我们今天的第三局游戏"
          },
          {
            "index": 2895,
            "source_segment_index": 2895,
            "start_ms": 5385440,
            "end_ms": 5387280,
            "text": "机械狼通灵师"
          },
          {
            "index": 2896,
            "source_segment_index": 2896,
            "start_ms": 5391220,
            "end_ms": 5393180,
            "text": "好人也是相互配合嘛对吧"
          },
          {
            "index": 2897,
            "source_segment_index": 2897,
            "start_ms": 5393180,
            "end_ms": 5394300,
            "text": "就互相信任"
          },
          {
            "index": 2898,
            "source_segment_index": 2898,
            "start_ms": 5394300,
            "end_ms": 5397340,
            "text": "你看12号他其实发言阶段其实是错的"
          },
          {
            "index": 2899,
            "source_segment_index": 2899,
            "start_ms": 5397340,
            "end_ms": 5398660,
            "text": "但是修正的很快"
          },
          {
            "index": 2900,
            "source_segment_index": 2900,
            "start_ms": 5398660,
            "end_ms": 5400340,
            "text": "毕竟一号发言对吧"
          },
          {
            "index": 2901,
            "source_segment_index": 2901,
            "start_ms": 5400340,
            "end_ms": 5401620,
            "text": "2号发言很正"
          },
          {
            "index": 2902,
            "source_segment_index": 2902,
            "start_ms": 5401620,
            "end_ms": 5403180,
            "text": "3号也把警徽飞给二了"
          },
          {
            "index": 2903,
            "source_segment_index": 2903,
            "start_ms": 5403180,
            "end_ms": 5404540,
            "text": "所以我觉得还是很好"
          },
          {
            "index": 2904,
            "source_segment_index": 2904,
            "start_ms": 5404540,
            "end_ms": 5406130,
            "text": "大家就是没有犯错误"
          },
          {
            "index": 2905,
            "source_segment_index": 2905,
            "start_ms": 5406130,
            "end_ms": 5407810,
            "text": "对我们夸夸队也要上线了"
          },
          {
            "index": 2906,
            "source_segment_index": 2906,
            "start_ms": 5407810,
            "end_ms": 5410510,
            "text": "本期其实从一号鹏鹏很关键"
          },
          {
            "index": 2907,
            "source_segment_index": 2907,
            "start_ms": 5410510,
            "end_ms": 5411430,
            "text": "听发言很细"
          },
          {
            "index": 2908,
            "source_segment_index": 2908,
            "start_ms": 5411430,
            "end_ms": 5414050,
            "text": "因为他已经坐实一个外置公共好人位置了"
          },
          {
            "index": 2909,
            "source_segment_index": 2909,
            "start_ms": 5414050,
            "end_ms": 5416130,
            "text": "他的发言其实也会影响着好人的判断"
          },
          {
            "index": 2910,
            "source_segment_index": 2910,
            "start_ms": 5416130,
            "end_ms": 5418800,
            "text": "就比如说像第一局这个诅咒老师"
          },
          {
            "index": 2911,
            "source_segment_index": 2911,
            "start_ms": 5418800,
            "end_ms": 5420960,
            "text": "影响了这个图图的判断对吧"
          },
          {
            "index": 2912,
            "source_segment_index": 2912,
            "start_ms": 5420960,
            "end_ms": 5424060,
            "text": "劝说因为确实九在那一轮可能有点瑕疵吧"
          },
          {
            "index": 2913,
            "source_segment_index": 2913,
            "start_ms": 5424060,
            "end_ms": 5427840,
            "text": "嗯然后一号3号呢救赎是12对吧"
          },
          {
            "index": 2914,
            "source_segment_index": 2914,
            "start_ms": 5427840,
            "end_ms": 5430120,
            "text": "尤其是很关键的是救赎我们猎人"
          },
          {
            "index": 2915,
            "source_segment_index": 2915,
            "start_ms": 5430120,
            "end_ms": 5431340,
            "text": "因为猎人开枪"
          },
          {
            "index": 2916,
            "source_segment_index": 2916,
            "start_ms": 5431340,
            "end_ms": 5433100,
            "text": "我们刚才已经跟大家讲了"
          },
          {
            "index": 2917,
            "source_segment_index": 2917,
            "start_ms": 5433100,
            "end_ms": 5434420,
            "text": "如果他开枪没有带到狼"
          },
          {
            "index": 2918,
            "source_segment_index": 2918,
            "start_ms": 5434420,
            "end_ms": 5435580,
            "text": "这把狼人就会赢"
          },
          {
            "index": 2919,
            "source_segment_index": 2919,
            "start_ms": 5435580,
            "end_ms": 5438100,
            "text": "所以是猎人这一枪非常关键"
          },
          {
            "index": 2920,
            "source_segment_index": 2920,
            "start_ms": 5438100,
            "end_ms": 5443690,
            "text": "对其实就是3号确实很就是很给力对吧"
          },
          {
            "index": 2921,
            "source_segment_index": 2921,
            "start_ms": 5443690,
            "end_ms": 5445810,
            "text": "就是很有这种责任意识"
          },
          {
            "index": 2922,
            "source_segment_index": 2922,
            "start_ms": 5445810,
            "end_ms": 5447170,
            "text": "单票归八呃"
          },
          {
            "index": 2923,
            "source_segment_index": 2923,
            "start_ms": 5447170,
            "end_ms": 5448610,
            "text": "警徽飞二啊"
          },
          {
            "index": 2924,
            "source_segment_index": 2924,
            "start_ms": 5448610,
            "end_ms": 5450930,
            "text": "就是非常的人狠话不多了"
          },
          {
            "index": 2925,
            "source_segment_index": 2925,
            "start_ms": 5450930,
            "end_ms": 5457170,
            "text": "就是犹豫就已经决定自己要就是怎么飞了是吧"
          },
          {
            "index": 2926,
            "source_segment_index": 2926,
            "start_ms": 5457170,
            "end_ms": 5460650,
            "text": "就是不想就是把机会留给自己了"
          },
          {
            "index": 2927,
            "source_segment_index": 2927,
            "start_ms": 5460650,
            "end_ms": 5462790,
            "text": "其实我感觉更多是一种感觉吧"
          },
          {
            "index": 2928,
            "source_segment_index": 2928,
            "start_ms": 5462790,
            "end_ms": 5466520,
            "text": "好但是歪哥本酒细依然超模啊"
          },
          {
            "index": 2929,
            "source_segment_index": 2929,
            "start_ms": 5466520,
            "end_ms": 5467520,
            "text": "非常厉害"
          },
          {
            "index": 2930,
            "source_segment_index": 2930,
            "start_ms": 5467520,
            "end_ms": 5468340,
            "text": "依然超模"
          },
          {
            "index": 2931,
            "source_segment_index": 2931,
            "start_ms": 5468340,
            "end_ms": 5469560,
            "text": "但是实话啊"
          },
          {
            "index": 2932,
            "source_segment_index": 2932,
            "start_ms": 5469560,
            "end_ms": 5470800,
            "text": "这把其实我自己觉得"
          },
          {
            "index": 2933,
            "source_segment_index": 2933,
            "start_ms": 5470800,
            "end_ms": 5472860,
            "text": "峰哥这个操作其实挺厉害的"
          },
          {
            "index": 2934,
            "source_segment_index": 2934,
            "start_ms": 5472860,
            "end_ms": 5474060,
            "text": "呃在狼人视角呢"
          },
          {
            "index": 2935,
            "source_segment_index": 2935,
            "start_ms": 5474060,
            "end_ms": 5475660,
            "text": "我觉得8号第一天已经打很帅"
          },
          {
            "index": 2936,
            "source_segment_index": 2936,
            "start_ms": 5475660,
            "end_ms": 5477660,
            "text": "包括他刚才上来跟我们有探讨嘛"
          },
          {
            "index": 2937,
            "source_segment_index": 2937,
            "start_ms": 5477660,
            "end_ms": 5478760,
            "text": "对我们跟他说"
          },
          {
            "index": 2938,
            "source_segment_index": 2938,
            "start_ms": 5478760,
            "end_ms": 5480600,
            "text": "其实狼这把赢还是很难"
          },
          {
            "index": 2939,
            "source_segment_index": 2939,
            "start_ms": 5480600,
            "end_ms": 5483000,
            "text": "但是呢你第一天已经打出你的气势了"
          },
          {
            "index": 2940,
            "source_segment_index": 2940,
            "start_ms": 5483000,
            "end_ms": 5483820,
            "text": "已经很帅了"
          }
        ],
