      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "night_entry_or_night_command_candidate",
      "start_ms": 4215940,
      "end_ms": 4218150,
      "text": "一天黑请闭眼",
      "source_segment_index": 2159,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "death_or_night_result_candidate",
      "start_ms": 4387620,
      "end_ms": 4389280,
      "text": "4号十号倒牌",
      "source_segment_index": 2228,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "death_or_night_result_candidate",
      "start_ms": 4390080,
      "end_ms": 4396469,
      "text": "受发动技能543214号10号请灭灯离场",
