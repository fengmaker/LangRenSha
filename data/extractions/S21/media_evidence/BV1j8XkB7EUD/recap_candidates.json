      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 5437650,
      "end_ms": 5438610,
      "text": "就投5号是可以赢的",
      "source_segment_index": 2763,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 5438610,
