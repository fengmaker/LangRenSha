        "evidence": [
          {
            "index": 1518,
            "source_segment_index": 1518,
            "start_ms": 3075820,
            "end_ms": 3077080,
            "text": "最好是离我对面"
          },
          {
            "index": 1519,
            "source_segment_index": 1519,
            "start_ms": 3077080,
            "end_ms": 3079440,
            "text": "因为我怕那个输出太激烈了"
          },
          {
            "index": 1520,
            "source_segment_index": 1520,
            "start_ms": 3079440,
            "end_ms": 3081620,
            "text": "以后跳开几个人都轮不到我"
          },
          {
            "index": 1521,
            "source_segment_index": 1521,
            "start_ms": 3081620,
            "end_ms": 3083670,
            "text": "大赛第21季回去谈"
          },
          {
            "index": 1522,
            "source_segment_index": 1522,
            "start_ms": 3083670,
            "end_ms": 3086110,
            "text": "我们正在进行今天的第三局游戏"
          },
          {
            "index": 1523,
            "source_segment_index": 1523,
            "start_ms": 3086110,
            "end_ms": 3087470,
            "text": "版型为机械狼通灵师"
          },
          {
            "index": 1524,
            "source_segment_index": 1524,
            "start_ms": 3087470,
            "end_ms": 3089830,
            "text": "我们继续第一轮的放逐发言环节"
          },
          {
            "index": 1525,
            "source_segment_index": 1525,
            "start_ms": 3089830,
            "end_ms": 3092350,
            "text": "接下来有请9号玩家发言"
          },
          {
            "index": 1526,
            "source_segment_index": 1526,
            "start_ms": 3095520,
            "end_ms": 3097000,
            "text": "9号"
          },
          {
            "index": 1527,
            "source_segment_index": 1527,
            "start_ms": 3100240,
            "end_ms": 3103620,
            "text": "嗯如果你们站边一先试图"
          },
          {
            "index": 1528,
            "source_segment_index": 1528,
            "start_ms": 3103620,
            "end_ms": 3106850,
            "text": "我知道我先因为我被踩的很在坑里了嘛"
          },
          {
            "index": 1529,
            "source_segment_index": 1529,
            "start_ms": 3106850,
            "end_ms": 3110410,
            "text": "先试图把我从七的团队里面剖析剖析开来"
          },
          {
            "index": 1530,
            "source_segment_index": 1530,
            "start_ms": 3110410,
            "end_ms": 3112450,
            "text": "然后如果一号玩家你是通灵师的话"
          },
          {
            "index": 1531,
            "source_segment_index": 1531,
            "start_ms": 3112450,
            "end_ms": 3113410,
            "text": "你必须得验我"
          },
          {
            "index": 1532,
            "source_segment_index": 1532,
            "start_ms": 3113410,
            "end_ms": 3114170,
            "text": "因为你不验我的话"
          },
          {
            "index": 1533,
            "source_segment_index": 1533,
            "start_ms": 3114170,
            "end_ms": 3115620,
            "text": "我感觉我一定被抗推走了"
          },
          {
            "index": 1534,
            "source_segment_index": 1534,
            "start_ms": 3115620,
            "end_ms": 3117620,
            "text": "守如果今天七因为我算了一下票"
          },
          {
            "index": 1535,
            "source_segment_index": 1535,
            "start_ms": 3117620,
            "end_ms": 3119220,
            "text": "我觉得7号玩家今天肯定出局了"
          },
          {
            "index": 1536,
            "source_segment_index": 1536,
            "start_ms": 3119220,
            "end_ms": 3120900,
            "text": "所以守卫你就去守一啊"
          },
          {
            "index": 1537,
            "source_segment_index": 1537,
            "start_ms": 3120900,
            "end_ms": 3122060,
            "text": "你把一号玩家守住"
          },
          {
            "index": 1538,
            "source_segment_index": 1538,
            "start_ms": 3122060,
            "end_ms": 3124500,
            "text": "然后一号玩家只要你能证明我的好人身份"
          },
          {
            "index": 1539,
            "source_segment_index": 1539,
            "start_ms": 3124500,
            "end_ms": 3126120,
            "text": "要不然我肯定是吃扛推了"
          },
          {
            "index": 1540,
            "source_segment_index": 1540,
            "start_ms": 3126120,
            "end_ms": 3127500,
            "text": "我觉得应该是我站错边了"
          },
          {
            "index": 1541,
            "source_segment_index": 1541,
            "start_ms": 3127500,
            "end_ms": 3128380,
            "text": "要不然怎么会有外置位"
          },
          {
            "index": 1542,
            "source_segment_index": 1542,
            "start_ms": 3128380,
            "end_ms": 3131760,
            "text": "这么多人拿我去塞到这个六七的团队里面去呢"
          },
          {
            "index": 1543,
            "source_segment_index": 1543,
            "start_ms": 3131760,
            "end_ms": 3134400,
            "text": "而且确实我听六的独立发言比较像狼人"
          },
          {
            "index": 1544,
            "source_segment_index": 1544,
            "start_ms": 3134400,
            "end_ms": 3136460,
            "text": "然后关于四五提出提"
          },
          {
            "index": 1545,
            "source_segment_index": 1545,
            "start_ms": 3136460,
            "end_ms": 3138060,
            "text": "同时对我提出那个观点"
          },
          {
            "index": 1546,
            "source_segment_index": 1546,
            "start_ms": 3138060,
            "end_ms": 3140220,
            "text": "我说的原话就是7号玩家"
          },
          {
            "index": 1547,
            "source_segment_index": 1547,
            "start_ms": 3140220,
            "end_ms": 3141340,
            "text": "至少我跟他玩这么久"
          },
          {
            "index": 1548,
            "source_segment_index": 1548,
            "start_ms": 3141340,
            "end_ms": 3143020,
            "text": "没有就是拉杆拉错过"
          },
          {
            "index": 1549,
            "source_segment_index": 1549,
            "start_ms": 3143020,
            "end_ms": 3145660,
            "text": "但一号玩家在我印象中有过这种问题"
          },
          {
            "index": 1550,
            "source_segment_index": 1550,
            "start_ms": 3145660,
            "end_ms": 3147500,
            "text": "所以我觉得那一号玩家爆爆"
          },
          {
            "index": 1551,
            "source_segment_index": 1551,
            "start_ms": 3147500,
            "end_ms": 3150439,
            "text": "就是如果一号玩家报错了12的身份"
          },
          {
            "index": 1552,
            "source_segment_index": 1552,
            "start_ms": 3150439,
            "end_ms": 3152319,
            "text": "或者一号玩家报对的12身份"
          },
          {
            "index": 1553,
            "source_segment_index": 1553,
            "start_ms": 3152319,
            "end_ms": 3154259,
            "text": "是不是相相比于7号家的力度大一点"
          },
          {
            "index": 1554,
            "source_segment_index": 1554,
            "start_ms": 3154259,
            "end_ms": 3156399,
            "text": "然后关于那个安MMM平票pk那个东西"
          },
          {
            "index": 1555,
            "source_segment_index": 1555,
            "start_ms": 3156399,
            "end_ms": 3158840,
            "text": "因为我不需要他们去报身份啊"
          },
          {
            "index": 1556,
            "source_segment_index": 1556,
            "start_ms": 3158840,
            "end_ms": 3160460,
            "text": "我觉得就可以听独立的发言啊"
          },
          {
            "index": 1557,
            "source_segment_index": 1557,
            "start_ms": 3160460,
            "end_ms": 3161300,
            "text": "所以你告诉我"
          },
          {
            "index": 1558,
            "source_segment_index": 1558,
            "start_ms": 3161300,
            "end_ms": 3162940,
            "text": "如果我在那个位末置位那个发言"
          },
          {
            "index": 1559,
            "source_segment_index": 1559,
            "start_ms": 3162940,
            "end_ms": 3164100,
            "text": "我去拉个平票pk"
          },
          {
            "index": 1560,
            "source_segment_index": 1560,
            "start_ms": 3164100,
            "end_ms": 3166060,
            "text": "那比如说有狼人藏起来了或者怎么样"
          },
          {
            "index": 1561,
            "source_segment_index": 1561,
            "start_ms": 3166060,
            "end_ms": 3167040,
            "text": "那都没法去说呀"
          },
          {
            "index": 1562,
            "source_segment_index": 1562,
            "start_ms": 3167040,
            "end_ms": 3170670,
            "text": "你们自己说这个一期可能都不太会拉杆错身份"
          },
          {
            "index": 1563,
            "source_segment_index": 1563,
            "start_ms": 3170670,
            "end_ms": 3173290,
            "text": "然后一边又说让我去安排平票pk去发身份"
          },
          {
            "index": 1564,
            "source_segment_index": 1564,
            "start_ms": 3173290,
            "end_ms": 3174819,
            "text": "所以是相违背的"
          },
          {
            "index": 1565,
            "source_segment_index": 1565,
            "start_ms": 3174819,
            "end_ms": 3175659,
            "text": "然后我觉得"
          },
          {
            "index": 1566,
            "source_segment_index": 1566,
            "start_ms": 3175659,
            "end_ms": 3178880,
            "text": "但是我没有觉得4号五号比较像狼人"
          },
          {
            "index": 1567,
            "source_segment_index": 1567,
            "start_ms": 3178880,
            "end_ms": 3179760,
            "text": "因为我觉得他们打我脸"
          },
          {
            "index": 1568,
            "source_segment_index": 1568,
            "start_ms": 3179760,
            "end_ms": 3180560,
            "text": "至少站在我的视角"
          },
          {
            "index": 1569,
            "source_segment_index": 1569,
            "start_ms": 3180560,
            "end_ms": 3181240,
            "text": "我是可以接受的"
          },
          {
            "index": 1570,
            "source_segment_index": 1570,
            "start_ms": 3181240,
            "end_ms": 3182200,
            "text": "我是能听进去的"
          },
          {
            "index": 1571,
            "source_segment_index": 1571,
            "start_ms": 3182200,
            "end_ms": 3183680,
            "text": "所以我去跟4号五号说的"
          },
          {
            "index": 1572,
            "source_segment_index": 1572,
            "start_ms": 3183680,
            "end_ms": 3187520,
            "text": "就是当然4号五号里面有可能有狼在电我"
          },
          {
            "index": 1573,
            "source_segment_index": 1573,
            "start_ms": 3187520,
            "end_ms": 3188660,
            "text": "因为我可能是警上"
          },
          {
            "index": 1574,
            "source_segment_index": 1574,
            "start_ms": 3188660,
            "end_ms": 3189100,
            "text": "我站错边"
          },
          {
            "index": 1575,
            "source_segment_index": 1575,
            "start_ms": 3189100,
            "end_ms": 3190860,
            "text": "我又不是说警我警上一定能站错"
          },
          {
            "index": 1576,
            "source_segment_index": 1576,
            "start_ms": 3190860,
            "end_ms": 3191460,
            "text": "站对边"
          },
          {
            "index": 1577,
            "source_segment_index": 1577,
            "start_ms": 3191460,
            "end_ms": 3193580,
            "text": "我只是觉得井上因为十一十二都没有交边"
          },
          {
            "index": 1578,
            "source_segment_index": 1578,
            "start_ms": 3193580,
            "end_ms": 3194780,
            "text": "我觉得我大大方交一个边"
          },
          {
            "index": 1579,
            "source_segment_index": 1579,
            "start_ms": 3194780,
            "end_ms": 3195420,
            "text": "我错了"
          },
          {
            "index": 1580,
            "source_segment_index": 1580,
            "start_ms": 3195420,
            "end_ms": 3196890,
            "text": "我可以选择忏悔吗"
          },
          {
            "index": 1581,
            "source_segment_index": 1581,
            "start_ms": 3196890,
            "end_ms": 3198970,
            "text": "但是目前为止看这个格式上来说的话"
          },
          {
            "index": 1582,
            "source_segment_index": 1582,
            "start_ms": 3198970,
            "end_ms": 3200570,
            "text": "我可能是站错了啊"
          },
          {
            "index": 1583,
            "source_segment_index": 1583,
            "start_ms": 3200570,
            "end_ms": 3204440,
            "text": "而且6号玩家我觉得发言确实比较像狼人"
          },
          {
            "index": 1584,
            "source_segment_index": 1584,
            "start_ms": 3204440,
            "end_ms": 3206640,
            "text": "甚至站边一号玩家团队的人呃"
          },
          {
            "index": 1585,
            "source_segment_index": 1585,
            "start_ms": 3206640,
            "end_ms": 3207720,
            "text": "那个2号玩家已经说"
          },
          {
            "index": 1586,
            "source_segment_index": 1586,
            "start_ms": 3207720,
            "end_ms": 3209990,
            "text": "6号玩家有可能是在电费一了"
          },
          {
            "index": 1587,
            "source_segment_index": 1587,
            "start_ms": 3210270,
            "end_ms": 3212790,
            "text": "所以我觉得格式上7号玩家也不太像啊"
          },
          {
            "index": 1588,
            "source_segment_index": 1588,
            "start_ms": 3212790,
            "end_ms": 3213290,
            "text": "也不太像"
          },
          {
            "index": 1589,
            "source_segment_index": 1589,
            "start_ms": 3213290,
            "end_ms": 3215410,
            "text": "我觉得有有狼人混在其其中"
          },
          {
            "index": 1590,
            "source_segment_index": 1590,
            "start_ms": 3215410,
            "end_ms": 3216870,
            "text": "拿我去垫啊"
          },
          {
            "index": 1591,
            "source_segment_index": 1591,
            "start_ms": 3216870,
            "end_ms": 3217750,
            "text": "拿我去凑狼坑"
          },
          {
            "index": 1592,
            "source_segment_index": 1592,
            "start_ms": 3217750,
            "end_ms": 3219550,
            "text": "然后我觉得这把一定有倒钩狼啊"
          },
          {
            "index": 1593,
            "source_segment_index": 1593,
            "start_ms": 3219550,
            "end_ms": 3221670,
            "text": "是一定有倒钩狼的"
          },
          {
            "index": 1594,
            "source_segment_index": 1594,
            "start_ms": 3223040,
            "end_ms": 3224200,
            "text": "没啥了呀"
          },
          {
            "index": 1595,
            "source_segment_index": 1595,
            "start_ms": 3224200,
            "end_ms": 3225960,
            "text": "就是你如果一号玩家"
          },
          {
            "index": 1596,
            "source_segment_index": 1596,
            "start_ms": 3225960,
            "end_ms": 3226360,
            "text": "你是预言家"
          },
          {
            "index": 1597,
            "source_segment_index": 1597,
            "start_ms": 3226360,
            "end_ms": 3226880,
            "text": "你可以验一下"
          },
          {
            "index": 1598,
            "source_segment_index": 1598,
            "start_ms": 3226880,
            "end_ms": 3227240,
            "text": "我咋了"
          },
          {
            "index": 1599,
            "source_segment_index": 1599,
            "start_ms": 3227240,
            "end_ms": 3232870,
            "text": "7号玩家怎么我一说又说给你说乐了咋了"
          },
          {
            "index": 1600,
            "source_segment_index": 1600,
            "start_ms": 3232870,
            "end_ms": 3235430,
            "text": "我本来是狼人"
          },
          {
            "index": 1601,
            "source_segment_index": 1601,
            "start_ms": 3235430,
            "end_ms": 3236810,
            "text": "觉得我这把太C了"
          },
          {
            "index": 1602,
            "source_segment_index": 1602,
            "start_ms": 3236810,
            "end_ms": 3239590,
            "text": "把我把我没办法迫使把我打到狼坑里"
          },
          {
            "index": 1603,
            "source_segment_index": 1603,
            "start_ms": 3239590,
            "end_ms": 3241990,
            "text": "然后我自己钻到狼队去了吗"
          },
          {
            "index": 1604,
            "source_segment_index": 1604,
            "start_ms": 3242610,
            "end_ms": 3246090,
            "text": "嗯我是觉得至少一号玩家警一号玩家"
          },
          {
            "index": 1605,
            "source_segment_index": 1605,
            "start_ms": 3246090,
            "end_ms": 3248190,
            "text": "至少我觉得警下的发言拉回来了很多"
          },
          {
            "index": 1606,
            "source_segment_index": 1606,
            "start_ms": 3248820,
            "end_ms": 3252820,
            "text": "反正如果你们因为我如果说一号玩家是通灵师"
          },
          {
            "index": 1607,
            "source_segment_index": 1607,
            "start_ms": 3252820,
            "end_ms": 3253540,
            "text": "早晚得表水"
          },
          {
            "index": 1608,
            "source_segment_index": 1608,
            "start_ms": 3253540,
            "end_ms": 3255320,
            "text": "我需要你们提前先认下我"
          },
          {
            "index": 1609,
            "source_segment_index": 1609,
            "start_ms": 3255320,
            "end_ms": 3256100,
            "text": "要不然我在后"
          },
          {
            "index": 1610,
            "source_segment_index": 1610,
            "start_ms": 3256100,
            "end_ms": 3257810,
            "text": "要不然我在后面我被抗推了"
          },
          {
            "index": 1611,
            "source_segment_index": 1611,
            "start_ms": 3257810,
            "end_ms": 3260420,
            "text": "又变我的了啊没了"
          },
          {
            "index": 1612,
            "source_segment_index": 1612,
            "start_ms": 3260420,
            "end_ms": 3262100,
            "text": "反正票型可以大于谦吗"
          },
          {
            "index": 1613,
            "source_segment_index": 1613,
            "start_ms": 3262100,
            "end_ms": 3262940,
            "text": "我听完七的发言"
          },
          {
            "index": 1614,
            "source_segment_index": 1614,
            "start_ms": 3262940,
            "end_ms": 3264500,
            "text": "如果七的发言足够好"
          },
          {
            "index": 1615,
            "source_segment_index": 1615,
            "start_ms": 3264500,
            "end_ms": 3266580,
            "text": "我可能我可以继续站边七"
          },
          {
            "index": 1616,
            "source_segment_index": 1616,
            "start_ms": 3266580,
            "end_ms": 3267340,
            "text": "但如果七的发言不好"
          },
          {
            "index": 1617,
            "source_segment_index": 1617,
            "start_ms": 3267340,
            "end_ms": 3267940,
            "text": "我把他投了"
          },
          {
            "index": 1618,
            "source_segment_index": 1618,
            "start_ms": 3267940,
            "end_ms": 3269980,
            "text": "我用我的票型证明我的好人身份就够了好吧"
          },
          {
            "index": 1619,
            "source_segment_index": 1619,
            "start_ms": 3269980,
            "end_ms": 3273420,
            "text": "过了8号请发言"
