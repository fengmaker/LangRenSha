          {
            "index": 1777,
            "source_segment_index": 1777,
            "start_ms": 3667750,
            "end_ms": 3669669,
            "text": "12号守夜射梦人"
          },
          {
            "index": 1778,
            "source_segment_index": 1778,
            "start_ms": 3669669,
            "end_ms": 3670729,
            "text": "梦游5号狼人"
          },
          {
            "index": 1779,
            "source_segment_index": 1779,
            "start_ms": 3670729,
            "end_ms": 3671969,
            "text": "狼人击杀10号女巫"
          },
          {
            "index": 1780,
            "source_segment_index": 1780,
            "start_ms": 3671969,
            "end_ms": 3674069,
            "text": "女巫毒杀7号射梦人"
          },
          {
            "index": 1781,
            "source_segment_index": 1781,
            "start_ms": 3674069,
            "end_ms": 3676189,
            "text": "第一页为5号七号"
          },
          {
            "index": 1782,
            "source_segment_index": 1782,
            "start_ms": 3676189,
            "end_ms": 3678029,
            "text": "10号多导当言预言家验证"
          },
          {
            "index": 1783,
            "source_segment_index": 1783,
            "start_ms": 3678029,
            "end_ms": 3679949,
            "text": "6号玩家平民为好人身份"
          },
          {
            "index": 1784,
            "source_segment_index": 1784,
            "start_ms": 3679949,
            "end_ms": 3681120,
            "text": "在警上竞选环节"
          },
          {
            "index": 1785,
            "source_segment_index": 1785,
            "start_ms": 3681120,
            "end_ms": 3682520,
            "text": "4号悍跳狼人获得警徽"
          },
          {
            "index": 1786,
            "source_segment_index": 1786,
            "start_ms": 3682520,
            "end_ms": 3683140,
            "text": "第一天白天"
          },
          {
            "index": 1787,
            "source_segment_index": 1787,
            "start_ms": 3683140,
            "end_ms": 3684520,
            "text": "4号狼人选择自爆"
          },
          {
            "index": 1788,
            "source_segment_index": 1788,
            "start_ms": 3684520,
            "end_ms": 3685140,
            "text": "撕掉警徽"
          },
          {
            "index": 1789,
            "source_segment_index": 1789,
            "start_ms": 3685140,
            "end_ms": 3687380,
            "text": "本局游戏警徽流失入夜"
          },
          {
            "index": 1790,
            "source_segment_index": 1790,
            "start_ms": 3687380,
            "end_ms": 3692850,
            "text": "典狱长选择3号平民与11号平民进行交易"
          },
          {
            "index": 1791,
            "source_segment_index": 1791,
            "start_ms": 3692850,
            "end_ms": 3696670,
            "text": "两名平民均选择认可交易"
          },
          {
            "index": 1792,
            "source_segment_index": 1792,
            "start_ms": 3696670,
            "end_ms": 3700220,
            "text": "所以我们当夜的这个交易池中无事发生"
          },
          {
            "index": 1793,
            "source_segment_index": 1793,
            "start_ms": 3700220,
            "end_ms": 3701240,
            "text": "狼人击杀"
          },
          {
            "index": 1794,
            "source_segment_index": 1794,
            "start_ms": 3701240,
            "end_ms": 3704300,
            "text": "9号预言家预言家验证了2号玩家"
          },
          {
            "index": 1795,
            "source_segment_index": 1795,
            "start_ms": 3704300,
            "end_ms": 3705620,
            "text": "典狱长为狼人身份"
          },
          {
            "index": 1796,
            "source_segment_index": 1796,
            "start_ms": 3705620,
            "end_ms": 3707260,
            "text": "在第二天的白天场上"
          },
          {
            "index": 1797,
            "source_segment_index": 1797,
            "start_ms": 3707260,
            "end_ms": 3710740,
            "text": "最后一张神牌猎人一号被抗推出局"
          },
          {
            "index": 1798,
            "source_segment_index": 1798,
            "start_ms": 3710740,
            "end_ms": 3711620,
            "text": "游戏结束"
          },
          {
            "index": 1799,
            "source_segment_index": 1799,
            "start_ms": 3711620,
            "end_ms": 3712800,
            "text": "狼人阵营获胜"
          },
          {
            "index": 1800,
            "source_segment_index": 1800,
            "start_ms": 3712800,
            "end_ms": 3715460,
            "text": "以上是我们今天第二局孤注一掷的全部内容"
          },
          {
            "index": 1801,
            "source_segment_index": 1801,
            "start_ms": 3715460,
            "end_ms": 3717460,
            "text": "非常感谢每一位大木老师的陪伴"
          },
          {
            "index": 1802,
            "source_segment_index": 1802,
            "start_ms": 3717460,
            "end_ms": 3719140,
            "text": "然后我们的晋城大师赛"
          },
          {
            "index": 1803,
            "source_segment_index": 1803,
            "start_ms": 3719140,
            "end_ms": 3723220,
            "text": "第2026年度的高校联赛已经开启招募了"
          },
          {
            "index": 1804,
            "source_segment_index": 1804,
            "start_ms": 3723220,
            "end_ms": 3724780,
            "text": "所以我们各位学校的学子们"
          },
          {
            "index": 1805,
            "source_segment_index": 1805,
            "start_ms": 3724780,
            "end_ms": 3725900,
            "text": "想要参加我们高校联赛"
          },
          {
            "index": 1806,
            "source_segment_index": 1806,
            "start_ms": 3725900,
            "end_ms": 3727900,
            "text": "欢迎来到我们京城大赛官博上"
          },
          {
            "index": 1807,
            "source_segment_index": 1807,
            "start_ms": 3727900,
            "end_ms": 3730590,
            "text": "查看一下我们报名的详细的须知"
          },
          {
            "index": 1808,
            "source_segment_index": 1808,
            "start_ms": 3730590,
            "end_ms": 3731070,
            "text": "同样的"
          },
          {
            "index": 1809,
            "source_segment_index": 1809,
            "start_ms": 3731070,
            "end_ms": 3732570,
            "text": "我们第一阶段的海选赛"
          },
          {
            "index": 1810,
            "source_segment_index": 1810,
            "start_ms": 3732570,
            "end_ms": 3736630,
            "text": "会在我们这个天天狼人的app上开展啊"
          },
          {
            "index": 1811,
            "source_segment_index": 1811,
            "start_ms": 3736630,
            "end_ms": 3738670,
            "text": "所以各位家人们可以及时去来下载一下"
          },
          {
            "index": 1812,
            "source_segment_index": 1812,
            "start_ms": 3738670,
            "end_ms": 3740160,
            "text": "我们这一款天天狼人的app"
          },
          {
            "index": 1813,
            "source_segment_index": 1813,
            "start_ms": 3740160,
            "end_ms": 3740640,
            "text": "然后呢"
          },
          {
            "index": 1814,
            "source_segment_index": 1814,
            "start_ms": 3740640,
            "end_ms": 3743640,
            "text": "我们第二阶段的这个赛段的线下晋级赛"
          },
          {
            "index": 1815,
            "source_segment_index": 1815,
            "start_ms": 3743640,
            "end_ms": 3746540,
            "text": "也在疯狂的招募我们的线下合作赛点"
          },
          {
            "index": 1816,
            "source_segment_index": 1816,
            "start_ms": 3746540,
            "end_ms": 3747500,
            "text": "所以各位家人们"
          },
          {
            "index": 1817,
            "source_segment_index": 1817,
            "start_ms": 3747500,
            "end_ms": 3749620,
            "text": "如果您拥有一个剧本杀或者狼人杀店"
          },
          {
            "index": 1818,
            "source_segment_index": 1818,
            "start_ms": 3749620,
            "end_ms": 3751540,
            "text": "或者您是高校的社团主理人"
          },
          {
            "index": 1819,
            "source_segment_index": 1819,
            "start_ms": 3751540,
            "end_ms": 3753560,
            "text": "也欢迎来到我们金融大赛官博"
          },
          {
            "index": 1820,
            "source_segment_index": 1820,
            "start_ms": 3753560,
            "end_ms": 3755600,
            "text": "查看一下我们报名的详细方式"
          },
          {
            "index": 1821,
            "source_segment_index": 1821,
            "start_ms": 3755600,
            "end_ms": 3757240,
            "text": "然后感谢一下侯小豚"
          },
          {
            "index": 1822,
            "source_segment_index": 1822,
            "start_ms": 3757240,
            "end_ms": 3759580,
            "text": "感谢一下LISA老师给我的投食"
          },
          {
            "index": 1823,
            "source_segment_index": 1823,
            "start_ms": 3759580,
            "end_ms": 3762300,
            "text": "接下来请导播老师把镜头移交至我们第二现场"
          },
          {
            "index": 1824,
            "source_segment_index": 1824,
            "start_ms": 3764860,
            "end_ms": 3765380,
            "text": "稍后回来"
          },
