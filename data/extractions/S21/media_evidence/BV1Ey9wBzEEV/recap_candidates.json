            "source_segment_index": 2442,
            "start_ms": 4673939,
            "end_ms": 4675619,
            "text": "3号守卫7号狼人阵营"
          },
          {
            "index": 2443,
            "source_segment_index": 2443,
            "start_ms": 4675619,
            "end_ms": 4677179,
            "text": "6号十号狼王"
          },
          {
            "index": 2444,
            "source_segment_index": 2444,
            "start_ms": 4677179,
            "end_ms": 4680300,
            "text": "4号平民阵营2号八号九号"
          },
          {
            "index": 2445,
            "source_segment_index": 2445,
            "start_ms": 4680300,
            "end_ms": 4681240,
            "text": "11号12号"
          },
          {
            "index": 2446,
            "source_segment_index": 2446,
            "start_ms": 4681240,
            "end_ms": 4683800,
            "text": "本局的傀儡为7号"
          },
          {
            "index": 2447,
            "source_segment_index": 2447,
            "start_ms": 4683800,
            "end_ms": 4686250,
            "text": "也是我们原本的守卫牌"
          },
          {
            "index": 2448,
            "source_segment_index": 2448,
            "start_ms": 4686250,
            "end_ms": 4690390,
            "text": "入夜狼人击杀9号平民"
          },
          {
            "index": 2449,
            "source_segment_index": 2449,
            "start_ms": 4690390,
            "end_ms": 4691790,
            "text": "并选择了7号"
          },
          {
            "index": 2450,
            "source_segment_index": 2450,
            "start_ms": 4691790,
            "end_ms": 4694810,
            "text": "首位为本局游戏的傀儡女巫"
          },
          {
            "index": 2451,
            "source_segment_index": 2451,
            "start_ms": 4694810,
            "end_ms": 4696090,
            "text": "解救9号平民"
          },
          {
            "index": 2452,
            "source_segment_index": 2452,
            "start_ms": 4696090,
            "end_ms": 4696930,
            "text": "形成平安夜"
          },
          {
            "index": 2453,
            "source_segment_index": 2453,
            "start_ms": 4696930,
            "end_ms": 4700500,
            "text": "预言家验证了6号玩家为狼人身份"
          },
          {
            "index": 2454,
            "source_segment_index": 2454,
            "start_ms": 4700500,
            "end_ms": 4701880,
            "text": "在警上竞选环节"
          },
          {
            "index": 2455,
            "source_segment_index": 2455,
            "start_ms": 4701880,
            "end_ms": 4703380,
            "text": "本就游戏由于全员上警"
          },
          {
            "index": 2456,
            "source_segment_index": 2456,
            "start_ms": 4703380,
            "end_ms": 4704410,
            "text": "警徽流失"
          },
          {
            "index": 2457,
            "source_segment_index": 2457,
            "start_ms": 4704410,
            "end_ms": 4705570,
            "text": "第一天的白天"
          },
          {
            "index": 2458,
            "source_segment_index": 2458,
            "start_ms": 4705570,
            "end_ms": 4709170,
            "text": "4号狼王被公投出局并开枪带走"
          },
          {
            "index": 2459,
            "source_segment_index": 2459,
            "start_ms": 4709170,
            "end_ms": 4713090,
            "text": "一号女巫入夜狼人击杀3号猎人"
          },
          {
            "index": 2460,
            "source_segment_index": 2460,
            "start_ms": 4713090,
            "end_ms": 4714790,
            "text": "预言家验证了8号玩家"
          },
          {
            "index": 2461,
            "source_segment_index": 2461,
            "start_ms": 4714790,
            "end_ms": 4716330,
            "text": "平民为好人身份"
          },
          {
            "index": 2462,
            "source_segment_index": 2462,
            "start_ms": 4716330,
            "end_ms": 4719250,
            "text": "3号猎人出局后开枪带走6号狼人"
          },
          {
            "index": 2463,
            "source_segment_index": 2463,
            "start_ms": 4719250,
            "end_ms": 4720310,
            "text": "在第二天的白天"
          },
          {
            "index": 2464,
            "source_segment_index": 2464,
            "start_ms": 4720310,
            "end_ms": 4722390,
            "text": "10号狼人被公投出局"
          },
          {
            "index": 2465,
            "source_segment_index": 2465,
            "start_ms": 4722390,
            "end_ms": 4723930,
            "text": "入夜"
          },
          {
            "index": 2466,
            "source_segment_index": 2466,
            "start_ms": 4725280,
            "end_ms": 4728600,
            "text": "预言家验证了2号玩家平民为好人身份"
          },
          {
            "index": 2467,
            "source_segment_index": 2467,
            "start_ms": 4728600,
            "end_ms": 4732040,
            "text": "在第三天的白天场上最后一张狼人阵营的牌"
          },
          {
            "index": 2468,
            "source_segment_index": 2468,
            "start_ms": 4732040,
            "end_ms": 4733059,
            "text": "7号玩家"
          },
          {
            "index": 2469,
            "source_segment_index": 2469,
            "start_ms": 4733059,
            "end_ms": 4735099,
            "text": "我们的傀儡守卫被公投出局"
          },
          {
            "index": 2470,
            "source_segment_index": 2470,
            "start_ms": 4735099,
            "end_ms": 4735659,
            "text": "游戏结束"
          },
          {
            "index": 2471,
            "source_segment_index": 2471,
            "start_ms": 4735659,
            "end_ms": 4736579,
            "text": "好人阵营获胜"
          },
          {
            "index": 2472,
            "source_segment_index": 2472,
            "start_ms": 4736579,
            "end_ms": 4738459,
            "text": "以上是我们今天第二局版型为零"
          },
          {
            "index": 2473,
            "source_segment_index": 2473,
            "start_ms": 4738459,
            "end_ms": 4739299,
            "text": "侍从的全部内容"
          },
          {
            "index": 2474,
            "source_segment_index": 2474,
            "start_ms": 4739299,
            "end_ms": 4741150,
            "text": "非常感谢每一位弹幕老师的陪伴"
          },
          {
            "index": 2475,
            "source_segment_index": 2475,
            "start_ms": 4741150,
            "end_ms": 4743530,
            "text": "这里是我们京城大师赛第21赛季"
          },
          {
            "index": 2476,
            "source_segment_index": 2476,
            "start_ms": 4743530,
            "end_ms": 4745110,
            "text": "葵曲集团的直播现场"
          },
          {
            "index": 2477,
            "source_segment_index": 2477,
            "start_ms": 4745110,
            "end_ms": 4747330,
            "text": "然后希望各位担保师们能够看得开心"
          },
          {
            "index": 2478,
            "source_segment_index": 2478,
            "start_ms": 4747330,
            "end_ms": 4751100,
            "text": "也再次感谢天天狼人app对我们节目的冠名赞助"
          },
          {
            "index": 2479,
            "source_segment_index": 2479,
            "start_ms": 4751100,
            "end_ms": 4752140,
            "text": "也请各位弹幕老师"
          },
          {
            "index": 2480,
            "source_segment_index": 2480,
            "start_ms": 4752140,
            "end_ms": 4754020,
            "text": "可以移步去各大应用平台搜索"
          },
          {
            "index": 2481,
            "source_segment_index": 2481,
            "start_ms": 4754020,
            "end_ms": 4755600,
            "text": "并下载天天狼人app"
          },
          {
            "index": 2482,
            "source_segment_index": 2482,
            "start_ms": 4755600,
            "end_ms": 4757220,
            "text": "就可以跟我们一起来玩游戏了"
          },
          {
            "index": 2483,
            "source_segment_index": 2483,
            "start_ms": 4757220,
            "end_ms": 4758980,
            "text": "同时呢我们还有两名赞助商"
          },
          {
            "index": 2484,
            "source_segment_index": 2484,
            "start_ms": 4758980,
            "end_ms": 4761740,
            "text": "一个是我们的这款懒赤霞品牌"
          },
          {
            "index": 2485,
            "source_segment_index": 2485,
            "start_ms": 4761740,
            "end_ms": 4763340,
            "text": "还有一个是我们的柠檬共和国"
          },
          {
            "index": 2486,
            "source_segment_index": 2486,
            "start_ms": 4763340,
            "end_ms": 4765400,
            "text": "然后希望各位大老师们在棺材图中"
          },
          {
            "index": 2487,
            "source_segment_index": 2487,
            "start_ms": 4765400,
            "end_ms": 4766720,
            "text": "如果感受到呃"
          },
          {
            "index": 2488,
            "source_segment_index": 2488,
            "start_ms": 4766720,
            "end_ms": 4767720,
            "text": "想要吃点喝点"
          },
          {
            "index": 2489,
            "source_segment_index": 2489,
            "start_ms": 4767720,
            "end_ms": 4767840,
            "text": "都"
          },
          {
            "index": 2490,
            "source_segment_index": 2490,
            "start_ms": 4767840,
            "end_ms": 4770160,
            "text": "欢迎来到我们joy dh的主页橱窗中"
          },
          {
            "index": 2491,
            "source_segment_index": 2491,
            "start_ms": 4770160,
            "end_ms": 4771630,
            "text": "随时进行下单补货"
          },
          {
            "index": 2492,
            "source_segment_index": 2492,
            "start_ms": 4771630,
            "end_ms": 4773710,
            "text": "那么接下来导播老师会把镜头移交至我们"
          },
          {
            "index": 2493,
            "source_segment_index": 2493,
            "start_ms": 4773710,
            "end_ms": 4774190,
            "text": "第二现场"
          },
          {
            "index": 2494,
            "source_segment_index": 2494,
            "start_ms": 4776550,
            "end_ms": 4778690,
            "text": "稍后回来会是我们第三局机械狼通灵师"
          },
          {
            "index": 2495,
            "source_segment_index": 2495,
            "start_ms": 4778690,
            "end_ms": 4780110,
            "text": "一会见"
