            "source_segment_index": 2028,
            "start_ms": 3994070,
            "end_ms": 3995470,
            "text": "7号守卫3号狼人阵营"
          },
          {
            "index": 2029,
            "source_segment_index": 2029,
            "start_ms": 3995470,
            "end_ms": 3996830,
            "text": "2号五号九号机械狼"
          },
          {
            "index": 2030,
            "source_segment_index": 2030,
            "start_ms": 3996830,
            "end_ms": 3999400,
            "text": "6号本就是为机械平民平民阵营"
          },
          {
            "index": 2031,
            "source_segment_index": 2031,
            "start_ms": 3999400,
            "end_ms": 4006300,
            "text": "4号八号十号12号首页守卫守护8号狼呃"
          },
          {
            "index": 2032,
            "source_segment_index": 2032,
            "start_ms": 4006300,
            "end_ms": 4008700,
            "text": "8号平民狼人击杀11号女巫牛"
          },
          {
            "index": 2033,
            "source_segment_index": 2033,
            "start_ms": 4008700,
            "end_ms": 4010420,
            "text": "毒杀8号平民8号"
          },
          {
            "index": 2034,
            "source_segment_index": 2034,
            "start_ms": 4010420,
            "end_ms": 4014400,
            "text": "11号双子通灵师验证了9号玩家为狼人身份"
          },
          {
            "index": 2035,
            "source_segment_index": 2035,
            "start_ms": 4014400,
            "end_ms": 4015580,
            "text": "在警上竞选环节"
          },
          {
            "index": 2036,
            "source_segment_index": 2036,
            "start_ms": 4015580,
            "end_ms": 4017600,
            "text": "一号通灵师获得警徽地点"
          },
          {
            "index": 2037,
            "source_segment_index": 2037,
            "start_ms": 4017600,
            "end_ms": 4021290,
            "text": "白天3号首位被抗推出局"
          },
          {
            "index": 2038,
            "source_segment_index": 2038,
            "start_ms": 4021290,
            "end_ms": 4024370,
            "text": "入夜狼人击杀一号通灵师"
          },
          {
            "index": 2039,
            "source_segment_index": 2039,
            "start_ms": 4024370,
            "end_ms": 4026890,
            "text": "通灵师验证10号玩家为平民身份"
          },
          {
            "index": 2040,
            "source_segment_index": 2040,
            "start_ms": 4026890,
            "end_ms": 4030010,
            "text": "并在出局后将警徽移交至10号平民"
          },
          {
