            "source_segment_index": 2025,
            "start_ms": 3991110,
            "end_ms": 3992490,
            "text": "神人摄影通灵师"
          },
          {
            "index": 2026,
            "source_segment_index": 2026,
            "start_ms": 3992490,
            "end_ms": 3993310,
            "text": "一号女巫"
