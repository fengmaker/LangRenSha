          },
          {
            "index": 3564,
            "source_segment_index": 3564,
            "start_ms": 6859580,
            "end_ms": 6860580,
            "text": "满盘皆输"
          },
          {
            "index": 3565,
            "source_segment_index": 3565,
            "start_ms": 6860580,
            "end_ms": 6863700,
            "text": "确实让我们恭喜蛟龙入海"
          },
          {
            "index": 3566,
            "source_segment_index": 3566,
            "start_ms": 6863700,
            "end_ms": 6865360,
            "text": "恭喜我们的主理人诶"
          },
          {
            "index": 3567,
            "source_segment_index": 3567,
            "start_ms": 6865360,
            "end_ms": 6866460,
            "text": "恭喜我们的主理人"
          },
          {
            "index": 3568,
            "source_segment_index": 3568,
            "start_ms": 6866460,
            "end_ms": 6868300,
            "text": "来自户晓的李四老师"
          },
          {
            "index": 3569,
            "source_segment_index": 3569,
            "start_ms": 6868300,
            "end_ms": 6869820,
            "text": "确实这局游戏呢"
