        "evidence": [
          {
            "index": 1022,
            "source_segment_index": 1022,
            "start_ms": 2216720,
            "end_ms": 2217440,
            "text": "是鬼术师"
          },
          {
            "index": 1023,
            "source_segment_index": 1023,
            "start_ms": 2217440,
            "end_ms": 2218900,
            "text": "不是魔术师"
          },
          {
            "index": 1024,
            "source_segment_index": 1024,
            "start_ms": 2218900,
            "end_ms": 2221620,
            "text": "朋友们有一个骗子"
          },
          {
            "index": 1025,
            "source_segment_index": 1025,
            "start_ms": 2221620,
            "end_ms": 2223620,
            "text": "那就是我鬼术师挂了吧"
          },
          {
            "index": 1026,
            "source_segment_index": 1026,
            "start_ms": 2223620,
            "end_ms": 2224980,
            "text": "好第二局游戏结束了"
          },
          {
            "index": 1027,
            "source_segment_index": 1027,
            "start_ms": 2224980,
            "end_ms": 2226420,
            "text": "本局游戏鬼畜之境"
          },
          {
            "index": 1028,
            "source_segment_index": 1028,
            "start_ms": 2226420,
            "end_ms": 2227260,
            "text": "版型预言家"
          },
          {
            "index": 1029,
            "source_segment_index": 1029,
            "start_ms": 2227260,
            "end_ms": 2227860,
            "text": "4号女巫"
          },
          {
            "index": 1030,
            "source_segment_index": 1030,
            "start_ms": 2227860,
            "end_ms": 2229220,
            "text": "12号定序王子"
          },
          {
            "index": 1031,
            "source_segment_index": 1031,
            "start_ms": 2229220,
            "end_ms": 2230300,
            "text": "9号魔术师"
          },
          {
            "index": 1032,
            "source_segment_index": 1032,
            "start_ms": 2230300,
            "end_ms": 2231690,
            "text": "6号鬼术师"
          },
          {
            "index": 1033,
            "source_segment_index": 1033,
            "start_ms": 2231690,
            "end_ms": 2232450,
            "text": "一号狼人"
          },
          {
            "index": 1034,
            "source_segment_index": 1034,
            "start_ms": 2232450,
            "end_ms": 2233250,
            "text": "3号七号"
          },
          {
            "index": 1035,
            "source_segment_index": 1035,
            "start_ms": 2233250,
            "end_ms": 2234070,
            "text": "8号平民"
          },
          {
            "index": 1036,
            "source_segment_index": 1036,
            "start_ms": 2234070,
            "end_ms": 2236190,
            "text": "2号五号十号11号"
          },
          {
            "index": 1037,
            "source_segment_index": 1037,
            "start_ms": 2236190,
            "end_ms": 2237430,
            "text": "首页鬼术师"
          },
          {
            "index": 1038,
            "source_segment_index": 1038,
            "start_ms": 2237430,
            "end_ms": 2241070,
            "text": "更换了2号平民和6号魔术师的投票"
          },
          {
            "index": 1039,
            "source_segment_index": 1039,
            "start_ms": 2241070,
            "end_ms": 2243640,
            "text": "结果当夜魔术师空过狼人"
          },
          {
            "index": 1040,
            "source_segment_index": 1040,
            "start_ms": 2243640,
            "end_ms": 2245520,
            "text": "击杀10号平民女巫要救起"
          },
          {
            "index": 1041,
            "source_segment_index": 1041,
            "start_ms": 2245520,
            "end_ms": 2248550,
            "text": "形成平安夜预言家验证9号玩家定序"
          },
          {
            "index": 1042,
            "source_segment_index": 1042,
            "start_ms": 2248550,
            "end_ms": 2250610,
            "text": "王子为好人身份上警环节"
          },
          {
            "index": 1043,
            "source_segment_index": 1043,
            "start_ms": 2250610,
            "end_ms": 2252909,
            "text": "8号狼人自爆入夜"
          },
          {
            "index": 1044,
            "source_segment_index": 1044,
            "start_ms": 2252909,
            "end_ms": 2255069,
            "text": "鬼术师更换了3号狼人同伴"
          },
          {
            "index": 1045,
            "source_segment_index": 1045,
            "start_ms": 2255069,
            "end_ms": 2257789,
            "text": "和12号女巫的放逐"
          },
          {
            "index": 1046,
            "source_segment_index": 1046,
            "start_ms": 2257789,
            "end_ms": 2258189,
            "text": "结果"
          },
          {
            "index": 1047,
            "source_segment_index": 1047,
            "start_ms": 2263040,
            "end_ms": 2264340,
            "text": "当夜狼人击杀6号"
          },
          {
            "index": 1048,
            "source_segment_index": 1048,
            "start_ms": 2264340,
            "end_ms": 2266069,
            "text": "实际一号中刀出局"
          },
          {
            "index": 1049,
            "source_segment_index": 1049,
            "start_ms": 2266069,
            "end_ms": 2268589,
            "text": "女巫通过预言家验证5号家位好人身份"
          },
          {
            "index": 1050,
            "source_segment_index": 1050,
            "start_ms": 2268589,
            "end_ms": 2270460,
            "text": "第二天延期清选进账环节"
          },
          {
            "index": 1051,
            "source_segment_index": 1051,
            "start_ms": 2270460,
            "end_ms": 2272380,
            "text": "3号狼人自爆成功"
          },
          {
            "index": 1052,
            "source_segment_index": 1052,
            "start_ms": 2272380,
            "end_ms": 2273580,
            "text": "本局游戏警徽流失"
          },
          {
            "index": 1053,
            "source_segment_index": 1053,
            "start_ms": 2273580,
            "end_ms": 2274920,
            "text": "入夜狼人追刀"
          },
          {
            "index": 1054,
            "source_segment_index": 1054,
            "start_ms": 2274920,
            "end_ms": 2278070,
            "text": "6号魔术师女巫毒杀最后一张狼人"
          },
          {
            "index": 1055,
            "source_segment_index": 1055,
            "start_ms": 2278070,
            "end_ms": 2279650,
            "text": "7号游戏结束"
          },
          {
            "index": 1056,
            "source_segment_index": 1056,
            "start_ms": 2279650,
            "end_ms": 2281330,
            "text": "好人正义获胜"
          },
          {
            "index": 1057,
            "source_segment_index": 1057,
            "start_ms": 2281330,
            "end_ms": 2282490,
            "text": "好各位弹幕老师们"
          },
          {
            "index": 1058,
            "source_segment_index": 1058,
            "start_ms": 2282490,
            "end_ms": 2284150,
            "text": "这里是金城大赛第21季"
          },
          {
            "index": 1059,
            "source_segment_index": 1059,
            "start_ms": 2284150,
            "end_ms": 2285770,
            "text": "鬼泣奇谈竞争大赛"
          },
          {
            "index": 1060,
            "source_segment_index": 1060,
            "start_ms": 2285770,
            "end_ms": 2288609,
            "text": "第21集是由天天狼人app冠名赞助播出的"
          },
          {
            "index": 1061,
            "source_segment_index": 1061,
            "start_ms": 2288609,
            "end_ms": 2290329,
            "text": "在我们的惊世宇宙当中啊"
          },
          {
            "index": 1062,
            "source_segment_index": 1062,
            "start_ms": 2290329,
            "end_ms": 2291169,
            "text": "我们的规则是"
          },
          {
            "index": 1063,
            "source_segment_index": 1063,
            "start_ms": 2291169,
            "end_ms": 2292449,
            "text": "如果两个狼人同时自爆"
          },
          {
            "index": 1064,
            "source_segment_index": 1064,
            "start_ms": 2292449,
            "end_ms": 2294320,
            "text": "我们优先小号的狼人自保"
          },
          {
            "index": 1065,
            "source_segment_index": 1065,
            "start_ms": 2294320,
            "end_ms": 2296720,
            "text": "然后默认第二天大号老人顺序自保"
          },
          {
            "index": 1066,
            "source_segment_index": 1066,
            "start_ms": 2296720,
            "end_ms": 2298560,
            "text": "但如果像刚才这种情况出现"
          },
          {
            "index": 1067,
            "source_segment_index": 1067,
            "start_ms": 2298560,
            "end_ms": 2299240,
            "text": "女巫还有毒呢"
          },
          {
            "index": 1068,
            "source_segment_index": 1068,
            "start_ms": 2299240,
            "end_ms": 2301990,
            "text": "只能是狼人自己的战术上失误了"
          },
          {
            "index": 1069,
            "source_segment_index": 1069,
            "start_ms": 2301990,
            "end_ms": 2304010,
            "text": "然后只能只能是自认倒霉啊"
          },
          {
            "index": 1070,
            "source_segment_index": 1070,
            "start_ms": 2304010,
            "end_ms": 2304720,
            "text": "然后呢"
          },
          {
            "index": 1071,
            "source_segment_index": 1071,
            "start_ms": 2304720,
            "end_ms": 2307880,
            "text": "呃可能是听说到我们个别的小人赛的规则"
          },
          {
            "index": 1072,
            "source_segment_index": 1072,
            "start_ms": 2307880,
            "end_ms": 2310200,
            "text": "执行暂时是没有那么的丝滑的"
          },
          {
            "index": 1073,
            "source_segment_index": 1073,
            "start_ms": 2310200,
            "end_ms": 2310520,
            "text": "然后呢"
          },
          {
            "index": 1074,
            "source_segment_index": 1074,
            "start_ms": 2310520,
            "end_ms": 2313429,
            "text": "这件事情我们未来也会在我们的法官组留言"
          },
          {
            "index": 1075,
            "source_segment_index": 1075,
            "start_ms": 2313429,
            "end_ms": 2316389,
            "text": "然后再跟我们各地的法官再次去强调"
          },
          {
            "index": 1076,
            "source_segment_index": 1076,
            "start_ms": 2316389,
            "end_ms": 2317750,
            "text": "这些细节上的规定"
          },
          {
            "index": 1077,
            "source_segment_index": 1077,
            "start_ms": 2317750,
            "end_ms": 2318910,
            "text": "不过呢一直以来"
          },
          {
            "index": 1078,
            "source_segment_index": 1078,
            "start_ms": 2318910,
            "end_ms": 2321750,
            "text": "京师京城大师赛的规定都是这样去执行的"
          },
          {
            "index": 1079,
            "source_segment_index": 1079,
            "start_ms": 2321750,
            "end_ms": 2325290,
            "text": "然后跟各位大宝老师们讲解一下刚才的这一幕"
          },
          {
            "index": 1080,
            "source_segment_index": 1080,
            "start_ms": 2325290,
            "end_ms": 2326490,
            "text": "比较有意思的情况出现"
          },
          {
            "index": 1081,
            "source_segment_index": 1081,
            "start_ms": 2326490,
            "end_ms": 2327690,
            "text": "我们是如何处理的"
          },
          {
            "index": 1082,
            "source_segment_index": 1082,
            "start_ms": 2327690,
            "end_ms": 2329810,
            "text": "然后今天还有一局机械狼通讯室的版型"
          },
          {
            "index": 1083,
            "source_segment_index": 1083,
            "start_ms": 2329810,
            "end_ms": 2332550,
            "text": "将在我们稍后解说老师的解说之后"
          },
          {
            "index": 1084,
            "source_segment_index": 1084,
            "start_ms": 2332550,
            "end_ms": 2333710,
            "text": "然后回到我们的现场"
          },
          {
            "index": 1085,
            "source_segment_index": 1085,
            "start_ms": 2333710,
            "end_ms": 2334940,
            "text": "继续各位大佬"
          },
          {
            "index": 1086,
            "source_segment_index": 1086,
            "start_ms": 2334940,
            "end_ms": 2337940,
            "text": "各位当老师们记得去来下载一下天天狼人app"
          },
          {
            "index": 1087,
            "source_segment_index": 1087,
            "start_ms": 2337940,
            "end_ms": 2340660,
            "text": "跟我们一起玩京城大赛同款版型"
          }
        ],
