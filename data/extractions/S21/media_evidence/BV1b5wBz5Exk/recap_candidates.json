          {
            "index": 1522,
            "source_segment_index": 1522,
            "start_ms": 3056220,
            "end_ms": 3061340,
            "text": "这只有他能做到这个赛道的独有风格"
          },
          {
            "index": 1523,
            "source_segment_index": 1523,
            "start_ms": 3062100,
            "end_ms": 3062500,
            "text": "好"
          },
          {
            "index": 1524,
            "source_segment_index": 1524,
            "start_ms": 3062500,
            "end_ms": 3063500,
            "text": "回到现场比赛继续"
          },
          {
            "index": 1525,
            "source_segment_index": 1525,
            "start_ms": 3063500,
            "end_ms": 3066500,
            "text": "这里是京城大赛第21季鬼区奇谭正在进行"
          },
          {
            "index": 1526,
            "source_segment_index": 1526,
            "start_ms": 3066500,
            "end_ms": 3069640,
            "text": "我们今天第三局的对局版型为机械狼通灵师"
          },
          {
            "index": 1527,
            "source_segment_index": 1527,
            "start_ms": 3069640,
            "end_ms": 3072900,
            "text": "我们即将继续我们的第一轮放逐发言环节"
          },
          {
            "index": 1528,
            "source_segment_index": 1528,
            "start_ms": 3072900,
            "end_ms": 3075490,
            "text": "接下来有请11号玩家发言"
          },
          {
            "index": 1529,
            "source_segment_index": 1529,
            "start_ms": 3075970,
            "end_ms": 3078330,
            "text": "如果站边7号应该是一号"
          },
          {
            "index": 1530,
            "source_segment_index": 1530,
            "start_ms": 3078330,
            "end_ms": 3079530,
            "text": "8号九号吧"
          },
          {
            "index": 1531,
            "source_segment_index": 1531,
            "start_ms": 3079530,
            "end_ms": 3081730,
            "text": "最后一个245里面我没有确定哦"
          },
          {
            "index": 1532,
            "source_segment_index": 1532,
            "start_ms": 3081730,
            "end_ms": 3083690,
            "text": "因为四五项不见面关系"
          },
          {
            "index": 1533,
            "source_segment_index": 1533,
            "start_ms": 3083690,
            "end_ms": 3085330,
            "text": "他们都是要站边七的"
          },
          {
            "index": 1534,
            "source_segment_index": 1534,
            "start_ms": 3085330,
            "end_ms": 3086700,
            "text": "但是他们又互打起来了"
          },
          {
            "index": 1535,
            "source_segment_index": 1535,
            "start_ms": 3086700,
            "end_ms": 3089220,
            "text": "2号呢我没有完全排选你"
          },
          {
            "index": 1536,
            "source_segment_index": 1536,
            "start_ms": 3089220,
            "end_ms": 3091380,
            "text": "因为其实你也是偏向站边七的嘛"
          },
          {
            "index": 1537,
            "source_segment_index": 1537,
            "start_ms": 3091380,
            "end_ms": 3093100,
            "text": "我是警下给七投票的"
          },
          {
            "index": 1538,
            "source_segment_index": 1538,
            "start_ms": 3093100,
            "end_ms": 3096500,
            "text": "你自己一开始发言是说你是啊"
          },
          {
            "index": 1539,
            "source_segment_index": 1539,
            "start_ms": 3097740,
            "end_ms": 3099100,
            "text": "强调了三遍对吧"
          },
          {
            "index": 1540,
            "source_segment_index": 1540,
            "start_ms": 3099100,
            "end_ms": 3101640,
            "text": "那既然你觉得七是一个预言家"
          },
          {
            "index": 1541,
            "source_segment_index": 1541,
            "start_ms": 3101640,
            "end_ms": 3102920,
            "text": "那我可以是个好人"
          },
          {
            "index": 1542,
            "source_segment_index": 1542,
            "start_ms": 3104400,
            "end_ms": 3105120,
            "text": "站边的七嘛"
          },
          {
            "index": 1543,
            "source_segment_index": 1543,
            "start_ms": 3105120,
            "end_ms": 3107400,
            "text": "所以其实你不需要一定要听我发言"
          },
          {
            "index": 1544,
            "source_segment_index": 1544,
            "start_ms": 3107400,
            "end_ms": 3109650,
            "text": "去区分七是不是预言家嘛"
          },
          {
            "index": 1545,
            "source_segment_index": 1545,
            "start_ms": 3109650,
            "end_ms": 3111530,
            "text": "其实警下我7号八号投票"
          },
          {
            "index": 1546,
            "source_segment_index": 1546,
            "start_ms": 3111530,
            "end_ms": 3112490,
            "text": "我蛮艰难的"
          },
          {
            "index": 1547,
            "source_segment_index": 1547,
            "start_ms": 3112490,
            "end_ms": 3115010,
            "text": "7号玩家发言只报了个金水警徽流"
          },
          {
            "index": 1548,
            "source_segment_index": 1548,
            "start_ms": 3115010,
            "end_ms": 3116830,
            "text": "也是留到我和一号嘛"
          },
          {
            "index": 1549,
            "source_segment_index": 1549,
            "start_ms": 3116830,
            "end_ms": 3121490,
            "text": "我是觉得啧很难听出来他一定是冤家"
          },
          {
            "index": 1550,
            "source_segment_index": 1550,
            "start_ms": 3121490,
            "end_ms": 3122670,
            "text": "但是听完八发言呢"
          },
          {
            "index": 1551,
            "source_segment_index": 1551,
            "start_ms": 3122670,
            "end_ms": 3126470,
            "text": "8号玩家也是给的十呃平民的身份"
          },
          {
            "index": 1552,
            "source_segment_index": 1552,
            "start_ms": 3126470,
            "end_ms": 3129410,
            "text": "第一个是你给十平民是卡顿了一下"
          },
          {
            "index": 1553,
            "source_segment_index": 1553,
            "start_ms": 3129410,
            "end_ms": 3132210,
            "text": "第二呢是假设你8号玩家是个预言家"
          },
          {
            "index": 1554,
            "source_segment_index": 1554,
            "start_ms": 3132210,
            "end_ms": 3132790,
            "text": "在你视角"
          },
          {
            "index": 1555,
            "source_segment_index": 1555,
            "start_ms": 3132790,
            "end_ms": 3136300,
            "text": "7号玩家有可能50%的几率做成悍跳"
          },
          {
            "index": 1556,
            "source_segment_index": 1556,
            "start_ms": 3136300,
            "end_ms": 3137120,
            "text": "对吧"
          },
          {
            "index": 1557,
            "source_segment_index": 1557,
            "start_ms": 3137120,
            "end_ms": 3138420,
            "text": "你验了十是个平民"
          },
          {
            "index": 1558,
            "source_segment_index": 1558,
            "start_ms": 3138420,
            "end_ms": 3142610,
            "text": "那你的悍跳狼他给十发了一个X身份"
          },
          {
            "index": 1559,
            "source_segment_index": 1559,
            "start_ms": 3142610,
            "end_ms": 3145310,
            "text": "其实在你视角期在试探时候"
          },
          {
            "index": 1560,
            "source_segment_index": 1560,
            "start_ms": 3145310,
            "end_ms": 3148710,
            "text": "所以呢你不太会去满足7号的需求"
          },
          {
            "index": 1561,
            "source_segment_index": 1561,
            "start_ms": 3148710,
            "end_ms": 3150510,
            "text": "告诉7号十号是平民"
          },
          {
            "index": 1562,
            "source_segment_index": 1562,
            "start_ms": 3150510,
            "end_ms": 3152130,
            "text": "我当时这么想的"
          },
          {
            "index": 1563,
            "source_segment_index": 1563,
            "start_ms": 3152130,
            "end_ms": 3153530,
            "text": "所以我强行投票"
          },
          {
            "index": 1564,
            "source_segment_index": 1564,
            "start_ms": 3153530,
            "end_ms": 3156810,
            "text": "我只能投给七摘盔的时候"
          },
          {
            "index": 1565,
            "source_segment_index": 1565,
            "start_ms": 3156810,
            "end_ms": 3158170,
            "text": "宣布我一个人在警下"
          },
          {
            "index": 1566,
            "source_segment_index": 1566,
            "start_ms": 3158170,
            "end_ms": 3160779,
            "text": "我当时是很紧张"
          },
          {
            "index": 1567,
            "source_segment_index": 1567,
            "start_ms": 3160779,
            "end_ms": 3161959,
            "text": "3号玩家说我有编"
          },
          {
            "index": 1568,
            "source_segment_index": 1568,
            "start_ms": 3161959,
            "end_ms": 3162719,
            "text": "我一点边都没有"
          },
          {
            "index": 1569,
            "source_segment_index": 1569,
            "start_ms": 3162719,
            "end_ms": 3163279,
            "text": "我很紧张"
          },
          {
            "index": 1570,
            "source_segment_index": 1570,
            "start_ms": 3163279,
            "end_ms": 3164579,
            "text": "因为只有我一个人投票"
          },
          {
            "index": 1571,
            "source_segment_index": 1571,
            "start_ms": 3164579,
            "end_ms": 3166300,
            "text": "我这一票是很关键的"
          },
          {
            "index": 1572,
            "source_segment_index": 1572,
            "start_ms": 3166300,
            "end_ms": 3168380,
            "text": "头头可能就是千夫所指了"
          },
          {
            "index": 1573,
            "source_segment_index": 1573,
            "start_ms": 3168380,
            "end_ms": 3172350,
            "text": "所以我我我只能只能尽量去凭听感去看嘛"
          },
          {
            "index": 1574,
            "source_segment_index": 1574,
            "start_ms": 3172350,
            "end_ms": 3174770,
            "text": "目前我觉得七是通灵师嘛"
          },
          {
            "index": 1575,
            "source_segment_index": 1575,
            "start_ms": 3174770,
            "end_ms": 3177370,
            "text": "所以我觉得不排水的位置可能是2号吧"
          },
          {
            "index": 1576,
            "source_segment_index": 1576,
            "start_ms": 3177370,
            "end_ms": 3178880,
            "text": "反正自己看着办吧"
          },
          {
            "index": 1577,
            "source_segment_index": 1577,
            "start_ms": 3178880,
            "end_ms": 3180640,
            "text": "他们获取位如果是有你不见面"
          },
          {
            "index": 1578,
            "source_segment_index": 1578,
            "start_ms": 3180640,
            "end_ms": 3181840,
            "text": "大哥也会传递信息的嘛"
          },
          {
            "index": 1579,
            "source_segment_index": 1579,
            "start_ms": 3181840,
            "end_ms": 3182860,
            "text": "你也会自爆的是吧"
          },
          {
            "index": 1580,
            "source_segment_index": 1580,
            "start_ms": 3182860,
            "end_ms": 3183920,
            "text": "反正就这样吧"
          },
          {
            "index": 1581,
            "source_segment_index": 1581,
            "start_ms": 3183920,
            "end_ms": 3184890,
            "text": "我是一个好人"
          },
          {
            "index": 1582,
            "source_segment_index": 1582,
            "start_ms": 3184890,
            "end_ms": 3185810,
            "text": "应该是一号"
          },
          {
            "index": 1583,
            "source_segment_index": 1583,
            "start_ms": 3185810,
            "end_ms": 3187610,
            "text": "我站边七就一号8号九号嘛"
          },
          {
            "index": 1584,
            "source_segment_index": 1584,
            "start_ms": 3187610,
            "end_ms": 3189090,
            "text": "9号警上是有点软"
          },
          {
            "index": 1585,
            "source_segment_index": 1585,
            "start_ms": 3189090,
            "end_ms": 3189570,
            "text": "站边七"
          },
          {
            "index": 1586,
            "source_segment_index": 1586,
            "start_ms": 3189570,
            "end_ms": 3191670,
            "text": "但是是有点倒钩气息的"
          },
          {
            "index": 1587,
            "source_segment_index": 1587,
            "start_ms": 3191670,
            "end_ms": 3193190,
            "text": "因为你没有打死八吗"
          },
          {
            "index": 1588,
            "source_segment_index": 1588,
            "start_ms": 3193190,
            "end_ms": 3194110,
            "text": "可以再听一下吗"
          },
          {
            "index": 1589,
            "source_segment_index": 1589,
            "start_ms": 3194110,
            "end_ms": 3194630,
            "text": "可以盘错的"
          },
          {
            "index": 1590,
            "source_segment_index": 1590,
            "start_ms": 3194630,
            "end_ms": 3195750,
            "text": "我可以盘错的好吧"
          },
          {
            "index": 1591,
            "source_segment_index": 1591,
            "start_ms": 3195750,
            "end_ms": 3196310,
            "text": "我是个好人"
          },
          {
            "index": 1592,
            "source_segment_index": 1592,
            "start_ms": 3196310,
            "end_ms": 3200100,
            "text": "过的10号呢请发言嗯"
          },
          {
            "index": 1593,
            "source_segment_index": 1593,
            "start_ms": 3201180,
            "end_ms": 3202060,
            "text": "5号哎"
          },
          {
            "index": 1594,
            "source_segment_index": 1594,
            "start_ms": 3202060,
            "end_ms": 3203660,
            "text": "这把我听2号是好人"
          },
          {
            "index": 1595,
            "source_segment_index": 1595,
            "start_ms": 3203660,
            "end_ms": 3206140,
            "text": "5号我想想警上干了啥啊"
          },
          {
            "index": 1596,
            "source_segment_index": 1596,
            "start_ms": 3206140,
            "end_ms": 3210900,
            "text": "5号聊了12号对吧"
          },
          {
            "index": 1597,
            "source_segment_index": 1597,
            "start_ms": 3210900,
            "end_ms": 3212980,
            "text": "咳咳但是5号有也有好人面"
          },
          {
            "index": 1598,
            "source_segment_index": 1598,
            "start_ms": 3212980,
            "end_ms": 3214220,
            "text": "因为你看6号打了五"
          },
          {
            "index": 1599,
            "source_segment_index": 1599,
            "start_ms": 3214220,
            "end_ms": 3215440,
            "text": "6号就打了5号"
          },
          {
            "index": 1600,
            "source_segment_index": 1600,
            "start_ms": 3215440,
            "end_ms": 3216540,
            "text": "5号还要站边七"
          },
          {
            "index": 1601,
            "source_segment_index": 1601,
            "start_ms": 3216540,
            "end_ms": 3219020,
            "text": "5号被6号打了再去倒钩"
          },
          {
            "index": 1602,
            "source_segment_index": 1602,
            "start_ms": 3219020,
            "end_ms": 3220580,
            "text": "七也是有说法"
          },
          {
            "index": 1603,
            "source_segment_index": 1603,
            "start_ms": 3220580,
            "end_ms": 3223130,
            "text": "其实也不一定非得是狼嗯"
          },
          {
            "index": 1604,
            "source_segment_index": 1604,
            "start_ms": 3223130,
            "end_ms": 3225890,
            "text": "开始我觉得这这徐姐像狼啊"
          },
          {
            "index": 1605,
            "source_segment_index": 1605,
            "start_ms": 3225890,
            "end_ms": 3229660,
            "text": "什么3号是不是猎人被被你学的机械猎人死了"
          },
          {
            "index": 1606,
            "source_segment_index": 1606,
            "start_ms": 3229660,
            "end_ms": 3230780,
            "text": "你猎人被毒死"
          },
          {
            "index": 1607,
            "source_segment_index": 1607,
            "start_ms": 3230780,
            "end_ms": 3232540,
            "text": "你这机械猎人传递信息的呗"
          },
          {
            "index": 1608,
            "source_segment_index": 1608,
            "start_ms": 3232540,
            "end_ms": 3234860,
            "text": "这老老是说这些吓唬人"
          },
          {
            "index": 1609,
            "source_segment_index": 1609,
            "start_ms": 3234860,
            "end_ms": 3235340,
            "text": "你知道吧"
          },
          {
            "index": 1610,
            "source_segment_index": 1610,
            "start_ms": 3235340,
            "end_ms": 3237020,
            "text": "他老咳咳"
          },
          {
            "index": 1611,
            "source_segment_index": 1611,
            "start_ms": 3239000,
            "end_ms": 3241760,
            "text": "2号我排了5号也不一定是狼"
          },
          {
            "index": 1612,
            "source_segment_index": 1612,
            "start_ms": 3241760,
            "end_ms": 3242940,
            "text": "我说句实在的"
          },
          {
            "index": 1613,
            "source_segment_index": 1613,
            "start_ms": 3242940,
            "end_ms": 3245960,
            "text": "所以其实我会把这个会瞄准4号"
          },
          {
            "index": 1614,
            "source_segment_index": 1614,
            "start_ms": 3245960,
            "end_ms": 3247740,
            "text": "9号这个位置嗯"
          },
          {
            "index": 1615,
            "source_segment_index": 1615,
            "start_ms": 3247740,
            "end_ms": 3249540,
            "text": "然后11号除非是机械狼"
          },
          {
            "index": 1616,
            "source_segment_index": 1616,
            "start_ms": 3249540,
            "end_ms": 3251180,
            "text": "他没找着家对吧"
          },
          {
            "index": 1617,
            "source_segment_index": 1617,
            "start_ms": 3251180,
            "end_ms": 3253030,
            "text": "否则的话七是预言家"
          },
          {
            "index": 1618,
            "source_segment_index": 1618,
            "start_ms": 3253030,
            "end_ms": 3256070,
            "text": "他不可能七八对跳警下唯一个他去倒钩去了"
          },
          {
            "index": 1619,
            "source_segment_index": 1619,
            "start_ms": 3256070,
            "end_ms": 3257750,
            "text": "所以11不是机械狼"
          },
          {
            "index": 1620,
            "source_segment_index": 1620,
            "start_ms": 3257750,
            "end_ms": 3258790,
            "text": "就是好人"
          },
          {
            "index": 1621,
            "source_segment_index": 1621,
            "start_ms": 3258790,
            "end_ms": 3261910,
            "text": "然后斌子应该像好人吧"
          },
          {
            "index": 1622,
            "source_segment_index": 1622,
            "start_ms": 3261910,
            "end_ms": 3265690,
            "text": "至少这一轮我觉得还好还好"
          },
          {
            "index": 1623,
            "source_segment_index": 1623,
            "start_ms": 3265690,
            "end_ms": 3267550,
            "text": "因为你看3号如果是好人"
          },
          {
            "index": 1624,
            "source_segment_index": 1624,
            "start_ms": 3267550,
            "end_ms": 3268650,
            "text": "12号是好人"
