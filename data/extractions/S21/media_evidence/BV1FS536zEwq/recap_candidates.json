        "evidence": [
          {
            "index": 1849,
            "source_segment_index": 1849,
            "start_ms": 3494270,
            "end_ms": 3496590,
            "text": "我读了个双刀秀哦"
          },
          {
            "index": 1850,
            "source_segment_index": 1850,
            "start_ms": 3496590,
            "end_ms": 3499070,
            "text": "我还以为他是卡双刀"
          },
          {
            "index": 1851,
            "source_segment_index": 1851,
            "start_ms": 3499680,
            "end_ms": 3501420,
            "text": "你还打我呢"
          },
          {
            "index": 1852,
            "source_segment_index": 1852,
            "start_ms": 3501420,
            "end_ms": 3503250,
            "text": "有人让我不上哦"
          },
          {
            "index": 1853,
            "source_segment_index": 1853,
            "start_ms": 3503250,
            "end_ms": 3508030,
            "text": "好给各位弹幕老师们先做一下本游戏的复盘"
          },
          {
            "index": 1854,
            "source_segment_index": 1854,
            "start_ms": 3508030,
            "end_ms": 3511130,
            "text": "本局版型为机械狼通灵师"
          },
          {
            "index": 1855,
            "source_segment_index": 1855,
            "start_ms": 3514940,
            "end_ms": 3516060,
            "text": "真人阵营通灵师"
          },
          {
            "index": 1856,
            "source_segment_index": 1856,
            "start_ms": 3516060,
            "end_ms": 3516700,
            "text": "一号女巫"
          },
          {
            "index": 1857,
            "source_segment_index": 1857,
            "start_ms": 3516700,
            "end_ms": 3517420,
            "text": "4号猎人"
          },
          {
            "index": 1858,
            "source_segment_index": 1858,
            "start_ms": 3517420,
            "end_ms": 3520400,
            "text": "9号守卫8号狼人阵营5号六号"
          },
          {
            "index": 1859,
            "source_segment_index": 1859,
            "start_ms": 3520400,
            "end_ms": 3522240,
            "text": "12号机械狼11号"
          },
          {
            "index": 1860,
            "source_segment_index": 1860,
            "start_ms": 3522240,
            "end_ms": 3523960,
            "text": "本游戏为机械双刀狼"
          },
          {
            "index": 1861,
            "source_segment_index": 1861,
            "start_ms": 3524110,
            "end_ms": 3526470,
            "text": "平民阵营2号三号七号"
          },
          {
            "index": 1862,
            "source_segment_index": 1862,
            "start_ms": 3526470,
            "end_ms": 3529890,
            "text": "10号首页首位守护10号平民狼人"
          },
          {
            "index": 1863,
            "source_segment_index": 1863,
            "start_ms": 3529890,
            "end_ms": 3532290,
            "text": "击杀9号猎人女王救起"
          },
          {
            "index": 1864,
            "source_segment_index": 1864,
            "start_ms": 3532290,
            "end_ms": 3533200,
            "text": "形成平安夜"
          },
          {
            "index": 1865,
            "source_segment_index": 1865,
            "start_ms": 3533200,
            "end_ms": 3534840,
            "text": "机械狼模仿5号狼人"
          },
          {
            "index": 1866,
            "source_segment_index": 1866,
            "start_ms": 3534840,
            "end_ms": 3536320,
            "text": "本就游戏为机械双刀狼"
          },
          {
            "index": 1867,
            "source_segment_index": 1867,
            "start_ms": 3536320,
            "end_ms": 3537120,
            "text": "通灵师验证"
          },
          {
            "index": 1868,
            "source_segment_index": 1868,
            "start_ms": 3537120,
            "end_ms": 3539069,
            "text": "9号玩家为猎人身份"
          },
          {
            "index": 1869,
            "source_segment_index": 1869,
            "start_ms": 3539069,
            "end_ms": 3540309,
            "text": "警上竞选环节"
          },
          {
            "index": 1870,
            "source_segment_index": 1870,
            "start_ms": 3540309,
            "end_ms": 3542029,
            "text": "一号通灵师获得警徽"
          },
          {
            "index": 1871,
            "source_segment_index": 1871,
            "start_ms": 3542029,
            "end_ms": 3545469,
            "text": "第一天白天5号悍跳狼人选择自爆"
          },
          {
            "index": 1872,
            "source_segment_index": 1872,
            "start_ms": 3546570,
            "end_ms": 3549810,
            "text": "入夜守卫守护8号自守狼人击杀8号首位"
          },
          {
            "index": 1873,
            "source_segment_index": 1873,
            "start_ms": 3549810,
            "end_ms": 3553900,
            "text": "形成平安夜女巫毒杀11号机械双刀狼"
          },
          {
            "index": 1874,
            "source_segment_index": 1874,
            "start_ms": 3553900,
            "end_ms": 3556250,
            "text": "11号机械狼单死"
          },
          {
            "index": 1875,
            "source_segment_index": 1875,
            "start_ms": 3556250,
            "end_ms": 3560160,
            "text": "当夜通灵师验证了11号玩家为狼人身份"
          },
          {
            "index": 1876,
            "source_segment_index": 1876,
            "start_ms": 3560160,
            "end_ms": 3561680,
            "text": "在第二天的白天"
          },
          {
            "index": 1877,
            "source_segment_index": 1877,
            "start_ms": 3561680,
            "end_ms": 3563280,
            "text": "6号狼人选择自爆"
          },
          {
            "index": 1878,
            "source_segment_index": 1878,
            "start_ms": 3563280,
            "end_ms": 3566140,
            "text": "入夜守卫守护一号通灵师"
          },
          {
            "index": 1879,
            "source_segment_index": 1879,
            "start_ms": 3566140,
            "end_ms": 3567060,
            "text": "狼人追刀"
          },
          {
            "index": 1880,
            "source_segment_index": 1880,
            "start_ms": 3567060,
            "end_ms": 3567820,
            "text": "8号守卫"
          },
          {
            "index": 1881,
            "source_segment_index": 1881,
            "start_ms": 3567820,
            "end_ms": 3568660,
            "text": "8号守卫单死"
          },
          {
            "index": 1882,
            "source_segment_index": 1882,
            "start_ms": 3568660,
            "end_ms": 3571870,
            "text": "当夜通灵师验证了7号玩家为平民身份"
          },
          {
            "index": 1883,
            "source_segment_index": 1883,
            "start_ms": 3571870,
            "end_ms": 3573430,
            "text": "在第三天的白天场上"
          },
          {
            "index": 1884,
            "source_segment_index": 1884,
            "start_ms": 3573430,
            "end_ms": 3575770,
            "text": "最后一狼12号选择自爆"
          },
          {
            "index": 1885,
            "source_segment_index": 1885,
            "start_ms": 3575770,
            "end_ms": 3576750,
            "text": "游戏结束"
          },
          {
            "index": 1886,
            "source_segment_index": 1886,
            "start_ms": 3576750,
            "end_ms": 3577890,
            "text": "好人阵营获胜"
          },
          {
            "index": 1887,
            "source_segment_index": 1887,
            "start_ms": 3577890,
            "end_ms": 3580410,
            "text": "以上8月也不算哦"
          },
          {
            "index": 1888,
            "source_segment_index": 1888,
            "start_ms": 3580410,
            "end_ms": 3581180,
            "text": "好的"
          },
          {
            "index": 1889,
            "source_segment_index": 1889,
            "start_ms": 3581180,
            "end_ms": 3583620,
            "text": "以上是我们今天三局版型的全部内容"
          },
          {
            "index": 1890,
            "source_segment_index": 1890,
            "start_ms": 3583620,
            "end_ms": 3586360,
            "text": "然后稍后或为各位额外增加一局"
          },
          {
            "index": 1891,
            "source_segment_index": 1891,
            "start_ms": 3586360,
            "end_ms": 3588820,
            "text": "四狼八列的对局是一个娱乐版型"
          },
          {
            "index": 1892,
            "source_segment_index": 1892,
            "start_ms": 3588820,
            "end_ms": 3589340,
            "text": "不算积分"
          },
          {
            "index": 1893,
            "source_segment_index": 1893,
            "start_ms": 3589340,
            "end_ms": 3591220,
            "text": "是一个非常惊险刺激的游戏"
          },
          {
            "index": 1894,
            "source_segment_index": 1894,
            "start_ms": 3591220,
            "end_ms": 3593740,
            "text": "然后希望各位家人们稍后来到我们哦"
          },
          {
            "index": 1895,
            "source_segment_index": 1895,
            "start_ms": 3593740,
            "end_ms": 3595180,
            "text": "我们会先切解说间啊"
          },
          {
            "index": 1896,
            "source_segment_index": 1896,
            "start_ms": 3595180,
            "end_ms": 3597760,
            "text": "然后我们一会会来一个四郎八类的轻松局"
          },
          {
            "index": 1897,
            "source_segment_index": 1897,
            "start_ms": 3597760,
            "end_ms": 3599680,
            "text": "因为我们确实是决赛周的第一天"
          },
          {
            "index": 1898,
            "source_segment_index": 1898,
            "start_ms": 3599680,
            "end_ms": 3601960,
            "text": "然后也希望呃不会有额外的积分"
          },
          {
            "index": 1899,
            "source_segment_index": 1899,
            "start_ms": 3601960,
            "end_ms": 3603440,
            "text": "影响到我们的对局的观赏性"
          },
          {
            "index": 1900,
            "source_segment_index": 1900,
            "start_ms": 3603440,
            "end_ms": 3605000,
            "text": "然后影响到我们选手的积分"
          },
          {
            "index": 1901,
            "source_segment_index": 1901,
            "start_ms": 3605000,
            "end_ms": 3606520,
            "text": "来感谢各位家人的陪伴"
          },
          {
            "index": 1902,
            "source_segment_index": 1902,
            "start_ms": 3606520,
            "end_ms": 3608520,
            "text": "因为现在是十点的15分啊"
          },
          {
            "index": 1903,
            "source_segment_index": 1903,
            "start_ms": 3608520,
            "end_ms": 3609180,
            "text": "稍后回来"
          },
          {
            "index": 1904,
            "source_segment_index": 1904,
            "start_ms": 3609180,
            "end_ms": 3611680,
            "text": "然后我们再一次跟各位来通知一下"
          },
          {
            "index": 1905,
            "source_segment_index": 1905,
            "start_ms": 3611680,
            "end_ms": 3614500,
            "text": "我们在呃周五晚上的一个带货活动啊"
          },
          {
            "index": 1906,
            "source_segment_index": 1906,
            "start_ms": 3614500,
            "end_ms": 3617620,
            "text": "在本周五晚18点将会迎来我们京城大师赛"
          },
          {
            "index": 1907,
            "source_segment_index": 1907,
            "start_ms": 3617620,
            "end_ms": 3618340,
            "text": "周边带货"
          },
          {
            "index": 1908,
            "source_segment_index": 1908,
            "start_ms": 3618340,
            "end_ms": 3621780,
            "text": "是我们这一款我们的逻辑兽"
          },
          {
            "index": 1909,
            "source_segment_index": 1909,
            "start_ms": 3621780,
            "end_ms": 3623780,
            "text": "还有我们的这个非常精美的帆布包"
          },
          {
            "index": 1910,
            "source_segment_index": 1910,
            "start_ms": 3623780,
            "end_ms": 3626220,
            "text": "帆布包也是一个非常漂亮的浅蓝色"
          },
          {
            "index": 1911,
            "source_segment_index": 1911,
            "start_ms": 3626220,
            "end_ms": 3629040,
            "text": "然后我们罗辑兽也是一个可爱的明黄色"
          },
          {
            "index": 1912,
            "source_segment_index": 1912,
            "start_ms": 3629040,
            "end_ms": 3630080,
            "text": "柔软的小玩偶"
          },
          {
            "index": 1913,
            "source_segment_index": 1913,
            "start_ms": 3630080,
            "end_ms": 3631920,
            "text": "然后能够给各位在夏天"
          },
          {
            "index": 1914,
            "source_segment_index": 1914,
            "start_ms": 3631920,
            "end_ms": 3633870,
            "text": "增加非常多的鲜艳的色彩"
          },
          {
            "index": 1915,
            "source_segment_index": 1915,
            "start_ms": 3633870,
            "end_ms": 3635430,
            "text": "所以各位家人们如果喜欢"
          },
          {
            "index": 1916,
            "source_segment_index": 1916,
            "start_ms": 3635430,
            "end_ms": 3637390,
            "text": "可以在周五晚上的18点整"
          },
          {
            "index": 1917,
            "source_segment_index": 1917,
            "start_ms": 3637390,
            "end_ms": 3640110,
            "text": "就周五晚上六点来到我们京师甄选直播间"
          },
          {
            "index": 1918,
            "source_segment_index": 1918,
            "start_ms": 3640110,
            "end_ms": 3641460,
            "text": "观看一下我们的带货"
          },
          {
            "index": 1919,
            "source_segment_index": 1919,
            "start_ms": 3641460,
            "end_ms": 3643700,
            "text": "然后我们当天也是先到先得"
          },
          {
            "index": 1920,
            "source_segment_index": 1920,
            "start_ms": 3643700,
            "end_ms": 3644300,
            "text": "数量有限"
          },
          {
            "index": 1921,
            "source_segment_index": 1921,
            "start_ms": 3644300,
            "end_ms": 3645060,
            "text": "预购从速"
          },
          {
            "index": 1922,
            "source_segment_index": 1922,
            "start_ms": 3645060,
            "end_ms": 3646660,
            "text": "同样的在明天下午"
          },
          {
            "index": 1923,
            "source_segment_index": 1923,
            "start_ms": 3646660,
            "end_ms": 3649350,
            "text": "也就是周三下午的16点整"
          },
          {
            "index": 1924,
            "source_segment_index": 1924,
            "start_ms": 3649350,
            "end_ms": 3651070,
            "text": "会由徐恩宇老师带来"
          },
          {
            "index": 1925,
            "source_segment_index": 1925,
            "start_ms": 3651070,
            "end_ms": 3655300,
            "text": "我们迪士尼迷奇侦探系列的玩偶的首发带货"
          },
          {
            "index": 1926,
            "source_segment_index": 1926,
            "start_ms": 3655300,
            "end_ms": 3656900,
            "text": "然后希望各位家人们如果喜欢"
          },
          {
            "index": 1927,
            "source_segment_index": 1927,
            "start_ms": 3656900,
            "end_ms": 3659230,
            "text": "可以来到京师甄选直播间关注一下"
          },
          {
            "index": 1928,
            "source_segment_index": 1928,
            "start_ms": 3659230,
            "end_ms": 3661750,
            "text": "同样的再一次感谢本赛季的赞助商"
          },
          {
            "index": 1929,
            "source_segment_index": 1929,
            "start_ms": 3661750,
            "end_ms": 3664460,
            "text": "感谢天天狼人app对我们节目的冠名赞助支持"
          },
          {
            "index": 1930,
            "source_segment_index": 1930,
            "start_ms": 3664460,
            "end_ms": 3666620,
            "text": "各位家人们可以随时来到各大应用平台"
          },
          {
            "index": 1931,
            "source_segment_index": 1931,
            "start_ms": 3666620,
            "end_ms": 3668380,
            "text": "搜索并下载天天狼人app"
          },
          {
            "index": 1932,
            "source_segment_index": 1932,
            "start_ms": 3668380,
            "end_ms": 3670020,
            "text": "就可以跟我们一起来玩京城大师赛"
          },
          {
            "index": 1933,
            "source_segment_index": 1933,
            "start_ms": 3670020,
            "end_ms": 3671529,
            "text": "同款的网上游戏了"
          },
          {
            "index": 1934,
            "source_segment_index": 1934,
            "start_ms": 3671529,
            "end_ms": 3674309,
            "text": "同样也再次感谢本赛季的特约赞助商"
          },
          {
            "index": 1935,
            "source_segment_index": 1935,
            "start_ms": 3674309,
            "end_ms": 3676369,
            "text": "感谢懒痴霞哈尼牧场"
          },
          {
            "index": 1936,
            "source_segment_index": 1936,
            "start_ms": 3676369,
            "end_ms": 3678790,
            "text": "以及柠檬共和国对我们节目的支持"
          },
          {
            "index": 1937,
            "source_segment_index": 1937,
            "start_ms": 3678790,
            "end_ms": 3681270,
            "text": "各位家人们可以来到这位大师个人主页橱窗内"
          },
          {
            "index": 1938,
            "source_segment_index": 1938,
            "start_ms": 3681270,
            "end_ms": 3682820,
            "text": "随时进行下单补货"
          },
          {
            "index": 1939,
            "source_segment_index": 1939,
            "start_ms": 3682820,
            "end_ms": 3685300,
            "text": "那么接下来导播老师会优先把镜头移交出我们"
          },
          {
            "index": 1940,
            "source_segment_index": 1940,
            "start_ms": 3685300,
            "end_ms": 3685820,
            "text": "第二现场"
          },
          {
            "index": 1941,
            "source_segment_index": 1941,
            "start_ms": 3685820,
            "end_ms": 3688060,
            "text": "两位解说老师会对我们第三局机械狼通灵师"
          },
          {
            "index": 1942,
            "source_segment_index": 1942,
            "start_ms": 3688060,
            "end_ms": 3689020,
            "text": "进行简单复盘"
          }
        ],
