        "evidence": [
          {
            "index": 2485,
            "source_segment_index": 2485,
            "start_ms": 4813900,
            "end_ms": 4814720,
            "text": "一是狼"
          },
          {
            "index": 2486,
            "source_segment_index": 2486,
            "start_ms": 4814720,
            "end_ms": 4815900,
            "text": "一是狼头狼"
          },
          {
            "index": 2487,
            "source_segment_index": 2487,
            "start_ms": 4815900,
            "end_ms": 4816760,
            "text": "都是狼"
          },
          {
            "index": 2488,
            "source_segment_index": 2488,
            "start_ms": 4816760,
            "end_ms": 4820640,
            "text": "哼给各位弹幕老师们做本局局的复盘"
          },
          {
            "index": 2489,
            "source_segment_index": 2489,
            "start_ms": 4820640,
            "end_ms": 4823820,
            "text": "本剧版星英语列白混血儿神阵营原家7号女巫"
          },
          {
            "index": 2490,
            "source_segment_index": 2490,
            "start_ms": 4823820,
            "end_ms": 4824520,
            "text": "9号猎人"
          },
          {
            "index": 2491,
            "source_segment_index": 2491,
            "start_ms": 4824520,
            "end_ms": 4827200,
            "text": "12号白神3号狼人阵营一号2号八号"
          },
          {
            "index": 2492,
            "source_segment_index": 2492,
            "start_ms": 4827200,
            "end_ms": 4830270,
            "text": "11号平民阵营4号六号"
          },
          {
            "index": 2493,
            "source_segment_index": 2493,
            "start_ms": 4830270,
            "end_ms": 4831970,
            "text": "10号混血儿5号"
          },
          {
            "index": 2494,
            "source_segment_index": 2494,
            "start_ms": 4831970,
            "end_ms": 4835690,
            "text": "本游戏狼人混首页混选选择8号狼人为榜样"
          },
          {
            "index": 2495,
            "source_segment_index": 2495,
            "start_ms": 4835690,
            "end_ms": 4838050,
            "text": "形成狼人或狼人击杀10号平民女王救起"
          },
          {
            "index": 2496,
            "source_segment_index": 2496,
            "start_ms": 4838050,
            "end_ms": 4840200,
            "text": "形成平安夜预言家验证"
          },
          {
            "index": 2497,
            "source_segment_index": 2497,
            "start_ms": 4840200,
            "end_ms": 4841760,
            "text": "11号玩家伪狼人身份"
          },
          {
            "index": 2498,
            "source_segment_index": 2498,
            "start_ms": 4841760,
            "end_ms": 4842780,
            "text": "在警上竞选环节"
          },
          {
            "index": 2499,
            "source_segment_index": 2499,
            "start_ms": 4842780,
            "end_ms": 4844180,
            "text": "8号狼人选择自爆"
          },
          {
            "index": 2500,
            "source_segment_index": 2500,
            "start_ms": 4844180,
            "end_ms": 4847220,
            "text": "入夜狼人击杀3号白神女巫技能空过"
          },
          {
            "index": 2501,
            "source_segment_index": 2501,
            "start_ms": 4847220,
            "end_ms": 4848020,
            "text": "预言家验证"
          },
          {
            "index": 2502,
            "source_segment_index": 2502,
            "start_ms": 4848020,
            "end_ms": 4850040,
            "text": "6号玩家平民为好人身份"
          },
          {
            "index": 2503,
            "source_segment_index": 2503,
            "start_ms": 4850040,
            "end_ms": 4851880,
            "text": "在第二天延期竞演环节"
          },
          {
            "index": 2504,
            "source_segment_index": 2504,
            "start_ms": 4851880,
            "end_ms": 4853120,
            "text": "11号狼人选择自爆"
          },
          {
            "index": 2505,
            "source_segment_index": 2505,
            "start_ms": 4853120,
            "end_ms": 4854220,
            "text": "本局游戏警徽流失"
          },
          {
            "index": 2506,
            "source_segment_index": 2506,
            "start_ms": 4854220,
            "end_ms": 4855940,
            "text": "入夜狼人击杀7号预言家"
          },
          {
            "index": 2507,
            "source_segment_index": 2507,
            "start_ms": 4855940,
            "end_ms": 4858940,
            "text": "预言家验证10号玩家平民为好人身份"
          },
          {
            "index": 2508,
            "source_segment_index": 2508,
            "start_ms": 4858940,
            "end_ms": 4861310,
            "text": "7号玩家单死在第三天白天"
          },
          {
            "index": 2509,
            "source_segment_index": 2509,
            "start_ms": 4861310,
            "end_ms": 4863370,
            "text": "一号狼人被公投出局"
          },
          {
            "index": 2510,
            "source_segment_index": 2510,
            "start_ms": 4863370,
            "end_ms": 4867980,
            "text": "入夜狼人击杀6号平民牛毒杀4号平民"
          },
          {
            "index": 2511,
            "source_segment_index": 2511,
            "start_ms": 4867980,
            "end_ms": 4871480,
            "text": "当夜4号六号双死在第四天白天"
          },
          {
            "index": 2512,
            "source_segment_index": 2512,
            "start_ms": 4871480,
            "end_ms": 4874340,
            "text": "10号平民被抗推出局后"
          },
          {
            "index": 2513,
            "source_segment_index": 2513,
            "start_ms": 4874340,
            "end_ms": 4875260,
            "text": "狼队拍刀"
          },
          {
            "index": 2514,
            "source_segment_index": 2514,
            "start_ms": 4875260,
            "end_ms": 4877920,
            "text": "5号混血儿快交成功"
          },
          {
            "index": 2515,
            "source_segment_index": 2515,
            "start_ms": 4877920,
            "end_ms": 4879180,
            "text": "游戏结束"
          },
          {
            "index": 2516,
            "source_segment_index": 2516,
            "start_ms": 4879180,
            "end_ms": 4880520,
            "text": "狼人阵营获胜"
          },
          {
            "index": 2517,
            "source_segment_index": 2517,
            "start_ms": 4880520,
            "end_ms": 4881740,
            "text": "以上是我们今天第一局"
          },
          {
            "index": 2518,
            "source_segment_index": 2518,
            "start_ms": 4881740,
            "end_ms": 4883300,
            "text": "预女猎白混血儿的全部内容"
          },
          {
            "index": 2519,
            "source_segment_index": 2519,
            "start_ms": 4883300,
            "end_ms": 4885190,
            "text": "非常感谢各位弹幕老师的陪伴"
          },
          {
            "index": 2520,
            "source_segment_index": 2520,
            "start_ms": 4885190,
            "end_ms": 4887270,
            "text": "这里是京城大师赛第21赛季"
          },
          {
            "index": 2521,
            "source_segment_index": 2521,
            "start_ms": 4887270,
            "end_ms": 4888630,
            "text": "葵曲奇谭的直播现场"
          },
          {
            "index": 2522,
            "source_segment_index": 2522,
            "start_ms": 4888630,
            "end_ms": 4891620,
            "text": "再一次感谢天狼up对我们节目的冠名赞助支持"
          },
          {
            "index": 2523,
            "source_segment_index": 2523,
            "start_ms": 4891620,
            "end_ms": 4893900,
            "text": "各位家人们可以随时来到各大应用平台"
          },
          {
            "index": 2524,
            "source_segment_index": 2524,
            "start_ms": 4893900,
            "end_ms": 4896000,
            "text": "搜索并下载天天狼人app"
          },
          {
            "index": 2525,
            "source_segment_index": 2525,
            "start_ms": 4896000,
            "end_ms": 4897980,
            "text": "就可以跟我们一起来玩网上游戏了"
          },
          {
            "index": 2526,
            "source_segment_index": 2526,
            "start_ms": 4897980,
            "end_ms": 4900060,
            "text": "同样感谢本赛季特约赞助商"
          },
          {
            "index": 2527,
            "source_segment_index": 2527,
            "start_ms": 4900060,
            "end_ms": 4901620,
            "text": "感谢柠檬共和国"
          },
          {
            "index": 2528,
            "source_segment_index": 2528,
            "start_ms": 4901620,
            "end_ms": 4903480,
            "text": "感谢懒赤霞以及哈尼牧场"
          },
          {
            "index": 2529,
            "source_segment_index": 2529,
            "start_ms": 4903480,
            "end_ms": 4905059,
            "text": "对我们节目的大力支持"
          },
          {
            "index": 2530,
            "source_segment_index": 2530,
            "start_ms": 4905059,
            "end_ms": 4906959,
            "text": "各位家人们也可以来到JY"
          },
          {
            "index": 2531,
            "source_segment_index": 2531,
            "start_ms": 4906959,
            "end_ms": 4908899,
            "text": "JY戴士的个人主页橱窗内"
          },
          {
            "index": 2532,
            "source_segment_index": 2532,
            "start_ms": 4908899,
            "end_ms": 4910500,
            "text": "随时进行下单补货"
          },
          {
            "index": 2533,
            "source_segment_index": 2533,
            "start_ms": 4910500,
            "end_ms": 4911940,
            "text": "那么接下来请导播老师"
          },
          {
            "index": 2534,
            "source_segment_index": 2534,
            "start_ms": 4911940,
            "end_ms": 4913620,
            "text": "帮我把镜头移交至第二现场"
          },
          {
            "index": 2535,
            "source_segment_index": 2535,
            "start_ms": 4913620,
            "end_ms": 4916549,
            "text": "两位解说老师会对本游戏进行简单复盘"
          },
          {
            "index": 2536,
            "source_segment_index": 2536,
            "start_ms": 4916549,
            "end_ms": 4919269,
            "text": "稍后回来会是我们第二局假面舞会"
          },
          {
            "index": 2537,
            "source_segment_index": 2537,
            "start_ms": 4919269,
            "end_ms": 4922680,
            "text": "一会见我不在假面"
          },
          {
            "index": 2538,
            "source_segment_index": 2538,
            "start_ms": 4932480,
            "end_ms": 4936930,
            "text": "大师赛原创版型假面舞会阵营分别为神职阵营"
          },
          {
            "index": 2539,
            "source_segment_index": 2539,
            "start_ms": 4936930,
            "end_ms": 4938690,
            "text": "狼人阵营和平民阵营"
          },
          {
            "index": 2540,
            "source_segment_index": 2540,
            "start_ms": 4938690,
            "end_ms": 4940610,
            "text": "在神职阵营中分为预言家"
          },
          {
            "index": 2541,
            "source_segment_index": 2541,
            "start_ms": 4940610,
            "end_ms": 4941090,
            "text": "女巫"
          },
          {
            "index": 2542,
            "source_segment_index": 2542,
            "start_ms": 4941090,
            "end_ms": 4942360,
            "text": "白痴和舞者"
          },
          {
            "index": 2543,
            "source_segment_index": 2543,
            "start_ms": 4942360,
            "end_ms": 4944900,
            "text": "舞者从第二页开始才能发动技能"
          },
          {
            "index": 2544,
            "source_segment_index": 2544,
            "start_ms": 4944900,
            "end_ms": 4946680,
            "text": "且每晚必须发动技能"
          },
          {
            "index": 2545,
            "source_segment_index": 2545,
            "start_ms": 4946680,
            "end_ms": 4949430,
            "text": "舞者每晚选择三名玩家进入50共五"
          },
          {
            "index": 2546,
            "source_segment_index": 2546,
            "start_ms": 4949430,
            "end_ms": 4950810,
            "text": "舞池中的三名玩家"
          },
          {
            "index": 2547,
            "source_segment_index": 2547,
            "start_ms": 4950810,
            "end_ms": 4953210,
            "text": "同为好人阵营或同为狼人阵营时"
          },
          {
            "index": 2548,
            "source_segment_index": 2548,
            "start_ms": 4953210,
            "end_ms": 4954770,
            "text": "舞池里无事发生"
          },
          {
            "index": 2549,
            "source_segment_index": 2549,
            "start_ms": 4954770,
            "end_ms": 4955790,
            "text": "舞池中的玩家"
          },
          {
            "index": 2550,
            "source_segment_index": 2550,
            "start_ms": 4955790,
            "end_ms": 4958989,
            "text": "如果为不同阵营人数少的一方被五出局"
          },
          {
            "index": 2551,
            "source_segment_index": 2551,
            "start_ms": 4958989,
            "end_ms": 4961029,
            "text": "武者选择自己进入舞池时"
          },
          {
            "index": 2552,
            "source_segment_index": 2552,
            "start_ms": 4961029,
            "end_ms": 4963209,
            "text": "当夜舞池中的三人免疫狼刀"
          },
          {
            "index": 2553,
            "source_segment_index": 2553,
            "start_ms": 4963209,
            "end_ms": 4964440,
            "text": "需要注意的是"
          },
          {
            "index": 2554,
            "source_segment_index": 2554,
            "start_ms": 4964440,
            "end_ms": 4967490,
            "text": "整局游戏每名玩家只可进入一次舞池"
          },
          {
            "index": 2555,
            "source_segment_index": 2555,
            "start_ms": 4967490,
            "end_ms": 4970630,
            "text": "并且当剩余可进入舞池的玩家不足三人时"
          },
          {
            "index": 2556,
            "source_segment_index": 2556,
            "start_ms": 4970630,
            "end_ms": 4972290,
            "text": "舞者不可发动技能"
          },
          {
            "index": 2557,
            "source_segment_index": 2557,
            "start_ms": 4972290,
            "end_ms": 4974010,
            "text": "舞者免疫女巫的毒药"
          },
          {
            "index": 2558,
            "source_segment_index": 2558,
            "start_ms": 4974010,
            "end_ms": 4976260,
            "text": "在狼人阵营中分为三名"
          },
          {
            "index": 2559,
            "source_segment_index": 2559,
            "start_ms": 4976260,
            "end_ms": 4977180,
            "text": "狼人和假面"
          },
          {
            "index": 2560,
            "source_segment_index": 2560,
            "start_ms": 4977180,
            "end_ms": 4978400,
            "text": "从第二页起"
          },
          {
            "index": 2561,
            "source_segment_index": 2561,
            "start_ms": 4978400,
            "end_ms": 4981360,
            "text": "假面可以查验一名玩家是否在武士当中"
          },
          {
            "index": 2562,
            "source_segment_index": 2562,
            "start_ms": 4981360,
            "end_ms": 4983700,
            "text": "假面连续两晚不可确认同一人"
          },
          {
            "index": 2563,
            "source_segment_index": 2563,
            "start_ms": 4983700,
            "end_ms": 4986500,
            "text": "然后选择给予场上任意一名玩家面具"
          },
          {
            "index": 2564,
            "source_segment_index": 2564,
            "start_ms": 4986500,
            "end_ms": 4989260,
            "text": "当夜带有面具的玩家进入舞池时"
          },
          {
            "index": 2565,
            "source_segment_index": 2565,
            "start_ms": 4989260,
            "end_ms": 4992660,
            "text": "将被视为相反阵营的玩家进行结算"
          },
          {
            "index": 2566,
            "source_segment_index": 2566,
            "start_ms": 4993390,
            "end_ms": 4994030,
            "text": "Oh no"
          },
          {
            "index": 2567,
            "source_segment_index": 2567,
            "start_ms": 4994030,
            "end_ms": 4996710,
            "text": "假面连续两晚不可给予同一名玩家面具"
          },
          {
            "index": 2568,
            "source_segment_index": 2568,
            "start_ms": 4996710,
            "end_ms": 4997970,
            "text": "需要注意的是"
          },
          {
            "index": 2569,
            "source_segment_index": 2569,
            "start_ms": 4997970,
            "end_ms": 5000430,
            "text": "假面与其他狼人同伴互不见面"
          },
          {
            "index": 2570,
            "source_segment_index": 2570,
            "start_ms": 5000430,
            "end_ms": 5001730,
            "text": "且假面不能自爆"
          },
          {
            "index": 2571,
            "source_segment_index": 2571,
            "start_ms": 5001730,
            "end_ms": 5003670,
            "text": "当其他狼人全部出局时"
          },
          {
            "index": 2572,
            "source_segment_index": 2572,
            "start_ms": 5003670,
            "end_ms": 5006150,
            "text": "假面方可行使狼人基本击杀技能"
          },
          {
            "index": 2573,
            "source_segment_index": 2573,
            "start_ms": 5006150,
            "end_ms": 5007510,
            "text": "及每晚可以刀人"
          },
          {
            "index": 2574,
            "source_segment_index": 2574,
            "start_ms": 5007510,
            "end_ms": 5009430,
            "text": "假面同样免疫女巫毒药"
          },
          {
            "index": 2575,
            "source_segment_index": 2575,
            "start_ms": 5009430,
            "end_ms": 5011260,
            "text": "本版型采用屠边规则"
          },
          {
            "index": 2576,
            "source_segment_index": 2576,
            "start_ms": 5011260,
            "end_ms": 5013620,
            "text": "及其中任一阵营玩家全部出局时"
          },
          {
            "index": 2577,
            "source_segment_index": 2577,
            "start_ms": 5013620,
            "end_ms": 5015500,
            "text": "则对立阵营获胜"
          }
        ],
