      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "death_or_night_result_candidate",
      "start_ms": 2175895,
      "end_ms": 2182290,
      "text": "就这个昨夜多岛死亡顺序不分先后五号、六号、七号倒牌没有遗言。",
      "source_segment_index": 1122,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 2377195,
      "end_ms": 2379295,
      "text": "这边投给投给九号，",
      "source_segment_index": 1212,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 2740115,
      "end_ms": 2741750,
      "text": "而且辩票投票给九号玩家，",
