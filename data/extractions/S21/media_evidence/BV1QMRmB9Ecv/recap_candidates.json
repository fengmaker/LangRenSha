        "evidence": [
          {
            "index": 2330,
            "source_segment_index": 2330,
            "start_ms": 4614610,
            "end_ms": 4614890,
            "text": "我靠，"
          },
          {
            "index": 2331,
            "source_segment_index": 2331,
            "start_ms": 4614890,
            "end_ms": 4615870,
            "text": "你砍我都已经，"
          },
          {
            "index": 2332,
            "source_segment_index": 2332,
            "start_ms": 4615870,
            "end_ms": 4616730,
            "text": "你可弹一场就赢了。"
          },
          {
            "index": 2333,
            "source_segment_index": 2333,
            "start_ms": 4616730,
            "end_ms": 4617830,
            "text": "对我肯定得三十了，"
          },
          {
            "index": 2334,
            "source_segment_index": 2334,
            "start_ms": 4617830,
            "end_ms": 4618825,
            "text": "因为他没一套身份，"
          },
          {
            "index": 2335,
            "source_segment_index": 2335,
            "start_ms": 4619010,
            "end_ms": 4619760,
            "text": "我肯定要走的。"
          },
          {
            "index": 2336,
            "source_segment_index": 2336,
            "start_ms": 4620500,
            "end_ms": 4621465,
            "text": "三主任没做生日。"
          },
          {
            "index": 2337,
            "source_segment_index": 2337,
            "start_ms": 4622470,
            "end_ms": 4622630,
            "text": "对，"
          },
          {
            "index": 2338,
            "source_segment_index": 2338,
            "start_ms": 4622630,
            "end_ms": 4623655,
            "text": "对我得要归他。"
          },
          {
            "index": 2339,
            "source_segment_index": 2339,
            "start_ms": 4623960,
            "end_ms": 4624200,
            "text": "好，"
          },
          {
            "index": 2340,
            "source_segment_index": 2340,
            "start_ms": 4624200,
            "end_ms": 4625720,
            "text": "给各位弹幕老师们做一下本游戏。"
          },
          {
            "index": 2341,
            "source_segment_index": 2341,
            "start_ms": 4625720,
            "end_ms": 4627580,
            "text": "戏复盘本局版型为机械狼，"
          },
          {
            "index": 2342,
            "source_segment_index": 2342,
            "start_ms": 4627580,
            "end_ms": 4631850,
            "text": "灵灵师说漏他有一点伤神。"
          },
          {
            "index": 2343,
            "source_segment_index": 2343,
            "start_ms": 4631850,
            "end_ms": 4638600,
            "text": "人阵营通灵师十二号女巫五号猎人七号守卫三号狼人阵营二号、六号九号，"
          },
          {
            "index": 2344,
            "source_segment_index": 2344,
            "start_ms": 4638680,
            "end_ms": 4645880,
            "text": "机械狼一号本局游戏为机械女巫平民阵营四号、八号、十号、十一号首夜守卫技能空过，"
          },
          {
            "index": 2345,
            "source_segment_index": 2345,
            "start_ms": 4646040,
            "end_ms": 4648900,
            "text": "狼人击杀十一号平民牛要救起，"
          },
          {
            "index": 2346,
            "source_segment_index": 2346,
            "start_ms": 4648940,
            "end_ms": 4653270,
            "text": "形成平安夜机械狼模仿五号女巫本游戏为机械女巫，"
          },
          {
            "index": 2347,
            "source_segment_index": 2347,
            "start_ms": 4653270,
            "end_ms": 4656005,
            "text": "通灵师验证了七号玩家为猎人身份。"
          },
          {
            "index": 2348,
            "source_segment_index": 2348,
            "start_ms": 4656330,
            "end_ms": 4657730,
            "text": "在警上竞选环节，"
          },
          {
            "index": 2349,
            "source_segment_index": 2349,
            "start_ms": 4657850,
            "end_ms": 4659550,
            "text": "两轮平票本局游戏警徽流失。"
          },
          {
            "index": 2350,
            "source_segment_index": 2350,
            "start_ms": 4659610,
            "end_ms": 4660450,
            "text": "在第一天白天，"
          },
          {
            "index": 2351,
            "source_segment_index": 2351,
            "start_ms": 4660530,
            "end_ms": 4662105,
            "text": "九号狼人选择自爆，"
          },
          {
            "index": 2352,
            "source_segment_index": 2352,
            "start_ms": 4662500,
            "end_ms": 4662880,
            "text": "入夜，"
          },
          {
            "index": 2353,
            "source_segment_index": 2353,
            "start_ms": 4662900,
            "end_ms": 4664360,
            "text": "守卫守护三号自守，"
          },
          {
            "index": 2354,
            "source_segment_index": 2354,
            "start_ms": 4664440,
            "end_ms": 4668305,
            "text": "狼人击杀七号猎人牛犊杀六号狼人，"
          },
          {
            "index": 2355,
            "source_segment_index": 2355,
            "start_ms": 4668660,
            "end_ms": 4677300,
            "text": "机械女巫毒杀五号女巫五号六号七号多岛当野通灵师验证了四号玩家为平民身份。"
          },
          {
            "index": 2356,
            "source_segment_index": 2356,
            "start_ms": 4677520,
            "end_ms": 4681185,
            "text": "七号猎人在出去后开枪带走二号狼人。"
          },
          {
            "index": 2357,
            "source_segment_index": 2357,
            "start_ms": 4681550,
            "end_ms": 4682830,
            "text": "在第二天的白天，"
          },
          {
            "index": 2358,
            "source_segment_index": 2358,
            "start_ms": 4682990,
            "end_ms": 4684070,
            "text": "三号守卫，"
          },
          {
            "index": 2359,
            "source_segment_index": 2359,
            "start_ms": 4684210,
            "end_ms": 4688840,
            "text": "被抗推出局入夜机械狼开刀，"
          },
          {
            "index": 2360,
            "source_segment_index": 2360,
            "start_ms": 4688840,
            "end_ms": 4691360,
            "text": "击杀十号平民十号平民单死，"
          },
          {
            "index": 2361,
            "source_segment_index": 2361,
            "start_ms": 4691360,
            "end_ms": 4694315,
            "text": "通灵师查验了一号玩家机械狼为女巫身份。"
          },
          {
            "index": 2362,
            "source_segment_index": 2362,
            "start_ms": 4694640,
            "end_ms": 4695640,
            "text": "在第三天白天，"
          },
          {
            "index": 2363,
            "source_segment_index": 2363,
            "start_ms": 4695700,
            "end_ms": 4698600,
            "text": "场上最后一狼一号机械女巫被公投出局，"
          },
          {
            "index": 2364,
            "source_segment_index": 2364,
            "start_ms": 4698620,
            "end_ms": 4700055,
            "text": "游戏结束好人阵营获胜。"
          },
          {
            "index": 2365,
            "source_segment_index": 2365,
            "start_ms": 4700450,
            "end_ms": 4702350,
            "text": "以上是我们今天三局版型的全部内容，"
          },
          {
            "index": 2366,
            "source_segment_index": 2366,
            "start_ms": 4702350,
            "end_ms": 4707330,
            "text": "也是我们金城大师赛第二十一赛季葵炬集团正规赛的全部内容了啊，"
          },
          {
            "index": 2367,
            "source_segment_index": 2367,
            "start_ms": 4707330,
            "end_ms": 4708350,
            "text": "常规赛的全部内容，"
          },
          {
            "index": 2368,
            "source_segment_index": 2368,
            "start_ms": 4708350,
            "end_ms": 4710305,
            "text": "非常感谢每一位家人的陪伴和支持，"
          },
          {
            "index": 2369,
            "source_segment_index": 2369,
            "start_ms": 4710700,
            "end_ms": 4713520,
            "text": "然后感谢一下苍蝇拍子老师给我投食。"
          },
          {
            "index": 2370,
            "source_segment_index": 2370,
            "start_ms": 4713520,
            "end_ms": 4715180,
            "text": "也再次感谢我们小五老师，"
          },
          {
            "index": 2371,
            "source_segment_index": 2371,
            "start_ms": 4715260,
            "end_ms": 4716655,
            "text": "感谢各位家人们给我投食。"
          },
          {
            "index": 2372,
            "source_segment_index": 2372,
            "start_ms": 4717070,
            "end_ms": 4718710,
            "text": "然后我们本赛季的常规赛已经结束，"
          },
          {
            "index": 2373,
            "source_segment_index": 2373,
            "start_ms": 4718710,
            "end_ms": 4722505,
            "text": "在下周将会迎来我们金融大赛第二十一赛季的决赛周，"
          },
          {
            "index": 2374,
            "source_segment_index": 2374,
            "start_ms": 4722880,
            "end_ms": 4725920,
            "text": "希望下一周的所有玩家们都可以发挥出非常好的成绩。"
          },
          {
            "index": 2375,
            "source_segment_index": 2375,
            "start_ms": 4725940,
            "end_ms": 4727485,
            "text": "然后也感谢各位家人的陪伴，"
          },
          {
            "index": 2376,
            "source_segment_index": 2376,
            "start_ms": 4727870,
            "end_ms": 4730570,
            "text": "再一次感谢天天狼人app对我们节目的冠名赞助支持。"
          },
          {
            "index": 2377,
            "source_segment_index": 2377,
            "start_ms": 4730690,
            "end_ms": 4732690,
            "text": "各位家人们可以随时来到我们各大应用平台，"
          },
          {
            "index": 2378,
            "source_segment_index": 2378,
            "start_ms": 4732750,
            "end_ms": 4734635,
            "text": "搜索并下载天天狼人app,"
          }
        ],
