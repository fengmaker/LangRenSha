      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 1852025,
      "end_ms": 1860485,
      "text": "八号投给九号十号投给七号十一号投给七号十二号投给七号七号九号各四号五九。",
      "source_segment_index": 956,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "night_entry_or_night_command_candidate",
      "start_ms": 1880055,
      "end_ms": 1881890,
      "text": "九号玩家选择自爆天黑请闭眼。",
