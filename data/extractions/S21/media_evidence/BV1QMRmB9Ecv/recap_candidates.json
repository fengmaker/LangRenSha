      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3196220,
      "end_ms": 3197660,
      "text": "十号十一号你就投给九号，",
      "source_segment_index": 1599,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3199930,
      "end_ms": 3200930,
      "text": "所以我就投给九号。",
