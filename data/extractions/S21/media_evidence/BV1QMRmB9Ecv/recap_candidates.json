      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 2753305,
      "end_ms": 2756465,
      "text": "哥没有听平票PK投票给七号玩家的对吧？",
      "source_segment_index": 1398,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3059180,
      "end_ms": 3067080,
      "text": "那么机械女巫是学习了五号为机械女巫牌第一天五号的警下票型是投给七号的。",
      "source_segment_index": 1539,
      "status": "text_cue_candidate_not_verified_as_game_event"
    },
    {
      "type": "vote_cast_words_candidate",
      "start_ms": 3168180,
      "end_ms": 3170680,
      "text": "我如果不是因为听了七号让我投给九号，",
