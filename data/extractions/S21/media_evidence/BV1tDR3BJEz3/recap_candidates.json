        "evidence": [
          {
            "index": 2114,
            "source_segment_index": 2114,
            "start_ms": 4445929,
            "end_ms": 4448460,
            "text": "我我就听两个都不是"
          },
          {
            "index": 2115,
            "source_segment_index": 2115,
            "start_ms": 4448460,
            "end_ms": 4448920,
            "text": "你知道吧"
          },
          {
            "index": 2116,
            "source_segment_index": 2116,
            "start_ms": 4448920,
            "end_ms": 4451340,
            "text": "我就说我就说他是我的那群龙人"
          },
          {
            "index": 2117,
            "source_segment_index": 2117,
            "start_ms": 4451340,
            "end_ms": 4451940,
            "text": "我投给他的"
          },
          {
            "index": 2118,
            "source_segment_index": 2118,
            "start_ms": 4451940,
            "end_ms": 4455350,
            "text": "我就11也不是哇"
          },
          {
            "index": 2119,
            "source_segment_index": 2119,
            "start_ms": 4455350,
            "end_ms": 4458230,
            "text": "来给各位弹幕老师们做本局游戏的复盘"
          },
          {
            "index": 2120,
            "source_segment_index": 2120,
            "start_ms": 4458230,
            "end_ms": 4461230,
            "text": "本局版行为预女猎白混血儿神阵营预言家"
          },
          {
            "index": 2121,
            "source_segment_index": 2121,
            "start_ms": 4461230,
            "end_ms": 4462030,
            "text": "3号女巫"
          },
          {
            "index": 2122,
            "source_segment_index": 2122,
            "start_ms": 4462030,
            "end_ms": 4462870,
            "text": "2号猎人"
          },
          {
            "index": 2123,
            "source_segment_index": 2123,
            "start_ms": 4462870,
            "end_ms": 4463630,
            "text": "8号白神"
          },
          {
            "index": 2124,
            "source_segment_index": 2124,
            "start_ms": 4463630,
            "end_ms": 4466820,
            "text": "10号狼人阵营4号五号"
          },
          {
            "index": 2125,
            "source_segment_index": 2125,
            "start_ms": 4466820,
            "end_ms": 4467540,
            "text": "11号"
          },
          {
            "index": 2126,
            "source_segment_index": 2126,
            "start_ms": 4467540,
            "end_ms": 4470160,
            "text": "12号平民阵营6号七号"
          },
          {
            "index": 2127,
            "source_segment_index": 2127,
            "start_ms": 4470160,
            "end_ms": 4471960,
            "text": "9号混血儿一号"
          },
          {
            "index": 2128,
            "source_segment_index": 2128,
            "start_ms": 4471960,
            "end_ms": 4475599,
            "text": "本游戏狼人混首页混圈选择5号狼人为榜样"
          },
          {
            "index": 2129,
            "source_segment_index": 2129,
            "start_ms": 4475599,
            "end_ms": 4476559,
            "text": "形成狼人或狼人"
          },
          {
            "index": 2130,
            "source_segment_index": 2130,
            "start_ms": 4476559,
            "end_ms": 4479259,
            "text": "击杀9号平民牛羊救起"
          },
          {
            "index": 2131,
            "source_segment_index": 2131,
            "start_ms": 4479259,
            "end_ms": 4480389,
            "text": "形成平安夜"
          },
          {
            "index": 2132,
            "source_segment_index": 2132,
            "start_ms": 4480389,
            "end_ms": 4483790,
            "text": "预言家验证了9号玩家平民为好人身份"
          },
          {
            "index": 2133,
            "source_segment_index": 2133,
            "start_ms": 4483790,
            "end_ms": 4485050,
            "text": "在警上竞选环节"
          },
          {
            "index": 2134,
            "source_segment_index": 2134,
            "start_ms": 4485050,
            "end_ms": 4486750,
            "text": "11号悍跳狼人获得警徽"
          },
          {
            "index": 2135,
            "source_segment_index": 2135,
            "start_ms": 4486750,
            "end_ms": 4490309,
            "text": "第一天白天3号预言家被抗推出局"
          },
          {
            "index": 2136,
            "source_segment_index": 2136,
            "start_ms": 4490309,
            "end_ms": 4493229,
            "text": "入夜狼人击杀2号女巫牛"
          },
          {
            "index": 2137,
            "source_segment_index": 2137,
            "start_ms": 4493229,
            "end_ms": 4494869,
            "text": "毒杀一号混血儿"
          },
          {
            "index": 2138,
            "source_segment_index": 2138,
            "start_ms": 4494869,
            "end_ms": 4496299,
            "text": "一号2号双死"
          },
          {
            "index": 2139,
            "source_segment_index": 2139,
            "start_ms": 4496299,
            "end_ms": 4497959,
            "text": "在第二天的白天"
          },
          {
            "index": 2140,
            "source_segment_index": 2140,
            "start_ms": 4497959,
            "end_ms": 4499419,
            "text": "11号狼人自爆后"
          },
          {
            "index": 2141,
            "source_segment_index": 2141,
            "start_ms": 4499419,
            "end_ms": 4500699,
            "text": "狼人选择拍刀"
          },
          {
            "index": 2142,
            "source_segment_index": 2142,
            "start_ms": 4500699,
            "end_ms": 4502219,
            "text": "10号白神"
          },
          {
            "index": 2143,
            "source_segment_index": 2143,
            "start_ms": 4502219,
            "end_ms": 4507450,
            "text": "6号平民以及7号平民狼人阵营拍刀失败"
          },
          {
            "index": 2144,
            "source_segment_index": 2144,
            "start_ms": 4507450,
            "end_ms": 4508330,
            "text": "游戏结束"
          },
          {
            "index": 2145,
            "source_segment_index": 2145,
            "start_ms": 4508330,
            "end_ms": 4509530,
            "text": "好人阵营获胜"
          },
          {
            "index": 2146,
            "source_segment_index": 2146,
            "start_ms": 4509530,
            "end_ms": 4511130,
            "text": "以上是我们今天第一局预女"
          },
          {
            "index": 2147,
            "source_segment_index": 2147,
            "start_ms": 4511130,
            "end_ms": 4512330,
            "text": "猎白混血儿的全部内容"
          },
          {
            "index": 2148,
            "source_segment_index": 2148,
            "start_ms": 4512330,
            "end_ms": 4514200,
            "text": "非常感谢各位弹幕老师的陪伴"
          },
          {
            "index": 2149,
            "source_segment_index": 2149,
            "start_ms": 4514200,
            "end_ms": 4516760,
            "text": "这里是京城大师赛第21赛季"
          },
          {
            "index": 2150,
            "source_segment_index": 2150,
            "start_ms": 4516760,
            "end_ms": 4518320,
            "text": "葵曲奇谭的直播现场"
          },
          {
            "index": 2151,
            "source_segment_index": 2151,
            "start_ms": 4518320,
            "end_ms": 4519720,
            "text": "再一次感谢天天狼人app"
          },
          {
            "index": 2152,
            "source_segment_index": 2152,
            "start_ms": 4519720,
            "end_ms": 4521680,
            "text": "对我们节目的冠名赞助支持"
          },
          {
            "index": 2153,
            "source_segment_index": 2153,
            "start_ms": 4521680,
            "end_ms": 4524520,
            "text": "同时也再次感谢我们本节目的特约赞助商"
          },
          {
            "index": 2154,
            "source_segment_index": 2154,
            "start_ms": 4524520,
            "end_ms": 4526480,
            "text": "感谢柠檬共和国懒赤霞"
          },
          {
            "index": 2155,
            "source_segment_index": 2155,
            "start_ms": 4526480,
            "end_ms": 4528510,
            "text": "以及哈尼牧场对我们节目的支持"
          },
          {
            "index": 2156,
            "source_segment_index": 2156,
            "start_ms": 4528510,
            "end_ms": 4531270,
            "text": "各位家人们可以随时来到我们歪哥的个人主页"
          },
          {
            "index": 2157,
            "source_segment_index": 2157,
            "start_ms": 4531270,
            "end_ms": 4533030,
            "text": "橱窗内进行下单补货"
          },
          {
            "index": 2158,
            "source_segment_index": 2158,
            "start_ms": 4533030,
            "end_ms": 4533870,
            "text": "那么接下来"
          },
          {
            "index": 2159,
            "source_segment_index": 2159,
            "start_ms": 4533870,
            "end_ms": 4536570,
            "text": "导播老师会优先把我们镜头移交至第二现场"
          },
          {
            "index": 2160,
            "source_segment_index": 2160,
            "start_ms": 4536570,
            "end_ms": 4539590,
            "text": "两位解说老师会对本局峰回路转的一局"
          },
          {
            "index": 2161,
            "source_segment_index": 2161,
            "start_ms": 4539590,
            "end_ms": 4541740,
            "text": "预女猎白混血儿进行简单复盘"
          },
          {
            "index": 2162,
            "source_segment_index": 2162,
            "start_ms": 4541740,
            "end_ms": 4544360,
            "text": "稍后回来会是我们第二局假面舞会"
          },
          {
            "index": 2163,
            "source_segment_index": 2163,
            "start_ms": 4544360,
            "end_ms": 4546140,
            "text": "一会见"
          },
          {
            "index": 2164,
            "source_segment_index": 2164,
            "start_ms": 4576520,
            "end_ms": 4580280,
            "text": "欢迎来到京城大师赛"
          },
          {
            "index": 2165,
            "source_segment_index": 2165,
            "start_ms": 4582860,
            "end_ms": 4587289,
            "text": "大师赛原创版型假面舞会阵营分别为神职阵营"
          },
          {
            "index": 2166,
            "source_segment_index": 2166,
            "start_ms": 4587289,
            "end_ms": 4589029,
            "text": "狼人阵营和平民阵营"
          },
          {
            "index": 2167,
            "source_segment_index": 2167,
            "start_ms": 4589029,
            "end_ms": 4590949,
            "text": "在神职阵营中分为预言家"
          },
          {
            "index": 2168,
            "source_segment_index": 2168,
            "start_ms": 4590949,
            "end_ms": 4591429,
            "text": "女巫"
          },
          {
            "index": 2169,
            "source_segment_index": 2169,
            "start_ms": 4591429,
            "end_ms": 4592710,
            "text": "白痴和舞者"
          },
          {
            "index": 2170,
            "source_segment_index": 2170,
            "start_ms": 4592710,
            "end_ms": 4595250,
            "text": "舞者从第二页开始才能发动技能"
          },
          {
            "index": 2171,
            "source_segment_index": 2171,
            "start_ms": 4595250,
            "end_ms": 4597030,
            "text": "且每晚必须发动技能"
          },
          {
            "index": 2172,
            "source_segment_index": 2172,
            "start_ms": 4597030,
            "end_ms": 4599830,
            "text": "舞者每晚选择三名玩家进入50共五"
          },
          {
            "index": 2173,
            "source_segment_index": 2173,
            "start_ms": 4599830,
            "end_ms": 4601150,
            "text": "舞池中的三名玩家"
          },
          {
            "index": 2174,
            "source_segment_index": 2174,
            "start_ms": 4601150,
            "end_ms": 4603570,
            "text": "同为好人阵营或同为狼人阵营时"
          },
          {
            "index": 2175,
            "source_segment_index": 2175,
            "start_ms": 4603570,
            "end_ms": 4605090,
            "text": "舞池里无事发生"
          },
          {
            "index": 2176,
            "source_segment_index": 2176,
            "start_ms": 4605090,
            "end_ms": 4606170,
            "text": "五池中的玩家"
          },
          {
            "index": 2177,
            "source_segment_index": 2177,
            "start_ms": 4606170,
            "end_ms": 4609329,
            "text": "如果为不同阵营人数少的一方被五出局"
          },
          {
            "index": 2178,
            "source_segment_index": 2178,
            "start_ms": 4609329,
            "end_ms": 4611369,
            "text": "舞者选择自己进入舞池时"
          },
          {
            "index": 2179,
            "source_segment_index": 2179,
            "start_ms": 4611369,
            "end_ms": 4613549,
            "text": "当夜舞池中的三人免疫狼刀"
          },
          {
            "index": 2180,
            "source_segment_index": 2180,
            "start_ms": 4613549,
            "end_ms": 4614780,
            "text": "需要注意的是"
          },
          {
            "index": 2181,
            "source_segment_index": 2181,
            "start_ms": 4614780,
            "end_ms": 4617820,
            "text": "整局游戏每名玩家只可进入一次舞池"
          },
          {
            "index": 2182,
            "source_segment_index": 2182,
            "start_ms": 4617820,
            "end_ms": 4621030,
            "text": "并且当剩余可进入舞池的玩家不足三人时"
          },
          {
            "index": 2183,
            "source_segment_index": 2183,
            "start_ms": 4621030,
            "end_ms": 4622630,
            "text": "舞者不可发动技能"
          },
          {
            "index": 2184,
            "source_segment_index": 2184,
            "start_ms": 4622630,
            "end_ms": 4624370,
            "text": "舞者免疫女巫的毒药"
          },
          {
            "index": 2185,
            "source_segment_index": 2185,
            "start_ms": 4624370,
            "end_ms": 4627529,
            "text": "在狼人阵营中分为三名狼人和假面"
          },
          {
            "index": 2186,
            "source_segment_index": 2186,
            "start_ms": 4627529,
            "end_ms": 4628750,
            "text": "从第二页起"
          },
          {
            "index": 2187,
            "source_segment_index": 2187,
            "start_ms": 4628750,
            "end_ms": 4631710,
            "text": "假面可以查验一名玩家是否在武士当中"
          },
          {
            "index": 2188,
            "source_segment_index": 2188,
            "start_ms": 4631710,
            "end_ms": 4634050,
            "text": "假面连续两晚不可确认同一人"
          },
          {
            "index": 2189,
            "source_segment_index": 2189,
            "start_ms": 4634050,
            "end_ms": 4636850,
            "text": "然后选择给予场上任意一名玩家面具"
          },
          {
            "index": 2190,
            "source_segment_index": 2190,
            "start_ms": 4636850,
            "end_ms": 4639600,
            "text": "当夜带有面具的玩家进入舞池时"
          },
          {
            "index": 2191,
            "source_segment_index": 2191,
            "start_ms": 4639600,
            "end_ms": 4643000,
            "text": "将被视为相反阵营的玩家进行结算"
          },
          {
            "index": 2192,
            "source_segment_index": 2192,
            "start_ms": 4643730,
            "end_ms": 4644370,
            "text": "Oh no"
          },
          {
            "index": 2193,
            "source_segment_index": 2193,
            "start_ms": 4644370,
            "end_ms": 4647050,
            "text": "假面连续两晚不可给予同一名玩家面具"
          },
          {
            "index": 2194,
            "source_segment_index": 2194,
            "start_ms": 4647050,
            "end_ms": 4648309,
            "text": "需要注意的是"
          },
          {
            "index": 2195,
            "source_segment_index": 2195,
            "start_ms": 4648309,
            "end_ms": 4650769,
            "text": "假面与其他狼人同伴互不见面"
          },
          {
            "index": 2196,
            "source_segment_index": 2196,
            "start_ms": 4650769,
            "end_ms": 4652069,
            "text": "且假面不能自爆"
          },
          {
            "index": 2197,
            "source_segment_index": 2197,
            "start_ms": 4652069,
            "end_ms": 4654030,
            "text": "当其他狼人全部出局时"
          },
          {
            "index": 2198,
            "source_segment_index": 2198,
            "start_ms": 4654030,
            "end_ms": 4656490,
            "text": "假面方可行使狼人基本击杀技能"
          },
          {
            "index": 2199,
            "source_segment_index": 2199,
            "start_ms": 4656490,
            "end_ms": 4657850,
            "text": "及每晚可以刀人"
          },
          {
            "index": 2200,
            "source_segment_index": 2200,
            "start_ms": 4657850,
            "end_ms": 4659770,
            "text": "假面同样免疫女巫毒药"
          },
          {
            "index": 2201,
            "source_segment_index": 2201,
            "start_ms": 4659770,
            "end_ms": 4661610,
            "text": "本版型采用屠边规则"
          },
          {
            "index": 2202,
            "source_segment_index": 2202,
            "start_ms": 4661610,
            "end_ms": 4663970,
            "text": "及其中任一阵营玩家全部出局时"
          },
          {
            "index": 2203,
            "source_segment_index": 2203,
            "start_ms": 4663970,
            "end_ms": 4665850,
            "text": "则对立阵营获胜"
          }
        ],
