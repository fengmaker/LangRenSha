            "source_segment_index": 3451,
            "start_ms": 6610330,
            "end_ms": 6612650,
            "text": "但是万一你是猎人"
          },
          {
            "index": 3452,
            "source_segment_index": 3452,
            "start_ms": 6612650,
            "end_ms": 6615810,
            "text": "但是但是我能万一希望猎人无所谓"
          },
          {
            "index": 3453,
            "source_segment_index": 3453,
            "start_ms": 6615810,
            "end_ms": 6619129,
            "text": "我想知好给各位大老师们做下本局游戏的复盘"
          },
          {
            "index": 3454,
            "source_segment_index": 3454,
            "start_ms": 6619129,
            "end_ms": 6625049,
            "text": "祝4日周6日4557开门"
          },
          {
            "index": 3455,
            "source_segment_index": 3455,
            "start_ms": 6625049,
            "end_ms": 6626689,
            "text": "本局版型为机械狼"
          },
          {
            "index": 3456,
            "source_segment_index": 3456,
            "start_ms": 6626689,
            "end_ms": 6627569,
            "text": "通灵师神阵营"
          },
          {
            "index": 3457,
            "source_segment_index": 3457,
            "start_ms": 6627569,
            "end_ms": 6628569,
            "text": "通灵师7号女巫"
          },
          {
            "index": 3458,
            "source_segment_index": 3458,
            "start_ms": 6628569,
            "end_ms": 6629129,
            "text": "8号猎人"
          },
          {
            "index": 3459,
            "source_segment_index": 3459,
            "start_ms": 6629129,
            "end_ms": 6630649,
            "text": "3号守卫4号狼人阵营"
          },
          {
            "index": 3460,
            "source_segment_index": 3460,
            "start_ms": 6630649,
            "end_ms": 6631729,
            "text": "5号六号"
          },
          {
            "index": 3461,
            "source_segment_index": 3461,
            "start_ms": 6631729,
            "end_ms": 6633069,
            "text": "9号机械狼11号"
          },
          {
            "index": 3462,
            "source_segment_index": 3462,
            "start_ms": 6633069,
            "end_ms": 6636450,
            "text": "本局游戏为机械守卫平民阵营"
          },
          {
            "index": 3463,
            "source_segment_index": 3463,
            "start_ms": 6636450,
            "end_ms": 6639960,
            "text": "一号2号十号12号首页守卫守护"
          },
          {
            "index": 3464,
            "source_segment_index": 3464,
            "start_ms": 6639960,
            "end_ms": 6642340,
            "text": "8号女巫狼人击杀11号机械狼"
          },
          {
            "index": 3465,
            "source_segment_index": 3465,
            "start_ms": 6642340,
            "end_ms": 6643040,
            "text": "女巫要救起"
          },
          {
            "index": 3466,
            "source_segment_index": 3466,
            "start_ms": 6643040,
            "end_ms": 6643880,
            "text": "形成平安夜"
          },
          {
            "index": 3467,
            "source_segment_index": 3467,
            "start_ms": 6643880,
            "end_ms": 6645520,
            "text": "机械狼模仿4号守卫"
          },
          {
            "index": 3468,
            "source_segment_index": 3468,
            "start_ms": 6645520,
            "end_ms": 6646990,
            "text": "本局游戏为机械守卫"
          },
          {
            "index": 3469,
            "source_segment_index": 3469,
            "start_ms": 6646990,
            "end_ms": 6650350,
            "text": "通灵师验证了2号玩家为平民身份"
          },
          {
