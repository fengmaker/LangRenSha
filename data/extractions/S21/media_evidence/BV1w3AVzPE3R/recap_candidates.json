            "source_segment_index": 3470,
            "start_ms": 6650350,
            "end_ms": 6651830,
            "text": "在警上竞选环节"
          },
          {
            "index": 3471,
            "source_segment_index": 3471,
            "start_ms": 6651830,
            "end_ms": 6653350,
            "text": "5号悍跳狼人获得警徽"
          },
