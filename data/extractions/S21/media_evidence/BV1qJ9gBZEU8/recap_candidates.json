            "source_segment_index": 3016,
            "start_ms": 5450720,
            "end_ms": 5451280,
            "text": "4号守卫"
          },
          {
            "index": 3017,
            "source_segment_index": 3017,
            "start_ms": 5451280,
            "end_ms": 5452120,
            "text": "11号狼人阵营"
          },
          {
            "index": 3018,
            "source_segment_index": 3018,
            "start_ms": 5452120,
            "end_ms": 5452880,
            "text": "9号十号"
          },
          {
            "index": 3019,
            "source_segment_index": 3019,
            "start_ms": 5452880,
            "end_ms": 5453760,
            "text": "12号机械狼"
          },
          {
            "index": 3020,
            "source_segment_index": 3020,
            "start_ms": 5453760,
            "end_ms": 5456439,
            "text": "7号本就系为机械女巫平民阵营"
          },
          {
            "index": 3021,
            "source_segment_index": 3021,
            "start_ms": 5456439,
            "end_ms": 5459079,
            "text": "一号3号六号八号首夜守卫"
          },
          {
            "index": 3022,
            "source_segment_index": 3022,
            "start_ms": 5459079,
            "end_ms": 5461599,
            "text": "守护4号猎人狼人击杀4号猎人女巫"
          },
          {
            "index": 3023,
            "source_segment_index": 3023,
            "start_ms": 5461599,
            "end_ms": 5462719,
            "text": "解救4号猎人"
          },
          {
            "index": 3024,
            "source_segment_index": 3024,
            "start_ms": 5462719,
            "end_ms": 5464340,
            "text": "4号玩家乃川出局"
          },
          {
            "index": 3025,
            "source_segment_index": 3025,
            "start_ms": 5464340,
            "end_ms": 5466180,
            "text": "机械狼模仿5号女巫"
          },
          {
            "index": 3026,
            "source_segment_index": 3026,
            "start_ms": 5466180,
            "end_ms": 5467940,
            "text": "本局游戏为机械女巫通灵师"
          },
          {
            "index": 3027,
            "source_segment_index": 3027,
            "start_ms": 5467940,
            "end_ms": 5470590,
            "text": "查验了一号玩家为平民身份"
          },
          {
            "index": 3028,
            "source_segment_index": 3028,
            "start_ms": 5470590,
            "end_ms": 5471710,
            "text": "井上竞选环节"
          },
          {
            "index": 3029,
            "source_segment_index": 3029,
            "start_ms": 5471710,
            "end_ms": 5473150,
            "text": "2号通灵失活的警徽"
          },
          {
            "index": 3030,
            "source_segment_index": 3030,
            "start_ms": 5473150,
            "end_ms": 5478630,
            "text": "第一天白天猎人开枪带走了11号守卫"
          },
          {
            "index": 3031,
            "source_segment_index": 3031,
            "start_ms": 5478630,
            "end_ms": 5482520,
            "text": "且第一天白天10号狼人被公投出局"
          },
          {
            "index": 3032,
            "source_segment_index": 3032,
            "start_ms": 5482520,
            "end_ms": 5487080,
            "text": "入夜狼人击杀3号平民女巫毒杀9号狼人"
          },
          {
            "index": 3033,
            "source_segment_index": 3033,
            "start_ms": 5487080,
            "end_ms": 5489040,
            "text": "机械狼毒杀5号女巫"
          },
          {
            "index": 3034,
            "source_segment_index": 3034,
            "start_ms": 5489040,
            "end_ms": 5491890,
            "text": "当夜3号五号九号多岛通灵"
          },
          {
            "index": 3035,
            "source_segment_index": 3035,
            "start_ms": 5491890,
            "end_ms": 5495070,
            "text": "是当验验证了7号玩家机械狼为机械女"
          },
          {
            "index": 3036,
            "source_segment_index": 3036,
            "start_ms": 5495070,
            "end_ms": 5496220,
            "text": "为女巫身份"
          },
          {
            "index": 3037,
            "source_segment_index": 3037,
            "start_ms": 5496220,
            "end_ms": 5497780,
            "text": "在第二天的白天"
          },
          {
            "index": 3038,
            "source_segment_index": 3038,
            "start_ms": 5497780,
            "end_ms": 5500340,
            "text": "7号机械女巫被公投出局"
          },
          {
            "index": 3039,
            "source_segment_index": 3039,
            "start_ms": 5500340,
            "end_ms": 5501540,
            "text": "入野狼人击杀"
          },
          {
            "index": 3040,
            "source_segment_index": 3040,
            "start_ms": 5501540,
            "end_ms": 5502660,
            "text": "场上最后一神"
          },
          {
            "index": 3041,
            "source_segment_index": 3041,
            "start_ms": 5502660,
            "end_ms": 5504700,
            "text": "2号通灵师游戏结束"
          },
          {
            "index": 3042,
            "source_segment_index": 3042,
            "start_ms": 5504700,
            "end_ms": 5506040,
            "text": "狼人阵营"
          },
          {
            "index": 3043,
            "source_segment_index": 3043,
            "start_ms": 5506040,
            "end_ms": 5507520,
            "text": "狼人阵营获胜"
          },
          {
            "index": 3044,
            "source_segment_index": 3044,
            "start_ms": 5507520,
            "end_ms": 5509680,
            "text": "以上是我们今天三局版型的全部内容"
          },
          {
            "index": 3045,
            "source_segment_index": 3045,
            "start_ms": 5509680,
            "end_ms": 5512230,
            "text": "也是我们本周晋城大师赛全部内容"
          },
          {
            "index": 3046,
            "source_segment_index": 3046,
            "start_ms": 5512230,
            "end_ms": 5513990,
            "text": "非常感谢每一位当老师的陪伴"
          },
          {
            "index": 3047,
            "source_segment_index": 3047,
            "start_ms": 5513990,
            "end_ms": 5516450,
            "text": "这里是梦京城大师赛第21赛季"
          },
          {
            "index": 3048,
            "source_segment_index": 3048,
            "start_ms": 5516450,
            "end_ms": 5518070,
            "text": "鬼泣奇谭的直播现场"
          },
          {
            "index": 3049,
            "source_segment_index": 3049,
            "start_ms": 5518070,
            "end_ms": 5520310,
            "text": "也再一次感谢天天狼人app"
          },
          {
            "index": 3050,
            "source_segment_index": 3050,
            "start_ms": 5520310,
            "end_ms": 5522130,
            "text": "对我们节目的冠名赞助支持"
          },
          {
