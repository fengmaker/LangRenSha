        "evidence": [
          {
            "index": 1477,
            "source_segment_index": 1477,
            "start_ms": 3410200,
            "end_ms": 3411680,
            "text": "我们社会是吧"
          },
          {
            "index": 1478,
            "source_segment_index": 1478,
            "start_ms": 3411680,
            "end_ms": 3413260,
            "text": "你们是一群好"
          },
          {
            "index": 1479,
            "source_segment_index": 1479,
            "start_ms": 3413260,
            "end_ms": 3416050,
            "text": "我听到他必须的好人也很疼"
          },
          {
            "index": 1480,
            "source_segment_index": 1480,
            "start_ms": 3416050,
            "end_ms": 3417190,
            "text": "因为紧张的说"
          },
          {
            "index": 1481,
            "source_segment_index": 1481,
            "start_ms": 3417190,
            "end_ms": 3418390,
            "text": "我不太同人"
          },
          {
            "index": 1482,
            "source_segment_index": 1482,
            "start_ms": 3418390,
            "end_ms": 3419810,
            "text": "先发言再自爆"
          },
          {
            "index": 1483,
            "source_segment_index": 1483,
            "start_ms": 3419810,
            "end_ms": 3421350,
            "text": "他是先查五后"
          },
          {
            "index": 1484,
            "source_segment_index": 1484,
            "start_ms": 3421350,
            "end_ms": 3424660,
            "text": "开始给各位弹幕老师们做本游戏的复盘"
          },
          {
            "index": 1485,
            "source_segment_index": 1485,
            "start_ms": 3424660,
            "end_ms": 3426300,
            "text": "本局半星唯一与猎白混血"
          },
          {
            "index": 1486,
            "source_segment_index": 1486,
            "start_ms": 3426300,
            "end_ms": 3427720,
            "text": "而神阵营预言家"
          },
          {
            "index": 1487,
            "source_segment_index": 1487,
            "start_ms": 3427720,
            "end_ms": 3428740,
            "text": "5号女巫"
          },
          {
            "index": 1488,
            "source_segment_index": 1488,
            "start_ms": 3428740,
            "end_ms": 3429820,
            "text": "8号猎人"
          },
          {
            "index": 1489,
            "source_segment_index": 1489,
            "start_ms": 3429820,
            "end_ms": 3430780,
            "text": "12号白神"
          },
          {
            "index": 1490,
            "source_segment_index": 1490,
            "start_ms": 3430780,
            "end_ms": 3433480,
            "text": "3号狼人阵营一号7号"
          },
          {
            "index": 1491,
            "source_segment_index": 1491,
            "start_ms": 3433480,
            "end_ms": 3437520,
            "text": "9号11号平民阵营2号四号六号混血儿10号"
          },
          {
            "index": 1492,
            "source_segment_index": 1492,
            "start_ms": 3437520,
            "end_ms": 3439110,
            "text": "本酒席为好人混"
          },
          {
            "index": 1493,
            "source_segment_index": 1493,
            "start_ms": 3439110,
            "end_ms": 3441630,
            "text": "首页混圈选择5号预言家为榜样"
          },
          {
            "index": 1494,
            "source_segment_index": 1494,
            "start_ms": 3441630,
            "end_ms": 3444030,
            "text": "行程好人昏狼人击杀8号牛牛"
          },
          {
            "index": 1495,
            "source_segment_index": 1495,
            "start_ms": 3444030,
            "end_ms": 3445330,
            "text": "毒杀7号狼人"
          },
          {
            "index": 1496,
            "source_segment_index": 1496,
            "start_ms": 3445330,
            "end_ms": 3448700,
            "text": "7号八号双子预言家验证了4号玩家"
          },
          {
            "index": 1497,
            "source_segment_index": 1497,
            "start_ms": 3448700,
            "end_ms": 3452080,
            "text": "平民为好人身份警上竞选环节"
          },
          {
            "index": 1498,
            "source_segment_index": 1498,
            "start_ms": 3452080,
            "end_ms": 3454279,
            "text": "7号狼人吞毒自爆"
          },
          {
            "index": 1499,
            "source_segment_index": 1499,
            "start_ms": 3454279,
            "end_ms": 3457199,
            "text": "入夜狼人击杀5号预言家"
          },
          {
            "index": 1500,
            "source_segment_index": 1500,
            "start_ms": 3457199,
            "end_ms": 3459799,
            "text": "预言家验证了一号玩家为狼人身份"
          },
          {
            "index": 1501,
            "source_segment_index": 1501,
            "start_ms": 3459799,
            "end_ms": 3462890,
            "text": "当夜没5号预言家单死第二天的白天"
          },
          {
            "index": 1502,
            "source_segment_index": 1502,
            "start_ms": 3462890,
            "end_ms": 3464150,
            "text": "延期竞选环节"
          },
          {
            "index": 1503,
            "source_segment_index": 1503,
            "start_ms": 3464150,
            "end_ms": 3465450,
            "text": "11号狼人选择自爆"
          },
          {
            "index": 1504,
            "source_segment_index": 1504,
            "start_ms": 3465450,
            "end_ms": 3469220,
            "text": "本游戏警徽流失入夜狼人击杀12号猎人"
          },
          {
            "index": 1505,
            "source_segment_index": 1505,
            "start_ms": 3469220,
            "end_ms": 3472190,
            "text": "12号猎人出去后开枪带走一号狼人"
          },
          {
            "index": 1506,
            "source_segment_index": 1506,
            "start_ms": 3472190,
            "end_ms": 3474150,
            "text": "在第三天的白天场上"
          },
          {
            "index": 1507,
            "source_segment_index": 1507,
            "start_ms": 3474150,
            "end_ms": 3476230,
            "text": "最后一狼9号被公投出局"
          },
          {
            "index": 1508,
            "source_segment_index": 1508,
            "start_ms": 3476230,
            "end_ms": 3476890,
            "text": "游戏结束"
          },
          {
            "index": 1509,
            "source_segment_index": 1509,
            "start_ms": 3476890,
            "end_ms": 3478010,
            "text": "好人阵营获胜"
          },
          {
            "index": 1510,
            "source_segment_index": 1510,
            "start_ms": 3478010,
            "end_ms": 3479730,
            "text": "以上是我们今天第一局版型"
          },
          {
            "index": 1511,
            "source_segment_index": 1511,
            "start_ms": 3479730,
            "end_ms": 3481050,
            "text": "预女猎白混血儿的全部内容"
          },
          {
            "index": 1512,
            "source_segment_index": 1512,
            "start_ms": 3481050,
            "end_ms": 3483130,
            "text": "非常感谢各位大老师们能够一直陪伴在我们"
          },
          {
            "index": 1513,
            "source_segment_index": 1513,
            "start_ms": 3483130,
            "end_ms": 3483530,
            "text": "直播间"
          },
          {
            "index": 1514,
            "source_segment_index": 1514,
            "start_ms": 3483530,
            "end_ms": 3484650,
            "text": "感谢LISA"
          },
          {
            "index": 1515,
            "source_segment_index": 1515,
            "start_ms": 3484650,
            "end_ms": 3488180,
            "text": "感谢杰杰杰宝哥的投食"
          },
          {
            "index": 1516,
            "source_segment_index": 1516,
            "start_ms": 3488180,
            "end_ms": 3490620,
            "text": "这里是我们晋城大师赛第21赛季"
          },
          {
            "index": 1517,
            "source_segment_index": 1517,
            "start_ms": 3490620,
            "end_ms": 3492810,
            "text": "可聚集团的决赛周的第二天"
          },
          {
            "index": 1518,
            "source_segment_index": 1518,
            "start_ms": 3492810,
            "end_ms": 3494490,
            "text": "刚才我们进行了第一局的对局"
          },
          {
            "index": 1519,
            "source_segment_index": 1519,
            "start_ms": 3494490,
            "end_ms": 3496350,
            "text": "希望各位家人们能够看得开心"
          },
          {
            "index": 1520,
            "source_segment_index": 1520,
            "start_ms": 3496350,
            "end_ms": 3498910,
            "text": "同样的在本周五下午的18点整"
          },
          {
            "index": 1521,
            "source_segment_index": 1521,
            "start_ms": 3498910,
            "end_ms": 3502120,
            "text": "会在京师镇远直播间迎来我们的这个带货直播"
          },
          {
            "index": 1522,
            "source_segment_index": 1522,
            "start_ms": 3502120,
            "end_ms": 3504040,
            "text": "会有我们这款非常护摩"
          },
          {
            "index": 1523,
            "source_segment_index": 1523,
            "start_ms": 3504040,
            "end_ms": 3504680,
            "text": "没有展示啊"
          },
          {
            "index": 1524,
            "source_segment_index": 1524,
            "start_ms": 3504680,
            "end_ms": 3507440,
            "text": "这个逻辑兽很明黄色的一个很可爱的小玩偶"
          },
          {
            "index": 1525,
            "source_segment_index": 1525,
            "start_ms": 3507440,
            "end_ms": 3509500,
            "text": "包括有一个浅蓝色的帆布袋"
          },
          {
            "index": 1526,
            "source_segment_index": 1526,
            "start_ms": 3509500,
            "end_ms": 3512250,
            "text": "会我们的大师赛周边会有一个上新"
          },
          {
            "index": 1527,
            "source_segment_index": 1527,
            "start_ms": 3512250,
            "end_ms": 3513850,
            "text": "向各位感兴趣的家人们"
          },
          {
            "index": 1528,
            "source_segment_index": 1528,
            "start_ms": 3513850,
            "end_ms": 3515450,
            "text": "在周五下午的18点整"
          },
          {
            "index": 1529,
            "source_segment_index": 1529,
            "start_ms": 3515450,
            "end_ms": 3518450,
            "text": "来到我们今日甄选直播间来观看一下预购"
          },
          {
            "index": 1530,
            "source_segment_index": 1530,
            "start_ms": 3518450,
            "end_ms": 3519770,
            "text": "从速先到先得"
          },
          {
            "index": 1531,
            "source_segment_index": 1531,
            "start_ms": 3519770,
            "end_ms": 3520250,
            "text": "接下来"
          },
          {
            "index": 1532,
            "source_segment_index": 1532,
            "start_ms": 3520250,
            "end_ms": 3522610,
            "text": "导播老师会优先把镜头移交至我们第二现场"
          },
          {
            "index": 1533,
            "source_segment_index": 1533,
            "start_ms": 3524970,
            "end_ms": 3527130,
            "text": "稍后回来会是我们第二局鬼畜致敬"
          },
          {
            "index": 1534,
            "source_segment_index": 1534,
            "start_ms": 3527130,
            "end_ms": 3528410,
            "text": "一会见"
          },
          {
            "index": 1535,
            "source_segment_index": 1535,
            "start_ms": 3532240,
            "end_ms": 3533360,
            "text": "现有四连胜的吗"
          },
          {
            "index": 1536,
            "source_segment_index": 1536,
            "start_ms": 3533360,
            "end_ms": 3535390,
            "text": "老师们有没有四连胜的"
          },
          {
            "index": 1537,
            "source_segment_index": 1537,
            "start_ms": 3535390,
            "end_ms": 3538450,
            "text": "其实这把狼队和好人都挺强的"
          },
          {
            "index": 1538,
            "source_segment_index": 1538,
            "start_ms": 3538450,
            "end_ms": 3539010,
            "text": "都很强"
          },
          {
            "index": 1539,
            "source_segment_index": 1539,
            "start_ms": 3539010,
            "end_ms": 3541410,
            "text": "我们这可能刀人的顺序上"
          },
          {
            "index": 1540,
            "source_segment_index": 1540,
            "start_ms": 3541410,
            "end_ms": 3546710,
            "text": "如果就是当然顺序上再好一点的话"
          },
          {
            "index": 1541,
            "source_segment_index": 1541,
            "start_ms": 3546710,
            "end_ms": 3548730,
            "text": "狼队应该是非常有机会的"
          },
          {
            "index": 1542,
            "source_segment_index": 1542,
            "start_ms": 3548730,
            "end_ms": 3550270,
            "text": "那最好的肯定先刀三嘛"
          },
          {
            "index": 1543,
            "source_segment_index": 1543,
            "start_ms": 3550270,
            "end_ms": 3552090,
            "text": "但这个有点有点难度"
          },
          {
            "index": 1544,
            "source_segment_index": 1544,
            "start_ms": 3552090,
            "end_ms": 3554029,
            "text": "最好是先到三"
          },
          {
            "index": 1545,
            "source_segment_index": 1545,
            "start_ms": 3554029,
            "end_ms": 3555920,
            "text": "直接四连胜嗯"
          },
          {
            "index": 1546,
            "source_segment_index": 1546,
            "start_ms": 3555920,
            "end_ms": 3559240,
            "text": "图图图的发言确实还是充斥着效果"
          },
          {
            "index": 1547,
            "source_segment_index": 1547,
            "start_ms": 3559240,
            "end_ms": 3560960,
            "text": "还是还是比较有效果的"
          },
          {
            "index": 1548,
            "source_segment_index": 1548,
            "start_ms": 3560960,
            "end_ms": 3563070,
            "text": "给这一把呃"
          },
          {
            "index": 1549,
            "source_segment_index": 1549,
            "start_ms": 3563070,
            "end_ms": 3566590,
            "text": "这个发言阶段的就是很平整"
          },
          {
            "index": 1550,
            "source_segment_index": 1550,
            "start_ms": 3566590,
            "end_ms": 3569390,
            "text": "大家投九投九投九就是个来了来了一点效果"
          },
          {
            "index": 1551,
            "source_segment_index": 1551,
            "start_ms": 3569390,
            "end_ms": 3572660,
            "text": "不然的话刚刚张一阳已经听得手舞足蹈了"
          },
          {
            "index": 1552,
            "source_segment_index": 1552,
            "start_ms": 3572660,
            "end_ms": 3575520,
            "text": "然后我想说哎果然是小孩子的感觉"
          },
          {
            "index": 1553,
            "source_segment_index": 1553,
            "start_ms": 3575520,
            "end_ms": 3578320,
            "text": "第一次感觉我跟他这个年龄有差距了"
          },
          {
            "index": 1554,
            "source_segment_index": 1554,
            "start_ms": 3578320,
            "end_ms": 3582120,
            "text": "就实在是有点实在是没忍住想笑出来了"
          },
          {
            "index": 1555,
            "source_segment_index": 1555,
            "start_ms": 3582120,
            "end_ms": 3584120,
            "text": "嗯嗯哼哼"
          },
          {
            "index": 1556,
            "source_segment_index": 1556,
            "start_ms": 3587630,
            "end_ms": 3589150,
            "text": "我跟你说这个其实是有角度"
          },
          {
            "index": 1557,
            "source_segment_index": 1557,
            "start_ms": 3589150,
            "end_ms": 3590890,
            "text": "你们就是你看的时候你要怎么"
          },
          {
            "index": 1558,
            "source_segment_index": 1558,
            "start_ms": 3590890,
            "end_ms": 3593910,
            "text": "比方说你觉得你可能觉得申屠的发言有点悬"
          },
          {
            "index": 1559,
            "source_segment_index": 1559,
            "start_ms": 3593910,
            "end_ms": 3595110,
            "text": "你要你要你有什么角度"
          },
          {
            "index": 1560,
            "source_segment_index": 1560,
            "start_ms": 3595110,
            "end_ms": 3596510,
            "text": "你大家听我说"
          },
          {
            "index": 1561,
            "source_segment_index": 1561,
            "start_ms": 3596510,
            "end_ms": 3597630,
            "text": "歪哥昨天三连胜"
          },
          {
            "index": 1562,
            "source_segment_index": 1562,
            "start_ms": 3597630,
            "end_ms": 3598350,
            "text": "对不对"
          },
          {
            "index": 1563,
            "source_segment_index": 1563,
            "start_ms": 3598350,
            "end_ms": 3600290,
            "text": "那么Y哥现在歪哥现在三分"
          },
          {
            "index": 1564,
            "source_segment_index": 1564,
            "start_ms": 3600290,
            "end_ms": 3601870,
            "text": "如果你希望歪哥夺冠"
          },
          {
            "index": 1565,
            "source_segment_index": 1565,
            "start_ms": 3601870,
            "end_ms": 3603580,
            "text": "那么你就得要好狼人赢"
          },
          {
            "index": 1566,
            "source_segment_index": 1566,
            "start_ms": 3603580,
            "end_ms": 3605800,
            "text": "因为狼人赢好人加的分少"
          },
          {
            "index": 1567,
            "source_segment_index": 1567,
            "start_ms": 3605800,
            "end_ms": 3606580,
            "text": "因为你是好人"
          },
          {
            "index": 1568,
            "source_segment_index": 1568,
            "start_ms": 3606580,
            "end_ms": 3608500,
            "text": "狼人狼人如果对"
          },
          {
            "index": 1569,
            "source_segment_index": 1569,
            "start_ms": 3608500,
            "end_ms": 3609500,
            "text": "只有四个人加分"
          },
          {
            "index": 1570,
            "source_segment_index": 1570,
            "start_ms": 3609500,
            "end_ms": 3611700,
            "text": "如果如果好人好人有八个人全部加分"
          },
          {
            "index": 1571,
            "source_segment_index": 1571,
            "start_ms": 3611700,
            "end_ms": 3613030,
            "text": "那是不是对不对"
          },
          {
            "index": 1572,
            "source_segment_index": 1572,
            "start_ms": 3613030,
            "end_ms": 3614210,
            "text": "那我你想歪哥夺冠"
          },
          {
            "index": 1573,
            "source_segment_index": 1573,
            "start_ms": 3614210,
            "end_ms": 3615250,
            "text": "那是不是就一直狼人赢"
          },
          {
            "index": 1574,
            "source_segment_index": 1574,
            "start_ms": 3615250,
            "end_ms": 3615610,
            "text": "狼人赢"
          },
          {
            "index": 1575,
            "source_segment_index": 1575,
            "start_ms": 3615610,
            "end_ms": 3616050,
            "text": "狼人赢"
          },
          {
            "index": 1576,
            "source_segment_index": 1576,
            "start_ms": 3616050,
            "end_ms": 3617980,
            "text": "那我歪哥是不是"
          }
        ],
