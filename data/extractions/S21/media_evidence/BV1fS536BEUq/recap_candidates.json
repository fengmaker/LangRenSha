        "evidence": [
          {
            "index": 2512,
            "source_segment_index": 2512,
            "start_ms": 5166100,
            "end_ms": 5167420,
            "text": "好人阵营获胜"
          },
          {
            "index": 2513,
            "source_segment_index": 2513,
            "start_ms": 5167420,
            "end_ms": 5169309,
            "text": "我们会打赢"
          },
          {
            "index": 2514,
            "source_segment_index": 2514,
            "start_ms": 5169309,
            "end_ms": 5171409,
            "text": "你是白山十一十一是白"
          },
          {
            "index": 2515,
            "source_segment_index": 2515,
            "start_ms": 5171409,
            "end_ms": 5172549,
            "text": "你是白天对吧"
          },
          {
            "index": 2516,
            "source_segment_index": 2516,
            "start_ms": 5172549,
            "end_ms": 5173629,
            "text": "但也不是平民"
          },
          {
            "index": 2517,
            "source_segment_index": 2517,
            "start_ms": 5173629,
            "end_ms": 5175639,
            "text": "但这不是全屏的吗"
          },
          {
            "index": 2518,
            "source_segment_index": 2518,
            "start_ms": 5175639,
            "end_ms": 5178359,
            "text": "来给各位弹幕老师们做本酒席的复盘"
          },
          {
            "index": 2519,
            "source_segment_index": 2519,
            "start_ms": 5178359,
            "end_ms": 5182030,
            "text": "本剧版行为玉女猎白混血儿神阵营预言家"
          },
          {
            "index": 2520,
            "source_segment_index": 2520,
            "start_ms": 5182030,
            "end_ms": 5182870,
            "text": "3号女巫"
          },
          {
            "index": 2521,
            "source_segment_index": 2521,
            "start_ms": 5182870,
            "end_ms": 5183830,
            "text": "7号猎人"
          },
          {
            "index": 2522,
            "source_segment_index": 2522,
            "start_ms": 5183830,
            "end_ms": 5184710,
            "text": "一号白神"
          },
          {
            "index": 2523,
            "source_segment_index": 2523,
            "start_ms": 5184710,
            "end_ms": 5190140,
            "text": "11号狼人阵营2号四号六号八号平民阵营"
          },
          {
            "index": 2524,
            "source_segment_index": 2524,
            "start_ms": 5190140,
            "end_ms": 5193410,
            "text": "5号十号12号混血儿9号"
          },
          {
            "index": 2525,
            "source_segment_index": 2525,
            "start_ms": 5193410,
            "end_ms": 5197610,
            "text": "本游戏好人混首页混血儿选择7号女巫为榜样"
          },
          {
            "index": 2526,
            "source_segment_index": 2526,
            "start_ms": 5197610,
            "end_ms": 5201150,
            "text": "形成好人混狼人击杀9号混血儿"
          },
          {
            "index": 2527,
            "source_segment_index": 2527,
            "start_ms": 5201150,
            "end_ms": 5202390,
            "text": "女药救起行车"
          },
          {
            "index": 2528,
            "source_segment_index": 2528,
            "start_ms": 5202390,
            "end_ms": 5205630,
            "text": "平安夜预言家验证2号玩家为狼人身份"
          },
          {
            "index": 2529,
            "source_segment_index": 2529,
            "start_ms": 5205630,
            "end_ms": 5207550,
            "text": "在警上竞选环节"
          },
          {
            "index": 2530,
            "source_segment_index": 2530,
            "start_ms": 5207550,
            "end_ms": 5209550,
            "text": "8号悍跳狼人获得警徽"
          },
          {
            "index": 2531,
            "source_segment_index": 2531,
            "start_ms": 5209550,
            "end_ms": 5210510,
            "text": "第一天白天"
          },
          {
            "index": 2532,
            "source_segment_index": 2532,
            "start_ms": 5210510,
            "end_ms": 5212910,
            "text": "2号狼人被公投出局"
          },
          {
            "index": 2533,
            "source_segment_index": 2533,
            "start_ms": 5212910,
            "end_ms": 5215850,
            "text": "入夜狼人击杀一号猎人"
          },
          {
            "index": 2534,
            "source_segment_index": 2534,
            "start_ms": 5215850,
            "end_ms": 5217710,
            "text": "女巫毒杀8号狼人"
          },
          {
            "index": 2535,
            "source_segment_index": 2535,
            "start_ms": 5217710,
            "end_ms": 5219290,
            "text": "一号8号双死"
          },
          {
            "index": 2536,
            "source_segment_index": 2536,
            "start_ms": 5219290,
            "end_ms": 5222750,
            "text": "预言家验证了11号玩家白神为好人身份"
          },
          {
            "index": 2537,
            "source_segment_index": 2537,
            "start_ms": 5222750,
            "end_ms": 5226389,
            "text": "一号猎人出局后开枪带走6号狼人"
          },
          {
            "index": 2538,
            "source_segment_index": 2538,
            "start_ms": 5226389,
            "end_ms": 5228909,
            "text": "8号玩家移交警徽至11号"
          },
          {
            "index": 2539,
            "source_segment_index": 2539,
            "start_ms": 5228909,
            "end_ms": 5230609,
            "text": "白神在第二天的白天"
          },
          {
            "index": 2540,
            "source_segment_index": 2540,
            "start_ms": 5230609,
            "end_ms": 5232189,
            "text": "4号狼人选择交牌"
          },
          {
            "index": 2541,
            "source_segment_index": 2541,
            "start_ms": 5232189,
            "end_ms": 5232829,
            "text": "游戏结束"
          },
          {
            "index": 2542,
            "source_segment_index": 2542,
            "start_ms": 5232829,
            "end_ms": 5233889,
            "text": "好人阵营获胜"
          },
          {
            "index": 2543,
            "source_segment_index": 2543,
            "start_ms": 5233889,
            "end_ms": 5235529,
            "text": "以上是我们今天第一局版型"
          },
          {
            "index": 2544,
            "source_segment_index": 2544,
            "start_ms": 5235529,
            "end_ms": 5236929,
            "text": "预女猎白混血儿的全部内容"
          },
          {
            "index": 2545,
            "source_segment_index": 2545,
            "start_ms": 5236929,
            "end_ms": 5238780,
            "text": "非常感谢各位弹幕老师的陪伴"
          },
          {
            "index": 2546,
            "source_segment_index": 2546,
            "start_ms": 5238780,
            "end_ms": 5241160,
            "text": "同样的在本周五晚上的18点整"
          },
          {
            "index": 2547,
            "source_segment_index": 2547,
            "start_ms": 5241160,
            "end_ms": 5243380,
            "text": "我们的今日甄选直播间会迎来一波"
          },
          {
            "index": 2548,
            "source_segment_index": 2548,
            "start_ms": 5243380,
            "end_ms": 5245060,
            "text": "大致在周边的带货啊"
          },
          {
            "index": 2549,
            "source_segment_index": 2549,
            "start_ms": 5245060,
            "end_ms": 5246620,
            "text": "我们是我们的逻辑兽"
          },
          {
            "index": 2550,
            "source_segment_index": 2550,
            "start_ms": 5246620,
            "end_ms": 5249150,
            "text": "还有我们一个非常精美的帆布包的带货"
          },
          {
            "index": 2551,
            "source_segment_index": 2551,
            "start_ms": 5249150,
            "end_ms": 5251030,
            "text": "这个逻辑是非常的小巧可爱"
          },
          {
            "index": 2552,
            "source_segment_index": 2552,
            "start_ms": 5251030,
            "end_ms": 5253490,
            "text": "然后我们的帆布包也是一个非常清新的色彩"
          },
          {
            "index": 2553,
            "source_segment_index": 2553,
            "start_ms": 5253490,
            "end_ms": 5257200,
            "text": "非常适合为各位家人的夏日增增添一抹色彩"
          },
          {
            "index": 2554,
            "source_segment_index": 2554,
            "start_ms": 5257200,
            "end_ms": 5258320,
            "text": "所以各位弹幕老师们"
          },
          {
            "index": 2555,
            "source_segment_index": 2555,
            "start_ms": 5258320,
            "end_ms": 5260560,
            "text": "一定要在周五下午的18点整"
          },
          {
            "index": 2556,
            "source_segment_index": 2556,
            "start_ms": 5260560,
            "end_ms": 5262120,
            "text": "蹲守在我们今日远直播间"
          },
          {
            "index": 2557,
            "source_segment_index": 2557,
            "start_ms": 5262120,
            "end_ms": 5263600,
            "text": "我们现货有限"
          },
          {
            "index": 2558,
            "source_segment_index": 2558,
            "start_ms": 5263600,
            "end_ms": 5264400,
            "text": "先到先得"
          },
          {
            "index": 2559,
            "source_segment_index": 2559,
            "start_ms": 5264400,
            "end_ms": 5265210,
            "text": "感谢各位"
          },
          {
            "index": 2560,
            "source_segment_index": 2560,
            "start_ms": 5265210,
            "end_ms": 5266490,
            "text": "那么接下来请导播老师"
          },
          {
            "index": 2561,
            "source_segment_index": 2561,
            "start_ms": 5266490,
            "end_ms": 5267770,
            "text": "把镜头移交至我们第二现场"
          },
          {
            "index": 2562,
            "source_segment_index": 2562,
            "start_ms": 5267770,
            "end_ms": 5269970,
            "text": "两位解说老师会对本局游戏进行复盘"
          },
          {
            "index": 2563,
            "source_segment_index": 2563,
            "start_ms": 5269970,
            "end_ms": 5272290,
            "text": "稍后回来会是我们第二局假面舞会"
          },
          {
            "index": 2564,
            "source_segment_index": 2564,
            "start_ms": 5272290,
            "end_ms": 5273650,
            "text": "一会见"
          },
          {
            "index": 2565,
            "source_segment_index": 2565,
            "start_ms": 5358140,
            "end_ms": 5360140,
            "text": "哈喽大毛老师们"
          },
          {
            "index": 2566,
            "source_segment_index": 2566,
            "start_ms": 5360140,
            "end_ms": 5361100,
            "text": "欢迎回来"
          },
          {
            "index": 2567,
            "source_segment_index": 2567,
            "start_ms": 5361100,
            "end_ms": 5361780,
            "text": "欢迎回来"
          },
          {
            "index": 2568,
            "source_segment_index": 2568,
            "start_ms": 5361780,
            "end_ms": 5364620,
            "text": "现在呢是我们的北京时间20.20分"
          },
          {
            "index": 2569,
            "source_segment_index": 2569,
            "start_ms": 5364620,
            "end_ms": 5367280,
            "text": "也是我们整个打人气票的时间段啊"
          },
          {
            "index": 2570,
            "source_segment_index": 2570,
            "start_ms": 5367280,
            "end_ms": 5369980,
            "text": "希望大家可以把手中的容器票送给"
          },
          {
            "index": 2571,
            "source_segment_index": 2571,
            "start_ms": 5369980,
            "end_ms": 5370940,
            "text": "送到我们的直播间"
          },
          {
            "index": 2572,
            "source_segment_index": 2572,
            "start_ms": 5370940,
            "end_ms": 5374280,
            "text": "好不助力我们拿到一个红牌子好吗"
          },
          {
            "index": 2573,
            "source_segment_index": 2573,
            "start_ms": 5374280,
            "end_ms": 5379840,
            "text": "然后呢这一把那确实突然的大家都突然回头了"
          },
          {
            "index": 2574,
            "source_segment_index": 2574,
            "start_ms": 5379840,
            "end_ms": 5382440,
            "text": "狼人杀的魅力就在于它的不确定性"
          },
          {
            "index": 2575,
            "source_segment_index": 2575,
            "start_ms": 5382440,
            "end_ms": 5382940,
            "text": "对不对"
          },
          {
            "index": 2576,
            "source_segment_index": 2576,
            "start_ms": 5382940,
            "end_ms": 5384460,
            "text": "其实我们一开始都会觉得"
          },
          {
            "index": 2577,
            "source_segment_index": 2577,
            "start_ms": 5384460,
            "end_ms": 5388060,
            "text": "比如说什么一号2号六号八号是肯定的"
          },
          {
            "index": 2578,
            "source_segment_index": 2578,
            "start_ms": 5388060,
            "end_ms": 5390740,
            "text": "四票加上4号倒勾狼是五票"
          },
          {
            "index": 2579,
            "source_segment_index": 2579,
            "start_ms": 5390740,
            "end_ms": 5393120,
            "text": "只需要骗到一个好一个好人的票就够了"
          },
          {
            "index": 2580,
            "source_segment_index": 2580,
            "start_ms": 5393120,
            "end_ms": 5393640,
            "text": "对不对"
          },
          {
            "index": 2581,
            "source_segment_index": 2581,
            "start_ms": 5393640,
            "end_ms": 5394780,
            "text": "对的哎"
          },
          {
            "index": 2582,
            "source_segment_index": 2582,
            "start_ms": 5394780,
            "end_ms": 5396700,
            "text": "万万没有2号哦"
          },
          {
            "index": 2583,
            "source_segment_index": 2583,
            "start_ms": 5396700,
            "end_ms": 5397620,
            "text": "不一号啊"
          },
          {
            "index": 2584,
            "source_segment_index": 2584,
            "start_ms": 5397620,
            "end_ms": 5398560,
            "text": "投了2号"
          },
          {
            "index": 2585,
            "source_segment_index": 2585,
            "start_ms": 5398560,
            "end_ms": 5401260,
            "text": "在没有宣布投票的那一刻"
          },
          {
            "index": 2586,
            "source_segment_index": 2586,
            "start_ms": 5401260,
            "end_ms": 5402010,
            "text": "开始"
          },
          {
            "index": 2587,
            "source_segment_index": 2587,
            "start_ms": 5402010,
            "end_ms": 5404290,
            "text": "所有的礼仪结论都可以被推翻"
          },
          {
            "index": 2588,
            "source_segment_index": 2588,
            "start_ms": 5404290,
            "end_ms": 5404850,
            "text": "对不对"
          },
          {
            "index": 2589,
            "source_segment_index": 2589,
            "start_ms": 5404850,
            "end_ms": 5406580,
            "text": "其实那时候我是真的觉得是"
          },
          {
            "index": 2590,
            "source_segment_index": 2590,
            "start_ms": 5406580,
            "end_ms": 5408460,
            "text": "可能是预言家被投死的"
          },
          {
            "index": 2591,
            "source_segment_index": 2591,
            "start_ms": 5408460,
            "end_ms": 5410260,
            "text": "真的很有可能预言家被投死"
          },
          {
            "index": 2592,
            "source_segment_index": 2592,
            "start_ms": 5410260,
            "end_ms": 5413140,
            "text": "甚至投完狼人会直接进入拍刀的节奏"
          },
          {
            "index": 2593,
            "source_segment_index": 2593,
            "start_ms": 5413140,
            "end_ms": 5415120,
            "text": "对万万没想到"
          }
        ],
