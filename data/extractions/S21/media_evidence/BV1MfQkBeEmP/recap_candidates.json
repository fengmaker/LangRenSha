            "source_segment_index": 2226,
            "start_ms": 4168250,
            "end_ms": 4169885,
            "text": "游戏结束好人阵营获胜。"
          },
          {
            "index": 2227,
            "source_segment_index": 2227,
            "start_ms": 4171000,
            "end_ms": 4171180,
            "text": "好，"
          },
