            "source_segment_index": 3573,
            "start_ms": 6998889,
            "end_ms": 7001289,
            "text": "本局游戏为盗宝猎人"
          },
          {
            "index": 3574,
            "source_segment_index": 3574,
            "start_ms": 7001289,
            "end_ms": 7005969,
            "text": "平民阵营2号四号九号十号首页声梦人"
          },
          {
            "index": 3575,
            "source_segment_index": 3575,
            "start_ms": 7005969,
            "end_ms": 7009620,
            "text": "梦游12号狼人毒师技能空过通灵师验证"
          },
          {
            "index": 3576,
            "source_segment_index": 3576,
            "start_ms": 7009620,
            "end_ms": 7011040,
            "text": "12号玩家为狼人身份"
          },
          {
            "index": 3577,
            "source_segment_index": 3577,
            "start_ms": 7011040,
            "end_ms": 7014660,
            "text": "盗宝大师在平民猎人的排队中选择了猎人身份"
          },
          {
            "index": 3578,
            "source_segment_index": 3578,
            "start_ms": 7014660,
            "end_ms": 7016260,
            "text": "在警上竞选环节"
          },
          {
            "index": 3579,
            "source_segment_index": 3579,
            "start_ms": 7016260,
            "end_ms": 7018100,
            "text": "7号盗宝大师获得警徽"
          },
          {
            "index": 3580,
            "source_segment_index": 3580,
            "start_ms": 7018100,
            "end_ms": 7018680,
            "text": "第一天白天"
          },
          {
            "index": 3581,
            "source_segment_index": 3581,
            "start_ms": 7018680,
            "end_ms": 7020680,
            "text": "12号狼人被公投出局"
          },
          {
            "index": 3582,
            "source_segment_index": 3582,
            "start_ms": 7020680,
            "end_ms": 7023140,
            "text": "入夜圣某人梦游5号狼人"
          },
          {
            "index": 3583,
            "source_segment_index": 3583,
            "start_ms": 7023140,
            "end_ms": 7025790,
            "text": "狼人击杀8号通灵师"
          },
          {
            "index": 3584,
            "source_segment_index": 3584,
            "start_ms": 7025790,
            "end_ms": 7027390,
            "text": "毒师技能继续空过"
          },
          {
            "index": 3585,
            "source_segment_index": 3585,
            "start_ms": 7027390,
            "end_ms": 7029810,
            "text": "通灵师验证了5号玩家唯一狼人身份"
          },
          {
            "index": 3586,
            "source_segment_index": 3586,
            "start_ms": 7029810,
            "end_ms": 7030950,
            "text": "在第二天的白天"
          },
          {
            "index": 3587,
            "source_segment_index": 3587,
            "start_ms": 7030950,
            "end_ms": 7034110,
            "text": "一号毒师被抗推出局"
          },
          {
            "index": 3588,
            "source_segment_index": 3588,
            "start_ms": 7034470,
            "end_ms": 7036330,
            "text": "入夜射梦人再次梦游"
          },
          {
            "index": 3589,
            "source_segment_index": 3589,
            "start_ms": 7036330,
            "end_ms": 7037370,
            "text": "5号狼人"
          },
          {
            "index": 3590,
            "source_segment_index": 3590,
            "start_ms": 7037370,
            "end_ms": 7039710,
            "text": "狼人击杀3号摄梦人"
          },
          {
            "index": 3591,
            "source_segment_index": 3591,
            "start_ms": 7039710,
            "end_ms": 7041650,
            "text": "3号五号双死"
          },
          {
            "index": 3592,
            "source_segment_index": 3592,
            "start_ms": 7041650,
            "end_ms": 7043950,
            "text": "盗宝大师切回猎人身份"
          },
          {
            "index": 3593,
            "source_segment_index": 3593,
            "start_ms": 7043950,
            "end_ms": 7048430,
            "text": "并在第三天被各位玩家们公投出局的7号"
          },
          {
            "index": 3594,
            "source_segment_index": 3594,
            "start_ms": 7048430,
            "end_ms": 7051450,
            "text": "盗宝大师发动技能带走了场上最后一神"
          },
          {
            "index": 3595,
            "source_segment_index": 3595,
            "start_ms": 7051450,
            "end_ms": 7053570,
            "text": "11号蒙面人游戏结束"
          },
          {
            "index": 3596,
            "source_segment_index": 3596,
            "start_ms": 7053570,
            "end_ms": 7054940,
            "text": "狼人阵营屠神获胜"
          },
          {
            "index": 3597,
            "source_segment_index": 3597,
            "start_ms": 7054940,
            "end_ms": 7056580,
            "text": "以上是我们今天第二局版型"
          },
          {
            "index": 3598,
            "source_segment_index": 3598,
            "start_ms": 7056580,
            "end_ms": 7057540,
            "text": "盗宝大师的全部内容"
          },
          {
            "index": 3599,
            "source_segment_index": 3599,
            "start_ms": 7057540,
            "end_ms": 7058900,
            "text": "感谢每一位大木老师的陪伴"
          },
          {
            "index": 3600,
            "source_segment_index": 3600,
            "start_ms": 7058900,
            "end_ms": 7061480,
            "text": "这里是我们精神大师赛第21赛季"
          },
          {
            "index": 3601,
            "source_segment_index": 3601,
            "start_ms": 7061480,
            "end_ms": 7062780,
            "text": "可以聚集团的直播现场"
          },
          {
            "index": 3602,
            "source_segment_index": 3602,
            "start_ms": 7062780,
            "end_ms": 7065940,
            "text": "也再次感谢天天狼人app对我们节目的冠名赞助"
          },
          {
            "index": 3603,
            "source_segment_index": 3603,
            "start_ms": 7065940,
            "end_ms": 7068060,
            "text": "也请各位大老师们可以来到各大应用平台"
