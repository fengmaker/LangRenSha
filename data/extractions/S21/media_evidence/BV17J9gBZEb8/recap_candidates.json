        "evidence": [
          {
            "index": 3303,
            "source_segment_index": 3303,
            "start_ms": 6358670,
            "end_ms": 6359630,
            "text": "Hello哦，"
          },
          {
            "index": 3304,
            "source_segment_index": 3304,
            "start_ms": 6359650,
            "end_ms": 6360190,
            "text": "那你投对，"
          },
          {
            "index": 3305,
            "source_segment_index": 3305,
            "start_ms": 6360190,
            "end_ms": 6361110,
            "text": "那时候如果不自爆，"
          },
          {
            "index": 3306,
            "source_segment_index": 3306,
            "start_ms": 6361110,
            "end_ms": 6362710,
            "text": "投完票就就知道了最棒了。"
          },
          {
            "index": 3307,
            "source_segment_index": 3307,
            "start_ms": 6362710,
            "end_ms": 6363115,
            "text": "嗯，"
          },
          {
            "index": 3308,
            "source_segment_index": 3308,
            "start_ms": 6363290,
            "end_ms": 6363625,
            "text": "不要走。"
          },
          {
            "index": 3309,
            "source_segment_index": 3309,
            "start_ms": 6364180,
            "end_ms": 6364515,
            "text": "对，"
          },
          {
            "index": 3310,
            "source_segment_index": 3310,
            "start_ms": 6366640,
            "end_ms": 6366800,
            "text": "好，"
          },
          {
            "index": 3311,
            "source_segment_index": 3311,
            "start_ms": 6366800,
            "end_ms": 6368895,
            "text": "给各位弹幕老师们做本节的不马看女巫，"
          },
          {
            "index": 3312,
            "source_segment_index": 3312,
            "start_ms": 6369430,
            "end_ms": 6369870,
            "text": "本局版型，"
          },
          {
            "index": 3313,
            "source_segment_index": 3313,
            "start_ms": 6369870,
            "end_ms": 6370990,
            "text": "预女猎白混血儿，"
          },
          {
            "index": 3314,
            "source_segment_index": 3314,
            "start_ms": 6370990,
            "end_ms": 6371570,
            "text": "神人阵营，"
          },
          {
            "index": 3315,
            "source_segment_index": 3315,
            "start_ms": 6371590,
            "end_ms": 6372790,
            "text": "预言家六号、女巫，"
          },
          {
            "index": 3316,
            "source_segment_index": 3316,
            "start_ms": 6372790,
            "end_ms": 6373710,
            "text": "十二号猎人、四号，"
          },
          {
            "index": 3317,
            "source_segment_index": 3317,
            "start_ms": 6373710,
            "end_ms": 6374790,
            "text": "白神一号狼人阵营，"
          },
          {
            "index": 3318,
            "source_segment_index": 3318,
            "start_ms": 6374790,
            "end_ms": 6377195,
            "text": "五号、七号、八号、九号、平民阵营，"
          },
          {
            "index": 3319,
            "source_segment_index": 3319,
            "start_ms": 6377570,
            "end_ms": 6379090,
            "text": "二号、三号、十一号，"
          },
          {
            "index": 3320,
            "source_segment_index": 3320,
            "start_ms": 6379110,
            "end_ms": 6380210,
            "text": "混血儿十号。"
          },
          {
            "index": 3321,
            "source_segment_index": 3321,
            "start_ms": 6380210,
            "end_ms": 6382400,
            "text": "本就戏狼人混首约混血儿，"
          },
          {
            "index": 3322,
            "source_segment_index": 3322,
            "start_ms": 6382400,
            "end_ms": 6384260,
            "text": "选择八号狼人为本王，"
          },
          {
            "index": 3323,
            "source_segment_index": 3323,
            "start_ms": 6384260,
            "end_ms": 6385440,
            "text": "形成狼人或狼人击杀。"
          },
          {
            "index": 3324,
            "source_segment_index": 3324,
            "start_ms": 6385920,
            "end_ms": 6388020,
            "text": "四号猎人牛要救起，"
          },
          {
            "index": 3325,
            "source_segment_index": 3325,
            "start_ms": 6388020,
            "end_ms": 6388960,
            "text": "形成平安夜预言家，"
          },
          {
            "index": 3326,
            "source_segment_index": 3326,
            "start_ms": 6388960,
            "end_ms": 6390195,
            "text": "验证了一号玩家。"
          },
          {
            "index": 3327,
            "source_segment_index": 3327,
            "start_ms": 6390610,
            "end_ms": 6390900,
            "text": "嗯，"
          },
          {
            "index": 3328,
            "source_segment_index": 3328,
            "start_ms": 6391680,
            "end_ms": 6395560,
            "text": "白神为好人身份在警上竞选环节七号预言家获得警徽。"
          },
          {
            "index": 3329,
            "source_segment_index": 3329,
            "start_ms": 6395560,
            "end_ms": 6396260,
            "text": "第一天白天，"
          },
          {
            "index": 3330,
            "source_segment_index": 3330,
            "start_ms": 6396620,
            "end_ms": 6397140,
            "text": "六号，"
          },
          {
            "index": 3331,
            "source_segment_index": 3331,
            "start_ms": 6397300,
            "end_ms": 6399805,
            "text": "预言家被扛推出局，"
          },
          {
            "index": 3332,
            "source_segment_index": 3332,
            "start_ms": 6400440,
            "end_ms": 6405600,
            "text": "入夜狼人击杀一号白神女巫技能空过一号白神单死。"
          },
          {
            "index": 3333,
            "source_segment_index": 3333,
            "start_ms": 6405620,
            "end_ms": 6406480,
            "text": "第二天的白天，"
          },
          {
            "index": 3334,
            "source_segment_index": 3334,
            "start_ms": 6406540,
            "end_ms": 6407740,
            "text": "七号狼人选择自爆，"
          },
          {
            "index": 3335,
            "source_segment_index": 3335,
            "start_ms": 6407740,
            "end_ms": 6408620,
            "text": "并撕掉警徽。"
          },
          {
            "index": 3336,
            "source_segment_index": 3336,
            "start_ms": 6408620,
            "end_ms": 6411110,
            "text": "本局游戏警徽流失嗯嗯，"
          },
          {
            "index": 3337,
            "source_segment_index": 3337,
            "start_ms": 6411110,
            "end_ms": 6411400,
            "text": "好的，"
          },
          {
            "index": 3338,
            "source_segment_index": 3338,
            "start_ms": 6411440,
            "end_ms": 6411780,
            "text": "入夜，"
          },
          {
            "index": 3339,
            "source_segment_index": 3339,
            "start_ms": 6411860,
            "end_ms": 6416960,
            "text": "狼人击杀十号混血儿牛犊杀三号平民，"
          },
          {
            "index": 3340,
            "source_segment_index": 3340,
            "start_ms": 6417100,
            "end_ms": 6418495,
            "text": "三号十号双死。"
          },
          {
            "index": 3341,
            "source_segment_index": 3341,
            "start_ms": 6418830,
            "end_ms": 6419770,
            "text": "第三天的白天，"
          },
          {
            "index": 3342,
            "source_segment_index": 3342,
            "start_ms": 6420010,
            "end_ms": 6421950,
            "text": "二号平民被扛推出局，"
          },
          {
            "index": 3343,
            "source_segment_index": 3343,
            "start_ms": 6421950,
            "end_ms": 6423670,
            "text": "夜狼人击杀十一号平民，"
          },
          {
            "index": 3344,
            "source_segment_index": 3344,
            "start_ms": 6423710,
            "end_ms": 6424505,
            "text": "游戏结束，"
          },
          {
            "index": 3345,
            "source_segment_index": 3345,
            "start_ms": 6424850,
            "end_ms": 6426110,
            "text": "狼人阵营同名获胜。"
          },
          {
            "index": 3346,
            "source_segment_index": 3346,
            "start_ms": 6426110,
            "end_ms": 6428610,
            "text": "以上是我们今天第一局预女猎白混血儿的全部内容，"
          },
          {
            "index": 3347,
            "source_segment_index": 3347,
            "start_ms": 6428610,
            "end_ms": 6429955,
            "text": "感谢每一位当老师的陪伴。"
          },
          {
            "index": 3348,
            "source_segment_index": 3348,
            "start_ms": 6430290,
            "end_ms": 6434315,
            "text": "这里是我们金钟大师赛第二十一赛季诡泣奇谈的直播现场，"
          },
          {
            "index": 3349,
            "source_segment_index": 3349,
            "start_ms": 6434660,
            "end_ms": 6438060,
            "text": "再次感谢天天狼人app对我们节目的冠名赞助支持。"
          },
          {
            "index": 3350,
            "source_segment_index": 3350,
            "start_ms": 6438300,
            "end_ms": 6438960,
            "text": "也请各位弹幕，"
          },
          {
            "index": 3351,
            "source_segment_index": 3351,
            "start_ms": 6438960,
            "end_ms": 6442875,
            "text": "老师们可以移步到我们各大应用平台搜索并下载天天狼人app,"
          },
          {
            "index": 3352,
            "source_segment_index": 3352,
            "start_ms": 6443030,
            "end_ms": 6444790,
            "text": "就可以跟我们一起来玩网上游戏了。"
          },
          {
            "index": 3353,
            "source_segment_index": 3353,
            "start_ms": 6444990,
            "end_ms": 6445390,
            "text": "同样的，"
          },
          {
            "index": 3354,
            "source_segment_index": 3354,
            "start_ms": 6445390,
            "end_ms": 6448190,
            "text": "我们本赛季还有三个品牌的特邀赞助，"
          },
          {
            "index": 3355,
            "source_segment_index": 3355,
            "start_ms": 6448190,
            "end_ms": 6450460,
            "text": "分别是我们的哈尼牧场。"
          },
          {
            "index": 3356,
            "source_segment_index": 3356,
            "start_ms": 6450460,
            "end_ms": 6451705,
            "text": "我们这个牛脆脆脆片，"
          },
          {
            "index": 3357,
            "source_segment_index": 3357,
            "start_ms": 6451960,
            "end_ms": 6454100,
            "text": "还有我们的懒赤侠以及我们的柠檬共和国。"
          },
          {
            "index": 3358,
            "source_segment_index": 3358,
            "start_ms": 6454360,
            "end_ms": 6455920,
            "text": "各位担保老师们在观赛途中，"
          },
          {
            "index": 3359,
            "source_segment_index": 3359,
            "start_ms": 6455920,
            "end_ms": 6457320,
            "text": "如果有任何的想法，"
          },
          {
            "index": 3360,
            "source_segment_index": 3360,
            "start_ms": 6457460,
            "end_ms": 6459960,
            "text": "都可以来到我们JY贷式的个人橱窗主页，"
          },
          {
            "index": 3361,
            "source_segment_index": 3361,
            "start_ms": 6459960,
            "end_ms": 6460900,
            "text": "进行随时的下单，"
          },
          {
            "index": 3362,
            "source_segment_index": 3362,
            "start_ms": 6460900,
            "end_ms": 6463305,
            "text": "补货都是非常好吃好喝的用品。"
          },
          {
            "index": 3363,
            "source_segment_index": 3363,
            "start_ms": 6463670,
            "end_ms": 6464970,
            "text": "同样的在明天下午，"
          },
          {
            "index": 3364,
            "source_segment_index": 3364,
            "start_ms": 6464970,
            "end_ms": 6466730,
            "text": "也就是我们周六下午的十四点整，"
          },
          {
            "index": 3365,
            "source_segment_index": 3365,
            "start_ms": 6466730,
            "end_ms": 6468055,
            "text": "会有我们一场水晶带货，"
          },
          {
            "index": 3366,
            "source_segment_index": 3366,
            "start_ms": 6468400,
            "end_ms": 6469400,
            "text": "然后会有我们牛肉干干。"
          },
          {
            "index": 3367,
            "source_segment_index": 3367,
            "start_ms": 6469400,
            "end_ms": 6472240,
            "text": "还有我们金鱼老师在明天下午的金狮甄选直播间，"
          },
          {
            "index": 3368,
            "source_segment_index": 3368,
            "start_ms": 6472240,
            "end_ms": 6475110,
            "text": "为各位带来非常精美的水晶展示。"
          },
          {
            "index": 3369,
            "source_segment_index": 3369,
            "start_ms": 6475110,
            "end_ms": 6477370,
            "text": "然后期待各位弹幕老师有需求可以来看一下。"
          },
          {
            "index": 3370,
            "source_segment_index": 3370,
            "start_ms": 6477690,
            "end_ms": 6480290,
            "text": "那么接下来我们导入老师会优先把镜头移交至我们第二现场。"
          },
          {
            "index": 3371,
            "source_segment_index": 3371,
            "start_ms": 6480290,
            "end_ms": 6482695,
            "text": "两位解说老师会对本局游戏进行简单复盘，"
          },
          {
            "index": 3372,
            "source_segment_index": 3372,
            "start_ms": 6483050,
            "end_ms": 6485585,
            "text": "稍后回来会是我们第二局盗宝大师一会儿见。"
          }
        ],
