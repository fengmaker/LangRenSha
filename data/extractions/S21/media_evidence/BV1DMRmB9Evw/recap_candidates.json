        "evidence": [
          {
            "index": 2062,
            "source_segment_index": 2062,
            "start_ms": 3980580,
            "end_ms": 3983380,
            "text": "已经不是刚刚我们是我一个人"
          },
          {
            "index": 2063,
            "source_segment_index": 2063,
            "start_ms": 3983380,
            "end_ms": 3985810,
            "text": "就是好给各位弹幕老师们做本角色的复盘"
          },
          {
            "index": 2064,
            "source_segment_index": 2064,
            "start_ms": 3985810,
            "end_ms": 3988770,
            "text": "本局版型为假面舞会神人阵营预言家"
          },
          {
            "index": 2065,
            "source_segment_index": 2065,
            "start_ms": 3988770,
            "end_ms": 3989950,
            "text": "12号女巫"
          },
          {
            "index": 2066,
            "source_segment_index": 2066,
            "start_ms": 3989950,
            "end_ms": 3990910,
            "text": "6号舞者"
          },
          {
            "index": 2067,
            "source_segment_index": 2067,
            "start_ms": 3990910,
            "end_ms": 3991770,
            "text": "2号白神"
          },
          {
            "index": 2068,
            "source_segment_index": 2068,
            "start_ms": 3991770,
            "end_ms": 3994700,
            "text": "8号狼人阵营4号七号"
          },
          {
            "index": 2069,
            "source_segment_index": 2069,
            "start_ms": 3994700,
            "end_ms": 3996700,
            "text": "11号假面一号平民阵营"
          },
          {
            "index": 2070,
            "source_segment_index": 2070,
            "start_ms": 3996700,
            "end_ms": 4001130,
            "text": "3号五号九号十号首页狼人击杀6号女巫"
          },
          {
            "index": 2071,
            "source_segment_index": 2071,
            "start_ms": 4001130,
            "end_ms": 4002470,
            "text": "女巫毒杀9号平民"
          },
          {
            "index": 2072,
            "source_segment_index": 2072,
            "start_ms": 4002470,
            "end_ms": 4003910,
            "text": "6号九号双死"
          },
          {
            "index": 2073,
            "source_segment_index": 2073,
            "start_ms": 4003910,
            "end_ms": 4008080,
            "text": "预言家验证了6号玩家为女巫为好人身份"
          },
          {
            "index": 2074,
            "source_segment_index": 2074,
            "start_ms": 4008080,
            "end_ms": 4009380,
            "text": "在警上竞选环节"
          },
          {
            "index": 2075,
            "source_segment_index": 2075,
            "start_ms": 4009380,
            "end_ms": 4011440,
            "text": "11号悍跳狼人获得警徽"
          },
          {
            "index": 2076,
            "source_segment_index": 2076,
            "start_ms": 4011440,
            "end_ms": 4012569,
            "text": "在第一天白天"
          },
          {
            "index": 2077,
            "source_segment_index": 2077,
            "start_ms": 4012569,
            "end_ms": 4015409,
            "text": "11号悍跳狼人被公投出局"
          },
          {
            "index": 2078,
            "source_segment_index": 2078,
            "start_ms": 4015409,
            "end_ms": 4018350,
            "text": "警徽移交至7号狼人"
          },
          {
            "index": 2079,
            "source_segment_index": 2079,
            "start_ms": 4018990,
            "end_ms": 4021430,
            "text": "入夜无止的舞池是一号假面"
          },
          {
            "index": 2080,
            "source_segment_index": 2080,
            "start_ms": 4021430,
            "end_ms": 4022550,
            "text": "3号平民"
          },
          {
            "index": 2081,
            "source_segment_index": 2081,
            "start_ms": 4022550,
            "end_ms": 4026230,
            "text": "5号平民当夜假面验证了10号玩家"
          },
          {
            "index": 2082,
            "source_segment_index": 2082,
            "start_ms": 4026230,
            "end_ms": 4027910,
            "text": "平民不在舞池内"
          },
          {
            "index": 2083,
            "source_segment_index": 2083,
            "start_ms": 4027910,
            "end_ms": 4030070,
            "text": "给予了4号狼人一张面具"
          },
          {
            "index": 2084,
            "source_segment_index": 2084,
            "start_ms": 4030070,
            "end_ms": 4032760,
            "text": "此时五池内一号假面被五出局"
          },
          {
            "index": 2085,
            "source_segment_index": 2085,
            "start_ms": 4032760,
            "end_ms": 4033720,
            "text": "狼人击杀"
          },
          {
            "index": 2086,
            "source_segment_index": 2086,
            "start_ms": 4033720,
            "end_ms": 4034820,
            "text": "12号预言家"
          },
          {
            "index": 2087,
            "source_segment_index": 2087,
            "start_ms": 4034820,
            "end_ms": 4037280,
            "text": "预言家验证了4号玩家为狼人身份"
          },
          {
            "index": 2088,
            "source_segment_index": 2088,
            "start_ms": 4038360,
            "end_ms": 4039590,
            "text": "在第二天的白天"
          },
          {
            "index": 2089,
            "source_segment_index": 2089,
            "start_ms": 4039590,
            "end_ms": 4041710,
            "text": "7号狼人选择自爆"
          },
          {
            "index": 2090,
            "source_segment_index": 2090,
            "start_ms": 4041710,
            "end_ms": 4044500,
            "text": "并将警徽移交至4号狼人"
          },
          {
            "index": 2091,
            "source_segment_index": 2091,
            "start_ms": 4044500,
            "end_ms": 4047580,
            "text": "入夜舞者的舞池是2号舞者"
          },
          {
            "index": 2092,
            "source_segment_index": 2092,
            "start_ms": 4047580,
            "end_ms": 4050590,
            "text": "4号狼人以及8号白神"
          },
          {
            "index": 2093,
            "source_segment_index": 2093,
            "start_ms": 4050590,
            "end_ms": 4053090,
            "text": "此时舞者在舞池内50没狼刀"
          },
          {
            "index": 2094,
            "source_segment_index": 2094,
            "start_ms": 4053090,
            "end_ms": 4054370,
            "text": "且假面已经出局"
          },
          {
            "index": 2095,
            "source_segment_index": 2095,
            "start_ms": 4054370,
            "end_ms": 4057530,
            "text": "所以我们场上最后一狼4号背五出局"
          },
          {
            "index": 2096,
            "source_segment_index": 2096,
            "start_ms": 4057530,
            "end_ms": 4058390,
            "text": "游戏结束"
          },
          {
            "index": 2097,
            "source_segment_index": 2097,
            "start_ms": 4058390,
            "end_ms": 4059430,
            "text": "好人阵营获胜"
          },
          {
            "index": 2098,
            "source_segment_index": 2098,
            "start_ms": 4059430,
            "end_ms": 4061750,
            "text": "以上是我们今天第二局假面舞会的全部内容"
          },
          {
            "index": 2099,
            "source_segment_index": 2099,
            "start_ms": 4061750,
            "end_ms": 4063590,
            "text": "非常感谢各位家人的陪伴和支持"
          },
          {
            "index": 2100,
            "source_segment_index": 2100,
            "start_ms": 4063590,
            "end_ms": 4065870,
            "text": "这里是京城大师赛第21赛季"
          },
          {
            "index": 2101,
            "source_segment_index": 2101,
            "start_ms": 4065870,
            "end_ms": 4067250,
            "text": "口曲奇谭的直播现场"
          },
          {
            "index": 2102,
            "source_segment_index": 2102,
            "start_ms": 4067250,
            "end_ms": 4070210,
            "text": "今天我也是我们本赛季的正赛最后一天"
          },
          {
            "index": 2103,
            "source_segment_index": 2103,
            "start_ms": 4070210,
            "end_ms": 4072130,
            "text": "下周将会进入我们的决赛周"
          },
          {
            "index": 2104,
            "source_segment_index": 2104,
            "start_ms": 4072130,
            "end_ms": 4073650,
            "text": "希望各位家人们可以玩得开心"
          },
          {
            "index": 2105,
            "source_segment_index": 2105,
            "start_ms": 4073650,
            "end_ms": 4076600,
            "text": "希望各位选手们也可以发挥出一个优异的成绩"
          },
          {
            "index": 2106,
            "source_segment_index": 2106,
            "start_ms": 4076600,
            "end_ms": 4078840,
            "text": "那么接下来导播老师会优先把镜头移交至我们"
          },
          {
            "index": 2107,
            "source_segment_index": 2107,
            "start_ms": 4078840,
            "end_ms": 4079480,
            "text": "第二现场"
          },
          {
            "index": 2108,
            "source_segment_index": 2108,
            "start_ms": 4079480,
            "end_ms": 4081860,
            "text": "两位解说老师会对本局假面舞会进行复盘"
          },
          {
            "index": 2109,
            "source_segment_index": 2109,
            "start_ms": 4081860,
            "end_ms": 4083160,
            "text": "稍后回来会是我们第三局"
          },
          {
            "index": 2110,
            "source_segment_index": 2110,
            "start_ms": 4083160,
            "end_ms": 4084040,
            "text": "机械狼通灵师"
          },
          {
            "index": 2111,
            "source_segment_index": 2111,
            "start_ms": 4084040,
            "end_ms": 4085280,
            "text": "一会见"
          },
          {
            "index": 2112,
            "source_segment_index": 2112,
            "start_ms": 4088680,
            "end_ms": 4090800,
            "text": "把我刚刚上来时还说还好"
          },
          {
            "index": 2113,
            "source_segment_index": 2113,
            "start_ms": 4090800,
            "end_ms": 4091840,
            "text": "这把我上来了"
          },
          {
            "index": 2114,
            "source_segment_index": 2114,
            "start_ms": 4091840,
            "end_ms": 4093060,
            "text": "我没有拿到假面金"
          },
          {
            "index": 2115,
            "source_segment_index": 2115,
            "start_ms": 4093060,
            "end_ms": 4094120,
            "text": "假面压力还挺大的"
          },
          {
            "index": 2116,
            "source_segment_index": 2116,
            "start_ms": 4094120,
            "end_ms": 4095590,
            "text": "那不一定你假面可能赢了"
          },
          {
            "index": 2117,
            "source_segment_index": 2117,
            "start_ms": 4095590,
            "end_ms": 4096830,
            "text": "两人可能赢了"
          },
          {
            "index": 2118,
            "source_segment_index": 2118,
            "start_ms": 4096830,
            "end_ms": 4098030,
            "text": "我这个东西我跟你说"
          },
          {
            "index": 2119,
            "source_segment_index": 2119,
            "start_ms": 4098030,
            "end_ms": 4098950,
            "text": "运气很重要"
          },
          {
            "index": 2120,
            "source_segment_index": 2120,
            "start_ms": 4098950,
            "end_ms": 4100130,
            "text": "运气很重要"
          },
          {
            "index": 2121,
            "source_segment_index": 2121,
            "start_ms": 4100130,
            "end_ms": 4103020,
            "text": "因为这个东西我给大家分析一下呃"
          },
          {
            "index": 2122,
            "source_segment_index": 2122,
            "start_ms": 4103340,
            "end_ms": 4104560,
            "text": "在这种情况下"
          },
          {
            "index": 2123,
            "source_segment_index": 2123,
            "start_ms": 4104560,
            "end_ms": 4108300,
            "text": "舞者最好的50确实就是两个好人加一个假面"
          },
          {
            "index": 2124,
            "source_segment_index": 2124,
            "start_ms": 4108300,
            "end_ms": 4108680,
            "text": "对吧"
          },
          {
            "index": 2125,
            "source_segment_index": 2125,
            "start_ms": 4108680,
            "end_ms": 4109540,
            "text": "没有我没有没有"
          },
          {
            "index": 2126,
            "source_segment_index": 2126,
            "start_ms": 4109540,
            "end_ms": 4110900,
            "text": "第二种思路就是两一个狼"
          },
          {
            "index": 2127,
            "source_segment_index": 2127,
            "start_ms": 4110900,
            "end_ms": 4112060,
            "text": "就是一个狼加两个好人"
          },
          {
            "index": 2128,
            "source_segment_index": 2128,
            "start_ms": 4112060,
            "end_ms": 4113370,
            "text": "就是舞者最好的思路"
          },
          {
            "index": 2129,
            "source_segment_index": 2129,
            "start_ms": 4113370,
            "end_ms": 4115550,
            "text": "那假面呢就是其实就是验一个好人"
          },
          {
            "index": 2130,
            "source_segment_index": 2130,
            "start_ms": 4115550,
            "end_ms": 4116890,
            "text": "扣一个好人就完事了"
          },
          {
            "index": 2131,
            "source_segment_index": 2131,
            "start_ms": 4116890,
            "end_ms": 4118370,
            "text": "那么其实他赢的概率有很大"
          },
          {
            "index": 2132,
            "source_segment_index": 2132,
            "start_ms": 4118370,
            "end_ms": 4120290,
            "text": "也就是说他比方验预言家不在50"
          },
          {
            "index": 2133,
            "source_segment_index": 2133,
            "start_ms": 4120290,
            "end_ms": 4123810,
            "text": "那说明可能可能舞者不是保护五对吧"
          },
          {
            "index": 2134,
            "source_segment_index": 2134,
            "start_ms": 4123810,
            "end_ms": 4125950,
            "text": "他愿意他只要在外面扣一个好人就可以了"
          },
          {
            "index": 2135,
            "source_segment_index": 2135,
            "start_ms": 4125950,
            "end_ms": 4127990,
            "text": "就是其实舞者胜利的概率呃"
          },
          {
            "index": 2136,
            "source_segment_index": 2136,
            "start_ms": 4127990,
            "end_ms": 4129990,
            "text": "在这种情况下是偏小的"
          },
          {
            "index": 2137,
            "source_segment_index": 2137,
            "start_ms": 4129990,
            "end_ms": 4131070,
            "text": "对不对"
          },
          {
            "index": 2138,
            "source_segment_index": 2138,
            "start_ms": 4131070,
            "end_ms": 4132830,
            "text": "也就是说他只要这一扣没扣到小果冻"
          },
          {
            "index": 2139,
            "source_segment_index": 2139,
            "start_ms": 4132830,
            "end_ms": 4134370,
            "text": "他只要扣的是个好人"
          },
          {
            "index": 2140,
            "source_segment_index": 2140,
            "start_ms": 4134370,
            "end_ms": 4138760,
            "text": "其实有可能都会对应该机会还是比较大的"
          },
          {
            "index": 2141,
            "source_segment_index": 2141,
            "start_ms": 4141400,
            "end_ms": 4143960,
            "text": "因为这把其实好人开"
          },
          {
            "index": 2142,
            "source_segment_index": 2142,
            "start_ms": 4143960,
            "end_ms": 4146260,
            "text": "其实狼队小狼队还是很厉害的对吧"
          },
          {
            "index": 2143,
            "source_segment_index": 2143,
            "start_ms": 4146260,
            "end_ms": 4148680,
            "text": "就是先把女巫首刀就刀掉了"
          },
          {
            "index": 2144,
            "source_segment_index": 2144,
            "start_ms": 4148680,
            "end_ms": 4149520,
            "text": "我这反正挺厉害的呀"
          },
          {
            "index": 2145,
            "source_segment_index": 2145,
            "start_ms": 4149520,
            "end_ms": 4150440,
            "text": "我归假面的呀"
          },
          {
            "index": 2146,
            "source_segment_index": 2146,
            "start_ms": 4150440,
            "end_ms": 4151160,
            "text": "我上次归假面"
          },
          {
            "index": 2147,
            "source_segment_index": 2147,
            "start_ms": 4151160,
            "end_ms": 4151960,
            "text": "我挺厉害的呀"
          },
          {
            "index": 2148,
            "source_segment_index": 2148,
            "start_ms": 4151960,
            "end_ms": 4154730,
            "text": "嘿嘿对"
          },
          {
            "index": 2149,
            "source_segment_index": 2149,
            "start_ms": 4154730,
            "end_ms": 4158720,
            "text": "然后呃女巫也没有毒到狼"
          },
          {
            "index": 2150,
            "source_segment_index": 2150,
            "start_ms": 4158720,
            "end_ms": 4160780,
            "text": "然后本来是好人是比较劣势"
          },
          {
            "index": 2151,
            "source_segment_index": 2151,
            "start_ms": 4160780,
            "end_ms": 4161660,
            "text": "而且是悍跳狼"
          },
          {
            "index": 2152,
            "source_segment_index": 2152,
            "start_ms": 4161660,
            "end_ms": 4162660,
            "text": "拿警徽嘛"
          },
          {
            "index": 2153,
            "source_segment_index": 2153,
            "start_ms": 4162660,
            "end_ms": 4165300,
            "text": "对主要这把这把确实徐姐厉害厉害"
          },
          {
            "index": 2154,
            "source_segment_index": 2154,
            "start_ms": 4165300,
            "end_ms": 4166620,
            "text": "最后投票也投对了"
          },
          {
            "index": 2155,
            "source_segment_index": 2155,
            "start_ms": 4166620,
            "end_ms": 4167700,
            "text": "投票都投对了"
          },
          {
            "index": 2156,
            "source_segment_index": 2156,
            "start_ms": 4167700,
            "end_ms": 4169180,
            "text": "好人好人都投对了"
          },
          {
            "index": 2157,
            "source_segment_index": 2157,
            "start_ms": 4169180,
            "end_ms": 4171960,
            "text": "其实狼是除了一号倒钩了"
          },
          {
            "index": 2158,
            "source_segment_index": 2158,
            "start_ms": 4171960,
            "end_ms": 4173300,
            "text": "对大家大家好像都站边"
          },
          {
            "index": 2159,
            "source_segment_index": 2159,
            "start_ms": 4173300,
            "end_ms": 4175990,
            "text": "并且你们可以看一下这个3号三号对吧"
          },
          {
            "index": 2160,
            "source_segment_index": 2160,
            "start_ms": 4175990,
            "end_ms": 4177950,
            "text": "3号其实呃是新人"
          },
          {
            "index": 2161,
            "source_segment_index": 2161,
            "start_ms": 4177950,
            "end_ms": 4179910,
            "text": "对他第一他第一把也是投队的第一票"
          }
        ],
