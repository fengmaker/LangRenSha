            "source_segment_index": 3007,
            "start_ms": 5824800,
            "end_ms": 5826080,
            "text": "也可以来到我们各大应用平台"
          },
          {
            "index": 3008,
            "source_segment_index": 3008,
            "start_ms": 5826080,
            "end_ms": 5827640,
            "text": "搜索并下载天天狼人app"
          },
          {
            "index": 3009,
            "source_segment_index": 3009,
            "start_ms": 5827640,
            "end_ms": 5829440,
            "text": "就可以跟我们一起来玩网杀游戏了"
          },
          {
            "index": 3010,
            "source_segment_index": 3010,
            "start_ms": 5829440,
            "end_ms": 5829920,
            "text": "然后呢"
          },
          {
            "index": 3011,
            "source_segment_index": 3011,
            "start_ms": 5829920,
            "end_ms": 5831040,
            "text": "我们现在京城大师赛"
          },
          {
            "index": 3012,
            "source_segment_index": 3012,
            "start_ms": 5831040,
            "end_ms": 5834680,
            "text": "2026年度的我们高校联赛正在招募进行中"
          },
          {
            "index": 3013,
            "source_segment_index": 3013,
            "start_ms": 5834680,
            "end_ms": 5835960,
            "text": "所以各位高校学子们"
          },
          {
            "index": 3014,
            "source_segment_index": 3014,
            "start_ms": 5835960,
            "end_ms": 5838200,
            "text": "也欢迎来到我们京大精神大赛官博"
          },
