          },
          {
            "index": 2970,
            "source_segment_index": 2970,
            "start_ms": 5739230,
            "end_ms": 5743790,
            "text": "来给各位大老师们做一下本局游戏的复盘"
          },
          {
            "index": 2971,
            "source_segment_index": 2971,
            "start_ms": 5744390,
            "end_ms": 5746940,
            "text": "本局版行为机械狼通灵师"
          },
          {
            "index": 2972,
            "source_segment_index": 2972,
            "start_ms": 5746940,
            "end_ms": 5749280,
            "text": "神人阵营通灵师11号女巫"
          },
          {
            "index": 2973,
            "source_segment_index": 2973,
            "start_ms": 5749280,
            "end_ms": 5750260,
            "text": "10号猎人"
          },
          {
            "index": 2974,
            "source_segment_index": 2974,
            "start_ms": 5750260,
            "end_ms": 5754010,
            "text": "一号守卫7号狼人阵营3号五号"
          },
          {
            "index": 2975,
            "source_segment_index": 2975,
            "start_ms": 5754010,
            "end_ms": 5755330,
            "text": "9号吉祥6号"
          },
          {
            "index": 2976,
            "source_segment_index": 2976,
            "start_ms": 5755330,
            "end_ms": 5761290,
            "text": "本球学机械守卫平民阵营2号四号八号12号"
          },
          {
            "index": 2977,
            "source_segment_index": 2977,
            "start_ms": 5761290,
            "end_ms": 5763450,
            "text": "首页首位技能空过狼人"
          },
          {
            "index": 2978,
            "source_segment_index": 2978,
            "start_ms": 5763450,
            "end_ms": 5764850,
            "text": "击杀10号女巫"
          },
          {
            "index": 2979,
            "source_segment_index": 2979,
            "start_ms": 5764850,
            "end_ms": 5767290,
            "text": "女巫毒杀6号机械狼"
          },
          {
            "index": 2980,
            "source_segment_index": 2980,
            "start_ms": 5767290,
            "end_ms": 5769130,
            "text": "6号十号双死机械狼"
          },
          {
            "index": 2981,
            "source_segment_index": 2981,
            "start_ms": 5769130,
            "end_ms": 5770330,
            "text": "模仿7号守卫"
          },
          {
            "index": 2982,
            "source_segment_index": 2982,
            "start_ms": 5770330,
            "end_ms": 5772350,
            "text": "本局游戏为机械首位通灵师"
          },
          {
            "index": 2983,
            "source_segment_index": 2983,
            "start_ms": 5772350,
            "end_ms": 5773900,
            "text": "查验了6号玩家"
          },
          {
            "index": 2984,
            "source_segment_index": 2984,
            "start_ms": 5773900,
            "end_ms": 5776460,
            "text": "机械龙为守卫身份"
          },
          {
            "index": 2985,
            "source_segment_index": 2985,
            "start_ms": 5776460,
            "end_ms": 5778080,
            "text": "在警上竞选环节"
          },
          {
            "index": 2986,
            "source_segment_index": 2986,
            "start_ms": 5778080,
            "end_ms": 5779720,
            "text": "5号悍跳狼人获得警徽地点"
          },
          {
            "index": 2987,
            "source_segment_index": 2987,
            "start_ms": 5779720,
            "end_ms": 5781880,
            "text": "白天5号悍跳狼人被公投出局"
          },
          {
            "index": 2988,
            "source_segment_index": 2988,
            "start_ms": 5781880,
            "end_ms": 5784750,
            "text": "并将警徽移交至12号平民入夜"
          },
          {
            "index": 2989,
            "source_segment_index": 2989,
            "start_ms": 5784750,
            "end_ms": 5787590,
            "text": "首位守护一号猎人狼人击杀7号"
          },
          {
            "index": 2990,
            "source_segment_index": 2990,
            "start_ms": 5787590,
            "end_ms": 5791580,
            "text": "首位通灵师验证了12号玩家为平民身份"
          },
          {
            "index": 2991,
            "source_segment_index": 2991,
            "start_ms": 5791580,
            "end_ms": 5792719,
            "text": "7号数为单死"
          },
          {
            "index": 2992,
            "source_segment_index": 2992,
            "start_ms": 5792719,
            "end_ms": 5793699,
            "text": "第二天的白天"
          },
          {
            "index": 2993,
            "source_segment_index": 2993,
            "start_ms": 5793699,
            "end_ms": 5795819,
            "text": "9号狼人选择自爆入夜"
          },
          {
            "index": 2994,
            "source_segment_index": 2994,
            "start_ms": 5795819,
            "end_ms": 5797599,
            "text": "狼人击杀11号通灵师"
          },
          {
            "index": 2995,
            "source_segment_index": 2995,
            "start_ms": 5797599,
            "end_ms": 5800809,
            "text": "通灵师验证8号玩家为平民身份"
          },
          {
            "index": 2996,
            "source_segment_index": 2996,
            "start_ms": 5800809,
            "end_ms": 5802109,
            "text": "在第三天的白天"
          },
          {
            "index": 2997,
            "source_segment_index": 2997,
            "start_ms": 5802109,
            "end_ms": 5804509,
            "text": "12号平民被抗推出局"
          },
          {
            "index": 2998,
            "source_segment_index": 2998,
            "start_ms": 5804509,
            "end_ms": 5807050,
            "text": "并将警徽移交至一号猎人"
          },
          {
            "index": 2999,
            "source_segment_index": 2999,
            "start_ms": 5807050,
            "end_ms": 5809950,
            "text": "入夜狼人击杀场上最后一神"
          },
          {
            "index": 3000,
            "source_segment_index": 3000,
            "start_ms": 5809950,
            "end_ms": 5811660,
            "text": "一号猎人游戏结束"
          },
          {
            "index": 3001,
            "source_segment_index": 3001,
            "start_ms": 5811660,
            "end_ms": 5813380,
            "text": "狼人阵营屠神获胜"
          },
          {
            "index": 3002,
            "source_segment_index": 3002,
            "start_ms": 5813380,
            "end_ms": 5815580,
            "text": "以上是我们今天三局百姓全部内容"
          },
          {
            "index": 3003,
            "source_segment_index": 3003,
            "start_ms": 5815580,
            "end_ms": 5817860,
            "text": "也是我们本周精神大师赛的全部内容"
          },
          {
            "index": 3004,
            "source_segment_index": 3004,
            "start_ms": 5817860,
            "end_ms": 5819790,
            "text": "非常感谢每一位弹幕老师的陪伴"
          },
          {
            "index": 3005,
            "source_segment_index": 3005,
            "start_ms": 5819790,
            "end_ms": 5823400,
