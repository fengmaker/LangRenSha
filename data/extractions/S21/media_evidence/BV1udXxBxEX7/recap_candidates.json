            "source_segment_index": 3188,
            "start_ms": 6196740,
            "end_ms": 6197500,
            "text": "混了三个好人"
          },
          {
            "index": 3189,
            "source_segment_index": 3189,
            "start_ms": 6197500,
            "end_ms": 6200930,
            "text": "混十一二点钟混呃呃三是白神"
          },
          {
            "index": 3190,
            "source_segment_index": 3190,
            "start_ms": 6200930,
            "end_ms": 6201750,
            "text": "他不是他"
          },
          {
            "index": 3191,
            "source_segment_index": 3191,
            "start_ms": 6201750,
            "end_ms": 6202670,
            "text": "三是白神"
          },
          {
            "index": 3192,
            "source_segment_index": 3192,
            "start_ms": 6202670,
            "end_ms": 6204290,
            "text": "对三是白神啊"
          },
          {
            "index": 3193,
            "source_segment_index": 3193,
            "start_ms": 6204290,
            "end_ms": 6204930,
            "text": "在好久了"
          },
          {
            "index": 3194,
            "source_segment_index": 3194,
            "start_ms": 6204930,
            "end_ms": 6207040,
            "text": "我就三分被主人来了"
          },
          {
            "index": 3195,
            "source_segment_index": 3195,
            "start_ms": 6207040,
            "end_ms": 6209480,
            "text": "好给各位弹幕老师们做本局局的复盘"
          },
          {
            "index": 3196,
            "source_segment_index": 3196,
            "start_ms": 6209480,
            "end_ms": 6210800,
            "text": "本局版型为玉女猎白混血"
          },
          {
            "index": 3197,
            "source_segment_index": 3197,
            "start_ms": 6210800,
            "end_ms": 6212500,
            "text": "而深圳预言家一号女巫"
          },
          {
            "index": 3198,
            "source_segment_index": 3198,
            "start_ms": 6212500,
            "end_ms": 6213240,
            "text": "4号猎人"
          },
          {
            "index": 3199,
            "source_segment_index": 3199,
            "start_ms": 6213240,
            "end_ms": 6213800,
            "text": "7号白神"
          },
          {
            "index": 3200,
            "source_segment_index": 3200,
            "start_ms": 6213800,
            "end_ms": 6215220,
            "text": "3号狼人阵营"
          },
          {
            "index": 3201,
            "source_segment_index": 3201,
            "start_ms": 6215220,
            "end_ms": 6216820,
            "text": "2号六号九号"
          },
          {
            "index": 3202,
            "source_segment_index": 3202,
            "start_ms": 6216820,
            "end_ms": 6217960,
            "text": "10号平民阵营"
          },
          {
            "index": 3203,
            "source_segment_index": 3203,
            "start_ms": 6217960,
            "end_ms": 6218800,
            "text": "5号八号"
          },
          {
            "index": 3204,
            "source_segment_index": 3204,
            "start_ms": 6218800,
            "end_ms": 6220000,
            "text": "12号混血儿11号"
          },
          {
            "index": 3205,
            "source_segment_index": 3205,
            "start_ms": 6220000,
            "end_ms": 6221270,
            "text": "本局游戏为好人混"
          },
          {
            "index": 3206,
            "source_segment_index": 3206,
            "start_ms": 6221270,
            "end_ms": 6223470,
            "text": "首页混血儿选择3号白神为本"
          },
          {
            "index": 3207,
            "source_segment_index": 3207,
            "start_ms": 6223470,
            "end_ms": 6223890,
            "text": "王先生"
          },
          {
            "index": 3208,
            "source_segment_index": 3208,
            "start_ms": 6223890,
            "end_ms": 6224870,
            "text": "好人混狼人"
          },
          {
            "index": 3209,
            "source_segment_index": 3209,
            "start_ms": 6224870,
            "end_ms": 6227390,
            "text": "七杀4号女巫女巫毒杀3号白神"
          },
          {
            "index": 3210,
            "source_segment_index": 3210,
            "start_ms": 6227390,
            "end_ms": 6228930,
            "text": "3号四号双死"
          },
          {
            "index": 3211,
            "source_segment_index": 3211,
            "start_ms": 6228930,
            "end_ms": 6230790,
            "text": "预言家验证了12号玩家"
          },
          {
            "index": 3212,
            "source_segment_index": 3212,
            "start_ms": 6230790,
            "end_ms": 6232580,
            "text": "平民为好人身份"
          },
          {
            "index": 3213,
            "source_segment_index": 3213,
            "start_ms": 6232580,
            "end_ms": 6234200,
            "text": "在警上竞选环节"
          },
          {
            "index": 3214,
            "source_segment_index": 3214,
            "start_ms": 6234200,
            "end_ms": 6235540,
            "text": "一号预言家获得警徽"
          },
          {
            "index": 3215,
            "source_segment_index": 3215,
            "start_ms": 6235540,
            "end_ms": 6237559,
            "text": "第一天白天2号狼人选择自爆"
          },
          {
            "index": 3216,
            "source_segment_index": 3216,
            "start_ms": 6237559,
            "end_ms": 6239559,
            "text": "入夜狼人击杀一号预言家"
          },
          {
            "index": 3217,
            "source_segment_index": 3217,
            "start_ms": 6239559,
            "end_ms": 6241879,
            "text": "预言家验证了7号玩家猎人为好人身份"
          },
          {
            "index": 3218,
            "source_segment_index": 3218,
            "start_ms": 6241879,
            "end_ms": 6244590,
            "text": "并在出局后将警徽移交至7号猎人"
          },
          {
            "index": 3219,
            "source_segment_index": 3219,
            "start_ms": 6244590,
            "end_ms": 6245830,
            "text": "在第二天的白天"
          },
          {
            "index": 3220,
            "source_segment_index": 3220,
            "start_ms": 6245830,
            "end_ms": 6247510,
            "text": "9号狼人选择自爆"
          },
          {
            "index": 3221,
            "source_segment_index": 3221,
            "start_ms": 6247510,
            "end_ms": 6250610,
            "text": "入夜狼人击杀8号平民"
          },
          {
            "index": 3222,
            "source_segment_index": 3222,
            "start_ms": 6250610,
            "end_ms": 6251950,
            "text": "第三天的白天"
          },
          {
            "index": 3223,
            "source_segment_index": 3223,
            "start_ms": 6251950,
            "end_ms": 6253850,
            "text": "5号狼呃"
          },
          {
            "index": 3224,
            "source_segment_index": 3224,
            "start_ms": 6253850,
            "end_ms": 6255250,
            "text": "5号平民被抗推出局"
          },
          {
            "index": 3225,
            "source_segment_index": 3225,
            "start_ms": 6256570,
            "end_ms": 6260720,
            "text": "入夜狼人击杀11号混血儿"
          },
          {
            "index": 3226,
            "source_segment_index": 3226,
            "start_ms": 6260720,
            "end_ms": 6261950,
            "text": "在第四天的白天"
          },
          {
            "index": 3227,
            "source_segment_index": 3227,
            "start_ms": 6261950,
            "end_ms": 6264950,
            "text": "10号狼人被公投出局后"
          },
          {
            "index": 3228,
            "source_segment_index": 3228,
            "start_ms": 6264950,
            "end_ms": 6267730,
            "text": "狼人拍刀7号猎人游戏结束"
          },
          {
            "index": 3229,
            "source_segment_index": 3229,
            "start_ms": 6267730,
            "end_ms": 6269220,
            "text": "狼人阵营屠城获胜"
          },
          {
            "index": 3230,
            "source_segment_index": 3230,
            "start_ms": 6269220,
            "end_ms": 6271340,
            "text": "以上是我们今天第一局版型的全部内容"
          },
          {
            "index": 3231,
            "source_segment_index": 3231,
            "start_ms": 6271340,
            "end_ms": 6272940,
            "text": "感谢每一位弹幕老师的陪伴"
          },
          {
            "index": 3232,
            "source_segment_index": 3232,
            "start_ms": 6272940,
            "end_ms": 6275540,
            "text": "我们金城大师赛第21赛季可以去奇谈"
          },
          {
            "index": 3233,
            "source_segment_index": 3233,
            "start_ms": 6275540,
            "end_ms": 6278700,
            "text": "是由我们天天啊天天狼人app独家赞助播出"
          },
          {
            "index": 3234,
            "source_segment_index": 3234,
            "start_ms": 6278700,
            "end_ms": 6281420,
            "text": "然后也感谢天狼对我们节目的冠名支持"
          },
          {
            "index": 3235,
            "source_segment_index": 3235,
            "start_ms": 6281420,
            "end_ms": 6285520,
            "text": "也请各位当老师们可以来到各大应用平台搜索并下载天天狼人app"
          },
          {
            "index": 3236,
            "source_segment_index": 3236,
            "start_ms": 6285520,
            "end_ms": 6287520,
            "text": "就可以跟我们一起来玩网杀游戏了"
          },
          {
            "index": 3237,
            "source_segment_index": 3237,
            "start_ms": 6287520,
            "end_ms": 6289640,
            "text": "同样的我们还有一个特约赞助"
          },
          {
            "index": 3238,
            "source_segment_index": 3238,
            "start_ms": 6289640,
            "end_ms": 6291160,
            "text": "我们有两个特约赞助品牌"
          },
          {
            "index": 3239,
            "source_segment_index": 3239,
            "start_ms": 6291160,
            "end_ms": 6292720,
            "text": "分别是我们柠檬共和国"
          },
          {
            "index": 3240,
            "source_segment_index": 3240,
            "start_ms": 6292720,
            "end_ms": 6294280,
            "text": "还有我们揽吃翔啊"
          },
          {
            "index": 3241,
            "source_segment_index": 3241,
            "start_ms": 6294280,
            "end_ms": 6295140,
            "text": "一个是小吃"
          },
          {
            "index": 3242,
            "source_segment_index": 3242,
            "start_ms": 6295140,
            "end_ms": 6296100,
            "text": "一个是饮料"
          },
          {
            "index": 3243,
            "source_segment_index": 3243,
            "start_ms": 6296100,
            "end_ms": 6300240,
            "text": "各位弹幕老师们也可以来到我们JY戴士的我们的主页中的商品"
          },
          {
            "index": 3244,
            "source_segment_index": 3244,
            "start_ms": 6300240,
            "end_ms": 6300920,
            "text": "橱窗中"
          },
          {
            "index": 3245,
            "source_segment_index": 3245,
            "start_ms": 6300920,
            "end_ms": 6303200,
            "text": "就可以随时下单补货了"
          },
          {
            "index": 3246,
            "source_segment_index": 3246,
            "start_ms": 6303200,
            "end_ms": 6306960,
            "text": "希望各位弹幕老师们在观赛途中能够吃好喝好看的开心"
          },
          {
            "index": 3247,
            "source_segment_index": 3247,
            "start_ms": 6306960,
            "end_ms": 6309300,
            "text": "那么接下来请导播老师把新同学交至第二现场"
          },
          {
            "index": 3248,
            "source_segment_index": 3248,
            "start_ms": 6309300,
            "end_ms": 6311650,
            "text": "请两位解说老师跟我们一起简单做一下复盘"
          },
          {
            "index": 3249,
            "source_segment_index": 3249,
            "start_ms": 6311650,
            "end_ms": 6314450,
            "text": "稍后回来会是我们第二局我们的鬼书致敬"
          },
          {
            "index": 3250,
            "source_segment_index": 3250,
            "start_ms": 6314450,
            "end_ms": 6315850,
            "text": "一会见"
          },
          {
            "index": 3251,
            "source_segment_index": 3251,
            "start_ms": 6318500,
            "end_ms": 6320560,
            "text": "呃也是非常精彩的一局游戏"
          },
          {
            "index": 3252,
            "source_segment_index": 3252,
            "start_ms": 6320560,
            "end_ms": 6323340,
            "text": "在女巫吃首刀毒掉白神的情况下"
          },
          {
            "index": 3253,
            "source_segment_index": 3253,
            "start_ms": 6323340,
            "end_ms": 6326260,
            "text": "我们这个游戏也是进行了长达挺久的"
          }
        ],
