    {
      "field": "dossier.rounds.1.day.sheriff_vote",
      "kind": "text",
      "source_path": "data/raw/bilibili/BV1RQx364EVx/p01/subtitle.01.raw.json",
      "start_ms": 1569880,
      "end_ms": 1584470,
      "quote": "请从5号11号当中选出本局游戏进账\n321\n请出票\n2号投票给5号\n10号投票给11号\n12号投票给5号\n投票结束\n5号玩家两票当选警长",
