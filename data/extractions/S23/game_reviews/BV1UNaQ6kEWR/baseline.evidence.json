  "recap_segments": [
    {
      "index": 2215,
      "start_ms": 4378000,
      "end_ms": 4382695,
      "text": "那我看这个是不是你经交了太多他们家的评委反水，"
    },
    {
      "index": 2216,
      "start_ms": 4383720,
      "end_ms": 4394190,
      "text": "我这里嗯这个感票来给各位当老师们本局游戏戏复盘本剧版型为假面舞会神警预言家。"
    },
    {
      "index": 2217,
      "start_ms": 4394210,
      "end_ms": 4398510,
      "text": "八号女巫十二号舞者四号白神十一号狼人阵营，"
    },
    {
      "index": 2218,
      "start_ms": 4398790,
      "end_ms": 4401830,
      "text": "五号六号、十号假面一号平民阵营，"
    },
    {
      "index": 2219,
      "start_ms": 4401910,
      "end_ms": 4408340,
      "text": "二号、三号、七号、九号首夜狼队击杀十号狼人女巫要救起，"
    },
    {
      "index": 2220,
      "start_ms": 4408500,
      "end_ms": 4412355,
      "text": "形成平安夜预言家验证五号玩家为老人身份。"
    },
    {
      "index": 2221,
      "start_ms": 4412770,
      "end_ms": 4413070,
      "text": "嗯嗯，"
    },
    {
      "index": 2222,
      "start_ms": 4413480,
      "end_ms": 4414480,
      "text": "在警上竞选环节，"
    },
    {
      "index": 2223,
      "start_ms": 4414480,
      "end_ms": 4415940,
      "text": "八号预言家获得警徽。"
    },
    {
      "index": 2224,
      "start_ms": 4415940,
      "end_ms": 4416840,
      "text": "在第一天白天，"
    },
    {
      "index": 2225,
      "start_ms": 4416900,
      "end_ms": 4420170,
      "text": "六号狼人选择自爆入夜舞止的舞池，"
    },
    {
      "index": 2226,
      "start_ms": 4420310,
      "end_ms": 4425560,
      "text": "一号假面、二号平民九号平民假面验证了十一号玩家，"
    },
    {
      "index": 2227,
      "start_ms": 4425560,
      "end_ms": 4426960,
      "text": "白神不在舞池内，"
    },
    {
      "index": 2228,
      "start_ms": 4426980,
      "end_ms": 4429245,
      "text": "给予了九号平民一张面具。"
    },
    {
      "index": 2229,
      "start_ms": 4429830,
      "end_ms": 4430250,
      "text": "当夜，"
    },
    {
      "index": 2230,
      "start_ms": 4430250,
      "end_ms": 4431745,
      "text": "二号平民被捂出局，"
    },
    {
      "index": 2231,
      "start_ms": 4432420,
      "end_ms": 4435740,
      "text": "狼队夜间选择击杀三号平民牛犊，"
    },
    {
      "index": 2232,
      "start_ms": 4435740,
      "end_ms": 4436740,
      "text": "杀五号狼人。"
    },
    {
      "index": 2233,
      "start_ms": 4436800,
      "end_ms": 4440400,
      "text": "当夜为二号、三号、五号多岛预言家，"
    },
    {
      "index": 2234,
      "start_ms": 4440400,
      "end_ms": 4442815,
      "text": "验证了四号玩家舞者为好人身份。"
    },
    {
      "index": 2235,
      "start_ms": 4443300,
      "end_ms": 4444420,
      "text": "在第二天白天，"
    },
    {
      "index": 2236,
      "start_ms": 4444520,
      "end_ms": 4448785,
      "text": "十号狼人行的自曝入夜无止的舞池，"
    },
    {
      "index": 2237,
      "start_ms": 4449340,
      "end_ms": 4451340,
      "text": "四号舞者八号预言家，"
    },
    {
      "index": 2238,
      "start_ms": 4451480,
      "end_ms": 4458090,
      "text": "十二号女巫当夜舞者在舞池内舞持美一狼刀假面验证了八号玩家。"
    },
    {
      "index": 2239,
      "start_ms": 4458090,
      "end_ms": 4461330,
      "text": "预言家在舞池内给予了八号预言家一张面具，"
    },
    {
      "index": 2240,
      "start_ms": 4461650,
      "end_ms": 4464250,
      "text": "并击杀七号平民。"
    },
    {
      "index": 2241,
      "start_ms": 4464330,
      "end_ms": 4466990,
      "text": "当夜为七号八号生死预言家，"
    },
    {
      "index": 2242,
      "start_ms": 4466990,
      "end_ms": 4469610,
      "text": "验证了九号玩家平民为好人身份，"
    },
    {
      "index": 2243,
      "start_ms": 4469630,
      "end_ms": 4472685,
      "text": "并在出局后将警徽移交至九号平民。"
    },
    {
      "index": 2244,
      "start_ms": 4473190,
      "end_ms": 4477195,
      "text": "在第三天白天场上最后一狼一号假面被公托出局，"
    },
    {
      "index": 2245,
      "start_ms": 4477550,
      "end_ms": 4479445,
      "text": "游戏结束好人这一获胜。"
    },
    {
      "index": 2246,
      "start_ms": 4480150,
      "end_ms": 4482890,
      "text": "以上是我们今天第二局版型假面舞会的全部内容，"
    },
    {
      "index": 2247,
      "start_ms": 4482890,
      "end_ms": 4484790,
      "text": "再次感谢每一位大老师的陪伴。"
    }
  ],
