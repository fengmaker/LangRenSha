        "start_ms": 3086380,
        "end_ms": 3088660,
        "text": "3号狼人吞毒自爆"
      },
      {
        "start_ms": 3088660,
        "end_ms": 3090800,
        "text": "7号平民自动当选警长"
      },
      {
        "start_ms": 3090800,
        "end_ms": 3092680,
        "text": "入夜守卫守护7号平民狼队"
      },
      {
        "start_ms": 3092680,
        "end_ms": 3094760,
        "text": "击杀12号平民女巫技能哦"
      },
      {
        "start_ms": 3094760,
        "end_ms": 3096069,
        "text": "不机械女巫技能"
      },
      {
        "start_ms": 3096069,
        "end_ms": 3098890,
        "text": "通过通灵师验证了4号玩家为狼人身份"
      },
      {
        "start_ms": 3098890,
        "end_ms": 3100070,
        "text": "在第二天的白天"
      },
      {
        "start_ms": 3100070,
        "end_ms": 3101370,
        "text": "4号狼人选择自爆"
      },
      {
        "start_ms": 3101370,
        "end_ms": 3103220,
        "text": "瑞野守卫守护一号通灵师"
      },
      {
        "start_ms": 3103220,
        "end_ms": 3105240,
        "text": "狼队击杀7号平民"
      },
      {
        "start_ms": 3105240,
        "end_ms": 3107100,
        "text": "机械女巫技能继续通过"
      },
      {
        "start_ms": 3107100,
        "end_ms": 3110130,
        "text": "通灵师验证了5号玩家为狼人身份"
      },
      {
        "start_ms": 3110130,
        "end_ms": 3111530,
        "text": "在第三天的白天"
      },
      {
        "start_ms": 3111530,
        "end_ms": 3113270,
        "text": "5号狼人选择自爆"
      },
      {
        "start_ms": 3113270,
        "end_ms": 3118680,
        "text": "咳咳入夜守卫守护11号平民"
      },
      {
        "start_ms": 3118680,
        "end_ms": 3121340,
        "text": "机械狼击杀11号平民"
      },
      {
        "start_ms": 3121340,
        "end_ms": 3122569,
        "text": "形成平安夜"
      },
      {
        "start_ms": 3122569,
        "end_ms": 3125389,
        "text": "在当夜发动技能毒杀8号猎人"
      },
      {
        "start_ms": 3125389,
        "end_ms": 3127149,
        "text": "当夜为8号猎人单死"
      },
      {
        "start_ms": 3127149,
        "end_ms": 3128969,
        "text": "通灵师验证6号玩家"
      },
      {
        "start_ms": 3128969,
        "end_ms": 3130880,
        "text": "机械狼为女巫身份"
      },
      {
        "start_ms": 3130880,
        "end_ms": 3132380,
        "text": "在第四天的白天"
      },
      {
        "start_ms": 3132380,
        "end_ms": 3132800,
        "text": "场上"
      },
      {
        "start_ms": 3132800,
        "end_ms": 3133380,
        "text": "最后一狼"
      },
      {
        "start_ms": 3133380,
        "end_ms": 3135520,
        "text": "6号机械女巫选择交牌"
      },
      {
        "start_ms": 3135520,
        "end_ms": 3136320,
        "text": "游戏结束"
      },
      {
        "start_ms": 3136320,
        "end_ms": 3137460,
        "text": "好人阵营获胜"
      },
      {
        "start_ms": 3137460,
        "end_ms": 3139920,
        "text": "以上是我们今天三局版型的全部内容"
      },
      {
        "start_ms": 3139920,
        "end_ms": 3141529,
        "text": "非常感谢各位家人的陪伴"
