    "recap_segments": [
      {
        "start_ms": 5498635,
        "end_ms": 5500355,
        "text": "第三九戏结束了机械狼通灵师，"
      },
      {
        "start_ms": 5500355,
        "end_ms": 5501615,
        "text": "版型本游戏通灵师。"
      },
      {
        "start_ms": 5501615,
        "end_ms": 5510145,
        "text": "四号女巫三号猎人八号守卫二号机械狼十号玩了一号九号、十一号平民五号六号七号十二号首页机械狼模仿。"
      },
      {
        "start_ms": 5510145,
        "end_ms": 5514005,
        "text": "四号通灵师本就是为机械通灵师首未通过拉吉莎。"
      },
      {
        "start_ms": 5514045,
        "end_ms": 5516185,
        "text": "十号机械狼牛开药解救行辰，"
      },
      {
        "start_ms": 5516185,
        "end_ms": 5521270,
        "text": "平安夜通灵师验证二号男位守卫身份上警环节圈上警警徽流失。"
      },
      {
        "start_ms": 5521605,
        "end_ms": 5522305,
        "text": "第一天白天，"
      },
      {
        "start_ms": 5522325,
        "end_ms": 5524150,
        "text": "十一号狼人被公投出局，"
      },
      {
        "start_ms": 5524535,
        "end_ms": 5526635,
        "text": "入夜守卫守护四号通灵师狼人击杀。"
      },
      {
        "start_ms": 5526635,
        "end_ms": 5531130,
        "text": "二号守卫机械狼验证一号玩家为狼人同伴。"
      },
      {
        "start_ms": 5531975,
        "end_ms": 5533095,
        "text": "牛毒杀九号，"
      },
      {
        "start_ms": 5533235,
        "end_ms": 5534275,
        "text": "狼人通灵师验证，"
      },
      {
        "start_ms": 5534275,
        "end_ms": 5536995,
        "text": "十号安家威通灵师身份照了个镜子。"
      },
      {
        "start_ms": 5537495,
        "end_ms": 5538155,
        "text": "第二天白天，"
      },
      {
        "start_ms": 5538155,
        "end_ms": 5539635,
        "text": "十号机械通灵师，"
      },
      {
        "start_ms": 5539815,
        "end_ms": 5540895,
        "text": "被公投出局，"
      },
      {
        "start_ms": 5540895,
        "end_ms": 5541695,
        "text": "入夜狼人击杀。"
      },
      {
        "start_ms": 5541695,
        "end_ms": 5543135,
        "text": "四号通灵师通灵师，"
      },
      {
        "start_ms": 5543135,
        "end_ms": 5544915,
        "text": "验证一号安家威狼人身份。"
      },
      {
        "start_ms": 5544995,
        "end_ms": 5547675,
        "text": "第三天白天最后一张狼人一号被公投出局，"
      },
      {
        "start_ms": 5547955,
        "end_ms": 5548635,
        "text": "游戏结束。"
      },
      {
        "start_ms": 5548635,
        "end_ms": 5548815,
        "text": "好，"
      },
      {
        "start_ms": 5548815,
        "end_ms": 5549535,
        "text": "人阵义获胜。"
      },
      {
        "start_ms": 5550395,
        "end_ms": 5550615,
        "text": "好，"
      },
      {
        "start_ms": 5550615,
        "end_ms": 5551275,
        "text": "各位大宝师们们，"
      },
      {
        "start_ms": 5551275,
        "end_ms": 5559555,
        "text": "这里是京城大赛第二十二季曙光航迹京城大赛第二十二季是由天天狼人以及捞月狗APP联合赞助播出的。"
      }
    ]
