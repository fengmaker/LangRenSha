  "day_crosscheck_changes": [],
  "day_crosscheck_source": {
    "path": "data/games/S22/2026-08-13_g02_BV1aXgW6nE6E/复核记录.json",
    "sha256": "0f56ad5579650d2af5ef8936921415819aad27fef29c014a6509a8632a5e9973",
    "recap_segments": [
      {
        "start_ms": 5106585,
        "end_ms": 5106855,
        "text": "好，"
      },
      {
        "start_ms": 5108705,
        "end_ms": 5111025,
        "text": "来给各位大老师们做一下本局游戏的复盘。"
      },
      {
        "start_ms": 5111165,
        "end_ms": 5112145,
        "text": "本局版行为，"
      },
      {
        "start_ms": 5112305,
        "end_ms": 5113220,
        "text": "盗宝大师，"
      },
      {
        "start_ms": 5113565,
        "end_ms": 5115095,
        "text": "你知道深人阵营通灵师，"
      },
      {
        "start_ms": 5115175,
        "end_ms": 5117695,
        "text": "八号毒师十二号猎人，"
      },
      {
        "start_ms": 5117775,
        "end_ms": 5118955,
        "text": "十号、蒙面人，"
      },
      {
        "start_ms": 5118955,
        "end_ms": 5126660,
        "text": "三号狼人阵营六号、十一号狼王五号盗宝大师七号本局游戏为盗宝设梦。"
      },
      {
        "start_ms": 5128045,
        "end_ms": 5128285,
        "text": "嗯，"
      },
      {
        "start_ms": 5128425,
        "end_ms": 5128990,
        "text": "是的，"
      },
      {
        "start_ms": 5129395,
        "end_ms": 5131335,
        "text": "平民阵营一号、二号、四号九号，"
      },
      {
        "start_ms": 5131795,
        "end_ms": 5134855,
        "text": "首夜盗宝大师切换为射梦人身份，"
      },
      {
        "start_ms": 5134935,
        "end_ms": 5135995,
        "text": "并在当夜梦游。"
      },
      {
        "start_ms": 5135995,
        "end_ms": 5138035,
        "text": "十号猎人当演通灵师，"
      },
      {
        "start_ms": 5138035,
        "end_ms": 5140635,
        "text": "验证了五号玩家为狼王身份，"
      },
      {
        "start_ms": 5140695,
        "end_ms": 5143920,
        "text": "在警上竞选环节八号通灵师获得警徽。"
      },
      {
        "start_ms": 5144295,
        "end_ms": 5144815,
        "text": "在第一天，"
      },
      {
        "start_ms": 5144815,
        "end_ms": 5145215,
        "text": "白天，"
      },
      {
        "start_ms": 5145375,
        "end_ms": 5151220,
        "text": "十号猎人被抗推出局并开枪带走六号狼人入夜，"
      },
      {
        "start_ms": 5151865,
        "end_ms": 5153925,
        "text": "狼队击杀八号通灵师，"
      },
      {
        "start_ms": 5154085,
        "end_ms": 5155125,
        "text": "毒尸毒杀，"
      },
      {
        "start_ms": 5155245,
        "end_ms": 5157365,
        "text": "十一号狼人当夜为八号，"
      },
      {
        "start_ms": 5157425,
        "end_ms": 5160715,
        "text": "十一号双子通灵师验证了七号。"
      },
      {
        "start_ms": 5161035,
        "end_ms": 5164580,
        "text": "在夜间切换为平民身份的盗宝大师为平民身份，"
      },
      {
        "start_ms": 5164915,
        "end_ms": 5168880,
        "text": "并在出局后将警徽移交至七号盗宝大师。"
      },
      {
        "start_ms": 5169365,
        "end_ms": 5170465,
        "text": "在第二天的白天，"
      },
      {
        "start_ms": 5170565,
        "end_ms": 5176445,
        "text": "五号狼王选择自爆入夜盗宝大师选择设梦人身份，"
      },
      {
        "start_ms": 5176445,
        "end_ms": 5180075,
        "text": "并梦游九号平民当业开刀击杀。"
      },
      {
        "start_ms": 5180155,
        "end_ms": 5181075,
        "text": "十二号毒师，"
      },
      {
        "start_ms": 5181095,
        "end_ms": 5182415,
        "text": "当夜为十二号毒师单死。"
      },
      {
        "start_ms": 5182495,
        "end_ms": 5183400,
        "text": "第三天白天，"
      },
      {
        "start_ms": 5183725,
        "end_ms": 5185445,
        "text": "一号平民被抗推出，"
      },
      {
        "start_ms": 5185445,
        "end_ms": 5188865,
        "text": "局入夜盗宝大师开刀击杀。"
      },
      {
        "start_ms": 5189045,
        "end_ms": 5194465,
        "text": "三号蒙面人在第二天白天三号蒙面人发言后倒牌，"
      },
      {
        "start_ms": 5194485,
        "end_ms": 5195065,
        "text": "游戏结束，"
      },
      {
        "start_ms": 5195285,
        "end_ms": 5196665,
        "text": "狼人阵营突神获胜。"
      },
      {
        "start_ms": 5196745,
        "end_ms": 5199525,
        "text": "以上是我们今天第二局版型盗宝大师的全部内容，"
      },
      {
        "start_ms": 5199525,
        "end_ms": 5201060,
        "text": "非常感谢各位家人的陪伴。"
      }
    ]
  },
