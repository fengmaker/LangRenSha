      },
      {
        "start_ms": 3804925,
        "end_ms": 3806630,
        "text": "五号狼人选择自爆，"
      },
      {
        "start_ms": 3807965,
        "end_ms": 3808945,
        "text": "入夜狼队击杀，"
      },
      {
        "start_ms": 3809045,
        "end_ms": 3810305,
        "text": "十二号预言家，"
      },
      {
        "start_ms": 3810445,
        "end_ms": 3811745,
        "text": "女巫就能空过预言家，"
      },
      {
        "start_ms": 3811745,
        "end_ms": 3812405,
        "text": "验证六号，"
      },
      {
        "start_ms": 3812405,
        "end_ms": 3813525,
        "text": "玩家平民为好人，"
      },
      {
        "start_ms": 3813525,
