      {
        "start_ms": 4930040,
        "end_ms": 4930880,
        "text": "狼爷呃"
      },
      {
        "start_ms": 4930880,
        "end_ms": 4933060,
        "text": "狼队当夜选择击杀8号预言家"
      },
      {
        "start_ms": 4933060,
        "end_ms": 4935640,
        "text": "预言家验证了2号玩家平民为好人身份"
