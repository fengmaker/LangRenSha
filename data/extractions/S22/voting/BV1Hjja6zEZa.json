      {
        "start_ms": 4940980,
        "end_ms": 4943500,
        "text": "2号平民被抗推出局后"
      },
      {
        "start_ms": 4943500,
        "end_ms": 4945800,
        "text": "警徽移交至11号平民"
      },
      {
        "start_ms": 4945800,
