  "day_crosscheck_source": {
    "path": "data/games/S22/2026-07-08_g03_BV1suMG6PEYP/复核记录.json",
    "sha256": "95d6e275629f288c34373d9ff963decc550b9d781fd1a1fc89ba633a8fcac735",
    "recap_segments": [
      {
        "start_ms": 6292905,
        "end_ms": 6293145,
        "text": "好，"
      },
      {
        "start_ms": 6293145,
        "end_ms": 6294145,
        "text": "第三游戏结束了。"
      },
      {
        "start_ms": 6294145,
        "end_ms": 6306585,
        "text": "接下来通力师版型本游戏通力师九号女巫五号恋人十二号守卫二号机械狼四号狼人六号八号十号平民一号三号七号十一号首页机械狼模仿十号狼人，"
      },
      {
        "start_ms": 6306585,
        "end_ms": 6311585,
        "text": "同伴本游戏为机械双刀狼人首页通过蓝极山二号守卫女巫开药解救星辰，"
      },
      {
        "start_ms": 6311585,
        "end_ms": 6312985,
        "text": "平安夜通灵师验证，"
      },
      {
        "start_ms": 6312985,
        "end_ms": 6315380,
        "text": "三号玩家为平民身份上警环节，"
      },
      {
        "start_ms": 6315785,
        "end_ms": 6317825,
        "text": "五号女巫获得警徽。"
      },
      {
        "start_ms": 6317825,
        "end_ms": 6318405,
        "text": "第一天白天，"
      },
      {
        "start_ms": 6318405,
        "end_ms": 6318785,
        "text": "五号，"
      },
      {
        "start_ms": 6318785,
        "end_ms": 6319725,
        "text": "女巫被抗退出，"
      },
      {
        "start_ms": 6319725,
        "end_ms": 6321320,
        "text": "局警徽交至七号平民，"
      },
      {
        "start_ms": 6321765,
        "end_ms": 6322085,
        "text": "入夜，"
      },
      {
        "start_ms": 6322085,
        "end_ms": 6324225,
        "text": "守卫守护七号平民狼人击杀九号，"
      },
      {
        "start_ms": 6324225,
        "end_ms": 6324840,
        "text": "通灵师，"
      },
      {
        "start_ms": 6325225,
        "end_ms": 6326105,
        "text": "当夜通灵师验证，"
      },
      {
        "start_ms": 6326105,
        "end_ms": 6327930,
        "text": "一号玩家为平民身份。"
      },
      {
        "start_ms": 6328325,
        "end_ms": 6329025,
        "text": "第二天白天，"
      },
      {
        "start_ms": 6329325,
        "end_ms": 6330625,
        "text": "十号狼人自爆，"
      },
      {
        "start_ms": 6331005,
        "end_ms": 6332825,
        "text": "入夜守卫守护三号平民，"
      },
      {
        "start_ms": 6332905,
        "end_ms": 6333505,
        "text": "狼人击杀。"
      },
      {
        "start_ms": 6333505,
        "end_ms": 6335665,
        "text": "二号守卫第三天白天，"
      },
      {
        "start_ms": 6335845,
        "end_ms": 6337150,
        "text": "六号狼人自爆，"
      },
      {
        "start_ms": 6337515,
        "end_ms": 6339875,
        "text": "入夜狼藉杀七号平民七号出局，"
      },
      {
        "start_ms": 6339875,
        "end_ms": 6341690,
        "text": "将警徽移交至十二号猎人。"
      },
      {
        "start_ms": 6342135,
        "end_ms": 6342535,
        "text": "第四天。"
      },
      {
        "start_ms": 6342535,
        "end_ms": 6343915,
        "text": "白天八号狼人自爆，"
      },
      {
        "start_ms": 6344055,
        "end_ms": 6349985,
        "text": "入夜机械狼拍刀十二号和十一号给出了明确的刀路啊，"
      },
      {
        "start_ms": 6349985,
        "end_ms": 6352220,
        "text": "然后是小刀击杀十二号猎人，"
      },
      {
        "start_ms": 6352635,
        "end_ms": 6355035,
        "text": "然后大刀击杀十一号平民由戏结束，"
      },
      {
        "start_ms": 6355035,
        "end_ms": 6356190,
        "text": "郎阵英突神获胜。"
      },
      {
        "start_ms": 6357295,
        "end_ms": 6357415,
        "text": "好，"
      },
      {
        "start_ms": 6357415,
        "end_ms": 6358055,
        "text": "各位道幕老师们，"
      },
      {
        "start_ms": 6358055,
        "end_ms": 6362395,
        "text": "您正在收看到的节目是京城大师赛第二十二季曙光航迹金蝉大赛。"
      },
      {
        "start_ms": 6362395,
        "end_ms": 6366620,
        "text": "第二十二季是由捞月狗APP和天天老APP联合冠名赞助播出的，"
      },
      {
        "start_ms": 6367155,
        "end_ms": 6368575,
        "text": "没空组局约人太累，"
      },
      {
        "start_ms": 6368655,
        "end_ms": 6370175,
        "text": "现在打开捞月狗APP,"
      },
      {
        "start_ms": 6370175,
        "end_ms": 6371035,
        "text": "一秒匹配，"
      },
      {
        "start_ms": 6371035,
        "end_ms": 6371680,
        "text": "随时开局。"
      },
      {
        "start_ms": 6371985,
        "end_ms": 6373225,
        "text": "感谢捞月狗APP."
      },
      {
        "start_ms": 6373225,
        "end_ms": 6374870,
        "text": "对于本节目的大力支持，"
      },
      {
        "start_ms": 6375235,
        "end_ms": 6378615,
        "text": "现在呢就可以去下载并输入DJDJ的代码，"
      },
      {
        "start_ms": 6378615,
        "end_ms": 6379795,
        "text": "领取新人红包，"
      },
      {
        "start_ms": 6379975,
        "end_ms": 6381050,
        "text": "免排队特权。"
      },
      {
        "start_ms": 6381485,
        "end_ms": 6381985,
        "text": "除此之外，"
      },
      {
        "start_ms": 6381985,
        "end_ms": 6385525,
        "text": "欢迎各位弹幕老师们到各大应用商店来搜索并下载天天玩APP,"
      },
      {
        "start_ms": 6385525,
        "end_ms": 6388390,
        "text": "来跟我们一起玩京城大师赛的同款版型。"
      },
      {
        "start_ms": 6388745,
        "end_ms": 6392925,
        "text": "同时感谢哈尼牧场、柠檬共和国以及懒痴霞对本节目的大力支持。"
      },
      {
        "start_ms": 6393125,
        "end_ms": 6393705,
        "text": "欢迎各位弹幕，"
      },
      {
        "start_ms": 6393705,
        "end_ms": 6397260,
        "text": "老师们随时到我们JY大事的主页橱窗当中来下单捕货。"
      },
      {
        "start_ms": 6397635,
        "end_ms": 6398455,
        "text": "另外各位大宝师们，"
      },
      {
        "start_ms": 6398455,
        "end_ms": 6404350,
        "text": "明天下午的三点到五点钟会有我们本赛季的周边为大家来捕获了。"
      },
      {
        "start_ms": 6404625,
        "end_ms": 6406345,
        "text": "明天会在我们三点到五点的时候，"
      },
      {
        "start_ms": 6406345,
        "end_ms": 6409470,
        "text": "在京师甄选的直播间来呃重新上线。"
      },
      {
        "start_ms": 6409775,
        "end_ms": 6411215,
        "text": "然后五点到七点的时候，"
      },
      {
        "start_ms": 6411215,
        "end_ms": 6414230,
        "text": "会有我们京城大赛周边的t恤首发上线。"
      },
      {
        "start_ms": 6414565,
        "end_ms": 6416885,
        "text": "明天的带货主播是宝玉和陈明俊，"
      },
      {
        "start_ms": 6416885,
        "end_ms": 6418550,
        "text": "欢迎各位弹幕老师们多多捧场。"
      },
      {
        "start_ms": 6418935,
        "end_ms": 6421535,
        "text": "而后天也就是周五的下午四点到六点，"
      },
      {
        "start_ms": 6421675,
        "end_ms": 6426125,
        "text": "也会有KS和耿雪儿为我们带来呃繁星之轮的水晶的新品。"
      },
      {
        "start_ms": 6426125,
        "end_ms": 6427620,
        "text": "大家也可以同时期待一下。"
      },
      {
        "start_ms": 6428305,
        "end_ms": 6430960,
        "text": "最后最后呢还会有一个小小的活动。"
      },
      {
        "start_ms": 6431255,
        "end_ms": 6434975,
        "text": "京城大赛和优酷游戏联合开启了惊喜票根的定制活动。"
      },
      {
        "start_ms": 6434975,
        "end_ms": 6435995,
        "text": "打开优酷APP,"
      },
      {
        "start_ms": 6435995,
        "end_ms": 6437480,
        "text": "搜索京城大师赛，"
      },
      {
        "start_ms": 6437755,
        "end_ms": 6439690,
        "text": "即可获取票根定制入口。"
      },
      {
        "start_ms": 6439975,
        "end_ms": 6442560,
        "text": "快来pick自己最鼠意的那个主播，"
      },
      {
        "start_ms": 6442925,
        "end_ms": 6445570,
        "text": "然后把这份独属于京城大师赛记忆打回家。"
      },
      {
        "start_ms": 6446005,
        "end_ms": 6447925,
        "text": "以上就是今天精神大赛的全部内容了，"
      },
      {
        "start_ms": 6447925,
        "end_ms": 6448685,
        "text": "明天晚上七点钟，"
      },
      {
        "start_ms": 6448685,
        "end_ms": 6451815,
        "text": "这位大师直播间京城大赛第二十二季继续播出，"
      },
      {
        "start_ms": 6451875,
        "end_ms": 6453915,
        "text": "欢迎各位大宝师们届时收看诸位。"
      },
      {
        "start_ms": 6453915,
        "end_ms": 6454375,
        "text": "晚安好梦，"
      },
      {
        "start_ms": 6454375,
        "end_ms": 6454675,
        "text": "拜拜，"
      },
      {
        "start_ms": 6454675,
        "end_ms": 6455270,
        "text": "明天见喽。"
      },
      {
        "start_ms": 6461325,
        "end_ms": 6462860,
        "text": "准备好拼死一搏了吗？"
      },
      {
        "start_ms": 6463355,
        "end_ms": 6464120,
        "text": "小意思，"
      },
      {
        "start_ms": 6464495,
        "end_ms": 6467985,
        "text": "我带你杀出去小心小心，"
      },
      {
        "start_ms": 6467985,
        "end_ms": 6471725,
        "text": "你快过来呀啊你这这儿下了早开黑搭子，"
      }
    ]
  },
