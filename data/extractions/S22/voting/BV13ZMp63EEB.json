  "day_crosscheck_changes": [],
  "day_crosscheck_source": {
    "path": "data/games/S22/2026-07-09_g03_BV13ZMp63EEB/复核记录.json",
    "sha256": "8724b874a10873b5f6a351d11db3598bc216dd8958aa2344197e917f8aed0718",
    "recap_segments": [
      {
        "start_ms": 3786655,
        "end_ms": 3788030,
        "text": "我怕有双包说大哥怎么办？"
      },
      {
        "start_ms": 3788995,
        "end_ms": 3796365,
        "text": "签字强烈谴责你们这些来给各位大幕老师们做本酒席的复盘。"
      },
      {
        "start_ms": 3796365,
        "end_ms": 3796945,
        "text": "本剧版型，"
      },
      {
        "start_ms": 3796945,
        "end_ms": 3797910,
        "text": "机械狼通律师，"
      },
      {
        "start_ms": 3798295,
        "end_ms": 3800635,
        "text": "神圣银通令十八号女巫十二号猎人九号，"
      },
      {
        "start_ms": 3800675,
        "end_ms": 3803395,
        "text": "守卫十号狼人阵营二号六号十一号。"
      },
      {
        "start_ms": 3803395,
        "end_ms": 3814305,
        "text": "机械狼七号本球区为机械平民平民阵营一号三号、四号五号首页首位守护四号平民狼人击杀四号平民牛要救起四号玩家，"
      },
      {
        "start_ms": 3814385,
        "end_ms": 3816765,
        "text": "同手同就乃川身亡当业。"
      },
      {
        "start_ms": 3816765,
        "end_ms": 3821410,
        "text": "机械狼模仿一号平民本局游戏为机械平民通灵师验证九号玩家为猎人身份，"
      },
      {
        "start_ms": 3821765,
        "end_ms": 3822625,
        "text": "请上竞选环节。"
      },
      {
        "start_ms": 3822645,
        "end_ms": 3823925,
        "text": "九号猎人获得警徽。"
      },
      {
        "start_ms": 3823925,
        "end_ms": 3827065,
        "text": "第一天白天十一号悍跳狼人选择自爆嗯，"
      },
      {
        "start_ms": 3827605,
        "end_ms": 3828545,
        "text": "入夜守卫守护。"
      },
      {
        "start_ms": 3828545,
        "end_ms": 3833585,
        "text": "九号猎人狼人击杀三号平民牛犊杀七号机械狼三号七号双死，"
      },
      {
        "start_ms": 3833665,
        "end_ms": 3836080,
        "text": "叶娟通灵师验证六号玩家为狼人身份，"
      },
      {
        "start_ms": 3836445,
        "end_ms": 3837605,
        "text": "在第二天的白天，"
      },
      {
        "start_ms": 3837625,
        "end_ms": 3838065,
        "text": "六号，"
      },
      {
        "start_ms": 3838085,
        "end_ms": 3838970,
        "text": "狼人选择自爆，"
      },
      {
        "start_ms": 3839325,
        "end_ms": 3841205,
        "text": "入夜守卫技能通过狼队击杀。"
      },
      {
        "start_ms": 3841205,
        "end_ms": 3843865,
        "text": "九号猎人通灵师验证了二号玩家，"
      },
      {
        "start_ms": 3843865,
        "end_ms": 3844760,
        "text": "我以狼人身份。"
      },
      {
        "start_ms": 3845145,
        "end_ms": 3847925,
        "text": "九号猎人出局后开枪带走一号平民，"
      },
      {
        "start_ms": 3847925,
        "end_ms": 3849565,
        "text": "并将警徽移交至八号。"
      },
      {
        "start_ms": 3849685,
        "end_ms": 3850400,
        "text": "通灵师。"
      },
      {
        "start_ms": 3850835,
        "end_ms": 3852435,
        "text": "在第三天的白天场上，"
      },
      {
        "start_ms": 3852435,
        "end_ms": 3855640,
        "text": "最后一狼二号选择自爆游戏结束好人阵营获胜。"
      },
      {
        "start_ms": 3856075,
        "end_ms": 3859015,
        "text": "以上就是我们今天京城大师赛三局版型的全部内容，"
      },
      {
        "start_ms": 3859015,
        "end_ms": 3860515,
        "text": "再一次感谢各位家人陪伴，"
      },
      {
        "start_ms": 3860535,
        "end_ms": 3861835,
        "text": "同时感谢赞助商，"
      }
    ]
  },
