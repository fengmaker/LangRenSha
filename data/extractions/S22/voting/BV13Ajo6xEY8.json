    "recap_segments": [
      {
        "start_ms": 4060875,
        "end_ms": 4063155,
        "text": "九号玩家三票出局，"
      },
      {
        "start_ms": 4063395,
        "end_ms": 4065090,
        "text": "游戏结束好人正义获胜。"
      },
      {
        "start_ms": 4065895,
        "end_ms": 4068035,
        "text": "所以你这个小红拿是预言家，"
      },
      {
        "start_ms": 4068105,
        "end_ms": 4069645,
        "text": "她是机械女巫啊，"
      },
      {
        "start_ms": 4069645,
        "end_ms": 4070405,
        "text": "她是机械女巫。"
      },
      {
        "start_ms": 4070405,
        "end_ms": 4072785,
        "text": "十一是小狼是言家哦，"
      },
      {
        "start_ms": 4072965,
        "end_ms": 4074275,
        "text": "这个关机银水，"
      },
      {
        "start_ms": 4074685,
        "end_ms": 4075440,
        "text": "我知道你，"
      },
      {
        "start_ms": 4075575,
        "end_ms": 4076805,
        "text": "而且要要是吧，"
      },
      {
        "start_ms": 4076985,
        "end_ms": 4078845,
        "text": "因为基本这样的好，"
      },
      {
        "start_ms": 4078945,
        "end_ms": 4080125,
        "text": "第三局游戏结束了。"
      },
      {
        "start_ms": 4080125,
        "end_ms": 4082905,
        "text": "本戏机机狼通通灵师版型通灵六号女巫，"
      },
      {
        "start_ms": 4082905,
        "end_ms": 4084865,
        "text": "五号猎人三号守卫，"
      },
      {
        "start_ms": 4084865,
        "end_ms": 4092785,
        "text": "十二号机械狼九号、狼人一号、二号、十一号平民四号七号八号十号首夜机械狼模仿五号女巫，"
      },
      {
        "start_ms": 4092785,
        "end_ms": 4097490,
        "text": "本就行为机械女巫守卫通过狼人击杀四号平民女巫开药解救形成平安夜，"
      },
      {
        "start_ms": 4097885,
        "end_ms": 4098745,
        "text": "当月通灵师验证，"
      },
      {
        "start_ms": 4098745,
        "end_ms": 4102825,
        "text": "七号将为平民身份上警环节全上警警徽流失。"
      },
      {
        "start_ms": 4102825,
        "end_ms": 4103580,
        "text": "第一天白天，"
      },
      {
        "start_ms": 4103905,
        "end_ms": 4105660,
        "text": "二号狼人被公投出局，"
      },
      {
        "start_ms": 4106055,
        "end_ms": 4110325,
        "text": "入夜守卫守护十二号自首狼人击杀七号平民女巫毒杀，"
      },
      {
        "start_ms": 4110745,
        "end_ms": 4113815,
        "text": "十一号狼人当夜机械女巫毒杀，"
      },
      {
        "start_ms": 4113915,
        "end_ms": 4117155,
        "text": "五号女巫五七十一三四通名身验证，"
      },
      {
        "start_ms": 4117155,
        "end_ms": 4118670,
        "text": "五号玩家为女巫身份。"
      },
      {
        "start_ms": 4119075,
        "end_ms": 4119355,
        "text": "第二天，"
      },
      {
        "start_ms": 4119355,
        "end_ms": 4120595,
        "text": "白天一号狼人自爆，"
      },
      {
        "start_ms": 4120615,
        "end_ms": 4120975,
        "text": "入夜，"
      },
      {
        "start_ms": 4120975,
        "end_ms": 4121895,
        "text": "守卫守护六号，"
      },
      {
        "start_ms": 4121895,
        "end_ms": 4125295,
        "text": "通灵师狼人击杀六号形成平安夜当夜通灵验证，"
      },
      {
        "start_ms": 4125295,
        "end_ms": 4127160,
        "text": "三号玩家为猎人身份。"
      },
      {
        "start_ms": 4127565,
        "end_ms": 4129525,
        "text": "第三天白天最后一张狼人九号，"
      },
      {
        "start_ms": 4129545,
        "end_ms": 4131005,
        "text": "机械女巫被公投出局，"
      },
      {
        "start_ms": 4131065,
        "end_ms": 4132870,
        "text": "游戏结束好人正义获胜。"
      },
      {
        "start_ms": 4134165,
        "end_ms": 4134285,
        "text": "好，"
      },
      {
        "start_ms": 4134285,
        "end_ms": 4136765,
        "text": "各位大宝老师们这里是京城大赛第二十二季，"
      },
      {
        "start_ms": 4136765,
        "end_ms": 4138125,
        "text": "曙光航迹京城大师赛。"
      }
    ]
  },
