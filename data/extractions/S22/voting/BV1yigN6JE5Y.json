  "day_crosscheck_changes": [],
  "day_crosscheck_source": {
    "path": "data/games/S22/2026-08-14_g02_BV1yigN6JE5Y/复核记录.json",
    "sha256": "65aa08a138ebdd977296c31e8abe2b9d8b2e2a5c16d6eb56b445a90ce6e6baae",
    "recap_segments": [
      {
        "start_ms": 3556100,
        "end_ms": 3556700,
        "text": "你听不懂"
      },
      {
        "start_ms": 3556700,
        "end_ms": 3557640,
        "text": "不用自己发"
      },
      {
        "start_ms": 3557640,
        "end_ms": 3559670,
        "text": "说的对好"
      },
      {
        "start_ms": 3559670,
        "end_ms": 3562270,
        "text": "接下来给各位大老师们做一下本周游戏的复盘"
      },
      {
        "start_ms": 3562270,
        "end_ms": 3565880,
        "text": "本局款新为孤注一掷"
      },
      {
        "start_ms": 3567160,
        "end_ms": 3569080,
        "text": "深圳营预言家10号女巫"
      },
      {
        "start_ms": 3569080,
        "end_ms": 3570280,
        "text": "11号射梦人"
      },
      {
        "start_ms": 3570280,
        "end_ms": 3571280,
        "text": "2号猎人"
      },
      {
        "start_ms": 3571280,
        "end_ms": 3573519,
        "text": "5号咳咳"
      },
      {
        "start_ms": 3573519,
        "end_ms": 3575759,
        "text": "狼人阵营一号7号"
      },
      {
        "start_ms": 3575759,
        "end_ms": 3578999,
        "text": "12号典狱长为8号平民阵营"
      },
      {
        "start_ms": 3578999,
        "end_ms": 3579819,
        "text": "3号四号"
      },
      {
        "start_ms": 3579819,
        "end_ms": 3584210,
        "text": "6号九号首页射梦人梦游9号平民狼人"
      },
      {
        "start_ms": 3584210,
        "end_ms": 3586510,
        "text": "击杀2号摄梦人牛药救起"
      },
      {
        "start_ms": 3586510,
        "end_ms": 3587790,
        "text": "形成平安夜"
      },
      {
        "start_ms": 3587790,
        "end_ms": 3591430,
        "text": "当验预言家验证了2号玩家声某人为好人身份"
      },
      {
        "start_ms": 3591430,
        "end_ms": 3592950,
        "text": "在警上竞选环节"
      },
      {
        "start_ms": 3592950,
        "end_ms": 3594940,
        "text": "10号预言家获得警徽"
      },
      {
        "start_ms": 3594940,
        "end_ms": 3595880,
        "text": "第一天白天"
      },
      {
        "start_ms": 3595880,
        "end_ms": 3598240,
        "text": "12号狼人选择自爆入夜"
      },
      {
        "start_ms": 3598240,
        "end_ms": 3603170,
        "text": "典狱长选择一号狼人及7号狼人进行交易"
      },
      {
        "start_ms": 3603170,
        "end_ms": 3604870,
        "text": "双方均选择交易"
      },
      {
        "start_ms": 3604870,
        "end_ms": 3608470,
        "text": "所以二位一号7号在夜间免疫任何伤害"
      },
      {
        "start_ms": 3608470,
        "end_ms": 3610650,
        "text": "当夜圣梦人梦游7号狼人"
      },
      {
        "start_ms": 3610650,
        "end_ms": 3612350,
        "text": "狼队击杀10号预言家"
      },
      {
        "start_ms": 3612350,
        "end_ms": 3613430,
        "text": "女巫技能空过"
      },
      {
        "start_ms": 3613430,
        "end_ms": 3615930,
        "text": "当夜为10号预言家单死"
      },
      {
        "start_ms": 3615930,
        "end_ms": 3619070,
        "text": "夜间预言家验证了一号玩家为狼人身份"
      },
      {
        "start_ms": 3619070,
        "end_ms": 3622920,
        "text": "并在出局后将警徽移交至2号摄梦人"
      },
      {
        "start_ms": 3622920,
        "end_ms": 3624260,
        "text": "在第二天的白天"
      },
      {
        "start_ms": 3624260,
        "end_ms": 3626540,
        "text": "一号狼人选择自爆入夜"
      },
      {
        "start_ms": 3626540,
        "end_ms": 3629290,
        "text": "典狱长选择2号售梦人"
      },
      {
        "start_ms": 3629290,
        "end_ms": 3632150,
        "text": "以及8号典狱长进行交易"
      },
      {
        "start_ms": 3632150,
        "end_ms": 3634609,
        "text": "双方选择交易"
      },
      {
        "start_ms": 3634609,
        "end_ms": 3637290,
        "text": "由于我们典狱长的特殊结算规则"
      },
      {
        "start_ms": 3637290,
        "end_ms": 3640430,
        "text": "如果双方选择与典狱长相同"
      },
      {
        "start_ms": 3640430,
        "end_ms": 3641950,
        "text": "则典狱场出局"
      },
      {
        "start_ms": 3641950,
        "end_ms": 3644590,
        "text": "所以当夜的交易是典狱狱长出局"
      },
      {
        "start_ms": 3644590,
        "end_ms": 3646390,
        "text": "夜间热梦人是夜间生"
      },
      {
        "start_ms": 3646390,
        "end_ms": 3648490,
        "text": "某人再次梦游7号狼人"
      },
      {
        "start_ms": 3648490,
        "end_ms": 3651270,
        "text": "当夜为7号八号双死"
      },
      {
        "start_ms": 3651270,
        "end_ms": 3652090,
        "text": "游戏结束"
      },
      {
        "start_ms": 3652090,
        "end_ms": 3653270,
        "text": "好人阵营获胜"
      },
      {
        "start_ms": 3653270,
        "end_ms": 3655030,
        "text": "以上是我们今天第二局版型"
      },
      {
        "start_ms": 3655030,
        "end_ms": 3656350,
        "text": "孤注一掷的全部内容"
      },
      {
        "start_ms": 3656350,
        "end_ms": 3658150,
        "text": "非常感谢各位弹幕老师的陪伴"
      }
    ]
  },
