  "segments": [
    {
      "id": 0,
      "start": 0.0,
      "end": 130.0,
      "text": "有否还记得最初",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 1,
      "start": 130.0,
      "end": 131.28,
      "text": "慕悠",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 2,
      "start": 131.28,
      "end": 138.05,
      "text": "还会想",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 3,
      "start": 138.05,
      "end": 140.93,
      "text": "我记在逻辑重迹当",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 4,
      "start": 140.93,
      "end": 144.97,
      "text": "原谅心中的呼",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 5,
      "start": 144.97,
      "end": 156.69,
      "text": "也好相瞒的梦",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 6,
      "start": 156.69,
      "end": 160.96,
      "text": "我让这故事",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 7,
      "start": 160.96,
      "end": 162.72,
      "text": "前每一地还睡",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 8,
      "start": 162.72,
      "end": 164.8,
      "text": "一些好精神的传说",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 9,
      "start": 164.8,
      "end": 174.99,
      "text": "就输出却陪伴我",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 10,
      "start": 174.99,
      "end": 176.99,
      "text": "我觉得我们这种大战争的非常非常棒",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 11,
      "start": 176.99,
      "end": 178.99,
      "text": "所以我觉得这种大战非常有意义",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 12,
      "start": 178.99,
      "end": 179.79,
      "text": "希望我们还能",
      "avg_logprob": -0.5799492909794762,
      "no_speech_prob": 0.46389445662498474
    },
    {
      "id": 13,
      "start": 3600.0,
      "end": 3601.96,
      "text": "4号玩家说先出7再出吧",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 14,
      "start": 3602.16,
      "end": 3604.64,
      "text": "她的视角里她觉得8号玩家是那张混子盘",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 15,
      "start": 3604.64,
      "end": 3607.36,
      "text": "她觉得7号玩家是那张红狼盘在重复",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 16,
      "start": 3607.36,
      "end": 3609.4,
      "text": "但紧张我其实当时我有一段没有聊吧",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 17,
      "start": 3609.4,
      "end": 3611.76,
      "text": "就我听7号玩家发言感觉跟以后不是你相见面",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 18,
      "start": 3611.76,
      "end": 3615.0,
      "text": "因为她对着3号说让3号5双爆起来是砍衣",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 19,
      "start": 3615.0,
      "end": 3616.68,
      "text": "所以她如果业里跟以后见面的话",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 20,
      "start": 3616.68,
      "end": 3619.56,
      "text": "是不太会在白天指出1号玩家是一个身份盘",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 21,
      "start": 3619.56,
      "end": 3621.0,
      "text": "引起她家关注的",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 22,
      "start": 3621.0,
      "end": 3622.68,
      "text": "所以就是你这一轮",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 23,
      "start": 3622.68,
      "end": 3624.92,
      "text": "找PK对象你要保4号你要财务",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 24,
      "start": 3624.92,
      "end": 3627.08,
      "text": "所以我肯定不会觉得你是好人盘",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 25,
      "start": 3627.08,
      "end": 3629.48,
      "text": "因为你紧张发言我是给过你一次好人身份",
      "avg_logprob": -0.2705152606085149,
      "no_speech_prob": 0.8878151178359985
    },
    {
      "id": 26,
      "start": 3629.48,
      "end": 3631.0,
      "text": "因为我觉得你当时说十一十二里有狼",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 27,
      "start": 3631.0,
      "end": 3633.8,
      "text": "我觉得比较像是没有工作量的盘吗",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 28,
      "start": 3633.8,
      "end": 3635.92,
      "text": "但是这轮你先是制一七号玩家的",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 29,
      "start": 3635.92,
      "end": 3638.24,
      "text": "练人身份又不说九号玩家是赤毒练人",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 30,
      "start": 3638.24,
      "end": 3639.4,
      "text": "因为现在三十刀走的",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 31,
      "start": 3639.4,
      "end": 3641.68,
      "text": "所以你要说七号不是练人是混贼",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 32,
      "start": 3641.68,
      "end": 3643.4,
      "text": "只能说九号是练人对吧",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 33,
      "start": 3643.4,
      "end": 3645.44,
      "text": "你也没有说你到最后后半段才补充",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 34,
      "start": 3645.44,
      "end": 3647.16,
      "text": "说九号玩家可能是赤毒的",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 35,
      "start": 3647.16,
      "end": 3649.84,
      "text": "但九号玩家出局出局的时候的反馈感觉",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 36,
      "start": 3649.84,
      "end": 3651.72,
      "text": "不是很像知道自己压力就死了",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 37,
      "start": 3651.72,
      "end": 3653.68,
      "text": "所以七号肯定是练人盘",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 38,
      "start": 3653.68,
      "end": 3655.88,
      "text": "我头可能会头十号吧",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 39,
      "start": 3655.88,
      "end": 3657.52,
      "text": "其他的这种没过",
      "avg_logprob": -0.258127031497436,
      "no_speech_prob": 0.7736191153526306
    },
    {
      "id": 40,
      "start": 3657.52,
      "end": 3660.64,
      "text": "所有玩家翻結束,請各位帶規則好投票準備",
      "avg_logprob": -0.31265196582627675,
      "no_speech_prob": 0.09912873804569244
    },
    {
      "id": 41,
      "start": 3660.64,
      "end": 3663.92,
      "text": "等級遊戲請回流失,各位玩家請自行投票",
      "avg_logprob": -0.31265196582627675,
      "no_speech_prob": 0.09912873804569244
    },
    {
      "id": 42,
      "start": 3663.92,
      "end": 3665.36,
      "text": "唱票結束前,不要放手",
      "avg_logprob": -0.31265196582627675,
      "no_speech_prob": 0.09912873804569244
    },
    {
      "id": 43,
      "start": 3665.36,
      "end": 3668.2,
      "text": "3、2、1,請出票",
      "avg_logprob": -0.31265196582627675,
      "no_speech_prob": 0.09912873804569244
    },
    {
      "id": 44,
      "start": 3669.96,
      "end": 3672.84,
      "text": "2號投給10號,4號投給12號",
      "avg_logprob": -0.31265196582627675,
      "no_speech_prob": 0.09912873804569244
    },
    {
      "id": 45,
      "start": 3672.84,
      "end": 3675.96,
      "text": "7號投給10號,10號投給22號",
      "avg_logprob": -0.31265196582627675,
      "no_speech_prob": 0.09912873804569244
    },
    {
      "id": 46,
      "start": 3675.96,
      "end": 3678.24,
      "text": "12號投給10號投票結束",
      "avg_logprob": -0.31265196582627675,
      "no_speech_prob": 0.09912873804569244
    },
    {
      "id": 47,
      "start": 3679.24,
      "end": 3683.28,
      "text": "10號玩家,3票出局,遊戲結束,好,人正義後生",
      "avg_logprob": -0.31265196582627675,
      "no_speech_prob": 0.09912873804569244
    },
    {
      "id": 48,
      "start": 3683.28,
      "end": 3698.2,
      "text": "好 各位大佬老師們 做一下本球期的復盤",
      "avg_logprob": -0.4405349858782508,
      "no_speech_prob": 0.6837368011474609
    },
    {
      "id": 49,
      "start": 3698.2,
      "end": 3706.04,
      "text": "本具版行為運舉列白混血兒 神陣營 議員家5號 女巫6號 列人7號 白神3號",
      "avg_logprob": -0.4405349858782508,
      "no_speech_prob": 0.6837368011474609
    },
    {
      "id": 50,
      "start": 3706.04,
      "end": 3711.96,
      "text": "玩人陣營1號8號10號11號 平民陣營2號4號12號",
      "avg_logprob": -0.4405349858782508,
      "no_speech_prob": 0.6837368011474609
    },
    {
      "id": 51,
      "start": 3711.96,
      "end": 3715.4,
      "text": "混血兒為9號本球 行為好人混",
      "avg_logprob": -0.4405349858782508,
      "no_speech_prob": 0.6837368011474609
    },
    {
      "id": 52,
      "start": 3715.4,
      "end": 3719.72,
      "text": "熊夜混血而选择 三号白神为保样青成好人混",
      "avg_logprob": -0.7538362052705553,
      "no_speech_prob": 0.6685399413108826
    },
    {
      "id": 53,
      "start": 3719.72,
      "end": 3723.92,
      "text": "狼对岬骑叉二号平民 牛牛就起 形成平野",
      "avg_logprob": -0.7538362052705553,
      "no_speech_prob": 0.6685399413108826
    },
    {
      "id": 54,
      "start": 3723.92,
      "end": 3726.98,
      "text": "岬完驾验证了1号玩家为狼女生奋",
      "avg_logprob": -0.7538362052705553,
      "no_speech_prob": 0.6685399413108826
    },
    {
      "id": 55,
      "start": 3726.98,
      "end": 3729.8,
      "text": "在几唱《星雄环节》1号狼人选择自报",
      "avg_logprob": -0.7538362052705553,
      "no_speech_prob": 0.6685399413108826
    },
    {
      "id": 56,
      "start": 3729.8,
      "end": 3731.0,
      "text": "入夜",
      "avg_logprob": -0.7538362052705553,
      "no_speech_prob": 0.6685399413108826
    },
    {
      "id": 57,
      "start": 3731.0,
      "end": 3734.28,
      "text": "狼对岬骑叉三号白神 牛气能空过",
      "avg_logprob": -0.7538362052705553,
      "no_speech_prob": 0.6685399413108826
    },
    {
      "id": 58,
      "start": 3734.28,
      "end": 3737.4,
      "text": "岬完驾验证了4号玩家平民为好人身份",
      "avg_logprob": -0.7538362052705553,
      "no_speech_prob": 0.6685399413108826
    },
    {
      "id": 59,
      "start": 3737.4,
      "end": 3742.28,
      "text": "在严騎轻雄环节11号狼人选择自报本究竟会留失",
      "avg_logprob": -0.7538362052705553,
      "no_speech_prob": 0.6685399413108826
    },
    {
      "id": 60,
      "start": 3742.28,
      "end": 3746.56,
      "text": "若夜 狼隊擊殺5號 預言家 牛羊技能 截取空過",
      "avg_logprob": -0.42001234085270855,
      "no_speech_prob": 0.5700027942657471
    },
    {
      "id": 61,
      "start": 3746.56,
      "end": 3749.24,
      "text": "預言家驗 整7號玩家 獵人為好人身份",
      "avg_logprob": -0.42001234085270855,
      "no_speech_prob": 0.5700027942657471
    },
    {
      "id": 62,
      "start": 3749.24,
      "end": 3751.0,
      "text": "當夜為5號玩家擔死",
      "avg_logprob": -0.42001234085270855,
      "no_speech_prob": 0.5700027942657471
    },
    {
      "id": 63,
      "start": 3751.0,
      "end": 3754.8,
      "text": "在第三天的白天 8號 狼人選擇自暴",
      "avg_logprob": -0.42001234085270855,
      "no_speech_prob": 0.5700027942657471
    },
    {
      "id": 64,
      "start": 3754.8,
      "end": 3759.6,
      "text": "若夜 狼隊擊殺6號 女巫 女巫獨殺9號 混血而69雙死",
      "avg_logprob": -0.42001234085270855,
      "no_speech_prob": 0.5700027942657471
    },
    {
      "id": 65,
      "start": 3759.6,
      "end": 3764.24,
      "text": "在第4天的白天 場上 最後一狼 使號被攻頭出局",
      "avg_logprob": -0.42001234085270855,
      "no_speech_prob": 0.5700027942657471
    },
    {
      "id": 66,
      "start": 3764.24,
      "end": 3766.28,
      "text": "遊戲結束 討人正義獲勝",
      "avg_logprob": -0.42001234085270855,
      "no_speech_prob": 0.5700027942657471
    },
    {
      "id": 67,
      "start": 3766.28,
      "end": 3769.2,
      "text": "以上是我們今天第一局 百姓應女了白混血而的全部內容",
      "avg_logprob": -0.42001234085270855,
      "no_speech_prob": 0.5700027942657471
    },
    {
      "id": 68,
      "start": 3769.2,
      "end": 3771.4,
      "text": "再一次感謝各位丹麗老師的陪伴",
      "avg_logprob": -0.42001234085270855,
      "no_speech_prob": 0.5700027942657471
    },
    {
      "id": 69,
      "start": 3771.4,
      "end": 3772.68,
      "text": "这里是我们精神大的赛",
      "avg_logprob": -0.2899005481294382,
      "no_speech_prob": 0.04160776361823082
    },
    {
      "id": 70,
      "start": 3772.68,
      "end": 3774.48,
      "text": "第二十二赛技术光航记",
      "avg_logprob": -0.2899005481294382,
      "no_speech_prob": 0.04160776361823082
    },
    {
      "id": 71,
      "start": 3774.48,
      "end": 3775.48,
      "text": "绝赛中的第二天",
      "avg_logprob": -0.2899005481294382,
      "no_speech_prob": 0.04160776361823082
    },
    {
      "id": 72,
      "start": 3775.48,
      "end": 3777.68,
      "text": "希望每位选手们都能够好好发挥",
      "avg_logprob": -0.2899005481294382,
      "no_speech_prob": 0.04160776361823082
    },
    {
      "id": 73,
      "start": 3777.68,
      "end": 3779.48,
      "text": "获得最终的理想成绩",
      "avg_logprob": -0.2899005481294382,
      "no_speech_prob": 0.04160776361823082
    },
    {
      "id": 74,
      "start": 3779.48,
      "end": 3780.76,
      "text": "同样在本月月末",
      "avg_logprob": -0.2899005481294382,
      "no_speech_prob": 0.04160776361823082
    },
    {
